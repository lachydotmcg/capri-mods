            }
        }
        internal Rectangle PlateOnScreen
        {
            get
            {
                float s = Dpi;
                return new Rectangle(PlateLocation, new Size((int)Math.Round(bandWidth * s), (int)Math.Round(bandHeight * s)));
            }
        }
        internal void SetSavedPosition(Point? where)
        {
            if (where.HasValue) plate = where.Value;
            Clamp();
        }
        internal void ResetPosition()
        {
            Screen screen = Screen.PrimaryScreen;
            Rectangle area = screen.WorkingArea;
            float s = Dpi;
            int width = (int)Math.Round(bandWidth * s);
            int height = (int)Math.Round(bandHeight * s);
            plate = new Point(area.Left + (area.Width - width) / 2, area.Bottom - height - (int)Math.Round(24 * s));
        }
        private void Clamp()
        {
            if (plate.X == int.MinValue) return;
            float s = Dpi;
            int width = (int)Math.Round(bandWidth * s);
            int height = (int)Math.Round(bandHeight * s);
            Screen screen = Screen.FromPoint(plate);
            Rectangle area = screen.WorkingArea;
            int maxX = area.Right - Math.Min(width, area.Width);
            int maxY = area.Bottom - Math.Min(height, area.Height);
            int x = Math.Max(area.Left, Math.Min(plate.X, maxX));
            int y = Math.Max(area.Top, Math.Min(plate.Y, maxY));
            plate = new Point(x, y);
        }
        internal void ShowBand(bool show)
        {
            if (show)
            {
                if (plate.X == int.MinValue) ResetPosition();
                if (!Visible || closing)
                {
                    opening = true;
                    openedAt = Tm.Ms;
                }
                closing = false;
                dirty = true;
                Redraw();
            }
            else
            {
                opening = false;
                if (!Visible)
                {
                    closing = false;
                    Hide();
                    Forget();
                    warped = null;
                    return;
                }
                closing = true;
                closedAt = Tm.Ms;
                dirty = true;
            }
        }
        internal void SetIdle()
        {
            if (Data != null || Status != "idle") dirty = true;
            Data = null;
            Status = "idle";
            Title = "";
            Artist = "";
            Length = 0;
            Position = 0;
            Playing = false;
            lastIndex = -2;
            lastFraction = -1;
            lineAt = Tm.Ms;
        }
        internal void SetLoading(string title, string artist)
        {
            Data = null;
            Status = "loading";
            Title = title == null ? "" : title;
            Artist = artist == null ? "" : artist;
            Position = 0;
            Length = 0;
            lastIndex = -2;
            lastFraction = -1;
            lineAt = Tm.Ms;
            dirty = true;
        }
        internal void ShowLyrics(Lyrics lyrics, string fallbackTitle, string fallbackArtist)
        {
            Data = lyrics;
            if (lyrics != null)
            {
                Status = lyrics.Instrumental ? "instrumental" : lyrics.Status;
                Title = !string.IsNullOrEmpty(lyrics.Title) ? lyrics.Title : (fallbackTitle == null ? "" : fallbackTitle);
                Artist = !string.IsNullOrEmpty(lyrics.Artist) ? lyrics.Artist : (fallbackArtist == null ? "" : fallbackArtist);
            }
            lastIndex = -2;
            lastFraction = -1;
            lineAt = Tm.Ms;
            dirty = true;
        }
        internal bool SetPosition(double position, double length, bool playing)
        {
            if (length != Length || playing != Playing) dirty = true;
            Position = position;
            Length = length;
            Playing = playing;
            int index = Data != null ? LyricsParser.IndexAt(Data.Lines, position) : -1;
            if (index != lastIndex)
            {
                bool animate = lastIndex != -2 && Data != null;
                lastIndex = index;
                lastFraction = -1;
                lineAt = Tm.Ms;
                MoveCursor(index, animate);
                if (animate) lineChanged = true;
                dirty = true;
            }
            lastFraction = LyricsParser.Fraction(Data != null ? Data.Lines : null, index, position);
            dirty = true;
            return dirty;
        }
        private float CursorNow()
        {
            int age = unchecked(Tm.Ms - cursorAt);
            if (age >= ScrollMs || age < 0) return cursorTo;
            float t = age / (float)ScrollMs;
            float eased = 1f - (float)Math.Pow(1f - t, 3.0);
            return cursorFrom + (cursorTo - cursorFrom) * eased;
        }
        private void MoveCursor(int index, bool animate)
        {
            float now = CursorNow();
            cursorFrom = animate && Math.Abs(index - now) <= 4f ? now : index;
            cursorTo = index;
            cursorAt = Tm.Ms;
        }
        internal void FrameStep()
        {
            if (!Visible || dragging || sizing) return;
            dirty = true;
            Redraw();
        }
        internal void Redraw()
        {
            if (!Visible && !dirty) return;
            dirty = false;
            double nowSeconds = Tm.Seconds;
            float dt = lastFrameAt < 0 ? 0.016f : (float)Math.Min(0.1, Math.Max(0.0, nowSeconds - lastFrameAt));
            lastFrameAt = nowSeconds;
            if (impact > impactTarget) impact = Math.Max(impactTarget, impact - dt * 2.4f);
            float fade = 1f;
            float slide = 0f;
            if (opening)
            {
                int openAge = unchecked(Tm.Ms - openedAt);
                if (openAge >= OpenMs) opening = false;
                else
                {
                    float t = openAge <= 0 ? 0f : openAge / (float)OpenMs;
                    float eased = 1f - (float)Math.Pow(1f - t, 3.0);
                    fade = eased;
                    slide = 1f - eased;
                }
            }
            if (closing)
            {
                int closeAge = unchecked(Tm.Ms - closedAt);
                if (closeAge >= CloseMs)
                {
                    closing = false;
                    opening = false;
                    Hide();
                    Forget();
                    warped = null;
                    return;
                }
                float u = closeAge <= 0 ? 0f : closeAge / (float)CloseMs;
                fade *= 1f - u * u;
            }
            float s = Dpi;
            int width = (int)Math.Round(bandWidth * s);
            int height = (int)Math.Round(bandHeight * s);
            if (surface == null || surface.Width != width || surface.Height != height)
            {
                ReleaseSurfaces();
                surface = new Bitmap(width, height, PixelFormat.Format32bppPArgb);
                warped = new Bitmap(width, height, PixelFormat.Format32bppPArgb);
                chrome = new Bitmap(width, height, PixelFormat.Format32bppPArgb);
                surfaceGraphics = Graphics.FromImage(surface);
                surfaceGraphics.SmoothingMode = SmoothingMode.AntiAlias;
                surfaceGraphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
                surfaceGraphics.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
                chromeGraphics = Graphics.FromImage(chrome);
                chromeGraphics.SmoothingMode = SmoothingMode.AntiAlias;
                chromeGraphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
                chromeGraphics.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
                chromeStep = int.MinValue;
            }
            Graphics graphics = surfaceGraphics;
            graphics.Clear(Color.Transparent);
            RectangleF box = new RectangleF(0, 0, width, height);
            float clock = Clock;
            int step = impact > 0.001f ? int.MinValue : (int)(clock * 20f);
            if (step == int.MinValue || step != chromeStep)
            {
                chromeGraphics.Clear(Color.Transparent);
                Art.PlateBody(chromeGraphics, box, s, clock, impact);
                chromeStep = step;
            }
            graphics.DrawImageUnscaled(chrome, 0, 0);
            Art.Runners(graphics, box, s, clock);
            bool rows = LayoutRows(graphics, s, width, height);
            bool newLine = lineChanged;
            lineChanged = false;
            if (FacesOn)
            {
                faces.Update(clock, dt, bandWidth, bandHeight, Playing && Status == "ok", newLine, impact);
                faces.Draw(graphics, s, clock, bandWidth, bandHeight);
            }
            DrawHeader(graphics, s, width, clock, impact);
            if (rows) PaintRows(graphics, s, width, height);
            else DrawMessage(graphics, s, width, height);
            DrawProgress(graphics, s, width, height);
            if (FacesOn) faces.DrawOverlay(graphics, s, clock, bandWidth, bandHeight);
            Bitmap image = Art.Tilt(surface, TopScale, warped);
            if (!ReferenceEquals(image, warped)) warped = image;
            int shakeX = FacesOn ? (int)Math.Round(faces.ShakeX * s) : 0;
            int shakeY = FacesOn ? (int)Math.Round(faces.ShakeY * s) : 0;
            Point at = new Point(PlateLocation.X + shakeX, PlateLocation.Y + shakeY + (int)Math.Round(slide * 14f * s));
            int alpha = (int)Math.Round(255f * Math.Max(0f, Math.Min(1f, fade)));
            try { Present(image, at, alpha); }
            catch (Exception) { warped = null; throw; }
            TuckSoon();
        }
        private void ReleaseSurfaces()
        {
            if (surfaceGraphics != null) { surfaceGraphics.Dispose(); surfaceGraphics = null; }
            if (chromeGraphics != null) { chromeGraphics.Dispose(); chromeGraphics = null; }
            if (surface != null) { surface.Dispose(); surface = null; }
            if (chrome != null) { chrome.Dispose(); chrome = null; }
            if (warped != null)
            {
                if (ReferenceEquals(Frame, warped)) Frame = null;
                warped.Dispose();
                warped = null;
            }
        }
        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                ReleaseSurfaces();
                faces.Release();
            }
            base.Dispose(disposing);
        }
        private string Headline()
        {
            string title = Title == null ? "" : Title.Trim();
            string artist = Artist == null ? "" : Artist.Trim();
            if (title.Length == 0 && artist.Length == 0) return "";
            if (artist.Length == 0) return title;
            if (title.Length == 0) return artist;
            return title + "  \u2014  " + artist;
        }
        private string StatusWord()
        {
            switch (Status)
            {
                case "loading": return "CHARGEMENT";
                case "instrumental": return "INSTRUMENTAL";
                case "none": return "PAS DE PAROLES";
                case "error": return "HORS LIGNE";
                case "ok": return Data != null && Data.Synced ? "SYNCHRO" : "APPROX.";
                default: return "";
            }
        }
        private string StatusMessage()
        {
            switch (Status)
            {
                case "loading": return "Chargement des paroles\u2026";
                case "instrumental": return "\u266a  Instrumental  \u266a";
                case "none": return "Pas de paroles pour ce titre.";
                case "error": return "Paroles indisponibles (hors ligne ?).";
                case "idle": return "Rien en lecture.";
                default: return "";
            }
        }
        private static string Mmss(double seconds)
        {
            int total = seconds < 0 ? 0 : (int)seconds;
            return (total / 60).ToString(CultureInfo.InvariantCulture) + ":" + (total % 60).ToString("00", CultureInfo.InvariantCulture);
        }
        private void DrawHeader(Graphics graphics, float s, int width, float clock, float impact)
        {
            float pad = 24 * s;
            bool lit = Status == "ok";
            StringFormat typo = Art.Shared;
            RectangleF badge = new RectangleF(pad, 9 * s, 34 * s, 19 * s);
            using (GraphicsPath path = Art.Cut(badge, 5 * s))
            {
                using (LinearGradientBrush fill = new LinearGradientBrush(new PointF(badge.Left, 0), new PointF(badge.Right + 1, 0),
                    Color.FromArgb(lit ? 74 : 28, lit ? Art.Cyan : Art.Dim), Color.FromArgb(lit ? 14 : 8, lit ? Art.Pink : Art.Dim)))
                    graphics.FillPath(fill, path);
                using (Pen edge = new Pen(Color.FromArgb(lit ? 230 : 120, lit ? Art.Cyan : Art.Dim), Math.Max(1, s)))
                    graphics.DrawPath(edge, path);
            }
            Font badgeFont = Art.Mono(11 * s, FontStyle.Regular, "CC");
            using (Brush badgeInk = new SolidBrush(Color.FromArgb(lit ? 245 : 150, lit ? Art.Ink : Art.Dim)))
            using (StringFormat centred = new StringFormat())
            {
                centred.Alignment = StringAlignment.Center;
                centred.LineAlignment = StringAlignment.Center;
                graphics.DrawString("CC", badgeFont, badgeInk, badge, centred);
            }
            float meterX = badge.Right + 9 * s;
            float meterBase = 27 * s;
            for (int i = 0; i < 5; i++)
            {
                double phase = clock * (Playing ? 6.2 : 1.7) + i * 1.17;
                float level = (float)(Math.Sin(phase) * 0.5 + 0.5);
                level = Playing ? 0.25f + level * 0.75f : 0.12f + level * 0.18f;
                float barHeight = (3f + level * 13f) * s;
                Color tone = i % 2 == 0 ? Art.Cyan : Art.Pink;
                using (Brush bar = new SolidBrush(Color.FromArgb(60 + (int)(level * 150), tone)))
                    graphics.FillRectangle(bar, meterX + i * 3.6f * s, meterBase - barHeight, 1.5f * s, barHeight);
            }
            float slashX = meterX + 5 * 3.6f * s + 4 * s;
            using (Pen slash = new Pen(Color.FromArgb(120, Art.Pink), Math.Max(1, s)))
            {
                graphics.DrawLine(slash, slashX, 24 * s, slashX + 4 * s, 12 * s);
                graphics.DrawLine(slash, slashX + 4 * s, 24 * s, slashX + 8 * s, 12 * s);
            }
            float pulse = (float)(Math.Sin(clock * (impact > 0 ? 9.0 : 3.4)) * 0.5 + 0.5);
            Color led = lit ? Art.Cyan : Art.Dim;
            float ledX = width - pad - 4 * s, ledY = 18.5f * s;
            float core = 3.1f * s;
            using (Brush halo = new SolidBrush(Color.FromArgb(22 + (int)(64 * pulse), led)))
                graphics.FillPolygon(halo, Diamond(ledX, ledY, core * 2.9f));
            using (Brush light = new SolidBrush(Color.FromArgb(110 + (int)(145 * pulse), led)))
                graphics.FillPolygon(light, Diamond(ledX, ledY, core));
            using (Pen tick = new Pen(Color.FromArgb(70 + (int)(60 * pulse), led), Math.Max(1, s)))
                graphics.DrawLine(tick, ledX, 8 * s, ledX, 12 * s);
            float right = ledX - 14 * s;
            string status = StatusWord();
            if (status.Length > 0)
            {
                Font statusFont = Art.Mono(10 * s, FontStyle.Regular, status);
                float statusWidth = graphics.MeasureString(status, statusFont, PointF.Empty, typo).Width;
                RectangleF tag = new RectangleF(right - statusWidth - 14 * s, 10 * s, statusWidth + 14 * s, 16 * s);
                using (GraphicsPath tagPath = Art.Cut(tag, 4 * s))
                {
                    using (Brush fill = new SolidBrush(Color.FromArgb(lit ? 26 : 14, lit ? Art.Cyan : Art.Dim)))
                        graphics.FillPath(fill, tagPath);
                    using (Pen edge = new Pen(Color.FromArgb(lit ? 150 : 90, lit ? Art.Cyan : Art.Dim), Math.Max(1, s)))
                        graphics.DrawPath(edge, tagPath);
                }
                using (Brush ink = new SolidBrush(Color.FromArgb(lit ? 225 : 170, lit ? Art.Cyan : Art.Dim)))
                    graphics.DrawString(status, statusFont, ink, tag.Left + 7 * s, tag.Top + (tag.Height - statusFont.GetHeight(graphics)) / 2f, typo);
                right = tag.Left - 12 * s;
            }
            if (lit && Length > 0)
            {
                string time = Mmss(Position) + " / " + Mmss(Length);
                Font timeFont = Art.Mono(11 * s, FontStyle.Regular, time);
                float timeWidth = graphics.MeasureString(time, timeFont, PointF.Empty, typo).Width;
                using (Brush ink = new SolidBrush(Color.FromArgb(185, Art.Dim)))
                    graphics.DrawString(time, timeFont, ink, right - timeWidth, 12 * s, typo);
                right -= timeWidth + 14 * s;
            }
            string title = Title == null ? "" : Title.Trim();
            string artist = Artist == null ? "" : Artist.Trim();
            if (title.Length > 0 || artist.Length > 0)
            {
                float left = slashX + 8 * s + 9 * s;
                float room = right - left;
                Font font = Art.Mono(12.5f * s, FontStyle.Regular, title + artist);
                float shift = 0;
                int alpha = 225;
                if (impact > 0.01f)
                {
                    uint h = Art.Hash((uint)(clock * 14f), 7u, 91u);
                    shift = ((int)(h & 63) - 31) / 31f * 9 * s * impact;
                    if ((h & 7) == 0) alpha = 90;
                }
                else
                {
                    int slot = (int)(clock * 1000f) % 4200;
                    if (slot < 90) alpha = 130;
                }
                float used = 0;
                if (title.Length > 0 && room > 10)
                {
                    string shown = Art.Ellipsize(graphics, title, font, typo, artist.Length > 0 ? Math.Max(10, room * 0.66f) : room);
                    used = graphics.MeasureString(shown, font, PointF.Empty, typo).Width;
                    using (Brush brush = new SolidBrush(Color.FromArgb(alpha, Art.Ink)))
                        graphics.DrawString(shown, font, brush, left + shift, 12 * s, typo);
                }
                if (artist.Length > 0 && room - used > 40 * s)
                {
                    string shown = Art.Ellipsize(graphics, (title.Length > 0 ? "  " : "") + artist, font, typo, room - used);
                    using (Brush brush = new SolidBrush(Color.FromArgb(Math.Max(0, alpha - 60), Art.Dim)))
                        graphics.DrawString(shown, font, brush, left + used + shift, 12 * s, typo);
                }
            }
            float ruleY = (HeaderHeight - 4) * s;
            using (LinearGradientBrush rule = new LinearGradientBrush(new PointF(pad, 0), new PointF(pad + width * 0.26f, 0),
                Color.FromArgb(lit ? 150 : 70, Art.Cyan), Color.FromArgb(0, Art.Cyan)))
            using (Pen pen = new Pen(rule, Math.Max(1, 1.2f * s))) graphics.DrawLine(pen, pad, ruleY, pad + width * 0.26f, ruleY);
            using (Brush node = new SolidBrush(Color.FromArgb(lit ? 220 : 110, Art.Pink)))
                graphics.FillPolygon(node, Diamond(pad, ruleY, 2.3f * s));
        }
        private static PointF[] Diamond(float cx, float cy, float radius)
        {
            return new PointF[]
            {
                new PointF(cx, cy - radius), new PointF(cx + radius, cy),
                new PointF(cx, cy + radius), new PointF(cx - radius, cy)
            };
        }
        private static float Weight(float rel)
        {
            float w = 1f - Math.Abs(rel);
            if (w <= 0f) return 0f;
            return w * w * (3f - 2f * w);
        }
        private static string TextOf(LyricLine[] lines, int index)
        {
            if (lines == null || index < 0 || index >= lines.Length || lines[index] == null || lines[index].Text == null) return "";
            return lines[index].Text;
        }
        private float GrowFor(Graphics graphics, LyricLine[] lines, int index, float baseSize, float room)
        {
            float known = growCache[index];
            if (known > 0f) return known;
            string text = TextOf(lines, index);
            if (text.Length == 0) text = "\u266A";
            Font probe = Art.Display(baseSize, FontStyle.Bold, text);
            float natural = graphics.MeasureString(text, probe, PointF.Empty, Art.Shared).Width;
            float grow = 1f;
            if (natural > 0 && natural < room) grow = Math.Min(room / natural, 1.55f);
            growCache[index] = grow;
            return grow;
        }
        private bool LayoutRows(Graphics graphics, float s, int width, int height)
        {
            seatKnown = false;
            rowCount = 0;
            LyricLine[] lines = Data != null ? Data.Lines : null;
            if (lines == null || lines.Length == 0) return false;
            float pad = 24 * s;
            float top = (HeaderHeight + 8) * s;
            float bottom = (height - 20) * s;
            float area = bottom - top;
            float room = width - 2 * pad;
            if (area <= 0 || room <= 0) return false;
            if (growCache == null || growCache.Length != lines.Length || !ReferenceEquals(growData, Data)
                || growRoom != room || growSize != TextSize * s)
            {
                growCache = new float[lines.Length];
                growData = Data;
                growRoom = room;
                growSize = TextSize * s;
            }
            float u = CursorNow();
            int first = (int)Math.Floor(u) - 3;
            int count = (int)Math.Ceiling(u) + 3 - first + 1;
            if (count > MaxRows) count = MaxRows;
            float ctxBase = Math.Max(9 * s, TextSize * ContextScale * s);
            float curBase = TextSize * CurrentScale * s;
            float ctxRefH = Art.Display(ctxBase, FontStyle.Bold, "Ag").GetHeight(graphics) + s;
            float curRefH = Art.Display(curBase * 1.55f, FontStyle.Bold, "Ag").GetHeight(graphics) + 2 * s;
            float need = 2f * (2f * ctxRefH + curRefH * 0.5f);
            float shrink = need > area && need > 0 ? area / need : 1f;
            float stack = 0f;
            for (int k = 0; k < count; k++)
            {
                int j = first + k;
                bool real = j >= 0 && j < lines.Length;
                float rel = j - u;
                float w = Weight(rel);
                float ctx = ctxBase * shrink;
                float cur = curBase * (real ? GrowFor(graphics, lines, j, curBase, room) : 1f) * shrink;
                float size = (float)Math.Round(ctx + (cur - ctx) * w);
                if (size < 6f) size = 6f;
                float h = Art.Display(size, FontStyle.Bold, "Ag").GetHeight(graphics) + (1f + w) * s;
                rowLine[k] = real ? j : -1;
                rowRel[k] = rel;
                rowWeight[k] = w;
                rowSize[k] = size;
                rowHeight[k] = h;
                rowTop[k] = stack;
                stack += h;
            }
            int k0 = (int)Math.Floor(u) - first;
            float frac = u - (float)Math.Floor(u);
            int k1 = Math.Min(count - 1, k0 + 1);
            float c0 = rowTop[k0] + rowHeight[k0] * 0.5f;
            float c1 = rowTop[k1] + rowHeight[k1] * 0.5f;
            float shift = top + area * 0.5f - (c0 + (c1 - c0) * frac);
            for (int k = 0; k < count; k++) rowTop[k] += shift;
            rowCount = count;
            int best = -1;
            float bestWeight = 0.5f;
            for (int k = 0; k < count; k++)
            {
                if (rowLine[k] >= 0 && rowWeight[k] > bestWeight)
                {
                    bestWeight = rowWeight[k];
                    best = k;
                }
            }
            if (best >= 0)
            {
                string text = TextOf(lines, rowLine[best]);
                if (text.Length == 0) text = "\u266A";
                Font font = Art.Display(rowSize[best], FontStyle.Bold, text);
                float measured = graphics.MeasureString(text, font, PointF.Empty, Art.Shared).Width;
                float used = Math.Min(measured, room);
                seatUsed = used / room;
                seatLineY = rowTop[best] + rowHeight[best] - 3 * s;
                seatLineRight = pad + (room + used) / 2f + 12 * s + 40 * s;
                seatKnown = true;
            }
            return true;
        }
        private void PaintRows(Graphics graphics, float s, int width, int height)
        {
            LyricLine[] lines = Data.Lines;
            float pad = 24 * s;
            float top = (HeaderHeight + 8) * s;
            float bottom = (height - 20) * s;
            float room = width - 2 * pad;
            int current = LyricsParser.IndexAt(lines, Position);
            double fraction = LyricsParser.Fraction(lines, current, Position);
            int age = unchecked(Tm.Ms - lineAt);
            float punch = age < 0 || age >= 320 ? 0f : 1f - age / 320f;
            Region saved = graphics.Clip;
            graphics.SetClip(new RectangleF(0, top - 4 * s, width, bottom - top + 8 * s), CombineMode.Intersect);
            for (int k = 0; k < rowCount; k++)
            {
                int j = rowLine[k];
                if (j < 0) continue;
                float rel = rowRel[k];
                float w = rowWeight[k];
                Color context = rel < 0 ? Color.FromArgb(90, Art.Dim) : Color.FromArgb(138, Art.Dim);
                Color colour = Art.Mix(context, Color.FromArgb(228, Art.Ink), w);
                float far = Math.Abs(rel);
                if (far > 2f) colour = Color.FromArgb((int)(colour.A * Math.Max(0f, 3f - far)), colour);
                if (colour.A < 4) continue;
                double wipe = j < current ? 1.0 : j == current ? fraction : 0.0;
                float used = Art.RowSmooth(graphics, TextOf(lines, j), rowSize[k], room, pad, rowTop[k], room,
                    colour, w, wipe, s, impact, j * 31 + 17, w >= 0.5f ? punch : 0f);
                if (w > 0.15f) Accent(graphics, s, pad, room, rowTop[k], used, rowHeight[k], impact, w);
            }
            graphics.Clip = saved;
            saved.Dispose();
        }
        private void DrawMessage(Graphics graphics, float s, int width, int height)
        {
            float pad = 24 * s;
            float top = (HeaderHeight + 8) * s;
            float bottom = (height - 20) * s;
            float area = bottom - top;
            string message = StatusMessage();
            if (message.Length == 0) return;
            float size = Math.Max(12 * s, TextSize * 0.72f * s);
            Font font = Art.Display(size, FontStyle.Bold, message);
            StringFormat msgFormat = Art.Shared;
            string shown = Art.Ellipsize(graphics, message, font, msgFormat, width - 2 * pad);
            float measured = graphics.MeasureString(shown, font, PointF.Empty, msgFormat).Width;
            float messageY = top + (area - font.GetHeight(graphics)) / 2f;
            int alpha = Status == "loading" ? 110 + (int)(90 * (Math.Sin(Clock * 4.0) * 0.5 + 0.5)) : 175;
            using (Brush brush = new SolidBrush(Color.FromArgb(alpha, Art.Dim)))
                graphics.DrawString(shown, font, brush, (width - measured) / 2f, messageY, msgFormat);
        }
        private void DrawProgress(Graphics graphics, float s, int width, int height)
        {
            if (Length <= 0 || Status != "ok") return;
            float pad = 24 * s;
            float label = 36 * s;
            float barLeft = pad + label, barRight = width - pad - label, y = height - 11 * s;
            float span = barRight - barLeft;
            if (span < 40 * s) return;
            double played = Math.Max(0, Math.Min(1, Position / Length));
            float x = barLeft + (float)(played * span);
            float seg = 5f * s, thick = 3.2f * s;
            float dash = 0.62f * seg / thick, gap = 0.38f * seg / thick;
            StringFormat typo = Art.Shared;
            using (Pen off = new Pen(Color.FromArgb(78, 56, 64, 80), thick))
            {
                off.DashPattern = new float[] { dash, gap };
                graphics.DrawLine(off, barLeft, y, barRight, y);
            }
            if (played > 0)
            {
                using (LinearGradientBrush ink = new LinearGradientBrush(new PointF(barLeft - 1, 0), new PointF(barRight + 1, 0), Art.Pink, Art.Cyan))
                using (Pen done = new Pen(ink, thick))
                {
                    done.DashPattern = new float[] { dash, gap };
                    graphics.DrawLine(done, barLeft, y, x, y);
                }
                float beat = (float)(Math.Sin(Clock * 5.4) * 0.5 + 0.5);
                using (Pen halo = new Pen(Color.FromArgb(24 + (int)(60 * beat), Art.Cyan), Math.Max(2f, 7f * s)))
                    graphics.DrawLine(halo, x, y - 7 * s, x, y + 7 * s);
                using (Pen blade = new Pen(Color.FromArgb(235, Art.Ink), Math.Max(1f, 1.6f * s)))
                    graphics.DrawLine(blade, x, y - 7 * s, x, y + 7 * s);
                using (Brush head = new SolidBrush(Color.FromArgb(235, Art.Pink)))
                    graphics.FillPolygon(head, Diamond(x, y - 10 * s, 2.6f * s));
            }
            Font font = Art.Mono(9.5f * s, FontStyle.Regular, "0:00");
            string elapsed = Mmss(Position), total = Mmss(Length);
            float rowTop = y - font.GetHeight(graphics) / 2f;
            float totalWidth = graphics.MeasureString(total, font, PointF.Empty, typo).Width;
            using (Brush ink = new SolidBrush(Color.FromArgb(185, Art.Dim)))
            {
                graphics.DrawString(elapsed, font, ink, pad, rowTop, typo);
                graphics.DrawString(total, font, ink, width - pad - totalWidth, rowTop, typo);
            }
        }
        private void Accent(Graphics graphics, float s, float left, float area, float top, float used, float height, float impact, float strength)
        {
            if (used <= 0 || strength <= 0.01f) return;
            float x0 = left + (area - used) / 2f;
            if (x0 < left) x0 = left;
            float x1 = x0 + used;
            float y = top + height - 3 * s;
            float reach = 12 * s;
            int basic = impact > 0.01f ? 80 : 150;
            int alpha = (int)(basic * strength);
            int nodeAlpha = (int)(Math.Min(255, basic + 80) * strength);
            using (LinearGradientBrush ink = new LinearGradientBrush(new PointF(x0 - reach, 0), new PointF(x1 + reach, 0),
                Color.FromArgb(alpha, Art.Cyan), Color.FromArgb(alpha, Art.Pink)))
            using (Pen pen = new Pen(ink, Math.Max(1, 1.6f * s)))
            {
                pen.StartCap = LineCap.Round;
                pen.EndCap = LineCap.Round;
                graphics.DrawLine(pen, x0 - reach, y, x0 - 4 * s, y);
                graphics.DrawLine(pen, x1 + 4 * s, y, x1 + reach, y);
            }
            using (Brush node = new SolidBrush(Color.FromArgb(nodeAlpha, Art.Pink)))
                graphics.FillPolygon(node, Diamond(x0 - 2 * s, y, 2.4f * s));
            using (Brush node = new SolidBrush(Color.FromArgb(nodeAlpha, Art.Cyan)))
                graphics.FillPolygon(node, Diamond(x1 + 2 * s, y, 2.4f * s));
        }
        protected override void WndProc(ref Message message)
        {
            if (message.Msg == 0x0021)
            {
                message.Result = new IntPtr(3); // MA_NOACTIVATE
                return;
            }
            if (message.Msg == 0x0084 && Frame != null)
            {
                long value = message.LParam.ToInt64();
                Point point = PointToClient(new Point((short)(value & 65535), (short)((value >> 16) & 65535)));
                float s = Dpi;
                int glow = (int)Math.Round(Glow * s);
                Rectangle header = new Rectangle(glow, glow, (int)Math.Round(bandWidth * s), (int)Math.Round(HeaderHeight * s));
                if (!header.Contains(point) && !GripBox(s).Contains(point))
                {
                    message.Result = new IntPtr(-1);
                    return;
                }
            }
            base.WndProc(ref message);
        }
        protected override void OnMouseDown(MouseEventArgs e)
        {
            base.OnMouseDown(e);
            if (e.Button != MouseButtons.Left) return;
            if (GripBox(Dpi).Contains(e.Location))
            {
                sizing = true;
                sizeCursor = Cursor.Position;
                sizeStartWidth = bandWidth;
                sizeStartHeight = bandHeight;
                Cursor = Cursors.SizeNWSE;
                Capture = true;
                return;
            }
            dragging = true;
            grabCursor = Cursor.Position;
            grabPlate = PlateLocation;
            Capture = true;
        }
        protected override void OnMouseMove(MouseEventArgs e)
        {
            base.OnMouseMove(e);
            float s = Dpi;
            if (sizing)
            {
                Point now = Cursor.Position;
                float scale = s <= 0 ? 1 : s;
                SizeF wanted = BandSize(sizeStartWidth + (now.X - sizeCursor.X) / scale,
                    sizeStartHeight + (now.Y - sizeCursor.Y) / scale);
                if (wanted.Width != bandWidth || wanted.Height != bandHeight)
                {
                    bandWidth = wanted.Width;
                    bandHeight = wanted.Height;
                    dirty = true;
                    Redraw();
                }
                return;
            }
            if (!dragging)
            {
                Cursor = GripBox(s).Contains(e.Location) ? Cursors.SizeNWSE : Cursors.SizeAll;
                return;
            }
            Point at = Cursor.Position;
            plate = new Point(grabPlate.X + at.X - grabCursor.X, grabPlate.Y + at.Y - grabCursor.Y);
            dirty = true;
            SlideTo(plate);
        }
        protected override void OnMouseUp(MouseEventArgs e)
        {
            base.OnMouseUp(e);
            if (sizing)
            {
                sizing = false;
                if (Capture) Capture = false;
                Clamp();
                dirty = true;
                Redraw();
                if (Moved != null) Moved();
                return;
            }
            if (!dragging) return;
            dragging = false;
            if (Capture) Capture = false;
            Clamp();
            dirty = true;
            Redraw();
            if (Moved != null) Moved();
        }
        protected override void OnVisibleChanged(EventArgs e)
        {
            base.OnVisibleChanged(e);
            if (!Visible)
            {
                Forget();
                warped = null;
                ForgetTuck();
            }
        }
    }
    internal sealed class CcWindow : BandForm
    {
        internal bool Lit;
        internal event Action Clicked;
        private bool hover;
        private bool drawnHover, drawnLit;
        private Rectangle drawnAt = Rectangle.Empty;
        private float drawnScale = -1;
        internal CcWindow() : base("Capri lyrics CC")
        {
            AccessibleName = "Capri lyrics CC";
            Cursor = Cursors.Hand;
        }
        internal void ShowAt(Point at, float scale, bool lit)
        {
            bool over = Bounds.Contains(Cursor.Position);
            if (Visible && !hover && over)
            {
                hover = true;
            }
            else if (!over) hover = false;
            if (Visible) Tuck();
            Size size = CcGeometry.ImageSize(scale);
            if (Visible && drawnAt.Location == at && drawnAt.Size == size && drawnHover == hover && drawnLit == lit && drawnScale == scale) return;
            drawnAt = new Rectangle(at, size);
            drawnHover = hover;
            drawnLit = lit;
            drawnScale = scale;
            Lit = lit;
            Present(Render(scale, over), at);
            Tuck();
        }
        internal void HideIfShown()
        {
            if (Visible) Hide();
            drawnAt = Rectangle.Empty;
            drawnScale = -1;
        }
        internal void SlideWith(Point at)
        {
            if (!Visible || Frame == null) return;
            Rectangle target = new Rectangle(at, Frame.Size);
            if (Bounds != target) Bounds = target;
            drawnAt = target;
        }
        private Bitmap Render(float scale, bool over)
        {
            float s = scale <= 0 ? 1 : scale;
            int glow = (int)Math.Round(CcGeometry.Glow * s);
            int side = (int)Math.Round(CcGeometry.Size * s);
            int size = side + glow * 2;
            Bitmap image = new Bitmap(size, size, PixelFormat.Format32bppPArgb);
            using (Graphics graphics = Graphics.FromImage(image))
            {
                graphics.SmoothingMode = SmoothingMode.AntiAlias;
                graphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
                graphics.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
                graphics.TranslateTransform(glow, glow);
                RectangleF box = new RectangleF(0, 0, side, side);
                Color edge = Lit ? Art.Cyan : Art.Dim;
                using (GraphicsPath path = Art.Cut(box, 6 * s))
                {
                    if (Lit || over)
                        using (LinearGradientBrush haze = new LinearGradientBrush(new PointF(-1, 0), new PointF(side + 1, 0),
                            Color.FromArgb(Lit ? 70 : 40, Art.Pink), Color.FromArgb(Lit ? 70 : 40, Art.Cyan)))
                        using (Pen wide = new Pen(haze, 8 * s)) graphics.DrawPath(wide, path);
                    using (Brush fill = new SolidBrush(Color.FromArgb(Lit ? 220 : 200, 5, 6, 9))) graphics.FillPath(fill, path);
                    Region saved = graphics.Clip;
                    graphics.SetClip(path);
                    using (Pen scan = new Pen(Color.FromArgb(10, 255, 255, 255), Math.Max(1, s)))
                        for (float row = 0; row < side; row += 3 * s) graphics.DrawLine(scan, 0, row, side, row);
                    graphics.Clip = saved;
                    using (Brush edgeBrush = new SolidBrush(over ? Art.Ink : edge))
                    using (Pen pen = new Pen(edgeBrush, Math.Max(1, 1.3f * s))) graphics.DrawPath(pen, path);
                }
                string label = "CC";
                Font font = Art.Mono(11.5f * s, FontStyle.Regular, label);
                using (Brush ink = new SolidBrush(Lit ? Art.Ink : over ? Art.Cyan : Art.Dim))
                using (StringFormat centred = new StringFormat())
                {
                    centred.Alignment = StringAlignment.Center;
                    centred.LineAlignment = StringAlignment.Center;
                    graphics.DrawString(label, font, ink, box, centred);
                }
            }
            return image;
        }
        protected override void OnMouseEnter(EventArgs e)
        {
            base.OnMouseEnter(e);
            hover = true;
        }
        protected override void OnMouseLeave(EventArgs e)
        {
            base.OnMouseLeave(e);
            hover = false;
        }
        protected override void OnMouseUp(MouseEventArgs e)
        {
            base.OnMouseUp(e);
            if (e.Button != MouseButtons.Left) return;
            if (Clicked != null) Clicked();
        }
    }
    internal static class FaceData
    {
        internal static float[] Eyes(string name)
        {
            switch (name)
            {
                case "ceiling_hands": return new float[] { 64.3f, 85.6f, 95.7f, 74.2f };
                case "ceiling_feet": return new float[] { 64.5f, 80.2f, 95.0f, 79.4f };
                case "crouch": return new float[] { 63.4f, 87.7f, 96.9f, 72.5f };
                case "wall_left": return new float[] { 62.7f, 85.2f, 97.6f, 75.1f };
                case "wall_right": return new float[] { 64.5f, 86.7f, 95.4f, 73.5f };
                case "seat": return new float[] { 63.0f, 86.7f, 97.1f, 73.4f };
                case "sit_floor": return new float[] { 63.5f, 87.4f, 96.5f, 73.1f };
            }
            return null;
        }
        internal static string Base64(string name)
        {
            switch (name)
            {
                case "ceiling_hands": return "";
                case "ceiling_feet": return "";
                case "crouch": return "";
                case "wall_left": return "";
                case "wall_right": return "";
                case "seat": return "";
                case "sit_floor": return "";
            }
            return null;
        }
    }
    internal sealed class Face
    {
        internal Bitmap Image;
        internal int Width, Height;
        internal float EyeAX, EyeAY, EyeBX, EyeBY;
    }
    internal static class FaceBank
    {
        internal const int Count = 7;
        private static readonly string[] Names = new string[]
        {
            "ceiling_hands", "ceiling_feet", "crouch", "wall_left", "wall_right", "seat", "sit_floor"
        };
        private static readonly Face[] Loaded = new Face[Count];
        private static readonly bool[] Tried = new bool[Count];
        internal static Face Get(int index)
        {
            if (index < 0 || index >= Count) return null;
            if (!Tried[index])
            {
                Tried[index] = true;
                Loaded[index] = Load(Names[index]);
            }
            return Loaded[index];
        }
        private static Face Load(string name)
        {
            try
            {
                string data = FaceData.Base64(name);
                float[] eyes = FaceData.Eyes(name);
                if (data == null || eyes == null) return null;
                byte[] bytes = Convert.FromBase64String(data);
                using (MemoryStream stream = new MemoryStream(bytes))
                using (Bitmap raw = new Bitmap(stream))
                {
                    Bitmap flat = new Bitmap(raw.Width, raw.Height, PixelFormat.Format32bppPArgb);
                    using (Graphics paint = Graphics.FromImage(flat))
                    {
                        paint.Clear(Color.Transparent);
                        paint.DrawImage(raw, 0, 0, raw.Width, raw.Height);
                    }
                    Face made = new Face();
                    made.Image = flat;
                    made.Width = flat.Width;
                    made.Height = flat.Height;
                    made.EyeAX = eyes[0];
                    made.EyeAY = eyes[1];
                    made.EyeBX = eyes[2];
                    made.EyeBY = eyes[3];
                    return made;
                }
            }
            catch (Exception)
            {
                return null;
            }
        }
    }
    internal sealed class FaceShow
    {
        private const int Tear = 0, Peek = 1, Scope = 2, Crack = 3, Scan = 4;
        private const float Opacity = 0.5f;
        private readonly Random dice = new Random();
        private bool active;
        private int kind, face, lastKind = -1, lastFace = -1;
        private double started, appear, hold, leave, nextAt = -1, lastClock;
        private float cx, cy, size, angle, flip = 1f;
        private float dirX, dirY;
        private float scopeX, scopeY, scopeW, scopeH;
        private int seed = 1;
        private float pulse;
        private double nextBlink = 2.0, blinkAt = -10;
        private double crackAt = -10;
        private float crackX, crackY, crackReach;
        private PointF[][] crackLines;
        private float[][] crackDist;
        private int crackRays;
        private float flash;
        private readonly ImageAttributes[] attrs = new ImageAttributes[3];
        private readonly float[] attrAlpha = new float[] { -1f, -1f, -1f };
        internal float ShakeX, ShakeY;
        internal void Release()
        {
            for (int i = 0; i < attrs.Length; i++)
            {
                if (attrs[i] != null) { attrs[i].Dispose(); attrs[i] = null; }
                attrAlpha[i] = -1f;
            }
        }
        private static float Clamp01(float t)
        {
            return t < 0f ? 0f : t > 1f ? 1f : t;
        }
        private static float EaseOut(float t)
        {
            t = Clamp01(t);
            return 1f - (float)Math.Pow(1f - t, 3.0);
        }
        private static float EaseIn(float t)
        {
            t = Clamp01(t);
            return t * t * t;
        }
        private static float EaseExpo(float t)
        {
            t = Clamp01(t);
            return t >= 1f ? 1f : 1f - (float)Math.Pow(2.0, -10.0 * t);
        }
        private static float EaseBack(float t)
        {
            t = Clamp01(t) - 1f;
            return 1f + 2.70158f * t * t * t + 1.70158f * t * t;
        }
        internal void Update(double clock, float dt, float width, float height, bool playing, bool newLine, float impact)
        {
            lastClock = clock;
            if (nextAt < 0) nextAt = clock + 1.2;
            if (newLine)
            {
                pulse = 1f;
                blinkAt = clock;
            }
            pulse = Math.Max(0f, pulse - dt * 2.6f);
            if (clock >= nextBlink)
            {
                blinkAt = clock;
                nextBlink = clock + 2.0 + dice.NextDouble() * 3.0;
            }
            if (impact > 0.6f && clock - crackAt > 2.6 && (!active || kind != Crack))
                Begin(clock, width, height, Crack, true);
            if (active && clock > started + appear + hold + leave)
            {
                active = false;
                nextAt = clock + (playing ? 2.0 + dice.NextDouble() * 3.4 : 6.0 + dice.NextDouble() * 5.0);
            }
            if (!active && clock >= nextAt) Begin(clock, width, height, -1, false);
            ShakeX = 0f;
            ShakeY = 0f;
            flash = 0f;
            double since = clock - crackAt;
            if (since >= 0 && since < 0.34)
            {
                float decay = 1f - (float)(since / 0.34);
                uint h = Art.Hash((uint)(clock * 60.0), 11u, 5u);
                ShakeX = (((int)(h & 15)) - 7.5f) / 7.5f * 5f * decay;
                ShakeY = (((int)((h >> 4) & 15)) - 7.5f) / 7.5f * 3f * decay;
            }
            if (since >= 0 && since < 0.2) flash = 1f - (float)(since / 0.2);
        }
        private float Roll()
        {
            return (float)dice.NextDouble();
        }
        private void Begin(double clock, float width, float height, int forced, bool smash)
        {
            float[] weight = new float[] { 3f, 3f, 2.2f, 1.6f, 2.4f };
            if (lastKind >= 0) weight[lastKind] = 0.2f;
            int chosen = forced;
            if (chosen < 0)
            {
                float total = 0f;
                for (int i = 0; i < weight.Length; i++) total += weight[i];
                float pick = Roll() * total;
                chosen = Tear;
                for (int i = 0; i < weight.Length; i++)
                {
                    if (pick < weight[i]) { chosen = i; break; }
                    pick -= weight[i];
                }
            }
            int tries = 0;
            int next;
            do
            {
                next = dice.Next(FaceBank.Count);
                tries++;
            }
            while ((next == lastFace || FaceBank.Get(next) == null) && tries < 14);
            if (FaceBank.Get(next) == null)
            {
                nextAt = clock + 12.0;
                return;
            }
            face = next;
            lastFace = next;
            kind = chosen;
            lastKind = chosen;
            active = true;
            started = clock;
            seed = dice.Next(1, 1 << 20);
            flip = dice.Next(2) == 0 ? 1f : -1f;
            angle = (Roll() * 2f - 1f) * 9f;
            size = height * (0.85f + Roll() * 0.4f);
            switch (kind)
            {
                case Tear:
                    appear = 0.4;
                    hold = 2.2 + Roll() * 1.6;
                    leave = 0.34;
                    Zone(width, height, true);
                    break;
                case Peek:
                    appear = 0.46;
                    hold = 2.0 + Roll() * 1.4;
                    leave = 0.42;
                    Zone(width, height, false);
                    break;
                case Scope:
                    appear = 0.55;
                    hold = 1.9 + Roll() * 1.1;
                    leave = 0.4;
                    scopeH = height * 0.62f;
                    scopeW = Math.Max(scopeH * 1.5f, width * (0.27f + Roll() * 0.06f));
                    int place = dice.Next(5);
                    scopeX = place < 2 ? width * 0.04f : place < 4 ? width * 0.96f - scopeW : (width - scopeW) * 0.5f;
                    scopeY = height * (0.2f + Roll() * 0.1f);
                    if (scopeY + scopeH > height - 16f) scopeY = Math.Max(4f, height - 16f - scopeH);
                    break;
                case Crack:
                    appear = smash ? 0.1 : 0.16;
                    hold = 2.4;
                    leave = 0.5;
                    size = height * 1.15f;
                    cx = width * (0.3f + Roll() * 0.4f);
                    cy = height * 0.5f;
                    crackAt = clock + appear;
                    crackX = cx + (Roll() - 0.5f) * 24f;
                    crackY = cy - 6f;
                    MakeCrack();
                    break;
                default:
                    appear = 0.6;
                    hold = 2.0 + Roll() * 1.4;
                    leave = 0.42;
                    Zone(width, height, true);
                    break;
            }
        }
        private void Zone(float width, float height, bool allowMiddle)
        {
            int zone = dice.Next(allowMiddle ? 9 : 8) + (allowMiddle ? 0 : 1);
            float edge = size * (allowMiddle ? 0.26f : 0.14f);
            dirX = 0f;
            dirY = 1f;
            switch (zone)
            {
                case 0:
                    cx = width * (0.32f + Roll() * 0.36f);
                    cy = height * 0.5f;
                    break;
                case 1:
                    cx = edge; cy = height * (0.38f + Roll() * 0.24f); dirX = -1f; dirY = 0f;
                    break;
                case 2:
                    cx = width - edge; cy = height * (0.38f + Roll() * 0.24f); dirX = 1f; dirY = 0f;
                    break;
                case 3:
                    cx = edge; cy = height * 0.14f; dirX = -0.7f; dirY = -0.7f;
                    break;
                case 4:
                    cx = width - edge; cy = height * 0.14f; dirX = 0.7f; dirY = -0.7f;
                    break;
                case 5:
                    cx = edge; cy = height * 0.88f; dirX = -0.7f; dirY = 0.7f;
                    break;
                case 6:
                    cx = width - edge; cy = height * 0.88f; dirX = 0.7f; dirY = 0.7f;
                    break;
                case 7:
                    cx = width * (0.2f + Roll() * 0.6f); cy = size * 0.2f; dirX = 0f; dirY = -1f;
                    break;
                default:
                    cx = width * (0.2f + Roll() * 0.6f); cy = height - size * 0.2f; dirX = 0f; dirY = 1f;
                    break;
            }
        }
        private void MakeCrack()
        {
            int rays = 9 + dice.Next(4);
            List<PointF[]> lines = new List<PointF[]>();
            List<PointF[]> branches = new List<PointF[]>();
            for (int i = 0; i < rays; i++)
            {
                float ang = (float)(i * Math.PI * 2.0 / rays + (dice.NextDouble() - 0.5) * 0.5);
                float total = 70f + Roll() * 120f;
                List<PointF> pts = new List<PointF>();
                pts.Add(new PointF(crackX, crackY));
                float x = crackX, y = crackY, run = 0f;
                int index = 0;
                while (run < total)
                {
                    float seg = 11f + Roll() * 11f;
                    ang += (Roll() - 0.5f) * 0.5f;
                    x += (float)Math.Cos(ang) * seg;
                    y += (float)Math.Sin(ang) * seg;
                    run += seg;
                    index++;
                    pts.Add(new PointF(x, y));
                    if (index >= 2 && dice.NextDouble() < 0.22)
                    {
                        float bang = ang + (dice.NextDouble() < 0.5 ? -1f : 1f) * (0.45f + Roll() * 0.5f);
                        int steps = 2 + dice.Next(3);
                        PointF[] branch = new PointF[steps + 1];
                        branch[0] = new PointF(x, y);
                        float bx = x, by = y;
                        for (int k = 1; k <= steps; k++)
                        {
                            float blen = 7f + Roll() * 9f;
                            bang += (Roll() - 0.5f) * 0.6f;
                            bx += (float)Math.Cos(bang) * blen;
                            by += (float)Math.Sin(bang) * blen;
                            branch[k] = new PointF(bx, by);
                        }
                        branches.Add(branch);
                    }
                }
                lines.Add(pts.ToArray());
            }
            crackRays = rays;
            lines.AddRange(branches);
            crackLines = lines.ToArray();
            crackDist = new float[crackLines.Length][];
            float reach = 0f;
            for (int i = 0; i < crackLines.Length; i++)
            {
                PointF[] p = crackLines[i];
                float[] d = new float[p.Length];
                for (int j = 0; j < p.Length; j++)
                {
                    float dx = p[j].X - crackX, dy = p[j].Y - crackY;
                    d[j] = (float)Math.Sqrt(dx * dx + dy * dy);
                    if (d[j] > reach) reach = d[j];
                }
                crackDist[i] = d;
            }
            crackReach = reach + 4f;
        }
        internal void DrawOverlay(Graphics graphics, float s, float clock, float width, float height)
        {
            if (flash > 0.01f)
            {
                using (GraphicsPath shape = Art.Shape(new RectangleF(0, 0, width * s, height * s), s))
                using (Brush white = new SolidBrush(Color.FromArgb((int)(75 * flash), 255, 255, 255)))
                    graphics.FillPath(white, shape);
            }
            double since = clock - crackAt;
            if (crackLines == null || since < 0 || since > 2.3) return;
            float grow = EaseOut((float)(since / 0.32));
            float life = since < 1.7 ? 1f : 1f - (float)((since - 1.7) / 0.6);
            if (life <= 0.01f) return;
            if (since > 1.1)
            {
                uint hv = Art.Hash((uint)(clock * 30.0), 13u, (uint)seed);
                if ((hv & 7u) == 0u) life *= 0.45f;
            }
            float reach = crackReach * grow;
            using (Pen glow = new Pen(Color.FromArgb((int)(40 * life), Art.Cyan), Math.Max(3f, 5f * s)))
            using (Pen core = new Pen(Color.FromArgb((int)(220 * life), Art.Ink), Math.Max(1f, 1.2f * s)))
            using (Pen fringe = new Pen(Color.FromArgb((int)(120 * life), Art.Pink), Math.Max(1f, s)))
            using (Pen web = new Pen(Color.FromArgb((int)(95 * life), Art.Ink), Math.Max(1f, 0.9f * s)))
            {
                glow.StartCap = LineCap.Round;
                glow.EndCap = LineCap.Round;
                for (int i = 0; i < crackLines.Length; i++)
                {
                    PointF[] p = crackLines[i];
                    float[] d = crackDist[i];
                    int n = 0;
                    while (n < p.Length && d[n] <= reach) n++;
                    if (n < 1) continue;
                    bool partial = n < p.Length;
                    PointF[] pts = new PointF[partial ? n + 1 : n];
                    for (int j = 0; j < n; j++) pts[j] = new PointF(p[j].X * s, p[j].Y * s);
                    if (partial)
                    {
                        float span = d[n] - d[n - 1];
                        float f = span > 0.001f ? (reach - d[n - 1]) / span : 0f;
                        pts[n] = new PointF((p[n - 1].X + (p[n].X - p[n - 1].X) * f) * s,
                            (p[n - 1].Y + (p[n].Y - p[n - 1].Y) * f) * s);
                    }
                    if (pts.Length < 2) continue;
                    graphics.DrawLines(glow, pts);
                    graphics.TranslateTransform(1.2f * s, 0.8f * s);
                    graphics.DrawLines(fringe, pts);
                    graphics.ResetTransform();
                    graphics.DrawLines(core, pts);
                }
                int[] rings = new int[] { 2, 3, 5 };
                for (int a = 0; a < rings.Length; a++)
                {
                    int r = rings[a];
                    for (int i = 0; i < crackRays; i++)
                    {
                        int j = (i + 1) % crackRays;
                        if (crackLines[i].Length <= r || crackLines[j].Length <= r) continue;
                        if (crackDist[i][r] > reach || crackDist[j][r] > reach) continue;
                        graphics.DrawLine(web, crackLines[i][r].X * s, crackLines[i][r].Y * s,
                            crackLines[j][r].X * s, crackLines[j][r].Y * s);
                    }
                }
            }
        }
        private static Matrix Place(Face f, float s, float x, float y, float height, float turn, float mirror, float sx, float sy)
        {
            float k = height * s / f.Height;
            Matrix m = new Matrix();
            m.Translate(x * s, y * s);
            m.Rotate(turn);
            m.Scale(mirror * sx * k, sy * k);
            m.Translate(-f.Width * 0.5f, -f.Height * 0.5f);
            return m;
        }
        private ImageAttributes Attr(int tone, float alpha)
        {
            ImageAttributes kept = attrs[tone];
            if (kept != null && Math.Abs(alpha - attrAlpha[tone]) < 0.015f) return kept;
            if (kept != null) kept.Dispose();
            ColorMatrix matrix;
            if (tone == 0)
            {
                matrix = new ColorMatrix(new float[][]
                {
                    new float[] { 1f, 0f, 0f, 0f, 0f },
                    new float[] { 0f, 1f, 0f, 0f, 0f },
                    new float[] { 0f, 0f, 1f, 0f, 0f },
                    new float[] { 0f, 0f, 0f, alpha, 0f },
                    new float[] { 0f, 0f, 0f, 0f, 1f }
                });
            }
            else
            {
                Color c = tone == 1 ? Art.Cyan : Art.Pink;
                matrix = new ColorMatrix(new float[][]
                {
                    new float[] { 0f, 0f, 0f, 0f, 0f },
                    new float[] { 0f, 0f, 0f, 0f, 0f },
                    new float[] { 0f, 0f, 0f, 0f, 0f },
                    new float[] { 0f, 0f, 0f, alpha, 0f },
                    new float[] { c.R / 255f, c.G / 255f, c.B / 255f, 0f, 1f }
                });
            }
            ImageAttributes made = new ImageAttributes();
            made.SetColorMatrix(matrix, ColorMatrixFlag.Default, ColorAdjustType.Bitmap);
            made.SetWrapMode(WrapMode.TileFlipXY);
            attrs[tone] = made;
            attrAlpha[tone] = alpha;
            return made;
        }
        private void Paint(Graphics graphics, Face f, Matrix place, int tone, float alpha)
        {
            if (alpha < 0.02f) return;
            GraphicsState saved = graphics.Save();
            try
            {
                graphics.Transform = place;
                graphics.InterpolationMode = InterpolationMode.HighQualityBilinear;
                graphics.DrawImage(f.Image, new Rectangle(0, 0, f.Width, f.Height),
                    0, 0, f.Width, f.Height, GraphicsUnit.Pixel, Attr(tone, alpha));
            }
            finally
            {
                graphics.Restore(saved);
            }
        }
        private void PaintSlice(Graphics graphics, Face f, Matrix place, int tone, float alpha, int y0, int h, float dx)
        {
            if (alpha < 0.02f) return;
            GraphicsState saved = graphics.Save();
            try
            {
                graphics.Transform = place;
                graphics.InterpolationMode = InterpolationMode.HighQualityBilinear;
                graphics.DrawImage(f.Image, new Rectangle((int)Math.Round(dx), y0, f.Width, h),
                    0, y0, f.Width, h, GraphicsUnit.Pixel, Attr(tone, alpha));
            }
            finally
            {
                graphics.Restore(saved);
            }
        }
        private void PaintSliced(Graphics graphics, Face f, Matrix place, float ppu, float alpha, float amount)
        {
            const int Slices = 14;
            int sliceH = (int)Math.Ceiling(f.Height / (double)Slices);
            uint step = (uint)(lastClock * 28.0);
            for (int i = 0; i < Slices; i++)
            {
                int y0 = i * sliceH;
                int h = Math.Min(sliceH + 1, f.Height - y0);
                if (h <= 0) break;
                uint hv = Art.Hash((uint)i, step, (uint)seed);
                float dx = ((((int)(hv & 255)) - 127) / 127f) * 70f * amount * ppu;
                float sa = alpha;
                if (amount > 0.05f && ((hv >> 9) & 7u) == 0u) sa *= 0.15f;
                if (amount > 0.08f)
                {
                    float off = 6f * amount * ppu;
                    PaintSlice(graphics, f, place, 1, sa * 0.35f, y0, h, dx - off);
                    PaintSlice(graphics, f, place, 2, sa * 0.35f, y0, h, dx + off);
                }
                PaintSlice(graphics, f, place, 0, sa, y0, h, dx);
            }
        }
        private void DrawEyes(Graphics graphics, Face f, Matrix place, float k, float s, float clock, float strengthScale)
        {
            float since = (float)(clock - blinkAt);
            if (since < 0f || since > 0.6f) return;
            float p = since / 0.6f;
            float strength = (1f - p) * strengthScale;
            if (strength < 0.03f) return;
            PointF[] eyes = new PointF[] { new PointF(f.EyeAX, f.EyeAY), new PointF(f.EyeBX, f.EyeBY) };
            place.TransformPoints(eyes);
            float r = (16f + 30f * p) * k;
            using (Pen ring = new Pen(Color.FromArgb((int)(215 * strength), Art.Cyan), Math.Max(1f, 1.5f * s)))
            using (Pen inner = new Pen(Color.FromArgb((int)(130 * strength), Art.Pink), Math.Max(1f, s)))
                for (int i = 0; i < eyes.Length; i++)
                {
                    PointF e = eyes[i];
                    graphics.DrawEllipse(ring, e.X - r, e.Y - r, r * 2f, r * 2f);
                    graphics.DrawEllipse(inner, e.X - r * 0.55f, e.Y - r * 0.55f, r * 1.1f, r * 1.1f);
                    float t0 = r * 1.15f, t1 = r * 1.6f;
                    graphics.DrawLine(ring, e.X - t1, e.Y, e.X - t0, e.Y);
                    graphics.DrawLine(ring, e.X + t0, e.Y, e.X + t1, e.Y);
                    graphics.DrawLine(ring, e.X, e.Y - t1, e.X, e.Y - t0);
                    graphics.DrawLine(ring, e.X, e.Y + t0, e.X, e.Y + t1);
                }
        }
        internal void Draw(Graphics graphics, float s, float clock, float width, float height)
        {
            if (!active) return;
            Face f = FaceBank.Get(face);
            if (f == null) return;
            double t = clock - started;
            float a = appear > 0 ? Clamp01((float)(t / appear)) : 1f;
            bool leaving = t > appear + hold;
            float q = leaving ? Clamp01((float)((t - appear - hold) / leave)) : 0f;
            switch (kind)
            {
                case Tear: DrawTear(graphics, f, s, clock, t, a, q, leaving); break;
                case Peek: DrawPeek(graphics, f, s, clock, t, a, q, leaving); break;
                case Scope: DrawScope(graphics, f, s, clock, a, q, leaving); break;
                case Crack: DrawCrackFace(graphics, f, s, clock, t, a, q, leaving); break;
                default: DrawScan(graphics, f, s, clock, t, a, q, leaving, width, height); break;
            }
        }
        private void Idle(double clock, out float dx, out float dy, out float sway)
        {
            dx = (float)Math.Sin(clock * 0.9 + seed) * 3f;
            dy = (float)Math.Cos(clock * 1.2 + seed) * 2f;
            sway = (float)Math.Sin(clock * 0.7 + seed) * 1.6f;
        }
        private void DrawTear(Graphics graphics, Face f, float s, float clock, double t, float a, float q, bool leaving)
        {
            float px = cx, py = cy, turn = angle, grow = 1f + 0.05f * pulse;
            float amount = leaving ? q * q : (1f - a) * (1f - a);
            float fade = leaving ? 1f - q : a;
            if (!leaving && a >= 1f)
            {
                float dx, dy, sway;
                Idle(clock, out dx, out dy, out sway);
                px += dx; py += dy; turn += sway;
                if ((Art.Hash((uint)(t * 5.0), 9u, (uint)seed) & 7u) == 0u) amount = 0.12f;
            }
            float ppu = f.Height / size;
            using (Matrix place = Place(f, s, px, py, size * grow, turn, flip, 1f, 1f))
            {
                if (amount <= 0.001f) Paint(graphics, f, place, 0, Opacity * fade);
                else PaintSliced(graphics, f, place, ppu, Opacity * fade, amount);
                if (a >= 1f && !leaving) DrawEyes(graphics, f, place, size * grow * s / f.Height, s, clock, 1f);
            }
        }
        private void DrawPeek(Graphics graphics, Face f, float s, float clock, double t, float a, float q, bool leaving)
        {
            float off = leaving ? EaseIn(q) : 1f - EaseBack(a);
            float px = cx + dirX * size * 0.75f * off;
            float py = cy + dirY * size * 0.75f * off;
            float turn = angle + (leaving ? q * 8f * flip : 0f);
            float grow = 1f + 0.05f * pulse;
            float alpha = Opacity * Math.Min(1f, a * 4f) * (leaving ? 1f - q * q : 1f);
            if (!leaving && a >= 1f)
            {
                float dx, dy, sway;
                Idle(clock, out dx, out dy, out sway);
                px += dx; py += dy; turn += sway;
            }
            bool moving = Math.Abs(off) > 0.05f;
            if (moving && (Art.Hash((uint)(clock * 40.0), 3u, (uint)seed) & 7u) == 0u) alpha *= 0.5f;
            using (Matrix place = Place(f, s, px, py, size * grow, turn, flip, 1f, 1f))
            {
                if (moving)
                {
                    float trail = size * 0.08f * off;
                    using (Matrix ghost = Place(f, s, px + dirX * trail, py + dirY * trail, size * grow, turn, flip, 1f, 1f))
                        Paint(graphics, f, ghost, 1, alpha * 0.3f);
                    using (Matrix ghost = Place(f, s, px + dirX * trail * 2f, py + dirY * trail * 2f, size * grow, turn, flip, 1f, 1f))
                        Paint(graphics, f, ghost, 2, alpha * 0.2f);
                }
                Paint(graphics, f, place, 0, alpha);
                if (a >= 1f && !leaving) DrawEyes(graphics, f, place, size * grow * s / f.Height, s, clock, 1f);
            }
        }
        private void DrawScope(Graphics graphics, Face f, float s, float clock, float a, float q, bool leaving)
        {
            float k0 = scopeH * s / f.Height;
            float z;
            if (!leaving) z = a < 1f ? 1f + 2.4f * EaseExpo(a) : 3.4f + 0.22f * (float)Math.Sin(clock * 1.7) + 0.45f * pulse;
            else z = 3.4f - 2.4f * EaseIn(q);
            float collapse = leaving ? EaseIn(q) : 0f;
            float open = a < 1f ? EaseOut(a * 2.5f) : 1f;
            float h = scopeH * Math.Max(0.04f, open * (1f - collapse * 0.96f));
            float fade = leaving ? 1f - Math.Max(0f, (q - 0.8f) / 0.2f) : 1f;
            float midX = scopeX + scopeW * 0.5f, midY = scopeY + scopeH * 0.5f;
            RectangleF rect = new RectangleF(scopeX * s, (midY - h * 0.5f) * s, scopeW * s, h * s);
            if (rect.Height < 2f) return;
            using (GraphicsPath frame = Art.Cut(rect, 7 * s))
            {
                using (Brush back = new SolidBrush(Color.FromArgb((int)(150 * fade), 3, 4, 8)))
                    graphics.FillPath(back, frame);
                Region saved = graphics.Clip;
                graphics.SetClip(frame, CombineMode.Intersect);
                float drift = (float)Math.Sin(clock * 1.3 + seed) * 4f;
                bool glitch = (Art.Hash((uint)(clock * 6.0), 17u, (uint)seed) & 7u) == 0u;
                if (glitch) drift += ((int)(Art.Hash((uint)(clock * 40.0), 19u, (uint)seed) & 15) - 7) * 1.4f;
                float eyeMidX = (f.EyeAX + f.EyeBX) * 0.5f, eyeMidY = (f.EyeAY + f.EyeBY) * 0.5f;
                using (Matrix place = new Matrix())
                {
                    place.Translate((midX + drift) * s, midY * s);
                    place.Rotate(angle * 0.5f);
                    place.Scale(flip * k0 * z, k0 * z);
                    place.Translate(-eyeMidX, -eyeMidY);
                    if (glitch)
                    {
                        using (Matrix ghost = place.Clone())
                        {
                            ghost.Translate(-6f, 0f, MatrixOrder.Prepend);
                            Paint(graphics, f, ghost, 1, 0.4f * fade);
                        }
                    }
                    Paint(graphics, f, place, 0, 0.82f * fade);
                    PointF[] eyes = new PointF[] { new PointF(f.EyeAX, f.EyeAY), new PointF(f.EyeBX, f.EyeBY) };
                    place.TransformPoints(eyes);
                    float r = 15f * k0 * z;
                    using (Pen ring = new Pen(Color.FromArgb((int)(210 * fade), Art.Cyan), Math.Max(1.2f, 1.6f * s)))
                    using (Pen outer = new Pen(Color.FromArgb((int)(120 * fade), Art.Pink), Math.Max(1f, s)))
                    {
                        outer.DashStyle = DashStyle.Dash;
                        for (int i = 0; i < eyes.Length; i++)
                        {
                            graphics.DrawEllipse(ring, eyes[i].X - r, eyes[i].Y - r, r * 2f, r * 2f);
                            graphics.DrawEllipse(outer, eyes[i].X - r * 1.5f, eyes[i].Y - r * 1.5f, r * 3f, r * 3f);
                        }
                    }
                }
                using (Pen lines = new Pen(Color.FromArgb((int)(60 * fade), 0, 0, 0), 1f))
                    for (float y = rect.Top; y < rect.Bottom; y += 3f * s) graphics.DrawLine(lines, rect.Left, y, rect.Right, y);
                float sweep = rect.Top + (float)((clock * 0.7) % 1.0) * rect.Height;
                using (Brush bar = new SolidBrush(Color.FromArgb((int)(34 * fade), Art.Cyan)))
                    graphics.FillRectangle(bar, rect.Left, sweep - 6f * s, rect.Width, 12f * s);
                using (Pen cross = new Pen(Color.FromArgb((int)(70 * fade), Art.Cyan), Math.Max(1f, s)))
                {
                    graphics.DrawLine(cross, rect.Left, midY * s, rect.Right, midY * s);
                    graphics.DrawLine(cross, (midX + drift) * s, rect.Top, (midX + drift) * s, rect.Bottom);
                }
                graphics.Clip = saved;
                saved.Dispose();
                using (Pen glow = new Pen(Color.FromArgb((int)(46 * fade), Art.Cyan), Math.Max(3f, 6f * s)))
                    graphics.DrawPath(glow, frame);
                using (Pen edge = new Pen(Color.FromArgb((int)(225 * fade), Art.Cyan), Math.Max(1f, 1.3f * s)))
                    graphics.DrawPath(edge, frame);
            }
            if (h > scopeH * 0.5f)
            {
                float len = 11f * s;
                using (Pen mark = new Pen(Color.FromArgb((int)(235 * fade), Art.Ink), Math.Max(1f, 1.4f * s)))
                {
                    graphics.DrawLine(mark, rect.Left + 4f * s, rect.Top + 4f * s + len, rect.Left + 4f * s, rect.Top + 4f * s);
                    graphics.DrawLine(mark, rect.Left + 4f * s, rect.Top + 4f * s, rect.Left + 4f * s + len, rect.Top + 4f * s);
                    graphics.DrawLine(mark, rect.Right - 4f * s - len, rect.Bottom - 4f * s, rect.Right - 4f * s, rect.Bottom - 4f * s);
                    graphics.DrawLine(mark, rect.Right - 4f * s, rect.Bottom - 4f * s, rect.Right - 4f * s, rect.Bottom - 4f * s - len);
                }
                string label = "OPTIC  x" + z.ToString("0.0", CultureInfo.InvariantCulture);
                Font font = Art.Mono(9.5f * s, FontStyle.Regular, label);
                using (Brush ink = new SolidBrush(Color.FromArgb((int)(225 * fade), Art.Cyan)))
                    graphics.DrawString(label, font, ink, rect.Left + 10f * s, rect.Top + 8f * s, Art.Shared);
                bool blink = ((int)(clock * 2.5)) % 2 == 0;
                using (Brush dot = new SolidBrush(Color.FromArgb((int)((blink ? 235 : 70) * fade), Art.Pink)))
                    graphics.FillEllipse(dot, rect.Right - 13f * s, rect.Top + 9f * s, 5f * s, 5f * s);
            }
        }
        private void DrawCrackFace(Graphics graphics, Face f, float s, float clock, double t, float a, float q, bool leaving)
        {
            float pop;
            if (a < 1f) pop = 0.55f + 0.6f * EaseOut(a);
            else pop = 1f + 0.15f * (float)Math.Exp(-(t - appear) * 7.0);
            float px = cx, py = cy, turn = angle;
            if (!leaving && a >= 1f)
            {
                float dx, dy, sway;
                Idle(clock, out dx, out dy, out sway);
                px += dx; py += dy; turn += sway;
            }
            float alpha = Opacity * Math.Min(1f, a * 2f);
            float ppu = f.Height / size;
            using (Matrix place = Place(f, s, px, py, size * pop * (1f + 0.05f * pulse), turn, flip, 1f, 1f))
            {
                if (leaving) PaintSliced(graphics, f, place, ppu, alpha * (1f - q), q * q);
                else Paint(graphics, f, place, 0, alpha);
                if (a >= 1f && !leaving) DrawEyes(graphics, f, place, size * pop * s / f.Height, s, clock, 1f);
            }
        }
        private void DrawScan(Graphics graphics, Face f, float s, float clock, double t, float a, float q, bool leaving, float width, float height)
        {
            float topY = (cy - size * 0.5f) * s;
            float fh = size * s;
            float px = cx, py = cy, turn = angle;
            float sx = 1f, sy = 1f;
            float alpha = Opacity;
            float reveal = leaving ? 1f : EaseOut(a);
            if (!leaving && a >= 1f)
            {
                float dx, dy, sway;
                Idle(clock, out dx, out dy, out sway);
                px += dx; py += dy; turn += sway;
            }
            if (leaving)
            {
                sy = 1f - EaseIn(Math.Min(1f, q / 0.7f));
                sx = q < 0.7f ? 1f : 1f - (q - 0.7f) / 0.3f;
                alpha = Math.Min(0.85f, Opacity * (1f + 1.2f * q));
            }
            float ppu = f.Height / size;
            using (Matrix place = Place(f, s, px, py, size * (1f + 0.05f * pulse), turn, flip, Math.Max(0.01f, sx), Math.Max(0.02f, sy)))
            {
                if (!leaving && a < 1f)
                {
                    float sweepY = topY + fh * reveal;
                    float band = 18f * s;
                    Region saved = graphics.Clip;
                    graphics.SetClip(new RectangleF(0, 0, width * s, Math.Max(0f, sweepY - band)), CombineMode.Intersect);
                    Paint(graphics, f, place, 0, alpha);
                    graphics.Clip = saved;
                    graphics.SetClip(new RectangleF(0, Math.Max(0f, sweepY - band), width * s, band), CombineMode.Intersect);
                    Paint(graphics, f, place, 1, alpha * 0.9f);
                    graphics.Clip = saved;
                    saved.Dispose();
                    float x0 = (cx - size * 0.62f) * s, x1 = (cx + size * 0.62f) * s;
                    using (Pen halo = new Pen(Color.FromArgb(70, Art.Cyan), Math.Max(3f, 7f * s)))
                        graphics.DrawLine(halo, x0, sweepY, x1, sweepY);
                    using (Pen line = new Pen(Color.FromArgb(235, Art.Ink), Math.Max(1f, 1.6f * s)))
                        graphics.DrawLine(line, x0, sweepY, x1, sweepY);
                }
                else if (leaving && sy > 0.02f)
                {
                    Paint(graphics, f, place, 0, alpha);
                }
                else if (!leaving)
                {
                    float amount = (Art.Hash((uint)(t * 5.0), 21u, (uint)seed) & 7u) == 0u ? 0.1f : 0f;
                    if (amount > 0f) PaintSliced(graphics, f, place, ppu, alpha, amount);
                    else Paint(graphics, f, place, 0, alpha);
                    DrawEyes(graphics, f, place, size * s / f.Height, s, clock, 1f);
                }
            }
            if (leaving && sy < 0.2f && sx > 0.02f)
            {
                float half = size * 0.45f * sx * s;
                using (Pen line = new Pen(Color.FromArgb((int)(235 * (1f - Math.Max(0f, (q - 0.9f) * 10f))), Art.Ink), Math.Max(1.5f, 2.2f * s)))
                    graphics.DrawLine(line, cx * s - half, cy * s, cx * s + half, cy * s);
            }
        }
    }
    public sealed class LyricsMod : ICapriMod
    {
        private const BindingFlags Any = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static;
        private const string Hotkey = "Ctrl+Alt+L";
        private const string Version = "1.4.0";
        private ICapriHost capri;
        private Form herWindow;
        private LyricsWindow band;
        private CcWindow cc;
        private System.Windows.Forms.Timer tick;
        private System.Windows.Forms.Timer frame;
        private bool framesRunning;
        private float frameCost;
        private int frameFaults;
        private CapriTrack liveTrack;
        private bool facesOn = true;
        private PropertyInfo plateProperty, scaleProperty;
        private FieldInfo playerField, thrownField;
        private MethodInfo ledgesInvalidate;
        private Form mini;
        private bool miniLooked;
        private MoverWindow miniMover;
        private LyricsCache cache;
        private readonly object fetchLock = new object();
        private Lyrics pending;
        private bool pendingReady;
        private volatile int fetchTicket;
        private volatile string requestedKey;
        private Action<CapriTrack> changedHandler, updatedHandler;
        private bool on;
        private string pose = LyricsPose.Sit;
        private bool poseLogged;
        private float textSize = 25f;
        private string shownKey;
        private bool wasThrown;
        private int flightAt;
        private double lastBodyX, lastBodyY;
        private int lastBodyAt;
        public void Start(ICapriHost host)
        {
            capri = host;
            try
            {
                ServicePointManager.SecurityProtocol |= (SecurityProtocolType)3072;
                herWindow = host.Ui.Window;
                ResolveReflection();
                pose = ReadPose(host);
                textSize = (float)host.Store.Number("lyrics.size", 25);
                if (textSize < 14) textSize = 14;
                if (textSize > 40) textSize = 40;
                facesOn = host.Store.Flag("lyrics.faces", true);
                cache = new LyricsCache(host.Folder);
                cache.Load();
                changedHandler = delegate(CapriTrack track) { SongChanged(track); };
                updatedHandler = delegate(CapriTrack track) { };
                host.Music.Changed += changedHandler;
                host.Music.Updated += updatedHandler;
                OnUi(BuildWindows);
                host.Ui.AddMenuItem("Paroles (CC)", delegate { Toggle(); });
                host.Ui.SetOptions("Lyrics", Options);
                try { host.Keys.Hotkey(Hotkey, delegate { Toggle(); }); }
                catch (ArgumentException) { host.Log("Lyrics: " + Hotkey + " is already taken; use the CC button."); }
                host.Log("Capri Lyrics " + Version + " started. Toggle with the CC button beside the heart, or " + Hotkey + ".");
                bool restore = host.Store.Flag("lyrics.on", false);
                if (restore) OnUi(delegate { TurnOn(true); });
            }
            catch (Exception error)
            {
                host.Log("Capri Lyrics failed to start: " + error);
            }
        }
        public bool Heard(string words)
        {
            string said = (words == null ? "" : words).ToLowerInvariant();
            if (Regex.IsMatch(said, @"\b(cache|masque|enl[e\u00E8]ve|retire|coupe)\b"))
            {
                if (said.IndexOf("parole", StringComparison.Ordinal) < 0) return false;
                OnUi(delegate { if (on) TurnOff(); });
                return true;
            }
            if (Regex.IsMatch(said, @"\b(affiche|montre|mets|active|lance|ouvre)\b") && said.IndexOf("parole", StringComparison.Ordinal) >= 0)
            {
                OnUi(delegate { if (!on) TurnOn(false); });
                return true;
            }
            return false;
        }
        public void Stop()
        {
            try { if (changedHandler != null) capri.Music.Changed -= changedHandler; }
            catch (Exception) { }
            try { if (updatedHandler != null) capri.Music.Updated -= updatedHandler; }
            catch (Exception) { }
            try { capri.Keys.Remove(Hotkey); }
            catch (Exception) { }
            try { if (cache != null) cache.Save(); }
            catch (Exception) { }
            OnUi(delegate
            {
                StopFrames();
                if (frame != null) { frame.Dispose(); frame = null; }
                if (tick != null) { tick.Stop(); tick.Dispose(); tick = null; }
                ReleaseMiniMover();
                if (band != null) { band.Dispose(); band = null; }
                if (cc != null) { cc.Dispose(); cc = null; }
            });
            on = false;
        }
        private void ResolveReflection()
        {
            Assembly app = typeof(ICapriMod).Assembly;
            Type player = app.GetType("CapriDesktop.MiniPlayer");
            Type ledges = app.GetType("CapriDesktop.Ledges");
            if (player != null)
            {
                plateProperty = player.GetProperty("Plate", Any);
                scaleProperty = player.GetProperty("ScaleShown", Any);
            }
            if (ledges != null)
            {
                ledgesInvalidate = ledges.GetMethod("Invalidate", Any);
            }
            if (herWindow != null)
            {
                Type her = herWindow.GetType();
                playerField = her.GetField("player", Any);
                thrownField = her.GetField("thrown", Any);
            }
        }
        private Form Mini()
        {
            if (mini != null && !mini.IsDisposed) return mini;
            if (miniLooked) return null;
            miniLooked = true;
            try
            {
                if (playerField != null && herWindow != null) mini = playerField.GetValue(herWindow) as Form;
            }
            catch (Exception) { mini = null; }
            return mini;
        }
        private void RefreshLedges()
        {
            if (ledgesInvalidate == null) return;
            try { ledgesInvalidate.Invoke(null, null); }
            catch (Exception) { }
        }
        private void WatchMini()
        {
            Form player = Mini();
            if (player == null || player.IsDisposed) return;
            IntPtr handle = IntPtr.Zero;
            try { handle = player.Handle; }
            catch (Exception) { return; }
            if (handle == IntPtr.Zero) return;
            if (miniMover != null && miniMover.Handle == handle) return;
            ReleaseMiniMover();
            try
            {
                MoverWindow watcher = new MoverWindow();
                watcher.Moved = delegate { OnUi(FollowCcMove); };
                watcher.AssignHandle(handle);
                miniMover = watcher;
            }
            catch (Exception) { miniMover = null; }
        }
        private void ReleaseMiniMover()
        {
            if (miniMover == null) return;
            try { miniMover.ReleaseHandle(); }
            catch (Exception) { }
            miniMover = null;
        }
        private static string ReadPose(ICapriHost host)
        {
            string stored = "";
            string legacy = null;
            try
            {
                stored = host.Store.Get("lyrics.pose", "");
                string[] keys = host.Store.Keys;
                if (keys != null && Array.IndexOf(keys, "lyrics.autolie") >= 0)
                    legacy = host.Store.Flag("lyrics.autolie", true) ? "true" : "false";
            }
            catch (Exception) { }
            string chosen = LyricsPose.Migrate(stored, legacy);
            try
            {
                if (string.IsNullOrEmpty(stored)) host.Store.Set("lyrics.pose", chosen);
                if (legacy != null) host.Store.Remove("lyrics.autolie");
            }
            catch (Exception) { }
            return chosen;
        }
        private void BuildWindows()
        {
            if (band != null) return;
            band = new LyricsWindow();
            band.TextSize = textSize;
            band.FacesOn = facesOn;
            band.Moved += delegate
            {
                if (capri != null)
                {
                    capri.Store.Set("lyrics.pos", band.PlateLocation.X + "," + band.PlateLocation.Y);
                    capri.Store.Set("lyrics.band", Math.Round(band.WidthUnits).ToString(CultureInfo.InvariantCulture)
                        + "," + Math.Round(band.HeightUnits).ToString(CultureInfo.InvariantCulture));
                }
                RefreshLedges();
            };
            SizeF? savedBand = SavedSize();
            if (savedBand.HasValue) band.SetBandSize(savedBand.Value.Width, savedBand.Value.Height);
            Point? saved = SavedPosition();
            band.SetSavedPosition(saved);
            cc = new CcWindow();
            cc.Clicked += delegate { Toggle(); };
            TuckUnderHer();
            tick = new System.Windows.Forms.Timer();
            tick.Interval = 80;
            tick.Tick += delegate { Tick(); };
            tick.Start();
            frame = new System.Windows.Forms.Timer();
            frame.Interval = 16;
            frame.Tick += delegate { FrameTick(); };
        }
        private void TuckUnderHer()
        {
            if (herWindow == null || herWindow.IsDisposed) return;
            IntPtr under = IntPtr.Zero;
            try { under = herWindow.Handle; } catch (Exception) { }
            if (band != null) band.Beneath = under;
            if (cc != null) cc.Beneath = under;
        }
        private Point? SavedPosition()
        {
            try
            {
                string raw = capri.Store.Get("lyrics.pos", "");
                if (string.IsNullOrEmpty(raw)) return null;
                string[] parts = raw.Split(',');
                int x, y;
                if (parts.Length == 2 && int.TryParse(parts[0], out x) && int.TryParse(parts[1], out y)) return new Point(x, y);
            }
            catch (Exception) { }
            return null;
        }
        private SizeF? SavedSize()
        {
            try
            {
                string raw = capri.Store.Get("lyrics.band", "");
                if (string.IsNullOrEmpty(raw)) return null;
                string[] parts = raw.Split(',');
                float width, height;
                if (parts.Length == 2
                    && float.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out width)
                    && float.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out height))
                    return new SizeF(width, height);
            }
            catch (Exception) { }
            return null;
        }
        public void Toggle()
        {
            OnUi(delegate
            {
                if (on) TurnOff();
                else TurnOn(false);
            });
        }
        private void TurnOn(bool restore)
        {
            if (band == null) return;
            on = true;
            poseLogged = false;
            capri.Store.Set("lyrics.on", true);
            band.TextSize = textSize;
            band.ShowBand(true);
            StartFrames();
            RefreshLedges();
            shownKey = null;
            CapriTrack now = null;
            try { now = capri.Music.Now; } catch (Exception) { }
            liveTrack = now;
            if (now != null) Follow(now);
            else band.SetIdle();
            if (pose != LyricsPose.None) SchedulePose(restore ? 1.2 : 0.5);
        }
        private void TurnOff()
        {
            on = false;
            capri.Store.Set("lyrics.on", false);
            if (band != null && OnBand(band.PlateOnScreen))
            {
                try { capri.Her.Move("stand_up"); } catch (Exception) { }
            }
            liveTrack = null;
            if (band != null)
            {
                band.Impact = 0;
                band.ShowBand(false);
            }
            wasThrown = false;
            RefreshLedges();
        }
        private void SchedulePose(double after)
        {
            if (pose == LyricsPose.None) return;
            try
            {
                capri.Timers.After(after, delegate { OnUi(PoseOnBand); });
            }
            catch (Exception) { }
        }
        private void PoseOnBand()
        {
            if (!on || band == null || pose == LyricsPose.None) return;
            try
            {
                if (!PlaceOnBand()) return;
                capri.Timers.After(1.6, delegate { OnUi(delegate { PoseAttempt(0); }); });
            }
            catch (Exception error)
            {
                capri.Log("Lyrics: couldn't put Capri on the lyrics: " + error.Message);
            }
        }
        private bool PlaceOnBand()
        {
            if (!on || band == null) return false;
            Rectangle plate = band.PlateOnScreen;
            if (plate.IsEmpty) return false;
            RefreshLedges();
            Point hip = new Point(plate.Left + plate.Width / 2, plate.Top - Math.Max(8, (int)Math.Round(6 * band.Dpi)));
            capri.Her.MoveTo(hip);
            return true;
        }
        private bool OnBand(Rectangle plate)
        {
            try
            {
                Rectangle body = capri.Her.Bounds;
                if (body.IsEmpty) return false;
                int slack = Math.Max(30, (int)Math.Round(12 * (band != null ? band.Dpi : 1f)));
                return body.Right > plate.Left && body.Left < plate.Right
                    && body.Bottom >= plate.Top - 4 * slack && body.Bottom <= plate.Top + 4 * slack;
            }
            catch (Exception) { return false; }
        }
        private void PoseAttempt(int tries)
        {
            if (!on || band == null || pose == LyricsPose.None) return;
            try
            {
                if (tries >= 3) return;
                Rectangle plate = band.PlateOnScreen;
                if (!OnBand(plate))
                {
                    if (PlaceOnBand()) capri.Timers.After(1.6, delegate { OnUi(delegate { PoseAttempt(tries + 1); }); });
                    return;
                }
                if (pose == LyricsPose.Sit)
                {
                    try { capri.Her.Move("sit_up"); } catch (Exception) { }
                    if (!poseLogged)
                    {
                        poseLogged = true;
                        capri.Log("Lyrics: Capri is sitting on the lyrics.");
                    }
                    return;
                }
                RefreshLedges();
                string said = capri.Her.Move("lie_down");
                bool lying = said != null && said.IndexOf("lying down", StringComparison.OrdinalIgnoreCase) >= 0
                    && said.IndexOf("nothing under", StringComparison.OrdinalIgnoreCase) < 0;
                if (lying)
                {
                    if (!poseLogged)
                    {
                        poseLogged = true;
                        capri.Log("Lyrics: Capri is lying on the lyrics.");
                    }
                    return;
                }
                capri.Timers.After(1.6, delegate { OnUi(delegate { PoseAttempt(tries + 1); }); });
            }
            catch (Exception error)
            {
                capri.Log("Lyrics: couldn't settle Capri on the lyrics: " + error.Message);
            }
        }
        private void SongChanged(CapriTrack track)
        {
            if (!on) return;
            OnUi(delegate
            {
                if (!on) return;
                if (track == null) band.SetIdle();
                else Follow(track);
            });
        }
        private void Follow(CapriTrack track)
        {
            if (band == null || track == null) { if (band != null) band.SetIdle(); return; }
            liveTrack = track;
            string key = Lyrics.KeyOf(track.Title, track.Artist, track.Length);
            if (string.IsNullOrEmpty(key)) { band.SetIdle(); return; }
            if (key == shownKey && band.Data != null) return;
            shownKey = key;
            Lyrics cached = cache != null ? cache.Get(key) : null;
            if (cached != null)
            {
                band.ShowLyrics(cached, track.Title, track.Artist);
                band.SetPosition(track.At(), track.Length, track.Playing);
                band.Dirty = true;
                band.Redraw();
                return;
            }
            band.SetLoading(track.Title, track.Artist);
            band.Redraw();
            Request(key, track.Title, track.Artist, track.Album, track.Length);
        }
        private void Request(string key, string title, string artist, string album, double length)
        {
            requestedKey = key;
            int ticket = ++fetchTicket;
            ThreadPool.QueueUserWorkItem(delegate
            {
                Lyrics found = Fetch(title, artist, album, length, key);
                lock (fetchLock)
                {
                    if (ticket != fetchTicket) return;
                    pending = found;
                    pendingReady = true;
                }
            });
        }
        private static Lyrics Fetch(string title, string artist, string album, double length, string key)
        {
            try
            {
                string json = Get(LyricsSource.LrclibGetUrl(artist, title, album, length));
                Lyrics found = LyricsSource.FromLrclib(json, key, length);
                if (found != null && !found.Empty) return found;
                if (found != null && found.Instrumental) return found;
                json = Get(LyricsSource.LrclibSearchUrl(artist, title));
                found = LyricsSource.FromSearch(json, key, length);
                if (found != null && !found.Empty) return found;
                json = Get(LyricsSource.OvhUrl(artist, title));
                found = LyricsSource.FromOvh(json, key, length);
                if (found != null && !found.Empty) return found;
                return Lyrics.None(key);
            }
            catch (Exception)
            {
                return null;
            }
        }
        private static string Get(string address)
        {
            try
            {
                ServicePointManager.SecurityProtocol |= (SecurityProtocolType)3072;
                HttpWebRequest request = (HttpWebRequest)WebRequest.Create(address);
                request.UserAgent = "CapriLyrics/" + Version + " (Capri Desktop mod)";
                request.Accept = "application/json";
                request.Timeout = 7000;
                request.ReadWriteTimeout = 7000;
                request.AutomaticDecompression = DecompressionMethods.GZip | DecompressionMethods.Deflate;
                using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
                using (Stream stream = response.GetResponseStream())
                using (StreamReader reader = new StreamReader(stream, Encoding.UTF8))
                    return reader.ReadToEnd();
            }
            catch (WebException) { return null; }
            catch (IOException) { return null; }
            catch (NotSupportedException) { return null; }
            catch (InvalidOperationException) { return null; }
        }
        private void Tick()
        {
            if (band == null) return;
            TuckUnderHer();
            Lyrics arrived = null;
            bool ready = false;
            lock (fetchLock)
            {
                if (pendingReady)
                {
                    arrived = pending;
                    pending = null;
                    pendingReady = false;
                    ready = true;
                }
            }
            if (ready)
            {
                if (cache != null)
                {
                    if (arrived != null) cache.Put(arrived);
                    cache.SaveSoon();
                }
                if (arrived != null && arrived.Key == requestedKey)
                {
                    CapriTrack now = null;
                    try { now = capri.Music.Now; } catch (Exception) { }
                    band.ShowLyrics(arrived, now != null ? now.Title : "", now != null ? now.Artist : "");
                    if (now != null)
                    {
                        band.SetPosition(now.At(), now.Length, now.Playing);
                        band.Length = now.Length;
                    }
                    band.Dirty = true;
                    band.Redraw();
                }
                else if (arrived == null && band.Status == "loading")
                {
                    CapriTrack missed = null;
                    try { missed = capri.Music.Now; } catch (Exception) { }
                    band.ShowLyrics(Lyrics.Error(requestedKey), missed != null ? missed.Title : "", missed != null ? missed.Artist : "");
                    band.Dirty = true;
                    band.Redraw();
                }
            }
            WatchMini();
            FollowCc();
            if (!on) return;
            WatchThrow();
            CapriTrack track = null;
            try { track = capri.Music.Now; } catch (Exception) { }
            liveTrack = track;
            if (track == null) { band.SetIdle(); return; }
            string key = Lyrics.KeyOf(track.Title, track.Artist, track.Length);
            if (!string.IsNullOrEmpty(key) && key != shownKey)
            {
                shownKey = key;
                Lyrics cached = cache != null ? cache.Get(key) : null;
                if (cached != null && !cached.Empty)
                {
                    band.ShowLyrics(cached, track.Title, track.Artist);
                    band.SetPosition(track.At(), track.Length, track.Playing);
                    band.Dirty = true;
                    band.Redraw();
                }
                else
                {
                    band.SetLoading(track.Title, track.Artist);
                    band.Redraw();
                    Request(key, track.Title, track.Artist, track.Album, track.Length);
                }
                return;
            }
            band.SetPosition(track.At(), track.Length, track.Playing);
        }
        private void StartFrames()
        {
            if (frame == null || framesRunning) return;
            framesRunning = true;
            Win32.HighRes(true);
            frame.Interval = 16;
            frameCost = 0;
            frame.Start();
        }
        private void StopFrames()
        {
            if (!framesRunning) return;
            framesRunning = false;
            if (frame != null) frame.Stop();
            Win32.HighRes(false);
        }
        private void FrameTick()
        {
            try
            {
                if (band == null || (!on && !band.Closing)) { StopFrames(); return; }
                long started = Stopwatch.GetTimestamp();
                if (on)
                {
                    CapriTrack track = liveTrack;
                    if (track != null)
                    {
                        try { band.SetPosition(track.At(), track.Length, track.Playing); }
                        catch (Exception) { }
                    }
                }
                band.FrameStep();
                float cost = (float)((Stopwatch.GetTimestamp() - started) * 1000.0 / Stopwatch.Frequency);
                frameCost = frameCost <= 0f ? cost : frameCost * 0.92f + cost * 0.08f;
                if (frame != null)
                {
                    if (frameCost > 12.5f && frame.Interval != 33) frame.Interval = 33;
                    else if (frameCost < 8.5f && frame.Interval != 16) frame.Interval = 16;
                }
            }
            catch (Exception error)
            {
                frameFaults++;
                if (frameFaults <= 3 && capri != null) capri.Log("Lyrics: frame: " + error.Message);
            }
        }
        private void FollowCc()
        {
            if (cc == null) return;
            CapriTrack track = null;
            try { track = capri.Music.Now; } catch (Exception) { }
            Form player = Mini();
            bool spotify = track != null && IsSpotify(track);
            if (player == null || !player.IsHandleCreated || !player.Visible || !spotify || plateProperty == null || scaleProperty == null)
            {
                cc.HideIfShown();
                return;
            }
            Rectangle plate = Rectangle.Empty;
            float scale = 1;
            try
            {
                plate = (Rectangle)plateProperty.GetValue(player, null);
                scale = (float)scaleProperty.GetValue(player, null);
            }
            catch (Exception) { }
            if (plate.Width <= 0 || plate.Height <= 0 || scale <= 0)
            {
                cc.HideIfShown();
                return;
            }
            cc.ShowAt(CcGeometry.Place(plate, scale), scale, on);
        }
        private void FollowCcMove()
        {
            if (cc == null || !cc.Visible) return;
            Form player = Mini();
            if (player == null || player.IsDisposed || plateProperty == null || scaleProperty == null) return;
            try
            {
                Rectangle plate = (Rectangle)plateProperty.GetValue(player, null);
                float scale = (float)scaleProperty.GetValue(player, null);
                if (plate.Width <= 0 || plate.Height <= 0 || scale <= 0) return;
                cc.SlideWith(CcGeometry.Place(plate, scale));
            }
            catch (Exception) { }
        }
        private void WatchThrow()
        {
            if (band == null) return;
            int now = Environment.TickCount;
            bool flying = false;
            bool known = false;
            if (thrownField != null && herWindow != null)
            {
                try
                {
                    object value = thrownField.GetValue(herWindow);
                    flying = value is bool && (bool)value;
                    known = true;
                }
                catch (Exception) { known = false; }
            }
            Rectangle body = Rectangle.Empty;
            try { body = capri.Her.Bounds; } catch (Exception) { }
            if (!body.IsEmpty)
            {
                int since = unchecked(now - lastBodyAt);
                if (since > 0 && since < 2000)
                {
                    double dx = body.Left - lastBodyX, dy = body.Top - lastBodyY;
                    double speed = Math.Sqrt(dx * dx + dy * dy) * 1000.0 / since;
                    if (!known && speed > 1500) flying = true;
                }
                lastBodyX = body.Left;
                lastBodyY = body.Top;
            }
            lastBodyAt = now;
            if (flying)
            {
                band.Impact = wasThrown ? Math.Min(1f, band.Impact + 0.25f) : 1f;
                wasThrown = true;
                flightAt = now;
                return;
            }
            if (!wasThrown) { band.Impact = 0; return; }
            int ago = unchecked(now - flightAt);
            if (ago < 0 || ago > 900)
            {
                wasThrown = false;
                band.Impact = 0;
                return;
            }
            band.Impact = 1f - (float)ago / 900f;
        }
        private static bool IsSpotify(CapriTrack track)
        {
            string where = (track.App == null ? "" : track.App) + " " + (track.AppId == null ? "" : track.AppId);
            return where.IndexOf("spotify", StringComparison.OrdinalIgnoreCase) >= 0;
        }
        private Control Options()
        {
            Panel panel = new Panel();
            panel.Size = new Size(380, 184);
            panel.AutoScroll = false;
            Label poseLabel = new Label();
            poseLabel.Text = "Quand les paroles s'ouvrent";
            poseLabel.SetBounds(0, 2, 240, 18);
            ComboBox poseBox = new ComboBox();
            poseBox.DropDownStyle = ComboBoxStyle.DropDownList;
            poseBox.SetBounds(0, 22, 260, 24);
            poseBox.Items.Add("Capri s'assied dessus");
            poseBox.Items.Add("Capri s'allonge dessus");
            poseBox.Items.Add("Capri reste ou elle est");
            poseBox.SelectedIndex = pose == LyricsPose.Lie ? 1 : pose == LyricsPose.None ? 2 : 0;
            poseBox.SelectedIndexChanged += delegate
            {
                pose = poseBox.SelectedIndex == 1 ? LyricsPose.Lie
                    : poseBox.SelectedIndex == 2 ? LyricsPose.None : LyricsPose.Sit;
                capri.Store.Set("lyrics.pose", pose);
                if (on && pose != LyricsPose.None)
                {
                    poseLogged = false;
                    SchedulePose(0.3);
                }
            };
            Label label = new Label();
            label.Text = "Taille du texte";
            label.SetBounds(0, 56, 200, 18);
            TrackBar bar = new TrackBar();
            bar.SetBounds(0, 74, 350, 40);
            bar.Minimum = 16;
            bar.Maximum = 38;
            bar.TickFrequency = 4;
            bar.Value = (int)Math.Max(bar.Minimum, Math.Min(bar.Maximum, textSize));
            bar.ValueChanged += delegate
            {
                textSize = bar.Value;
                capri.Store.Set("lyrics.size", (double)textSize);
                if (band != null) { band.TextSize = textSize; band.Dirty = true; if (on) band.Redraw(); }
            };
            Button reset = new Button();
            reset.Text = "Recentrer la fenetre";
            reset.SetBounds(0, 120, 170, 26);
            reset.Click += delegate
            {
                if (band == null) return;
                band.ResetPosition();
                band.Dirty = true;
                if (on) band.Redraw();
                capri.Store.Set("lyrics.pos", band.PlateLocation.X + "," + band.PlateLocation.Y);
                RefreshLedges();
            };
            CheckBox facesBox = new CheckBox();
            facesBox.Text = "Visages de Capri en gros plan (glitch, fissures)";
            facesBox.SetBounds(0, 154, 370, 22);
            facesBox.Checked = facesOn;
            facesBox.CheckedChanged += delegate
            {
                facesOn = facesBox.Checked;
                capri.Store.Set("lyrics.faces", facesOn);
                if (band != null) { band.FacesOn = facesOn; band.Dirty = true; }
            };
            panel.Controls.Add(facesBox);
            panel.Controls.Add(poseLabel);
            panel.Controls.Add(poseBox);
            panel.Controls.Add(label);
            panel.Controls.Add(bar);
            panel.Controls.Add(reset);
            return panel;
        }
        private void OnUi(Action work)
        {
            if (work == null) return;
            Action safe = delegate
            {
                try { work(); }
                catch (Exception error) { try { if (capri != null) capri.Log("Lyrics: " + error.Message); } catch (Exception) { } }
            };
            if (herWindow == null) { safe(); return; }
            try
            {
                if (herWindow.IsHandleCreated && !herWindow.IsDisposed && herWindow.InvokeRequired) herWindow.BeginInvoke(safe);
                else safe();
            }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { safe(); }
        }
    }
}