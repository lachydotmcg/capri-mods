        internal static SizeF BandSize(float width, float height)
        {
            if (float.IsNaN(width) || width <= 0) width = Wide;
            if (float.IsNaN(height) || height <= 0) height = Tall;
            width = Math.Max(MinWidth, Math.Min(MaxWidth, width));
            height = Math.Max(MinHeight, Math.Min(MaxHeight, height));
            return new SizeF(width, height);
        }
        internal void SetBandSize(float width, float height)
        {
            SizeF size = BandSize(width, height);
            if (size.Width == bandWidth && size.Height == bandHeight) return;
            bandWidth = size.Width;
            bandHeight = size.Height;
            dirty = true;
        }
        private Rectangle GripBox(float s)
        {
            int side = (int)Math.Round(GripSize * s);
            int width = (int)Math.Round(bandWidth * s);
            int height = (int)Math.Round(bandHeight * s);
            return new Rectangle(width - side, height - side, side, side);
        }
        internal void Animate()
        {
