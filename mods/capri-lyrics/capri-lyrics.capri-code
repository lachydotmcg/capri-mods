    public sealed class LyricLine
    {
        public double Time;
        public string Text;
    }
    public sealed class Lyrics
    {
        public string Key = "";
        public string Title = "";
        public string Artist = "";
        public string Source = "";
        public string Status = "none";
        public bool Synced;
        public bool Instrumental;
        public LyricLine[] Lines;
        public string Plain = "";
        public long At;
        public bool Empty
        {
            get { return (Lines == null || Lines.Length == 0) && (Plain == null || Plain.Length == 0); }
        }
        public static Lyrics None(string key)
        {
            Lyrics made = new Lyrics();
            made.Key = key == null ? "" : key;
            made.Status = "none";
            made.At = LyricsParser.NowUnix();
            return made;
        }
        public static Lyrics Error(string key)
        {
            Lyrics made = new Lyrics();
            made.Key = key == null ? "" : key;
            made.Status = "error";
            made.At = LyricsParser.NowUnix();
            return made;
        }
        public static string KeyOf(string title, string artist, double length)
        {
            string t = (title == null ? "" : title).Trim().ToLowerInvariant();
            string a = (artist == null ? "" : artist).Trim().ToLowerInvariant();
            string d = length > 0 ? ((int)Math.Round(length)).ToString(CultureInfo.InvariantCulture) : "";
            if (t.Length == 0) return null;
            return a + "|" + t + "|" + d;
        }
    }
    public static class Json
    {
        public static int KeyAt(string json, string key)
        {
            if (json == null || key == null) return -1;
            string needle = "\"" + key + "\"";
            int from = 0;
            while (true)
            {
                int at = json.IndexOf(needle, from, StringComparison.Ordinal);
                if (at < 0) return -1;
                int i = at + needle.Length;
                while (i < json.Length && char.IsWhiteSpace(json[i])) i++;
                if (i < json.Length && json[i] == ':') return i + 1;
                from = at + 1;
            }
        }
        public static string Str(string json, string key)
        {
            int at = KeyAt(json, key);
            if (at < 0) return null;
            while (at < json.Length && char.IsWhiteSpace(json[at])) at++;
            if (at >= json.Length) return null;
            if (json[at] != '"') return null;
            return ReadString(json, ref at);
        }
        public static bool Bool(string json, string key)
        {
            int at = KeyAt(json, key);
            if (at < 0) return false;
            while (at < json.Length && char.IsWhiteSpace(json[at])) at++;
            return string.Compare(json, at, "true", 0, 4, StringComparison.OrdinalIgnoreCase) == 0;
        }
        public static double Num(string json, string key)
        {
            int at = KeyAt(json, key);
            if (at < 0) return 0;
            while (at < json.Length && char.IsWhiteSpace(json[at])) at++;
            int start = at;
            while (at < json.Length)
            {
                char c = json[at];
                if (!(char.IsDigit(c) || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E')) break;
                at++;
            }
            double value;
            if (at <= start) return 0;
            double.TryParse(json.Substring(start, at - start), NumberStyles.Float, CultureInfo.InvariantCulture, out value);
            return value;
        }
        public static List<string> Objects(string json)
        {
            List<string> found = new List<string>();
            if (json == null) return found;
            int depth = 0, start = -1;
            bool inString = false, escaped = false;
            for (int i = 0; i < json.Length; i++)
            {
                char c = json[i];
                if (inString)
                {
                    if (escaped) escaped = false;
                    else if (c == '\\') escaped = true;
                    else if (c == '"') inString = false;
                    continue;
                }
                if (c == '"') { inString = true; continue; }
                if (c == '{')
                {
                    if (depth == 0) start = i;
                    depth++;
                }
                else if (c == '}')
                {
                    if (depth > 0) depth--;
                    if (depth == 0 && start >= 0)
                    {
                        found.Add(json.Substring(start, i - start + 1));
                        start = -1;
                    }
                }
            }
            return found;
        }
        private static string ReadString(string s, ref int at)
        {
            at++; // the opening quote
            StringBuilder text = new StringBuilder();
            while (at < s.Length)
            {
                char c = s[at++];
                if (c == '"') break;
                if (c != '\\') { text.Append(c); continue; }
                if (at >= s.Length) break;
                char escape = s[at++];
                switch (escape)
                {
                    case '"': text.Append('"'); break;
                    case '\\': text.Append('\\'); break;
                    case '/': text.Append('/'); break;
                    case 'b': text.Append('\b'); break;
                    case 'f': text.Append('\f'); break;
                    case 'n': text.Append('\n'); break;
                    case 'r': text.Append('\r'); break;
                    case 't': text.Append('\t'); break;
                    case 'u':
                        if (at + 4 <= s.Length)
                        {
                            int code;
                            if (int.TryParse(s.Substring(at, 4), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out code))
                                text.Append((char)code);
                            at += 4;
                        }
                        break;
                    default: text.Append(escape); break;
                }
            }
            return text.ToString();
        }
        public static string Quote(string value)
        {
            if (value == null) return "null";
            StringBuilder text = new StringBuilder("\"");
            foreach (char c in value)
            {
                switch (c)
                {
                    case '"': text.Append("\\\""); break;
                    case '\\': text.Append("\\\\"); break;
                    case '\n': text.Append("\\n"); break;
                    case '\r': text.Append("\\r"); break;
                    case '\t': text.Append("\\t"); break;
                    default:
                        if (c < 32) text.Append("\\u").Append(((int)c).ToString("x4", CultureInfo.InvariantCulture));
                        else text.Append(c);
                        break;
                }
            }
            return text.Append('"').ToString();
        }
    }
    public static class LyricsParser
    {
        private static readonly Regex Stamp = new Regex(@"\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]");
        private static readonly Regex OffsetTag = new Regex(@"^\s*\[offset:\s*([+-]?\d+)\s*\]\s*$", RegexOptions.IgnoreCase);
        public static long NowUnix()
        {
            return (long)(DateTime.UtcNow - new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalSeconds;
        }
        private static double Seconds(Match stamp)
        {
            double minutes = double.Parse(stamp.Groups[1].Value, CultureInfo.InvariantCulture);
            double seconds = double.Parse(stamp.Groups[2].Value, CultureInfo.InvariantCulture);
            double fraction = 0;
            if (stamp.Groups[3].Success)
            {
                string digits = stamp.Groups[3].Value;
                double value = double.Parse(digits, CultureInfo.InvariantCulture);
                if (digits.Length == 1) fraction = value / 10.0;
                else if (digits.Length == 2) fraction = value / 100.0;
                else fraction = value / 1000.0;
            }
            return minutes * 60.0 + seconds + fraction;
        }
        public static LyricLine[] ParseLrc(string lrc, out double offsetMilliseconds)
        {
            offsetMilliseconds = 0;
            List<LyricLine> lines = new List<LyricLine>();
            if (string.IsNullOrEmpty(lrc)) return lines.ToArray();
            string text = lrc.Replace("\r", "");
            foreach (string raw in text.Split('\n'))
            {
                Match tag = OffsetTag.Match(raw);
                if (!tag.Success) continue;
                double parsed;
                if (double.TryParse(tag.Groups[1].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out parsed))
                    offsetMilliseconds = parsed;
            }
            foreach (string raw in text.Split('\n'))
            {
                if (raw.Trim().Length == 0) continue;
                MatchCollection stamps = Stamp.Matches(raw);
                if (stamps.Count == 0) continue;
                List<double> times = new List<double>();
                int lastEnd = 0;
                bool broken = false;
                foreach (Match stamp in stamps)
                {
                    if (stamp.Index > lastEnd && raw.Substring(lastEnd, stamp.Index - lastEnd).Trim().Length > 0)
                    {
                        broken = true;
                        break;
                    }
                    times.Add(Seconds(stamp));
                    lastEnd = stamp.Index + stamp.Length;
                }
                if (broken || times.Count == 0) continue;
                string words = raw.Substring(lastEnd).Trim();
                if (words.Length == 0) continue;
                foreach (double time in times)
                    lines.Add(new LyricLine { Time = Math.Max(0, time + offsetMilliseconds / 1000.0), Text = words });
            }
            lines.Sort(delegate(LyricLine a, LyricLine b)
            {
                int byTime = a.Time.CompareTo(b.Time);
                return byTime != 0 ? byTime : string.CompareOrdinal(a.Text, b.Text);
            });
            return lines.ToArray();
        }
        public static LyricLine[] ParseLrc(string lrc)
        {
            double offset;
            return ParseLrc(lrc, out offset);
        }
        public static int IndexAt(IList<LyricLine> lines, double t)
        {
            if (lines == null || lines.Count == 0) return -1;
            int low = 0, high = lines.Count - 1, found = -1;
            while (low <= high)
            {
                int mid = (low + high) / 2;
                if (lines[mid].Time <= t + 0.001)
                {
                    found = mid;
                    low = mid + 1;
                }
                else high = mid - 1;
            }
            return found;
        }
        public static LyricLine[] EvenLines(string plain, double duration)
        {
            List<string> kept = new List<string>();
            if (plain != null)
            {
                foreach (string raw in plain.Replace("\r", "").Split('\n'))
                {
                    string line = raw.Trim();
                    if (line.Length == 0) continue;
                    if (line.StartsWith("[", StringComparison.Ordinal) && line.EndsWith("]", StringComparison.Ordinal)) continue;
                    kept.Add(line);
                }
            }
            if (kept.Count == 0) return new LyricLine[0];
            double total = duration > 10 ? duration : kept.Count * 6.0;
            LyricLine[] made = new LyricLine[kept.Count];
            for (int i = 0; i < kept.Count; i++)
                made[i] = new LyricLine { Time = total * i / kept.Count, Text = kept[i] };
            return made;
        }
        public static string JoinLrc(LyricLine[] lines)
        {
            if (lines == null) return "";
            StringBuilder text = new StringBuilder();
            foreach (LyricLine line in lines) text.Append('[').Append(StampOf(line.Time)).Append(']').Append(line.Text).Append('\n');
            return text.ToString();
        }
        private static string StampOf(double seconds)
        {
            int totalMinutes = (int)(seconds / 60);
            double rest = seconds - totalMinutes * 60;
            int whole = (int)rest;
            int hundredths = (int)Math.Round((rest - whole) * 100);
            if (hundredths >= 100) { hundredths = 0; whole++; }
            if (whole >= 60) { whole -= 60; totalMinutes++; }
            return totalMinutes.ToString("00", CultureInfo.InvariantCulture) + ":" + whole.ToString("00", CultureInfo.InvariantCulture) + "." + hundredths.ToString("00", CultureInfo.InvariantCulture);
        }
        public static double Fraction(IList<LyricLine> lines, int index, double position)
        {
            if (lines == null || index < 0 || index >= lines.Count) return 0;
            double start = lines[index].Time;
            double end = index + 1 < lines.Count ? lines[index + 1].Time : start + 4.0;
            if (end <= start) return 1;
            double value = (position - start) / (end - start);
            if (value < 0) return 0;
            if (value > 1) return 1;
            return value;
        }
    }
    public static class LyricsSource
    {
        public static string LrclibGetUrl(string artist, string title, string album, double length)
        {
            StringBuilder url = new StringBuilder("https://lrclib.net/api/get?artist_name=");
            url.Append(Uri.EscapeDataString(artist == null ? "" : artist));
            url.Append("&track_name=").Append(Uri.EscapeDataString(title == null ? "" : title));
            if (!string.IsNullOrEmpty(album)) url.Append("&album_name=").Append(Uri.EscapeDataString(album));
            if (length > 0) url.Append("&duration=").Append(((int)Math.Round(length)).ToString(CultureInfo.InvariantCulture));
            return url.ToString();
        }
        public static string LrclibSearchUrl(string artist, string title)
        {
            return "https://lrclib.net/api/search?artist_name=" + Uri.EscapeDataString(artist == null ? "" : artist)
                + "&track_name=" + Uri.EscapeDataString(title == null ? "" : title);
        }
        public static string OvhUrl(string artist, string title)
        {
            return "https://api.lyrics.ovh/v1/" + Uri.EscapeDataString(artist == null ? "" : artist)
                + "/" + Uri.EscapeDataString(title == null ? "" : title);
        }
        public static Lyrics FromLrclib(string json, string key, double duration)
        {
            if (string.IsNullOrEmpty(json)) return null;
            if (Json.KeyAt(json, "trackName") < 0) return null;
            Lyrics made = Base(json, key);
            made.Source = "lrclib";
            if (Json.Bool(json, "instrumental"))
            {
                made.Instrumental = true;
                made.Status = "instrumental";
                return made;
            }
            string synced = Json.Str(json, "syncedLyrics");
            string plain = Json.Str(json, "plainLyrics");
            if (!string.IsNullOrEmpty(synced))
            {
                double offset;
                LyricLine[] lines = LyricsParser.ParseLrc(synced, out offset);
                if (lines.Length > 0)
                {
                    made.Lines = lines;
                    made.Synced = true;
                    made.Status = "ok";
                    return made;
                }
            }
            if (!string.IsNullOrEmpty(plain))
            {
                made.Plain = plain;
                made.Lines = LyricsParser.EvenLines(plain, duration);
                made.Synced = false;
                made.Status = "ok";
                return made;
            }
            return null;
        }
        public static Lyrics FromSearch(string json, string key, double duration)
        {
            if (string.IsNullOrEmpty(json)) return null;
            List<string> found = Json.Objects(json);
            Lyrics plainPick = null;
            foreach (string one in found)
            {
                if (Json.KeyAt(one, "trackName") < 0) continue;
                if (Json.Bool(one, "instrumental")) continue;
                string synced = Json.Str(one, "syncedLyrics");
                if (!string.IsNullOrEmpty(synced))
                {
                    double offset;
                    LyricLine[] lines = LyricsParser.ParseLrc(synced, out offset);
                    if (lines.Length > 0)
                    {
                        Lyrics made = Base(one, key);
                        made.Source = "lrclib";
                        made.Lines = lines;
                        made.Synced = true;
                        made.Status = "ok";
                        return made;
                    }
                }
                if (plainPick == null)
                {
                    string plain = Json.Str(one, "plainLyrics");
                    if (!string.IsNullOrEmpty(plain))
                    {
                        Lyrics made = Base(one, key);
                        made.Source = "lrclib";
                        made.Plain = plain;
                        made.Lines = LyricsParser.EvenLines(plain, duration);
                        made.Synced = false;
                        made.Status = "ok";
                        plainPick = made;
                    }
                }
            }
            return plainPick;
        }
        public static Lyrics FromOvh(string json, string key, double duration)
        {
            if (string.IsNullOrEmpty(json)) return null;
            string plain = Json.Str(json, "lyrics");
            if (string.IsNullOrEmpty(plain)) return null;
            Lyrics made = new Lyrics();
            made.Key = key == null ? "" : key;
            made.Source = "lyrics.ovh";
            made.Plain = HtmlDecode(plain).Replace("\r", "").Trim();
            made.Lines = LyricsParser.EvenLines(made.Plain, duration);
            made.Synced = false;
            made.Status = "ok";
            made.At = LyricsParser.NowUnix();
            return made;
        }
        private static Lyrics Base(string json, string key)
        {
            Lyrics made = new Lyrics();
            made.Key = key == null ? "" : key;
            made.Title = Json.Str(json, "trackName");
            if (made.Title == null) made.Title = "";
            made.Artist = Json.Str(json, "artistName");
            if (made.Artist == null) made.Artist = "";
            made.At = LyricsParser.NowUnix();
            return made;
        }
        public static string HtmlDecode(string text)
        {
            if (text == null) return "";
            string working = text;
            working = working.Replace("&amp;", "&").Replace("&lt;", "<").Replace("&gt;", ">");
            working = working.Replace("&quot;", "\"").Replace("&apos;", "'").Replace("&#39;", "'").Replace("&nbsp;", " ");
            working = Regex.Replace(working, "&#(x?)([0-9a-fA-F]+);", delegate(Match m)
            {
                int code;
                bool ok = m.Groups[1].Value.Length > 0
                    ? int.TryParse(m.Groups[2].Value, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out code)
                    : int.TryParse(m.Groups[2].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out code);
                return ok && code > 0 && code <= 0x10FFFF ? char.ConvertFromUtf32(code) : m.Value;
            });
            return working;
        }
    }
    public sealed class LyricsCache
    {
        private readonly Dictionary<string, Lyrics> byKey = new Dictionary<string, Lyrics>(StringComparer.OrdinalIgnoreCase);
        public readonly string File;
        private double lastSave = -100;
        private const int Keep = 500;
        private const long NoneRetrySeconds = 3 * 24 * 60 * 60;
        public LyricsCache(string folder)
        {
            File = Path.Combine(folder, "lyrics-cache.jsonl");
        }
        public int Count { get { return byKey.Count; } }
        public Lyrics Get(string key)
        {
            if (key == null) return null;
            Lyrics found;
            if (!byKey.TryGetValue(key, out found)) return null;
            if (found.Status == "none" && LyricsParser.NowUnix() - found.At > NoneRetrySeconds) return null;
            return found;
        }
        public void Put(Lyrics lyrics)
        {
            if (lyrics == null || string.IsNullOrEmpty(lyrics.Key)) return;
            byKey[lyrics.Key] = lyrics;
        }
        public void Load()
        {
            try
            {
                if (!System.IO.File.Exists(File)) return;
                foreach (string raw in System.IO.File.ReadAllLines(File, Encoding.UTF8))
                {
                    string line = raw.Trim();
                    if (line.Length == 0) continue;
                    Lyrics made = Parse(line);
                    if (made != null) byKey[made.Key] = made;
                }
            }
            catch (IOException) { }
            catch (UnauthorizedAccessException) { }
        }
        private static Lyrics Parse(string line)
        {
            string key = Json.Str(line, "k");
            if (string.IsNullOrEmpty(key)) return null;
            Lyrics made = new Lyrics();
            made.Key = key;
            made.Title = Json.Str(line, "t");
            if (made.Title == null) made.Title = "";
            made.Artist = Json.Str(line, "a");
            if (made.Artist == null) made.Artist = "";
            made.Source = Json.Str(line, "o");
            if (made.Source == null) made.Source = "";
            made.At = (long)Json.Num(line, "at");
            made.Instrumental = Json.Bool(line, "i");
            string synced = Json.Str(line, "s");
            string plain = Json.Str(line, "p");
            double duration = Json.Num(line, "d");
            made.Plain = plain == null ? "" : plain;
            if (made.Instrumental)
            {
                made.Status = "instrumental";
            }
            else if (!string.IsNullOrEmpty(synced))
            {
                double offset;
                made.Lines = LyricsParser.ParseLrc(synced, out offset);
                made.Synced = made.Lines.Length > 0;
                made.Status = made.Synced ? "ok" : "none";
            }
            else if (!string.IsNullOrEmpty(plain))
            {
                made.Lines = LyricsParser.EvenLines(plain, duration);
                made.Synced = false;
                made.Status = "ok";
            }
            else made.Status = "none";
            return made;
        }
        public void Save()
        {
            try
            {
                Directory.CreateDirectory(Path.GetDirectoryName(File));
                List<Lyrics> all = new List<Lyrics>(byKey.Values);
                all.Sort(delegate(Lyrics a, Lyrics b) { return b.At.CompareTo(a.At); });
                StringBuilder text = new StringBuilder();
                int count = Math.Min(all.Count, Keep);
                for (int i = 0; i < count; i++) text.AppendLine(Line(all[i]));
                string temp = File + ".tmp";
                System.IO.File.WriteAllText(temp, text.ToString(), new UTF8Encoding(false));
                if (System.IO.File.Exists(File)) System.IO.File.Delete(File);
                System.IO.File.Move(temp, File);
                lastSave = Seconds();
            }
            catch (IOException) { }
            catch (UnauthorizedAccessException) { }
        }
        public void SaveSoon()
        {
            if (Seconds() - lastSave < 8) return;
            Save();
        }
        private static double Seconds() { return Environment.TickCount / 1000.0; }
        private static string Line(Lyrics made)
        {
            string synced = made.Synced ? LyricsParser.JoinLrc(made.Lines) : "";
            string plain = made.Plain == null ? "" : made.Plain;
            if (!made.Synced && !string.IsNullOrEmpty(synced)) synced = "";
            return "{\"k\":" + Json.Quote(made.Key)
                + ",\"t\":" + Json.Quote(made.Title)
                + ",\"a\":" + Json.Quote(made.Artist)
                + ",\"o\":" + Json.Quote(made.Source)
                + ",\"i\":" + (made.Instrumental ? "true" : "false")
                + ",\"s\":" + Json.Quote(synced)
                + ",\"p\":" + Json.Quote(plain)
                + ",\"d\":" + (made.Lines != null && made.Lines.Length > 0 ? LastTime(made.Lines) : 0).ToString("0.###", CultureInfo.InvariantCulture)
                + ",\"at\":" + made.At.ToString(CultureInfo.InvariantCulture) + "}";
        }
        private static double LastTime(LyricLine[] lines)
        {
            return lines.Length == 0 ? 0 : lines[lines.Length - 1].Time;
        }
    }
    internal static class Tm
    {
        private static readonly Stopwatch Watch = Stopwatch.StartNew();
        internal static double Seconds { get { return Watch.ElapsedTicks / (double)Stopwatch.Frequency; } }
        internal static int Ms { get { return unchecked((int)Watch.ElapsedMilliseconds); } }
    }
    public static class LyricLayout
    {
        public static bool HasLine(IList<LyricLine> lines, int index)
        {
            return lines != null && index >= 0 && index < lines.Count;
        }
        public static int FirstRow(int current, int count, int rows)
        {
            if (count <= rows) return 0;
            int first = current - rows / 2;
            if (first < 0) first = 0;
            if (first > count - rows) first = count - rows;
            return first;
        }
    }
    public static class LyricsPose
    {
        public const string Sit = "sit";
        public const string Lie = "lie";
        public const string None = "none";
        public static string Parse(string raw)
        {
            if (raw == null) return Sit;
            string value = raw.Trim().ToLowerInvariant();
            if (value.Length == 0) return Sit;
            if (value == "lie" || value == "lies" || value == "lying"
                || value == "allonge" || value == "allongee" || value == "allong\u00E9" || value == "allong\u00E9e")
                return Lie;
            if (value == "none" || value == "off" || value == "never" || value == "jamais" || value == "non")
                return None;
            return Sit;
        }
        public static string Migrate(string stored, string legacyAutoLie)
        {
            if (stored != null && stored.Trim().Length > 0) return Parse(stored);
            if (legacyAutoLie == null) return Sit;
            string legacy = legacyAutoLie.Trim().ToLowerInvariant();
            if (legacy == "true" || legacy == "1") return Lie;
            if (legacy == "false" || legacy == "0") return None;
            return Sit;
        }
    }
    public static class CcGeometry
    {
        public const float Left = 253f;
        public const float Top = 73f;
        public const float Size = 30f;
        public const float Glow = 6f;
        public static Point Place(Rectangle plate, float scale)
        {
            float s = scale <= 0 ? 1 : scale;
            int glow = (int)Math.Round(Glow * s);
            return new Point(
                plate.Left + (int)Math.Round(Left * s) - glow,
                plate.Top + (int)Math.Round(Top * s) - glow);
        }
        public static Size ImageSize(float scale)
        {
            float s = scale <= 0 ? 1 : scale;
            int side = (int)Math.Round((Size + Glow * 2) * s);
            return new Size(side, side);
        }
    }
    public static class Art
    {
        public static readonly Color Panel = Color.FromArgb(9, 11, 15);
        public static readonly Color Cyan = Color.FromArgb(58, 214, 235);
        public static readonly Color Pink = Color.FromArgb(255, 46, 136);
        public static readonly Color Ink = Color.FromArgb(232, 236, 240);
        public static readonly Color Dim = Color.FromArgb(122, 128, 138);
        public static readonly Color Violet = Color.FromArgb(146, 92, 255);
        private static MethodInfo mono;
        private static bool looked;
        private static readonly Dictionary<string, Font> Fonts = new Dictionary<string, Font>();
        private static string FontKey(char face, float size, FontStyle style)
        {
            float half = (float)Math.Round(Math.Max(1f, size) * 2f) / 2f;
            return face + half.ToString("0.0", CultureInfo.InvariantCulture) + "/" + (int)style;
        }
        private static void Keep(string key, Font font)
        {
            if (Fonts.Count >= 800) Fonts.Clear();
            Fonts[key] = font;
        }
        public static Font Mono(float size, FontStyle style, string text)
        {
            string key = FontKey('M', size, style);
            Font cached;
            if (Fonts.TryGetValue(key, out cached)) return cached;
            if (!looked)
            {
                looked = true;
                try
                {
                    Type look = typeof(ICapriMod).Assembly.GetType("CapriDesktop.Look");
                    if (look != null)
                        mono = look.GetMethod("Mono", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static, null,
                            new[] { typeof(float), typeof(FontStyle), typeof(GraphicsUnit), typeof(string) }, null);
                }
                catch (Exception) { mono = null; }
            }
            Font made = null;
            float half = (float)Math.Round(Math.Max(1f, size) * 2f) / 2f;
            if (mono != null)
            {
                try { made = (Font)mono.Invoke(null, new object[] { half, style, GraphicsUnit.Pixel, text }); }
                catch (Exception) { }
            }
            if (made == null) made = new Font("Consolas", Math.Max(1f, half), style, GraphicsUnit.Pixel);
            Keep(key, made);
            return made;
        }
        public static GraphicsPath Cut(RectangleF box, float cut)
        {
            GraphicsPath path = new GraphicsPath();
            path.AddPolygon(new[]
            {
                new PointF(box.Left + cut, box.Top),
                new PointF(box.Right - cut, box.Top),
                new PointF(box.Right, box.Top + cut),
                new PointF(box.Right, box.Bottom - cut),
                new PointF(box.Right - cut, box.Bottom),
                new PointF(box.Left + cut, box.Bottom),
                new PointF(box.Left, box.Bottom - cut),
                new PointF(box.Left, box.Top + cut)
            });
            path.CloseFigure();
            return path;
        }
        public static StringFormat Typographic()
        {
            StringFormat format = (StringFormat)StringFormat.GenericTypographic.Clone();
            format.FormatFlags |= StringFormatFlags.NoWrap | StringFormatFlags.MeasureTrailingSpaces;
            return format;
        }
        public static string Ellipsize(Graphics graphics, string text, Font font, StringFormat format, float maxWidth)
        {
            if (text == null) return "";
            if (maxWidth <= 0) return "";
            if (graphics.MeasureString(text, font, PointF.Empty, format).Width <= maxWidth) return text;
            int low = 0, high = text.Length;
            while (low < high)
            {
                int mid = (low + high + 1) / 2;
                string part = text.Substring(0, mid) + "\u2026";
                if (graphics.MeasureString(part, font, PointF.Empty, format).Width <= maxWidth) low = mid;
                else high = mid - 1;
            }
            return low <= 0 ? "" : text.Substring(0, low) + "\u2026";
        }
        private static string displayFamily;
        private static bool displayLooked;
        private static string DisplayFamily()
        {
            if (!displayLooked)
            {
                displayLooked = true;
                string[] wanted = new string[]
                {
                    "Bahnschrift SemiBold Condensed", "Bahnschrift SemiBold SemiConden",
                    "Bahnschrift SemiBold", "Bahnschrift Condensed", "Bahnschrift",
                    "Segoe UI Semibold", "Segoe UI Black", "Segoe UI", "Tahoma", "Arial"
                };
                try
                {
                    using (InstalledFontCollection fonts = new InstalledFontCollection())
                    {
                        List<string> have = new List<string>();
                        foreach (FontFamily family in fonts.Families) have.Add(family.Name);
                        foreach (string name in wanted)
                        {
                            if (have.Contains(name)) { displayFamily = name; break; }
                        }
                    }
                }
                catch (Exception) { }
                if (displayFamily == null) displayFamily = "Arial";
            }
            return displayFamily;
        }
        public static Font Display(float size, FontStyle style, string text)
        {
            if (size < 6) size = 6;
            string key = FontKey('D', size, style);
            Font cached;
            if (Fonts.TryGetValue(key, out cached)) return cached;
            Font made = null;
            float half = (float)Math.Round(size * 2f) / 2f;
            try { made = new Font(DisplayFamily(), half, style, GraphicsUnit.Pixel); }
            catch (Exception) { }
            if (made == null) made = Mono(size, style, text);
            Keep(key, made);
            return made;
        }
        private static readonly StringFormat RowFormat = Typographic();
        internal static StringFormat Shared { get { return RowFormat; } }
        public static bool Glitching
        {
            get
            {
                long slot = (uint)Environment.TickCount / 110u;
                return slot % 31 < 2;
            }
        }
        public static float Row(Graphics graphics, string text, float size, float maxWidth, float left, float top,
            float areaWidth, Color baseColour, double fraction, bool current, float s, float impact, int seed)
        {
            if (text == null) text = "";
            if (text.Length == 0) text = "\u266a";
            StringFormat format = RowFormat;
            Font baseFont = Display(size, current ? FontStyle.Bold : FontStyle.Regular, text);
            Font fitted = baseFont;
            float measured = graphics.MeasureString(text, fitted, PointF.Empty, format).Width;
            if (measured > maxWidth && measured > 0)
            {
                float scaled = Math.Max(8f * s, size * maxWidth / measured);
                fitted = Display(scaled, current ? FontStyle.Bold : FontStyle.Regular, text);
                measured = graphics.MeasureString(text, fitted, PointF.Empty, format).Width;
            }
            if (measured > maxWidth)
            {
                text = Ellipsize(graphics, text, fitted, format, maxWidth);
                measured = graphics.MeasureString(text, fitted, PointF.Empty, format).Width;
            }
            float x = left + (areaWidth - measured) / 2f;
            if (x < left) x = left;
            if (impact > 0.01f && measured > 0)
            {
                if (current)
                {
                    GlitchText(graphics, text, fitted, x, top, measured, baseColour, fraction, current, s, impact, seed);
                    return measured;
                }
                uint h = Hash((uint)seed, (uint)(Environment.TickCount / 90), 31u);
                float jx = ((int)(h & 63) - 31) / 31f * 7f * s * impact;
                int tone = ClampByte(150 - (int)(((h >> 8) & 31) * impact));
                using (Brush ghost = new SolidBrush(Color.FromArgb(tone / 2, Cyan)))
                    graphics.DrawString(text, fitted, ghost, x + jx + 3 * s * impact, top, format);
                using (Brush brush = new SolidBrush(Color.FromArgb(tone, baseColour)))
                    graphics.DrawString(text, fitted, brush, x + jx, top, format);
                return measured;
            }
            bool burst = current && Glitching;
            float split = (burst ? 2.6f : 1.2f) * s;
            if (current)
            {
                using (Brush pink = new SolidBrush(Color.FromArgb(150, Pink)))
                    graphics.DrawString(text, fitted, pink, x - split, top, format);
                using (Brush cyan = new SolidBrush(Color.FromArgb(150, Cyan)))
                    graphics.DrawString(text, fitted, cyan, x + split, top, format);
            }
            using (Brush brush = new SolidBrush(baseColour))
                graphics.DrawString(text, fitted, brush, x, top, format);
            if (current && fraction > 0 && measured > 0)
            {
                double part = fraction >= 1 ? 1 : fraction;
                Region saved = graphics.Clip;
                graphics.SetClip(new RectangleF(x, top - 2 * s, (float)(measured * part), fitted.GetHeight(graphics) + 4 * s), CombineMode.Intersect);
                using (LinearGradientBrush hot = new LinearGradientBrush(
                    new PointF(x, 0), new PointF(x + Math.Max(1f, measured), 0), Pink, Cyan))
                    graphics.DrawString(text, fitted, hot, x, top, format);
                graphics.Clip = saved;
                saved.Dispose();
            }
            if (burst && measured > 0)
            {
                float height = fitted.GetHeight(graphics);
                int mark = unchecked(Environment.TickCount * 1103515245 + 12345);
                for (int i = 0; i < 3; i++)
                {
                    float sliceTop = top + (float)((mark >> (i * 5 + 1)) & 63) / 63f * height;
                    float sliceHeight = (2f + ((mark >> (i * 4 + 3)) & 3)) * s;
                    float dx = (((mark >> (i * 7 + 2)) & 7) - 3) * 1.8f * s;
                    Region saved = graphics.Clip;
                    graphics.SetClip(new RectangleF(x - 4 * s, sliceTop, measured + 8 * s, sliceHeight), CombineMode.Intersect);
                    using (Brush ghost = new SolidBrush(i % 2 == 0 ? Color.FromArgb(130, Cyan) : Color.FromArgb(130, Pink)))
                        graphics.DrawString(text, fitted, ghost, x + dx, top, format);
                    graphics.Clip = saved;
                    saved.Dispose();
                }
            }
            return measured;
        }
        internal static Color Mix(Color a, Color b, float t)
        {
            if (t <= 0f) return a;
            if (t >= 1f) return b;
            return Color.FromArgb(
                ClampByte((int)(a.A + (b.A - a.A) * t)),
                ClampByte((int)(a.R + (b.R - a.R) * t)),
                ClampByte((int)(a.G + (b.G - a.G) * t)),
                ClampByte((int)(a.B + (b.B - a.B) * t)));
        }
        public static float RowSmooth(Graphics graphics, string text, float size, float maxWidth, float left, float top,
            float areaWidth, Color baseColour, float weight, double fraction, float s, float impact, int seed, float punch)
        {
            if (text == null) text = "";
            if (text.Length == 0) text = "\u266a";
            StringFormat format = RowFormat;
            Font fitted = Display(size, FontStyle.Bold, text);
            float measured = graphics.MeasureString(text, fitted, PointF.Empty, format).Width;
            if (measured > maxWidth && measured > 0)
            {
                float scaled = Math.Max(8f * s, size * maxWidth / measured);
                fitted = Display(scaled, FontStyle.Bold, text);
                measured = graphics.MeasureString(text, fitted, PointF.Empty, format).Width;
            }
            if (measured > maxWidth)
            {
                text = Ellipsize(graphics, text, fitted, format, maxWidth);
                measured = graphics.MeasureString(text, fitted, PointF.Empty, format).Width;
            }
            float x = left + (areaWidth - measured) / 2f;
            if (x < left) x = left;
            bool lit = weight >= 0.5f;
            if (impact > 0.01f && measured > 0)
            {
                if (lit)
                {
                    GlitchText(graphics, text, fitted, x, top, measured, baseColour, fraction, true, s, impact, seed);
                    return measured;
                }
                uint h = Hash((uint)seed, (uint)(Environment.TickCount / 90), 31u);
                float jx = ((int)(h & 63) - 31) / 31f * 7f * s * impact;
                int tone = ClampByte(Math.Min(150, (int)baseColour.A) - (int)(((h >> 8) & 31) * impact));
                using (Brush ghost = new SolidBrush(Color.FromArgb(tone / 2, Cyan)))
                    graphics.DrawString(text, fitted, ghost, x + jx + 3 * s * impact, top, format);
                using (Brush brush = new SolidBrush(Color.FromArgb(tone, baseColour)))
                    graphics.DrawString(text, fitted, brush, x + jx, top, format);
                return measured;
            }
            bool burst = lit && Glitching;
            if (weight > 0.3f)
            {
                using (Brush shadow = new SolidBrush(Color.FromArgb((int)(130 * weight), 0, 0, 0)))
                    graphics.DrawString(text, fitted, shadow, x + 1.2f * s, top + 1.8f * s, format);
            }
            if (weight > 0.04f)
            {
                float split = ((burst ? 2.6f : 1.2f) + 3.4f * punch) * s;
                int ghostAlpha = ClampByte((int)(150f * weight));
                using (Brush pink = new SolidBrush(Color.FromArgb(ghostAlpha, Pink)))
                    graphics.DrawString(text, fitted, pink, x - split, top, format);
                using (Brush cyan = new SolidBrush(Color.FromArgb(ghostAlpha, Cyan)))
                    graphics.DrawString(text, fitted, cyan, x + split, top, format);
            }
            using (Brush brush = new SolidBrush(baseColour))
                graphics.DrawString(text, fitted, brush, x, top, format);
            if (weight > 0.04f && fraction > 0 && measured > 0)
            {
                double part = fraction >= 1 ? 1 : fraction;
                float edge = (float)(measured * part);
                float rowHeight = fitted.GetHeight(graphics);
                int hotAlpha = ClampByte((int)(255f * weight));
                Region saved = graphics.Clip;
                graphics.SetClip(new RectangleF(x, top - 2 * s, edge, rowHeight + 4 * s), CombineMode.Intersect);
                using (LinearGradientBrush hot = new LinearGradientBrush(
                    new PointF(x, 0), new PointF(x + Math.Max(1f, measured), 0),
                    Color.FromArgb(hotAlpha, Pink), Color.FromArgb(hotAlpha, Cyan)))
                    graphics.DrawString(text, fitted, hot, x, top, format);
                graphics.Clip = saved;
                saved.Dispose();
                if (lit && part < 1.0)
                {
                    int bladeAlpha = ClampByte((int)(185f * weight));
                    float edgeX = x + edge;
                    using (Pen halo = new Pen(Color.FromArgb(bladeAlpha / 4, Cyan), Math.Max(2f, 6f * s)))
                        graphics.DrawLine(halo, edgeX, top + 2 * s, edgeX, top + rowHeight - 2 * s);
                    using (Pen blade = new Pen(Color.FromArgb(bladeAlpha, Ink), Math.Max(1f, 1.4f * s)))
                        graphics.DrawLine(blade, edgeX, top + 2 * s, edgeX, top + rowHeight - 2 * s);
                }
            }
            if (burst && measured > 0)
            {
                float height = fitted.GetHeight(graphics);
                int mark = unchecked(Environment.TickCount * 1103515245 + 12345);
                for (int i = 0; i < 3; i++)
                {
                    float sliceTop = top + (float)((mark >> (i * 5 + 1)) & 63) / 63f * height;
                    float sliceHeight = (2f + ((mark >> (i * 4 + 3)) & 3)) * s;
                    float dx = (((mark >> (i * 7 + 2)) & 7) - 3) * 1.8f * s;
                    Region saved = graphics.Clip;
                    graphics.SetClip(new RectangleF(x - 4 * s, sliceTop, measured + 8 * s, sliceHeight), CombineMode.Intersect);
                    using (Brush ghost = new SolidBrush(i % 2 == 0 ? Color.FromArgb(130, Cyan) : Color.FromArgb(130, Pink)))
                        graphics.DrawString(text, fitted, ghost, x + dx, top, format);
                    graphics.Clip = saved;
                    saved.Dispose();
                }
            }
            return measured;
        }
        private static readonly SolidBrush GlyphBrush = new SolidBrush(Color.White);
        private static readonly Matrix GlyphMatrix = new Matrix();
        private static readonly Dictionary<char, string> CharText = new Dictionary<char, string>(96);
        private static readonly Dictionary<string, float[]> GlyphWidths = new Dictionary<string, float[]>();
        private static Font heightFont;
        private static float heightValue;
        private static string CharOf(char c)
        {
            string one;
            if (!CharText.TryGetValue(c, out one))
            {
                one = c.ToString();
                CharText[c] = one;
            }
            return one;
        }
        private static float GlyphHeight(Graphics graphics, Font font)
        {
            if (!ReferenceEquals(heightFont, font))
            {
                heightFont = font;
                heightValue = font.GetHeight(graphics);
            }
            return heightValue;
        }
        private static float[] WidthsFor(Graphics graphics, string text, Font font, StringFormat format)
        {
            string key = ((int)font.Style).ToString(CultureInfo.InvariantCulture) + "|"
                + font.Size.ToString("0.0", CultureInfo.InvariantCulture) + "|" + text;
            float[] widths;
            if (GlyphWidths.TryGetValue(key, out widths)) return widths;
            widths = new float[text.Length];
            for (int i = 0; i < text.Length; i++)
            {
                string one = CharOf(text[i]);
                float w = one == " " ? font.Size * 0.28f : graphics.MeasureString(one, font, PointF.Empty, format).Width;
                if (w < 0.5f) w = 0.5f;
                widths[i] = w;
            }
            if (GlyphWidths.Count >= 64) GlyphWidths.Clear();
            GlyphWidths[key] = widths;
            return widths;
        }
        private static void GlitchText(Graphics graphics, string text, Font font, float x, float top, float measured,
            Color baseColour, double fraction, bool current, float s, float impact, int seed)
        {
            StringFormat format = RowFormat;
            float height = GlyphHeight(graphics, font);
            GlyphBrush.Color = Color.FromArgb(current ? 55 : 32, baseColour);
            graphics.DrawString(text, font, GlyphBrush, x, top, format);
            float[] widths = WidthsFor(graphics, text, font, format);
            float total = 0;
            for (int i = 0; i < widths.Length; i++) total += widths[i];
            float fit = total > 0 ? measured / total : 1f;
            double sung = fraction <= 0 ? 0 : fraction >= 1 ? 1 : fraction;
            int step = Environment.TickCount / 90;
            float penX = x;
            try
            {
                for (int i = 0; i < text.Length; i++)
                {
                    float w = widths[i] * fit;
                    char c = text[i];
                    if (c == ' ')
                    {
                        penX += w;
                        continue;
                    }
                    uint h = Hash((uint)i, (uint)step, (uint)seed);
                    float amp = impact * (0.45f + 0.55f * ((h & 255) / 255f));
                    float dx = ((int)((h >> 8) & 255) - 127) / 127f * 22f * s * amp;
                    float dy = ((int)((h >> 16) & 255) - 127) / 127f * 10f * s * amp;
                    float angle = ((int)((h >> 24) & 255) - 127) / 127f * 30f * amp;
                    float scale = 1f + ((int)((h >> 3) & 63) - 31) / 31f * 0.3f * amp;
                    bool lit = current && (penX - x) <= measured * sung;
                    Color colour = baseColour;
                    switch ((int)(h % 7))
                    {
                        case 0: colour = Pink; break;
                        case 1: colour = Cyan; break;
                        case 2: colour = current ? Ink : Dim; break;
                        case 3: colour = lit ? Ink : Dim; break;
                        default: break;
                    }
                    int alpha = ClampByte((current ? 225 : 150) + (int)(amp * 25));
                    if (amp > 0.5f && ((h >> 11) & 7) == 0) alpha = ClampByte(alpha - 110);
                    if (amp > 0.4f && ((h >> 11) & 7) < 2)
                    {
                        float gx = penX + (((h >> 20) & 255) - 127) / 127f * 70f * s * amp;
                        float gy = (((h >> 28) & 127) - 63) / 63f * 22f * s * amp;
                        DrawGlyph(graphics, c, font, format, gx + w / 2, top + height / 2 + gy,
                            w, height, -angle * 0.6f, scale, ClampByte((int)(alpha * 0.35f)), colour);
                    }
                    DrawGlyph(graphics, c, font, format, penX + w / 2 + dx, top + height / 2 + dy,
                        w, height, angle, scale, alpha, colour);
                    penX += w;
                }
            }
            finally
            {
                graphics.ResetTransform();
            }
        }
        private static void DrawGlyph(Graphics graphics, char c, Font font, StringFormat format, float cx, float cy,
            float w, float h, float angle, float scale, int alpha, Color colour)
        {
            GlyphMatrix.Reset();
            GlyphMatrix.Translate(cx, cy, MatrixOrder.Append);
            if (angle != 0f) GlyphMatrix.Rotate(angle, MatrixOrder.Append);
            if (scale != 1f) GlyphMatrix.Scale(scale, scale, MatrixOrder.Append);
            graphics.Transform = GlyphMatrix;
            GlyphBrush.Color = Color.FromArgb(alpha, colour);
            graphics.DrawString(CharOf(c), font, GlyphBrush, -w / 2, -h / 2, format);
        }
        internal static uint Hash(uint index, uint step, uint seed)
        {
            uint value = index * 374761393u + step * 668265263u + seed * 2246822519u;
            value = (value ^ (value >> 13)) * 1274126177u;
            return value ^ (value >> 16);
        }
        public static void Plate(Graphics graphics, RectangleF box, float s, float clock, float impact)
        {
            PlateBody(graphics, box, s, clock, impact);
            Runners(graphics, box, s, clock);
        }
        public static GraphicsPath Shape(RectangleF box, float s)
        {
            float tl = 22 * s, tr = 9 * s, br = 28 * s, bl = 9 * s;
            GraphicsPath path = new GraphicsPath();
            path.AddPolygon(new[]
            {
                new PointF(box.Left + tl, box.Top),
                new PointF(box.Right - tr, box.Top),
                new PointF(box.Right, box.Top + tr),
                new PointF(box.Right, box.Bottom - br),
                new PointF(box.Right - br, box.Bottom),
                new PointF(box.Left + bl, box.Bottom),
                new PointF(box.Left, box.Bottom - bl),
                new PointF(box.Left, box.Top + tl)
            });
            path.CloseFigure();
            return path;
        }
        private static LinearGradientBrush Rim(RectangleF box, int alpha)
        {
            LinearGradientBrush brush = new LinearGradientBrush(new PointF(box.Left, 0), new PointF(box.Right + 1, 0),
                Color.FromArgb(alpha, Cyan), Color.FromArgb(alpha, Pink));
            ColorBlend blend = new ColorBlend(3);
            blend.Positions = new float[] { 0f, 0.5f, 1f };
            blend.Colors = new Color[]
            {
                Color.FromArgb(alpha, Cyan), Color.FromArgb(alpha, Violet), Color.FromArgb(alpha, Pink)
            };
            brush.InterpolationColors = blend;
            return brush;
        }
        public static void PlateBody(Graphics graphics, RectangleF box, float s, float clock, float impact)
        {
            float breathe = (float)Math.Sin(clock * 2.1f);
            float pulse = breathe * 0.5f + 0.5f;
            float flicker = impact > 0 ? (float)Math.Sin(clock * 37f) * impact : 0f;
            using (GraphicsPath path = Shape(box, s))
            {
                using (LinearGradientBrush glass = new LinearGradientBrush(new PointF(0, box.Top), new PointF(0, box.Bottom + 1),
                    Color.FromArgb(194, 5, 8, 17), Color.FromArgb(150, 2, 3, 8)))
                    graphics.FillPath(glass, path);
                Region saved = graphics.Clip;
                graphics.SetClip(path);
                float sx = box.Left + box.Width * 0.07f;
                using (Brush sheen = new SolidBrush(Color.FromArgb(ClampByte(10 + (int)(pulse * 6)), 255, 255, 255)))
                    graphics.FillPolygon(sheen, new PointF[]
                    {
                        new PointF(sx, box.Top), new PointF(sx + 96 * s, box.Top),
                        new PointF(sx + 38 * s, box.Bottom), new PointF(sx - 58 * s, box.Bottom)
                    });
                using (Brush sheen = new SolidBrush(Color.FromArgb(7, 255, 255, 255)))
                    graphics.FillPolygon(sheen, new PointF[]
                    {
                        new PointF(sx + 124 * s, box.Top), new PointF(sx + 140 * s, box.Top),
                        new PointF(sx + 82 * s, box.Bottom), new PointF(sx + 66 * s, box.Bottom)
                    });
                using (Pen scan = new Pen(Color.FromArgb(11, 255, 255, 255), 1f))
                    for (float y = box.Top + 2 * s; y < box.Bottom; y += 3 * s) graphics.DrawLine(scan, box.Left, y, box.Right, y);
                int outer = ClampByte(40 + (int)(breathe * 14) + (int)(flicker * 34));
                int near = ClampByte(84 + (int)(breathe * 22) + (int)(flicker * 44));
                using (LinearGradientBrush haze = Rim(box, outer))
                using (Pen wide = new Pen(haze, 17 * s)) graphics.DrawPath(wide, path);
                using (LinearGradientBrush haze = Rim(box, near))
                using (Pen nearPen = new Pen(haze, 4.5f * s)) graphics.DrawPath(nearPen, path);
                if (impact > 0)
                {
                    int seed = unchecked(Environment.TickCount * 1103515245 + 12345);
                    for (int i = 0; i < 3; i++)
                    {
                        float barY = box.Top + (float)((seed >> (i * 5 + 2)) & 127) / 127f * box.Height;
                        float barX = box.Left + (float)((seed >> (i * 7 + 1)) & 255) / 255f * box.Width * 0.7f;
                        float barW = (40 + ((seed >> (i * 3 + 4)) & 127)) * s;
                        using (Brush tear = new SolidBrush(Color.FromArgb((int)(70 * impact), i % 2 == 0 ? Pink : Cyan)))
                            graphics.FillRectangle(tear, barX, barY, barW, 1.5f * s);
                    }
                }
                graphics.Clip = saved;
                saved.Dispose();
                using (LinearGradientBrush ink = Rim(box, 255))
                using (Pen edge = new Pen(ink, Math.Max(1.2f, 1.4f * s))) graphics.DrawPath(edge, path);
            }
            float inset = 4 * s;
            using (GraphicsPath inner = Shape(new RectangleF(box.Left + inset, box.Top + inset,
                box.Width - inset * 2, box.Height - inset * 2), s * 0.7f))
            using (LinearGradientBrush ink = Rim(box, 34))
            using (Pen hair = new Pen(ink, Math.Max(1, s))) graphics.DrawPath(hair, inner);
            int bracket = ClampByte(150 + (int)(pulse * 80) + (int)(flicker * 30));
            float bi = 8 * s, bl = 20 * s, th = Math.Max(1.2f, 1.6f * s);
            using (Pen cyanPen = new Pen(Color.FromArgb(bracket, Cyan), th))
            using (Pen pinkPen = new Pen(Color.FromArgb(bracket, Pink), th))
            {
                float x1 = box.Right - bi, y1 = box.Top + bi;
                graphics.DrawLine(pinkPen, x1 - bl, y1, x1, y1);
                graphics.DrawLine(pinkPen, x1, y1, x1, y1 + bl);
                float x2 = box.Left + bi, y2 = box.Bottom - bi;
                graphics.DrawLine(cyanPen, x2, y2 - bl, x2, y2);
                graphics.DrawLine(cyanPen, x2, y2, x2 + bl, y2);
            }
            float midY = box.Top + box.Height * 0.5f;
            using (Pen markL = new Pen(Color.FromArgb(120, Cyan), Math.Max(1, s)))
            using (Pen markR = new Pen(Color.FromArgb(120, Pink), Math.Max(1, s)))
            {
                float mx = box.Left + 7 * s;
                graphics.DrawLine(markL, mx - 3.5f * s, midY, mx + 3.5f * s, midY);
                graphics.DrawLine(markL, mx, midY - 3.5f * s, mx, midY + 3.5f * s);
                mx = box.Right - 7 * s;
                graphics.DrawLine(markR, mx - 3.5f * s, midY, mx + 3.5f * s, midY);
                graphics.DrawLine(markR, mx, midY - 3.5f * s, mx, midY + 3.5f * s);
            }
            using (Brush barL = new SolidBrush(Color.FromArgb(54, Cyan)))
            using (Brush barR = new SolidBrush(Color.FromArgb(54, Pink)))
            {
                int row = 0;
                for (float y = box.Top + box.Height * 0.60f; y < box.Top + box.Height * 0.84f; y += 3 * s, row++)
                {
                    uint h = Hash((uint)row, 5u, 41u);
                    graphics.FillRectangle(barL, box.Left + 5 * s, y, (2 + (int)(h & 7)) * s, 1.2f * s);
                }
                row = 0;
                for (float y = box.Top + box.Height * 0.16f; y < box.Top + box.Height * 0.40f; y += 3 * s, row++)
                {
                    uint h = Hash((uint)row, 9u, 77u);
                    float len = (2 + (int)(h & 7)) * s;
                    graphics.FillRectangle(barR, box.Right - 5 * s - len, y, len, 1.2f * s);
                }
            }
            using (Pen ruler = new Pen(Color.FromArgb(44, 170, 220, 240), Math.Max(1, s)))
            {
                int tick = 0;
                for (float x = box.Left + 40 * s; x < box.Right - 56 * s; x += 12 * s, tick++)
                {
                    float len = (tick % 4 == 0 ? 4f : 2.5f) * s;
                    graphics.DrawLine(ruler, x, box.Bottom - 3 * s, x, box.Bottom - 3 * s - len);
                }
            }
            int gripAlpha = impact > 0 ? ClampByte(150 + (int)(impact * 90)) : ClampByte(76 + (int)(pulse * 76));
            float cutB = 28 * s;
            PointF a0 = new PointF(box.Right - cutB, box.Bottom), b0 = new PointF(box.Right, box.Bottom - cutB);
            using (Pen glow = new Pen(Color.FromArgb(gripAlpha / 5, Cyan), Math.Max(2, 4 * s)))
            using (Pen grip = new Pen(Color.FromArgb(gripAlpha, Cyan), Math.Max(1, s)))
                for (int i = 0; i < 3; i++)
                {
                    float d = (7 + i * 5) * s * 0.7071f;
                    PointF p = new PointF(a0.X - d + (b0.X - a0.X) * 0.22f, a0.Y - d + (b0.Y - a0.Y) * 0.22f);
                    PointF q = new PointF(a0.X - d + (b0.X - a0.X) * 0.78f, a0.Y - d + (b0.Y - a0.Y) * 0.78f);
                    graphics.DrawLine(glow, p, q);
                    graphics.DrawLine(grip, p, q);
                }
        }
        internal static void Runners(Graphics graphics, RectangleF box, float s, float clock)
        {
            Runner(graphics, box, s, clock, true);
            Runner(graphics, box, s, clock, false);
        }
        private static void Brackets(Graphics graphics, RectangleF box, float s, int alpha)
        {
            float inset = 7 * s, len = 20 * s, thick = Math.Max(1.2f, 1.6f * s), node = 2.2f * s;
            using (Pen cyan = new Pen(Color.FromArgb(alpha, Cyan), thick))
            using (Pen pink = new Pen(Color.FromArgb(alpha, Pink), thick))
            using (Brush cyanNode = new SolidBrush(Color.FromArgb(Math.Min(255, alpha + 30), Cyan)))
            using (Brush pinkNode = new SolidBrush(Color.FromArgb(Math.Min(255, alpha + 30), Pink)))
            {
                float x0 = box.Left + inset, y0 = box.Top + inset;
                graphics.DrawLine(cyan, x0, y0 + len, x0, y0);
                graphics.DrawLine(cyan, x0, y0, x0 + len, y0);
                graphics.FillRectangle(cyanNode, x0 - node / 2, y0 - node / 2, node, node);
                float x1 = box.Right - inset, y1 = box.Top + inset;
                graphics.DrawLine(pink, x1 - len, y1, x1, y1);
                graphics.DrawLine(pink, x1, y1, x1, y1 + len);
                graphics.FillRectangle(pinkNode, x1 - node / 2, y1 - node / 2, node, node);
                float x2 = box.Left + inset, y2 = box.Bottom - inset;
                graphics.DrawLine(pink, x2, y2 - len, x2, y2);
                graphics.DrawLine(pink, x2, y2, x2 + len, y2);
                graphics.FillRectangle(pinkNode, x2 - node / 2, y2 - node / 2, node, node);
            }
        }
        private static void Runner(Graphics graphics, RectangleF box, float s, float clock, bool top)
        {
            float length = 78 * s, width = box.Width + length * 2;
            float x = (float)(clock * (top ? 96 : -74)) % width;
            if (x < 0) x += width;
            float from = box.Left - length + x;
            float y = top ? box.Top + 1 * s : box.Bottom - 1 * s;
            Region saved = graphics.Clip;
            using (GraphicsPath shape = Shape(box, s)) graphics.SetClip(shape);
            using (LinearGradientBrush glow = new LinearGradientBrush(new PointF(from, 0), new PointF(from + length, 0),
                Color.Transparent, Color.Transparent))
            {
                ColorBlend blend = new ColorBlend(3);
                blend.Positions = new float[] { 0f, 0.5f, 1f };
                blend.Colors = new Color[]
                {
                    Color.FromArgb(0, top ? Cyan : Pink),
                    Color.FromArgb(175, top ? Cyan : Pink),
                    Color.FromArgb(0, top ? Cyan : Pink)
                };
                glow.InterpolationColors = blend;
                using (Pen pen = new Pen(glow, 2 * s))
                {
                    pen.StartCap = LineCap.Round;
                    pen.EndCap = LineCap.Round;
                    graphics.DrawLine(pen, from, y, from + length, y);
                }
            }
            float head = top ? from + length : from;
            if (head > box.Left && head < box.Right)
            {
                Color tone = top ? Cyan : Pink;
                using (Brush halo = new SolidBrush(Color.FromArgb(36, tone)))
                    graphics.FillEllipse(halo, head - 3.6f * s, y - 3.6f * s, 7.2f * s, 7.2f * s);
                using (Brush core = new SolidBrush(Color.FromArgb(215, tone)))
                    graphics.FillEllipse(core, head - 1.4f * s, y - 1.4f * s, 2.8f * s, 2.8f * s);
            }
            graphics.Clip = saved;
            saved.Dispose();
        }
        private static int ClampByte(int value)
        {
            return value < 0 ? 0 : value > 255 ? 255 : value;
        }
        private static int[] TiltPixels, TiltOutput, TiltFrom, TiltBlend;
        private static int TiltWidth, TiltHeight, TiltScale;
        public static Bitmap Tilt(Bitmap source, float topScale)
        {
            return Tilt(source, topScale, null);
        }
        public static Bitmap Tilt(Bitmap source, float topScale, Bitmap target)
        {
            int width = source.Width, height = source.Height;
            if (width <= 0 || height <= 0) return source;
            if (topScale <= 0.5f) topScale = 0.5f;
            if (topScale > 1f) topScale = 1f;
            int count = width * height;
            if (TiltPixels == null || TiltPixels.Length < count)
            {
                TiltPixels = new int[count];
                TiltOutput = new int[count];
            }
            int scaleKey = (int)Math.Round(topScale * 4096f);
            if (TiltFrom == null || TiltFrom.Length < count || TiltWidth != width || TiltHeight != height || TiltScale != scaleKey)
            {
                if (TiltFrom == null || TiltFrom.Length < count)
                {
                    TiltFrom = new int[count];
                    TiltBlend = new int[count];
                }
                BuildTilt(width, height, topScale);
            }
            int[] pixels = TiltPixels, output = TiltOutput, from = TiltFrom, mix = TiltBlend;
            Array.Clear(output, 0, count);
            Bitmap tilted = target != null && target.Width == width && target.Height == height
                ? target : new Bitmap(width, height, PixelFormat.Format32bppPArgb);
            BitmapData src = null, dst = null;
            try
            {
                src = source.LockBits(new Rectangle(0, 0, width, height), ImageLockMode.ReadOnly, PixelFormat.Format32bppPArgb);
                Marshal.Copy(src.Scan0, pixels, 0, count);
                int rowWidth = width;
                Action<int> resample = delegate(int rowIndex)
                {
                    int begin = rowIndex * rowWidth, end = begin + rowWidth;
                    for (int i = begin; i < end; i++)
                    {
                        int at = from[i];
                        if (at < 0) continue;
                        int w = mix[i];
                        int a = pixels[at];
                        if (w == 0)
                        {
                            output[i] = a;
                            continue;
                        }
                        int b = pixels[at + 1];
                        int inv = 256 - w;
                        int alpha = (((a >> 24) & 255) * inv + ((b >> 24) & 255) * w) >> 8;
                        int red = (((a >> 16) & 255) * inv + ((b >> 16) & 255) * w) >> 8;
                        int green = (((a >> 8) & 255) * inv + ((b >> 8) & 255) * w) >> 8;
                        int blue = ((a & 255) * inv + (b & 255) * w) >> 8;
                        output[i] = (alpha << 24) | (red << 16) | (green << 8) | blue;
                    }
                };
                if (count >= 120000) Parallel.For(0, height, resample);
                else for (int rowIndex = 0; rowIndex < height; rowIndex++) resample(rowIndex);
                dst = tilted.LockBits(new Rectangle(0, 0, width, height), ImageLockMode.WriteOnly, PixelFormat.Format32bppPArgb);
                Marshal.Copy(output, 0, dst.Scan0, count);
            }
            finally
            {
                if (src != null) source.UnlockBits(src);
                if (dst != null) tilted.UnlockBits(dst);
            }
            return tilted;
        }
        private static void BuildTilt(int width, int height, float topScale)
        {
            TiltWidth = width;
            TiltHeight = height;
            TiltScale = (int)Math.Round(topScale * 4096f);
            for (int y = 0; y < height; y++)
            {
                float t = height <= 1 ? 0 : (float)y / (height - 1);
                float scale = topScale + (1 - topScale) * t;
                int inset = (int)Math.Round((1 - scale) * width / 2);
                int span = width - inset * 2;
                int row = y * width;
                for (int x = 0; x < width; x++) TiltFrom[row + x] = -1;
                if (span <= 0) continue;
                for (int x = 0; x < span; x++)
                {
                    float at = (x + 0.5f) * width / span - 0.5f;
                    int x0 = (int)Math.Floor(at);
                    float part = at - x0;
                    if (x0 < 0) { x0 = 0; part = 0; }
                    if (x0 >= width) { x0 = width - 1; part = 0; }
                    if (part < 0) part = 0;
                    if (part > 1) part = 1;
                    if (x0 >= width - 1) part = 0;
                    int dst = row + inset + x;
                    TiltFrom[dst] = row + x0;
                    TiltBlend[dst] = (int)(part * 256f + 0.5f);
                }
            }
        }
    }
    internal static class Win32
    {
        [StructLayout(LayoutKind.Sequential, Pack = 1)]
        private struct Blend { internal byte Operation, Flags, Alpha, Format; }
        [DllImport("user32.dll")] private static extern IntPtr GetDC(IntPtr window);
        [DllImport("user32.dll")] private static extern int ReleaseDC(IntPtr window, IntPtr dc);
        [DllImport("user32.dll")] internal static extern int GetDpiForWindow(IntPtr window);
        [DllImport("user32.dll")] internal static extern bool SetWindowPos(IntPtr window, IntPtr after, int x, int y, int width, int height, int flags);
        [DllImport("gdi32.dll")] private static extern IntPtr CreateCompatibleDC(IntPtr dc);
        [DllImport("gdi32.dll")] private static extern bool DeleteDC(IntPtr dc);
        [DllImport("gdi32.dll")] private static extern IntPtr SelectObject(IntPtr dc, IntPtr value);
        [DllImport("gdi32.dll")] private static extern bool DeleteObject(IntPtr value);
        [DllImport("user32.dll", SetLastError = true)] private static extern bool UpdateLayeredWindow(IntPtr window, IntPtr screen,
            ref Point destination, ref Size size, IntPtr source, ref Point origin, int colorKey, ref Blend blend, int flags);
        internal const int HwndTopmost = -1;
        internal const int SwpNoSize = 0x0001, SwpNoMove = 0x0002, SwpNoActivate = 0x0010;
        [DllImport("winmm.dll")] private static extern uint timeBeginPeriod(uint period);
        [DllImport("winmm.dll")] private static extern uint timeEndPeriod(uint period);
        private static bool highRes;
        internal static void HighRes(bool on)
        {
            if (on == highRes) return;
            try
            {
                if (on) timeBeginPeriod(1);
                else timeEndPeriod(1);
                highRes = on;
            }
            catch (Exception) { }
        }
        internal static float DpiScale(IntPtr window)
        {
            int dpi = 96;
            try { if (window != IntPtr.Zero) dpi = GetDpiForWindow(window); }
            catch (EntryPointNotFoundException) { }
            if (dpi <= 0) dpi = 96;
            return Math.Max(1f, dpi / 96f);
        }
        internal static void KeepOnTop(IntPtr window)
        {
            if (window == IntPtr.Zero) return;
            try { SetWindowPos(window, new IntPtr(HwndTopmost), 0, 0, 0, 0, SwpNoMove | SwpNoSize | SwpNoActivate); }
            catch (Exception) { }
        }
        internal static void Beneath(IntPtr window, IntPtr under)
        {
            if (window == IntPtr.Zero || under == IntPtr.Zero) return;
            try { SetWindowPos(window, under, 0, 0, 0, 0, SwpNoMove | SwpNoSize | SwpNoActivate); }
            catch (Exception) { }
        }
        internal static void DrawLayered(IntPtr window, Bitmap bitmap, Point location)
        {
            DrawLayered(window, bitmap, location, 255);
        }
        internal static void DrawLayered(IntPtr window, Bitmap bitmap, Point location, int alpha)
        {
            IntPtr screen = IntPtr.Zero, memory = IntPtr.Zero, native = IntPtr.Zero, previous = IntPtr.Zero;
            try
            {
                screen = GetDC(IntPtr.Zero);
                memory = CreateCompatibleDC(screen);
                native = bitmap.GetHbitmap(Color.FromArgb(0));
                previous = SelectObject(memory, native);
                Point destination = new Point(location.X, location.Y);
                Point origin = new Point(0, 0);
                Size size = new Size(bitmap.Width, bitmap.Height);
                Blend blend = new Blend { Operation = 0, Flags = 0, Alpha = (byte)(alpha < 0 ? 0 : alpha > 255 ? 255 : alpha), Format = 1 };
                if (!UpdateLayeredWindow(window, screen, ref destination, ref size, memory, ref origin, 0, ref blend, 2))
                    throw new System.ComponentModel.Win32Exception(Marshal.GetLastWin32Error());
            }
            finally
            {
                if (previous != IntPtr.Zero && memory != IntPtr.Zero) SelectObject(memory, previous);
                if (native != IntPtr.Zero) DeleteObject(native);
                if (memory != IntPtr.Zero) DeleteDC(memory);
                if (screen != IntPtr.Zero) ReleaseDC(IntPtr.Zero, screen);
            }
        }
    }
    internal class BandForm : Form
    {
        protected Bitmap Frame;
        internal IntPtr Beneath;
        private bool tucked;
        private int tuckedAt;
        internal void Tuck()
        {
            if (!IsHandleCreated) return;
            if (Beneath != IntPtr.Zero) Win32.Beneath(Handle, Beneath);
            else Win32.KeepOnTop(Handle);
            tucked = true;
            tuckedAt = Tm.Ms;
        }
        internal void TuckSoon()
        {
            if (tucked && unchecked(Tm.Ms - tuckedAt) < 250) return;
            Tuck();
        }
        internal void ForgetTuck()
        {
            tucked = false;
        }
        internal BandForm(string name)
        {
            Text = name;
            FormBorderStyle = FormBorderStyle.None;
            ShowInTaskbar = false;
            StartPosition = FormStartPosition.Manual;
            AutoScaleMode = AutoScaleMode.None;
            TopMost = true;
            DoubleBuffered = false;
        }
        protected override bool ShowWithoutActivation { get { return true; } }
        protected override CreateParams CreateParams
        {
            get
            {
                CreateParams value = base.CreateParams;
                value.ExStyle |= 0x00080000 | 0x00000080 | 0x08000000 | 0x00000008;
                return value;
            }
        }
        internal bool IsShown { get { return Visible && Frame != null; } }
        internal void Present(Bitmap image, Point at)
        {
            Present(image, at, 255);
        }
        internal void Present(Bitmap image, Point at, int alpha)
        {
            Rectangle target = new Rectangle(at, image.Size);
            if (Bounds != target) Bounds = target;
            bool opened = !Visible;
            if (opened) Show();
            try { Win32.DrawLayered(Handle, image, at, alpha); }
            catch (Exception)
            {
                if (opened && Visible) Hide();
                image.Dispose();
                throw;
            }
            Bitmap old = Frame;
            Frame = image;
            if (old != null && !ReferenceEquals(old, image)) old.Dispose();
        }
        internal void SlideTo(Point at)
        {
            if (Frame == null) return;
            Rectangle target = new Rectangle(at, Frame.Size);
            if (Bounds != target) Bounds = target;
        }
        internal void Forget()
        {
            Bitmap old = Frame;
            Frame = null;
            if (old != null) old.Dispose();
        }
        protected override void Dispose(bool disposing)
        {
            if (disposing) Forget();
            base.Dispose(disposing);
        }
    }
    internal sealed class MoverWindow : NativeWindow
    {
        internal Action Moved;
        protected override void WndProc(ref Message message)
        {
            base.WndProc(ref message);
            if (message.Msg != 0x0003 && message.Msg != 0x0047) return;
            Action moved = Moved;
            if (moved != null) moved();
        }
    }
