// capri-mod: 1
// id: mk002-emoji-flags-01
// name: Emoji Flags 1
// version: 1.0.0
// author: Mirit0
// description: additional emoji's for Caprichat
using System;
using System.IO;
using CapriDesktop;
public sealed class MK002EmojiFlags01 : ICapriMod
{
    private string published;
    public void Start(ICapriHost host)
    {
        string root=Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),"Capri","mods");
        string folder=Path.Combine(root,"mk002-caprichat-data","emoji-packs");
        Directory.CreateDirectory(folder);
        published=Path.Combine(folder,"pack-8-0.png");
        byte[] image=Convert.FromBase64String(Art);
        string temp=published+".new";
        File.WriteAllBytes(temp,image);
        if(File.Exists(published))File.Delete(published);
        File.Move(temp,published);
        host.Log("MK002 Flags emoji pack 1 enabled.");
    }
    public bool Heard(string words) {return false;}
    public void Stop()
    {
        try {if(published!=null&&File.Exists(published))File.Delete(published);}
        catch(IOException) {}
        catch(UnauthorizedAccessException) {}
    }
    private const string Art="";
}
