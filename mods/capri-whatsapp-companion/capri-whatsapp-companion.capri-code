function cleanPrefs(c) {
  const source = c && typeof c === 'object' ? c : {};
  const profile = ['work','gaming','presentation','sleep'].includes(source.notificationProfile) ? source.notificationProfile : 'work';
  const schedule = Object.assign({}, DEFAULT_CONFIG.profileSchedule, source.profileSchedule || {});
  if (!['work','gaming','presentation','sleep'].includes(schedule.profile)) schedule.profile = 'sleep';
  const storage = Object.assign({}, DEFAULT_CONFIG.storage, source.storage || {});
  storage.autoCleanup = Boolean(storage.autoCleanup);
  storage.retentionDays = Math.min(3650, Math.max(1, Number(storage.retentionDays) || 30));
  storage.maxMb = Math.min(102400, Math.max(50, Number(storage.maxMb) || 512));
  return {
    mutedChats: source.mutedChats && typeof source.mutedChats === 'object' ? source.mutedChats : {},
    priorityChats: source.priorityChats && typeof source.priorityChats === 'object' ? source.priorityChats : {},
    quietHours: Object.assign({ enabled: false, start: '22:00', end: '08:00' }, source.quietHours || {}),
    focusMode: Boolean(source.focusMode), readIndividuals: source.readIndividuals !== false,
    readGroups: source.readGroups !== false, readAudioTranscripts: source.readAudioTranscripts !== false,
    groupBurstProtection: source.groupBurstProtection !== false,
    language: ['pt-BR', 'en', 'auto'].indexOf(source.language) >= 0 ? source.language : 'pt-BR',
