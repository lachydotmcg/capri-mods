function log(...parts) {
  const line = '[Capri WhatsApp] ' + parts.map(x => String(x)).join(' ') + '\n';
  try { fs.appendFileSync(path.join(ROOT, 'bridge.log'), line, 'utf8'); } catch {}
}
function loadJson(file, fallback) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch { return fallback; }
}
function saveJson(file, value) {
  const tmp = file + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(value, null, 2), 'utf8');
  try { fs.renameSync(tmp, file); } catch { fs.copyFileSync(tmp, file); fs.unlinkSync(tmp); }
}
function clean(value, max = 300) {
  return String(value == null ? '' : value).replace(/[\r\n\t]+/g, ' ').replace(/\s{2,}/g, ' ').trim().slice(0, max);
}
function normalize(value) {
  return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, ' ').trim().toLowerCase();
}
function jidBase(value) { return String(value || '').split('@')[0].split(':')[0]; }
function digits(value) { return String(value || '').replace(/\D/g, ''); }
function groupJid(jid) { return String(jid || '').endsWith('@g.us'); }
function supportedJid(jid) { return !!jid && !/@(broadcast|newsletter)$/.test(jid) && jid !== 'status@broadcast'; }
function identityKeys(jid, alternateJid) {
  const out = [];
  for (const value of [jid, alternateJid]) {
    if (!value) continue;
    const base = jidBase(value);
    const numeric = digits(base);
    for (const key of [value, base, numeric]) if (key && !out.includes(key)) out.push(key);
  }
  return out;
}
function phoneContactFor(jid, alternateJid) {
  for (const key of identityKeys(jid, alternateJid)) if (whatsappContacts[key]) return whatsappContacts[key];
  return null;
}
function importedPhoneNameFor(jid, alternateJid) {
  const nums = identityKeys(jid, alternateJid).map(digits).filter(n => n.length >= 8);
  for (const num of nums) if (phonebook[num]) return clean(phonebook[num], 100);
  const matches = new Set();
  for (const [stored, name] of Object.entries(phonebook)) {
    if (!stored || stored.length < 10 || !name) continue;
    for (const num of nums) {
      if (num.length >= 10 && (stored.endsWith(num) || num.endsWith(stored))) matches.add(name);
    }
  }
  return matches.size === 1 ? clean([...matches][0], 100) : '';
}
function getDisplayName(jid, rawName, alternateJid) {
  const keys = identityKeys(jid, alternateJid);
  for (const key of keys) if (contacts[key]) return clean(contacts[key], 64);
  const importedName = importedPhoneNameFor(jid, alternateJid);
  if (importedName) return clean(importedName, 64);
  const phoneContact = phoneContactFor(jid, alternateJid);
  const phoneName = phoneContact && (phoneContact.name || phoneContact.notify || phoneContact.verifiedName);
  return clean(phoneName || rawName || jidBase(jid) || 'Contato', 64);
}
function storeWhatsappContact(contact) {
  if (!contact || typeof contact !== 'object') return false;
  const id = clean(contact.id || '', 160);
  const phoneNumber = clean(contact.phoneNumber || '', 100);
  const lid = clean(contact.lid || '', 100);
  const keys = identityKeys(id, phoneNumber).concat(identityKeys(lid, id)).filter((v, i, a) => v && a.indexOf(v) === i);
  if (!keys.length) return false;
  let previous = null;
  for (const key of keys) if (whatsappContacts[key]) { previous = whatsappContacts[key]; break; }
  const record = Object.assign({}, previous || {});
  record.id = id || record.id || phoneNumber || lid;
  if (phoneNumber) record.phoneNumber = phoneNumber;
  if (lid) record.lid = lid;
  for (const field of ['name', 'notify', 'verifiedName']) {
    if (typeof contact[field] === 'string' && contact[field].trim()) record[field] = clean(contact[field], 100);
  }
  record.updatedAt = Date.now();
  for (const key of keys) whatsappContacts[key] = record;
  // Refresh cached message labels when the linked phone supplies a saved contact name.
  for (const item of messages) {
    const itemIds = item.isGroup ? identityKeys(item.participantJid, item.altJid) : identityKeys(item.jid, item.altJid);
    if (!itemIds.some(key => keys.includes(key))) continue;
    const senderJid = item.isGroup ? (item.altJid || item.participantJid) : (item.altJid || item.jid);
    const alternate = item.isGroup ? (item.altJid ? item.participantJid : '') : (item.altJid ? item.jid : '');
    item.senderName = getDisplayName(senderJid, item.rawSenderLabel || item.senderName, alternate);
    item.contact = item.isGroup ? (item.senderName + ' no grupo ' + (item.groupName || '')) : item.senderName;
  }
  saveMessages();
  saveJson(WA_CONTACTS_PATH, whatsappContacts);
  return true;
}
function knownContacts() {
  const rows = new Map(); const idToKey = new Map();
  function add(jid, alternateJid, rawName, lastSeen, groupName) {
    const ids = identityKeys(jid, alternateJid);
    if (!ids.length) return;
    let key = ids.map(x => idToKey.get(x)).find(Boolean) || jid || alternateJid;
    let row = rows.get(key);
    if (!row) row = { jid: jid || alternateJid, alternateJid: alternateJid || '', rawName: '', lastSeen: 0, groupName: '' };
    if (jid && (!row.jid || (jid.endsWith('@s.whatsapp.net') && !row.jid.endsWith('@s.whatsapp.net')))) row.jid = jid;
    if (alternateJid && alternateJid !== row.jid) row.alternateJid = alternateJid;
    if (rawName) row.rawName = rawName;
    if (lastSeen > row.lastSeen) row.lastSeen = lastSeen;
    if (groupName) row.groupName = groupName;
    rows.set(key, row);
    for (const id of ids) idToKey.set(id, key);
  }
  for (const m of messages) {
    if (m.isGroup) add(m.altJid || m.participantJid, m.altJid ? m.participantJid : '', m.rawSenderLabel || m.senderName, Number(m.timestamp) || 0, m.groupName || '');
    else add(m.altJid || m.jid, m.altJid ? m.jid : '', m.rawSenderLabel || m.senderName, Number(m.timestamp) || 0, '');
  }
  const seenPhoneRecords = new Set();
  for (const record of Object.values(whatsappContacts)) {
    if (!record || typeof record !== 'object') continue;
    const recordKey = record.id || record.phoneNumber || record.lid;
    if (!recordKey || seenPhoneRecords.has(recordKey)) continue;
    seenPhoneRecords.add(recordKey);
    add(record.id || record.phoneNumber || record.lid, record.phoneNumber || record.lid || '', record.name || record.notify || record.verifiedName || '', Number(record.updatedAt) || 0, '');
  }
  return [...rows.values()].map(row => {
    const phoneRecord = phoneContactFor(row.jid, row.alternateJid);
    const label = getDisplayName(row.jid, row.rawName, row.alternateJid);
    const alias = identityKeys(row.jid, row.alternateJid).map(k => contacts[k]).find(Boolean) || '';
    return { jid: row.jid, alternateJid: row.alternateJid, label, alias: clean(alias, 64), phoneName: clean(importedPhoneNameFor(row.jid, row.alternateJid) || (phoneRecord && (phoneRecord.name || phoneRecord.notify || phoneRecord.verifiedName)) || '', 100), lastSeen: row.lastSeen, groupName: row.groupName };
  }).sort((a, b) => b.lastSeen - a.lastSeen || a.label.localeCompare(b.label));
}
function lastSenderIdentity() {
  for (let i = messages.length - 1; i >= 0; i--) {
    const m = messages[i]; if (!m || m.fromMe) continue;
    if (m.isGroup) {
      const jid = m.altJid || m.participantJid;
      if (jid) return { jid, altJid: m.altJid ? m.participantJid : '', label: m.senderName || m.rawSenderLabel || jidBase(jid), kind: 'contact' };
    } else if (m.jid) return { jid: m.altJid || m.jid, altJid: m.altJid ? m.jid : '', label: m.senderName || m.contact || m.rawSenderLabel || jidBase(m.jid), kind: 'contact' };
  }
  return null;
}
function lastGroupIdentity() {
  let latest = null;
  let latestAt = -1;
  for (const m of messages) {
    if (!m || m.fromMe || !m.isGroup || !groupJid(m.jid)) continue;
    const at = Number(m.timestamp) || 0;
    if (at >= latestAt) { latest = m; latestAt = at; }
  }
  if (!latest) return null;
  const cached = groupCache.get(latest.jid);
  return { jid: latest.jid, altJid: '', label: latest.groupName || (cached && cached.name) || 'Grupo', kind: 'group' };
}
function unwrap(message) {
  let m = message || {};
  for (let i = 0; i < 6; i++) {
    if (m.ephemeralMessage?.message) m = m.ephemeralMessage.message;
    else if (m.viewOnceMessage?.message) m = m.viewOnceMessage.message;
    else if (m.viewOnceMessageV2?.message) m = m.viewOnceMessageV2.message;
    else if (m.documentWithCaptionMessage?.message) m = m.documentWithCaptionMessage.message;
    else break;
  }
  return m;
}
function messageText(message) {
  const m = unwrap(message);
  return m.conversation || m.extendedTextMessage?.text || m.imageMessage?.caption || m.videoMessage?.caption ||
    m.documentMessage?.caption || (m.audioMessage ? '[Áudio recebido]' : '') || (m.stickerMessage ? '[Figurinha]' : '') ||
    (m.imageMessage ? '[Imagem]' : '') || (m.videoMessage ? '[Vídeo]' : '') || (m.documentMessage ? '[Documento]' : '') ||
    (m.locationMessage ? '[Localização]' : '') || (m.contactMessage ? '[Contato]' : '') || '[Mensagem sem texto]';
}
async function groupName(jid) {
  if (!groupJid(jid)) return '';
  const cached = groupCache.get(jid);
  if (cached && Date.now() - cached.at < 600000) return cached.name;
  try {
    const info = await socket.groupMetadata(jid);
    const name = clean(info?.subject || 'Grupo', 80);
    groupCache.set(jid, { name, at: Date.now() });
    return name;
  } catch { return cached?.name || 'Grupo'; }
}
function isWithinQuietHours() {
  const q = config.quietHours || {};
  if (!q.enabled) return false;
  const parse = s => { const m = /^(\d{2}):(\d{2})$/.exec(String(s || '')); return m ? Number(m[1]) * 60 + Number(m[2]) : null; };
  const start = parse(q.start), end = parse(q.end);
  if (start == null || end == null || start === end) return false;
  const now = new Date(); const cur = now.getHours() * 60 + now.getMinutes();
  return start < end ? (cur >= start && cur < end) : (cur >= start || cur < end);
}
function inTimeRange(startText, endText) {
  const parse = s => { const m = /^([0-2]\d):([0-5]\d)$/.exec(String(s || '')); return m && Number(m[1]) < 24 ? Number(m[1]) * 60 + Number(m[2]) : null; };
  const start = parse(startText), end = parse(endText);
  if (start == null || end == null || start === end) return false;
  const now = new Date(); const cur = now.getHours() * 60 + now.getMinutes();
  return start < end ? (cur >= start && cur < end) : (cur >= start || cur < end);
}
function activeNotificationProfile() {
  const schedule = config.profileSchedule || {};
  if (schedule.enabled && inTimeRange(schedule.start, schedule.end)) return schedule.profile || 'sleep';
  return config.notificationProfile || 'work';
}
function findChatMatches(target, kind) {
  const targetKey = normalize(target);
  const lastGroupAliases = ['__last_group__', 'ultimo grupo', 'ultima conversa em grupo', 'grupo que acabou de mandar mensagem', 'grupo que acabou de mandar a mensagem',
    'grupo que acabou de me mandar mensagem', 'grupo que acabou de me mandar a mensagem', 'grupo que acabou de enviar mensagem',
    'grupo que enviou a ultima mensagem', 'grupo que me enviou a ultima mensagem', 'grupo que me mandou mensagem',
    'grupo da ultima mensagem', 'grupo mais recente', 'ultimo grupo que mandou mensagem', 'last group', 'last group that messaged',
    'group that just messaged', 'group that just sent a message', 'group that last messaged'];
  if (kind === 'group' && lastGroupAliases.includes(targetKey)) {
    const last = lastGroupIdentity(); return last ? [last] : [];
  }
  if (kind === 'contact' && ['ultima pessoa', 'ultimo contato', 'last sender', 'last person'].includes(targetKey)) {
    const last = lastSenderIdentity(); return last ? [last] : [];
  }
  const probe = normalize(target);
  const raw = String(target || '').trim().toLowerCase();
  const found = new Map();
  for (const m of messages) {
    if (kind === 'group' && !m.isGroup) continue;
    if (kind === 'contact' && m.isGroup) {
      const personJid = m.altJid || m.participantJid || '';
      const personLabel = m.senderName || m.rawSenderLabel || '';
      const direct = [personJid, jidBase(personJid), personLabel, m.rawSenderLabel].filter(Boolean);
      if (direct.some(v => String(v).toLowerCase() === raw || normalize(v) === probe)) {
        if (personJid) found.set(personJid, { jid: personJid, altJid: personJid === m.participantJid ? (m.altJid || '') : (m.participantJid || ''), label: personLabel, kind: 'contact' });
      }
      continue;
    }
    const label = m.isGroup ? (m.groupName || '') : (m.senderName || m.contact || '');
    const direct = [m.jid, jidBase(m.jid), m.altJid, jidBase(m.altJid || ''), label, m.contact, m.rawSenderLabel].filter(Boolean);
    if (direct.some(v => String(v).toLowerCase() === raw || normalize(v) === probe))
      found.set(m.jid, { jid: m.jid, altJid: m.altJid || '', label: m.isGroup ? (m.groupName || label) : label, kind: m.isGroup ? 'group' : 'contact' });
  }
  if (kind === 'group') {
    for (const [jid, cached] of groupCache.entries()) {
      const name = cached && cached.name ? cached.name : '';
      const direct = [jid, jidBase(jid), name].filter(Boolean);
      if (direct.some(v => String(v).toLowerCase() === raw || normalize(v) === probe))
        found.set(jid, { jid, altJid: '', label: name || 'Grupo', kind: 'group' });
    }
  }
  if (/^[0-9]{8,15}$/.test(digits(target))) {
    const d = digits(target);
    for (const m of messages) {
      if (m.isGroup) continue;
      if (digits(jidBase(m.jid)).endsWith(d)) found.set(m.jid, { jid: m.jid, label: m.senderName || m.contact, kind: 'contact' });
      const alt = digits(jidBase(m.altJid || ''));
      if (alt && alt.endsWith(d)) found.set(m.altJid, { jid: m.altJid, label: m.senderName || m.contact, kind: 'contact' });
    }
  }
  return [...found.values()];
}
function isPriority(jid, participantJid, alternateJid) {
  return Boolean(config.priorityChats[jid] || (participantJid && config.priorityChats[participantJid]) ||
    (alternateJid && config.priorityChats[alternateJid]));
}
function shouldNotify(item) {
  // Prioridades são exceção deliberada: podem atravessar foco, horários e silenciamento geral.
  if (isPriority(item.jid, item.participantJid, item.altJid)) return true;
  const profile = activeNotificationProfile();
  if (profile === 'gaming' || profile === 'presentation' || profile === 'sleep') return false;
  if (config.focusMode || isWithinQuietHours()) return false;
  if (config.mutedChats[item.jid] || (item.altJid && config.mutedChats[item.altJid])) return false;
  if (item.isGroup) {
    // A mesma pessoa pode aparecer como LID ou número de telefone, conforme a conversa.
    if ((item.participantJid && config.mutedChats[item.participantJid]) ||
        (item.altJid && config.mutedChats[item.altJid])) return false;
    if (!config.readGroups) return false;
  } else if (!config.readIndividuals) return false;
  return true;
}
function persistNotifications() {
  const lines = notifications.slice(-100).map(n => [n.id, clean(n.contact, 64), clean(n.preview, 4000), clean(n.kind, 12), clean(n.mediaFile || '', 120)].join('\t'));
  fs.writeFileSync(EVENTS_PATH, lines.length ? lines.join('\n') + '\n' : '', 'utf8');
}
function pushNotification(item) {
  notifications.push(item); notifications = notifications.slice(-100); persistNotifications();
}
function checkGroupBurst(jid, name) {
  const now = Date.now();
  let s = burst.get(jid) || { stamps: [], until: 0 };
  s.stamps = s.stamps.filter(t => now - t < 25000); s.stamps.push(now);
  if (s.until > now) { burst.set(jid, s); return { suppress: true, announce: false }; }
