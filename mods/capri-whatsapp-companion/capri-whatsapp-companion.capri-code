        } else if (kind !== 'audio' || config.readAudioTranscripts) pushNotification({ id, contact: item.contact, preview: text, kind, mediaFile });
      } else if (kind !== 'audio' || config.readAudioTranscripts) pushNotification({ id, contact: item.contact, preview: text, kind, mediaFile });
