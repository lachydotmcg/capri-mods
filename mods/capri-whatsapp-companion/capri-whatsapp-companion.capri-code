async function listKnownGroups(refreshRemote) {
  if (refreshRemote && socket && connected && typeof socket.groupFetchAllParticipating === 'function') {
    try {
      const remoteGroups = await socket.groupFetchAllParticipating();
      for (const [jid, info] of Object.entries(remoteGroups || {})) {
        if (!groupJid(jid)) continue;
        const name = clean(info && info.subject ? info.subject : 'Grupo', 100);
        groupCache.set(jid, { name, at: Date.now() });
      }
      log('Lista de grupos atualizada pelo WhatsApp: ' + Object.keys(remoteGroups || {}).length + ' grupo(s).');
    } catch (e) { log('Não foi possível consultar todos os grupos; usando histórico local: ' + e.message); }
  }
  const rows = new Map();
  for (const m of messages) {
    if (!m || !m.isGroup || !groupJid(m.jid)) continue;
    const prior = rows.get(m.jid);
    const at = Number(m.timestamp) || 0;
    if (!prior || at >= prior.timestamp) rows.set(m.jid, { jid: m.jid, name: clean(m.groupName || (groupCache.get(m.jid) || {}).name || 'Grupo', 100), timestamp: at, lastMessage: clean(m.text, 160) });
  }
  for (const [jid, cached] of groupCache.entries()) {
    if (!groupJid(jid)) continue;
    const prior = rows.get(jid) || { jid, name: 'Grupo', timestamp: 0, lastMessage: '' };
    if (cached && cached.name) prior.name = clean(cached.name, 100);
    rows.set(jid, prior);
  }
  for (const mapName of ['mutedChats', 'priorityChats']) {
    for (const [jid, pref] of Object.entries(config[mapName] || {})) {
      if (!groupJid(jid) || !pref || pref.kind !== 'group') continue;
      if (!rows.has(jid)) rows.set(jid, { jid, name: clean(pref.label || 'Grupo', 100), timestamp: 0, lastMessage: '' });
    }
  }
  return [...rows.values()].map(row => Object.assign(row, {
    muted: Boolean(config.mutedChats[row.jid]), priority: Boolean(config.priorityChats[row.jid])
