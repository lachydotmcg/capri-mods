  if (!fs.existsSync(WHISPER_EXE) || !fs.existsSync(WHISPER_MODEL) || !fs.existsSync(FFMPEG_EXE))
    return { ok: false, status: 'not_ready', pending: pendingAudioMessages().length, error: 'Whisper, modelo ou FFmpeg ainda não está preparado.' };
