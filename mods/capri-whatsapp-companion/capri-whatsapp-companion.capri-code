function parseDateBoundary(value, endOfDay) {
  if (!value) return 0;
  const raw = String(value).trim();
  const parsed = /^\d{4}-\d{2}-\d{2}$/.test(raw) ? Date.parse(raw + (endOfDay ? 'T23:59:59.999' : 'T00:00:00.000')) : Date.parse(raw);
  return Number.isFinite(parsed) ? parsed : 0;
}
function advancedSearch(params) {
  const q = normalize(params.get('q') || params.get('termo') || '');
  const person = normalize(params.get('person') || params.get('pessoa') || '');
  const group = normalize(params.get('group') || params.get('grupo') || '');
  const subject = normalize(params.get('subject') || params.get('assunto') || '');
  const fromRaw = params.get('from') || params.get('de') || '';
  const toRaw = params.get('to') || params.get('ate') || '';
  const from = parseDateBoundary(fromRaw, false);
  const to = parseDateBoundary(toRaw, true);
  if (fromRaw && !from) throw new Error('A data inicial não é válida. Use AAAA-MM-DD.');
  if (toRaw && !to) throw new Error('A data final não é válida. Use AAAA-MM-DD.');
  if (from && to && from > to) throw new Error('A data inicial precisa ser anterior à data final.');
  if (!q && !person && !group && !subject && !from && !to) throw new Error('Informe ao menos um filtro para a busca avançada.');
  const allFound = messages.filter(m => {
    if (from && Number(m.timestamp) < from) return false;
    if (to && Number(m.timestamp) > to) return false;
    if (q && !normalize([m.text, m.senderName, m.groupName, m.jid].join(' ')).includes(q)) return false;
    if (person && !normalize([m.senderName, m.rawSenderLabel, m.participantJid, m.altJid, m.isGroup ? '' : m.jid].join(' ')).includes(person)) return false;
    if (group && (!m.isGroup || !normalize([m.groupName, m.jid].join(' ')).includes(group))) return false;
    if (subject && !normalize(m.text || '').includes(subject)) return false;
    return true;
  });
  const found = allFound.slice(-100).reverse();
  return { count: allFound.length, returned: found.length, filters: { q, person, group, subject, from: from || null, to: to || null }, messages: found };
}
function summaryData(target, scope) {
  const matches = findChatMatches(target, 'group');
  if (matches.length !== 1) throw new Error(matches.length ? 'Nome de grupo ambíguo.' : 'Grupo não encontrado.');
  const group = matches[0]; const key = group.jid; const allRows = messages.filter(m => m.jid === key).sort((a,b) => a.timestamp - b.timestamp);
  const selectedScope = ['24h','last24h','since_last','decisions_tasks','recent'].includes(scope) ? scope : 'recent';
  let periodLabel = 'Últimas 80 mensagens'; let filtered = []; let morePending = false;
  if (selectedScope === 'recent') {
    filtered = allRows.slice(-80);
  } else if (selectedScope === '24h' || selectedScope === 'last24h') {
    periodLabel = 'Últimas 24 horas';
    const lastDay = allRows.filter(m => Number(m.timestamp) >= Date.now() - 86400000);
    filtered = lastDay.slice(0, 150); morePending = lastDay.length > filtered.length;
  } else {
    const savedCursor = summaryCursors[key];
    let cursorTime = 0; let cursorId = '';
    if (savedCursor && typeof savedCursor === 'object') {
      cursorTime = Number(savedCursor.timestamp) || 0;
      cursorId = String(savedCursor.id || '');
    } else cursorTime = Number(savedCursor) || 0;
    const hasCursor = cursorTime > 0 || Boolean(cursorId);
    periodLabel = hasCursor ? 'Desde o último resumo' : 'Últimas 24 horas (primeiro resumo)';
    let afterCursor = [];
    if (cursorId) {
      const cursorIndex = allRows.findIndex(m => String(m.id) === cursorId);
      afterCursor = cursorIndex >= 0 ? allRows.slice(cursorIndex + 1) : allRows.filter(m => Number(m.timestamp) >= cursorTime);
    } else {
      const start = hasCursor ? cursorTime : Date.now() - 86400000;
      afterCursor = allRows.filter(m => Number(m.timestamp) >= start);
    }
    // Lê em ordem cronológica e avança só até o último item entregue, sem pular lotes grandes.
    filtered = afterCursor.slice(0, 150); morePending = afterCursor.length > filtered.length;
    if (selectedScope === 'decisions_tasks') periodLabel += ' — identificar decisões e tarefas';
  }
  const payload = filtered.map(m => ({ autor: m.senderName, hora: new Date(m.timestamp).toLocaleString('pt-BR'), mensagem: m.text }));
  // O marcador guarda horário e ID para não perder mensagens que compartilhem o mesmo segundo.
  if (filtered.length) {
    const last = filtered[filtered.length - 1];
    summaryCursors[key] = { timestamp: Number(last.timestamp) || Date.now(), id: String(last.id || '') };
    saveJson(SUMMARY_CURSOR_PATH, summaryCursors);
  }
  return { grupo: group.label, scope: selectedScope, periodo: periodLabel, quantidade: payload.length,
    cursorAtualizado: filtered.length > 0, mensagens: payload, maisMensagensPendentes: morePending };
}
function cleanupMedia(force) {
  const settings = config.storage || DEFAULT_CONFIG.storage;
  if (!force && !settings.autoCleanup) return { ok: true, removed: 0, storage: storageStats(), skipped: 'limpeza automática desativada' };
  const candidates = []; const seen = new Set();
  for (const m of messages) {
    if (!m.mediaFile || !m.transcription || m.transcriptionStatus === 'pending' || m.transcriptionStatus === 'processing') continue;
    const name = path.basename(String(m.mediaFile));
    if (!/^audio-[A-Za-z0-9._-]+\.ogg$/.test(name) || seen.has(name)) continue;
    seen.add(name);
    const file = path.join(MEDIA_DIR, name);
    try { const st = fs.statSync(file); if (st.isFile()) candidates.push({ name, file, bytes: st.size, age: Number(m.timestamp) || st.mtimeMs, message: m }); } catch { m.mediaFile = ''; }
  }
  const cutoff = Date.now() - Math.min(3650, Math.max(1, Number(settings.retentionDays) || 30)) * 86400000;
  let removed = 0, totalBytes = candidates.reduce((n,x) => n + x.bytes, 0);
  const maxBytes = Math.min(102400, Math.max(50, Number(settings.maxMb) || 512)) * 1048576;
  candidates.sort((a,b) => a.age - b.age);
  for (const item of candidates) {
    if (item.age >= cutoff && totalBytes <= maxBytes) continue;
    try {
      fs.unlinkSync(item.file); totalBytes -= item.bytes; removed++;
      for (const m of messages) if (m.mediaFile === item.name) { m.mediaFile = ''; m.mediaDeletedAt = Date.now(); }
    } catch (e) { log('Falha ao limpar mídia de áudio:', clean(e.message, 180)); }
  }
  if (removed) { saveMessages(); log('Limpeza de armazenamento: ' + removed + ' arquivo(s) de áudio removido(s); transcrições preservadas.'); }
  return { ok: true, removed, storage: storageStats(), message: 'Áudios antigos removidos quando elegíveis; mensagens e transcrições foram preservadas.' };
}
function importPhonebook(rows) {
  if (!Array.isArray(rows)) throw new Error('Lista de contatos inválida.');
  let imported = 0;
  for (const row of rows.slice(0, 500)) {
    const name = clean(row && row.name || '', 100);
    const number = digits(row && row.phone || '');
    if (!name || number.length < 8 || number.length > 15) continue;
    phonebook[number] = name; imported++;
  }
  saveJson(PHONEBOOK_PATH, phonebook);
  let matched = 0;
  for (const m of messages) {
    const senderJid = m.isGroup ? (m.altJid || m.participantJid) : (m.altJid || m.jid);
    const alternate = m.isGroup ? (m.altJid ? m.participantJid : '') : (m.altJid ? m.jid : '');
    const name = importedPhoneNameFor(senderJid, alternate);
    if (!name) continue;
    m.senderName = getDisplayName(senderJid, m.rawSenderLabel || m.senderName, alternate);
    m.contact = m.isGroup ? (m.senderName + ' no grupo ' + (m.groupName || '')) : m.senderName;
    matched++;
  }
  saveMessages();
  return { ok: true, imported, matchedMessages: matched, phonebookEntries: Object.keys(phonebook).length,
    message: 'Agenda importada localmente. O WhatsApp não foi alterado e os dados permanecem neste PC.' };
}
function targetForSend(target) {
  const matches = findChatMatches(target, null);
  if (!matches.length) throw new Error('Destinatário não encontrado no histórico. Não vou adivinhar um número.');
  if (matches.length > 1) throw new Error('Destinatário ambíguo. Use o nome exclusivo do contato/grupo.');
  return matches[0];
}
async function prepareSend(body) {
  if (!connected || !socket) throw new Error('WhatsApp não está conectado.');
  if (pendingSend && pendingSend.status === 'pending' && pendingSend.expiresAt > Date.now()) throw new Error('Já existe um envio aguardando confirmação.');
  const target = targetForSend(clean(body.destinatario || body.target || '', 100));
  const isCapriReply = body.capriReply === true;
  if (isCapriReply && !config.capriRepliesEnabled) throw new Error('As respostas escritas da Capri estão desativadas no Mainframe.');
  let text = String(body.mensagem || body.message || '').trim();
  if (!text || text.length > 3800) throw new Error('A mensagem precisa ter entre 1 e 3800 caracteres.');
  if (isCapriReply) text = 'Oi! Aqui é a Capri, assistente de IA deste WhatsApp. ' + text;
  const approvalId = crypto.randomBytes(12).toString('hex');
  pendingSend = { approvalId, jid: target.jid, target: target.label, text, isCapriReply, status: 'pending', createdAt: Date.now(), expiresAt: Date.now() + 120000 };
  saveJson(PENDING_PATH, pendingSend);
  return { ok: true, status: 'aguardando_confirmacao', approvalId, destinatario: target.label, tipo: target.kind,
    mensagem: text, expiraEmSegundos: 120, instrucao: 'Mostre destinatário e mensagem completos, explique que é uma resposta da Capri quando indicado e peça confirmação explícita antes de whatsapp_confirmar_envio.' };
}
async function decideSend(body) {
  if (!pendingSend || pendingSend.status !== 'pending') throw new Error('Não há envio aguardando confirmação.');
  if (pendingSend.expiresAt <= Date.now()) { pendingSend.status = 'expired'; saveJson(PENDING_PATH, pendingSend); throw new Error('A confirmação expirou. Prepare o envio novamente.'); }
  if (String(body.approvalId || '') !== pendingSend.approvalId) throw new Error('Código de aprovação não corresponde ao envio pendente.');
  if (body.approved !== true) { pendingSend.status = 'cancelled'; pendingSend.updatedAt = Date.now(); saveJson(PENDING_PATH, pendingSend); return { ok: true, status: 'cancelado' }; }
  const item = pendingSend; item.status = 'sending'; saveJson(PENDING_PATH, item);
  try {
    await socket.sendMessage(item.jid, { text: item.text });
    item.status = 'sent'; item.updatedAt = Date.now(); saveJson(PENDING_PATH, item);
    return { ok: true, status: 'enviado', destinatario: item.target };
  } catch (e) {
    item.status = 'uncertain'; item.updatedAt = Date.now(); item.error = clean(e.message, 300); saveJson(PENDING_PATH, item);
    throw new Error('Resultado incerto; verifique o chat antes de tentar novamente.');
  }
}
function exportBackup() {
  return { format: 'capri-whatsapp-preferences', version: 1, exportedAt: new Date().toISOString(), preferences: cleanPrefs(config), aliases: contacts };
}
function importBackup(data) {
  if (!data || data.format !== 'capri-whatsapp-preferences' || !data.preferences) throw new Error('Arquivo de backup não reconhecido.');
  const p = cleanPrefs(data.preferences);
  const cleanAliases = {};
  if (data.aliases && typeof data.aliases === 'object') for (const [k,v] of Object.entries(data.aliases)) {
    const key = clean(k, 150), val = clean(v, 64); if (key && val) cleanAliases[key] = val;
  }
  config = Object.assign({}, config, p); contacts = cleanAliases;
  saveJson(CONFIG_PATH, config); saveJson(CONTACTS_PATH, contacts);
  return { ok: true, message: 'Preferências e apelidos restaurados. Sessão e conversas não foram incluídas no backup.' };
}

const server = http.createServer(async (req, res) => {
  if (!authorized(req)) return response(res, 401, { error: 'Não autorizado.' });
  const url = new URL(req.url || '/', 'http://127.0.0.1:' + config.port);
  try {
    if (req.method === 'GET' && url.pathname === '/health') return response(res, 200, status());
    if (req.method === 'GET' && url.pathname === '/groups/list') {
      const rows = await listKnownGroups(url.searchParams.get('refresh') === '1');
      const encode = value => Buffer.from(String(value == null ? '' : value), 'utf8').toString('base64');
      const data = rows.map(row => [row.jid, row.name, row.muted ? '1' : '0', row.priority ? '1' : '0', row.timestamp, row.lastMessage].map(encode).join('\t')).join('\n');
      return responseText(res, 200, data);
    }
    if (req.method === 'GET' && url.pathname === '/chats') return response(res, 200, { chats: recentChats(Math.min(50, Math.max(1, Number(url.searchParams.get('limit') || 20)))) });
    if (req.method === 'GET' && url.pathname === '/messages') {
      const q = normalize(url.searchParams.get('contact') || ''); const rows = messages.filter(m => !q || normalize(m.senderName).includes(q) || normalize(m.groupName).includes(q) || normalize(m.jid).includes(q));
      return response(res, 200, { messages: rows.slice(-Math.min(100, Math.max(1, Number(url.searchParams.get('limit') || 30)))).reverse() });
    }
    if (req.method === 'GET' && url.pathname === '/search') {
      return response(res, 200, advancedSearch(url.searchParams));
    }
    if (req.method === 'GET' && url.pathname === '/audios') {
      const q = normalize(url.searchParams.get('contact') || ''); const rows = messages.filter(m => m.kind === 'audio' && (!q || normalize([m.senderName,m.groupName,m.jid].join(' ')).includes(q))).slice(-30).reverse();
      return response(res, 200, { audios: rows.map(m => ({ id: m.id, contato: m.contact, grupo: m.groupName || '', recebidoEm: m.timestamp, transcricao: m.transcription || '', textoCompleto: m.transcription || m.text || '', status: m.transcriptionStatus || 'unknown', erro: m.transcriptionError || '', arquivoDisponivel: Boolean(m.mediaFile && fs.existsSync(path.join(MEDIA_DIR, path.basename(m.mediaFile)))) })) });
    }
    if (req.method === 'POST' && url.pathname === '/audios/reprocess') {
      const body = await readBody(req);
      const includeFailed = body.includeFailed === true;
      const pending = pendingAudioMessages(includeFailed).length;
      if (!pending) return response(res, 200, { ok: true, status: 'nothing_pending', recovered: 0, pending: 0 });
      if (!fs.existsSync(WHISPER_EXE) || !fs.existsSync(WHISPER_MODEL) || !fs.existsSync(FFMPEG_EXE))
        return response(res, 200, { ok: false, status: 'not_ready', pending, error: 'Whisper, modelo ou FFmpeg ainda não está preparado.' });
      if (!audioReprocessing) setTimeout(() => reprocessPendingAudios(includeFailed).catch(e => log('Falha na fila de transcrição: ' + e.message)), 0);
      return response(res, 200, { ok: true, status: audioReprocessing ? 'already_running' : 'scheduled', pending, retryFailed: includeFailed });
    }
    if (req.method === 'GET' && url.pathname === '/summary') {
      const target = clean(url.searchParams.get('group') || '', 100);
      const scope = clean(url.searchParams.get('scope') || 'recent', 32);
      return response(res, 200, summaryData(target, scope));
    }
    if (req.method === 'POST' && url.pathname === '/contacts/import-vcf') {
      const body = await readBody(req);
      return response(res, 200, importPhonebook(body.contacts || []));
    }
    if (req.method === 'GET' && url.pathname === '/contacts/list') {
      const rows = knownContacts();
      const encode = value => Buffer.from(String(value || ''), 'utf8').toString('base64');
      const data = rows.map(row => [row.jid, row.alternateJid, row.label, row.alias, row.phoneName].map(encode).join('\t')).join('\n');
      return responseText(res, 200, data);
    }
    if (req.method === 'GET' && url.pathname === '/preferences') return response(res, 200, { ok: true, preferences: cleanPrefs(config), aliases: contacts });
    if (req.method === 'POST' && url.pathname === '/preferences') return response(res, 200, await handlePreferences(await readBody(req)));
    if (req.method === 'GET' && url.pathname === '/storage') return response(res, 200, storageStats());
    if (req.method === 'POST' && url.pathname === '/storage/settings') {
      const body = await readBody(req);
      config.storage = Object.assign({}, config.storage || DEFAULT_CONFIG.storage, {
        autoCleanup: Boolean(body.autoCleanup), retentionDays: Math.min(3650, Math.max(1, Number(body.retentionDays) || 30)),
        maxMb: Math.min(102400, Math.max(50, Number(body.maxMb) || 512))
      });
      saveJson(CONFIG_PATH, config);
      return response(res, 200, { ok: true, settings: config.storage, storage: storageStats() });
    }
    if (req.method === 'POST' && url.pathname === '/storage/cleanup') return response(res, 200, cleanupMedia(true));
    if (req.method === 'POST' && url.pathname === '/contacts/alias') {
      const body = await readBody(req);
      const alias = clean(body.apelido != null ? body.apelido : (body.alias || ''), 64);
      const target = clean(body.contato || body.target || '', 120);
      let matches = [];
      if (body.jid || body.contactId) {
        const wanted = String(body.jid || body.contactId);
        const row = knownContacts().find(item => item.jid === wanted || item.alternateJid === wanted);
        if (row) matches = [{ jid: row.jid, altJid: row.alternateJid, label: row.label, kind: 'contact' }];
      } else if (target) matches = findChatMatches(target, 'contact');
      if (matches.length !== 1) throw new Error(matches.length ? 'Encontrei mais de um contato com esse nome. Escolha-o na lista do Mainframe.' : 'Não encontrei esse contato. Atualize a lista de contatos ou escolha-o no Mainframe.');
      const m = matches[0];
      const ids = identityKeys(m.jid, m.altJid);
      if (alias) for (const id of ids) contacts[id] = alias;
      else for (const id of ids) delete contacts[id];
      saveJson(CONTACTS_PATH, contacts);
      let updated = 0;
      for (const item of messages) {
        const itemIds = item.isGroup ? identityKeys(item.participantJid, item.altJid) : identityKeys(item.jid, item.altJid);
        if (!itemIds.some(id => ids.includes(id))) continue;
        const senderJid = item.isGroup ? (item.altJid || item.participantJid) : (item.altJid || item.jid);
        const alternate = item.isGroup ? (item.altJid ? item.participantJid : '') : (item.altJid ? item.jid : '');
        item.senderName = getDisplayName(senderJid, item.rawSenderLabel || item.senderName, alternate);
        item.contact = item.isGroup ? (item.senderName + ' no grupo ' + (item.groupName || '')) : item.senderName;
        updated++;
      }
      saveMessages();
      return response(res, 200, { ok: true, contato: m.label, apelido: alias, cleared: !alias, mensagensAtualizadas: updated,
        message: alias ? 'Nome atualizado na Capri. O nome salvo no celular não foi alterado.' : 'Apelido local removido; a Capri voltou a usar o nome recebido do WhatsApp.' });
    }
    if (req.method === 'POST' && url.pathname === '/send/prepare') return response(res, 200, await prepareSend(await readBody(req)));
    if (req.method === 'POST' && url.pathname === '/send/decision') return response(res, 200, await decideSend(await readBody(req)));
    if (req.method === 'GET' && url.pathname === '/backup/export') return response(res, 200, exportBackup());
    if (req.method === 'POST' && url.pathname === '/backup/import') return response(res, 200, importBackup(await readBody(req)));
    if (req.method === 'POST' && url.pathname === '/pair/retry') {
      if (socket) { try { socket.end(undefined); } catch {} socket = null; }
      setTimeout(() => connectWhatsApp().catch(e => log('Falha ao reconectar:', e.message)), 300);
      return response(res, 200, { ok: true, message: 'Tentando conectar. O QR Code aparecerá nas opções do mod se necessário.' });
    }
    if (req.method === 'POST' && url.pathname === '/shutdown') {
      response(res, 200, { ok: true }); setTimeout(() => shutdown(), 150); return;
    }
    return response(res, 404, { error: 'Rota não encontrada.' });
  } catch (e) { return response(res, 400, { error: clean(e.message || e, 500) }); }
});

function shutdown() {
  if (shuttingDown) return; shuttingDown = true;
  if (reconnectTimer) clearTimeout(reconnectTimer);
  try { if (socket) socket.end(undefined); } catch {}
  try { server.close(); } catch {}
  log('Serviço encerrado; dados privados preservados.');
  setTimeout(() => process.exit(0), 500);
}

async function connectWhatsApp() {
  if (connecting || shuttingDown || socket) return;
  connecting = true;
  try {
    const auth = await useMultiFileAuthState(AUTH_DIR);
    const sock = makeWASocket({ auth: auth.state, logger: pino({ level: 'silent' }), printQRInTerminal: false,
      markOnlineOnConnect: false, syncFullHistory: true, generateHighQualityLinkPreview: false });
    socket = sock;
    sock.ev.on('creds.update', auth.saveCreds);
    sock.ev.on('messages.upsert', event => {
      const history = event?.type !== 'notify';
      for (const msg of event?.messages || []) addIncoming(msg, history).catch(e => log('Falha ao registrar mensagem:', e.message));
    });
    sock.ev.on('messaging-history.set', event => {
      const rows = (event?.messages || []).slice(-1500);
      let contactCount = 0;
      for (const contact of event?.contacts || []) if (storeWhatsappContact(contact)) contactCount++;
      for (const msg of rows) addIncoming(msg, true).catch(e => log('Falha ao sincronizar histórico:', e.message));
      log('Sincronização de histórico iniciada: ' + rows.length + ' mensagens; ' + contactCount + ' registros de contato recebidos.');
    });
    sock.ev.on('contacts.upsert', rows => {
      let count = 0; for (const contact of rows || []) if (storeWhatsappContact(contact)) count++;
      if (count) log('Contatos recebidos do WhatsApp: ' + count + '.');
    });
    sock.ev.on('contacts.update', rows => {
      let count = 0; for (const contact of rows || []) if (storeWhatsappContact(contact)) count++;
      if (count) log('Nomes de contatos atualizados pelo WhatsApp: ' + count + '.');
    });
    sock.ev.on('groups.update', updates => { for (const u of updates || []) if (u?.id && u?.subject) groupCache.set(u.id, { name: clean(u.subject, 80), at: Date.now() }); });
    sock.ev.on('connection.update', async update => {
      if (update.qr) {
        try { await QRCode.toFile(QR_PATH, update.qr, { width: 420, margin: 2, errorCorrectionLevel: 'M' }); log('QR Code atualizado; abra as opções do mod para escanear.'); }
        catch (e) { log('Não foi possível gerar a imagem do QR Code:', e.message); }
      }
      if (update.connection === 'open') {
        connected = true; try { if (fs.existsSync(QR_PATH)) fs.unlinkSync(QR_PATH); } catch {}
        log('WhatsApp conectado.');
      }
      if (update.connection === 'close') {
        connected = false; socket = null;
        const code = update.lastDisconnect?.error?.output?.statusCode;
        if (code === DisconnectReason.loggedOut) { log('Sessão revogada pelo WhatsApp. Remova o vínculo no celular e faça novo pareamento.'); return; }
        if (!shuttingDown && !reconnectTimer) reconnectTimer = setTimeout(() => { reconnectTimer = null; connectWhatsApp().catch(e => log(e.message)); }, code === DisconnectReason.restartRequired ? 1200 : 4000);
      }
    });
  } catch (e) { socket = null; connected = false; log('Falha de conexão:', e.stack || e); }
  finally { connecting = false; }
}

setInterval(() => { try { if (config.storage && config.storage.autoCleanup) cleanupMedia(false); } catch (e) { log('Falha na limpeza automática:', e.message); } }, 60 * 60 * 1000);
server.listen(Number(config.port), '127.0.0.1', () => log('Ponte local ativa somente em 127.0.0.1:' + config.port));
process.on('uncaughtException', e => { log('Erro inesperado:', e.stack || e); });
process.on('unhandledRejection', e => { log('Promessa rejeitada:', e?.stack || e); });
process.on('SIGINT', shutdown); process.on('SIGTERM', shutdown);
connectWhatsApp().catch(e => log('Falha na conexão inicial:', e.stack || e));
";

    public void Start(ICapriHost host)
    {
        capri = host;
        stopped = false;
        rootDir = Path.Combine(host.Folder, "whatsapp-runtime");
        appDir = Path.Combine(rootDir, "app");
        authDir = Path.Combine(rootDir, "auth");
        sttDir = Path.Combine(rootDir, "stt");
        nodeDir = Path.Combine(rootDir, "node");
        workerPath = Path.Combine(appDir, "worker.mjs");
        eventsPath = Path.Combine(rootDir, "notifications.tsv");
        configPath = Path.Combine(rootDir, "config.json");
        audioStatusPath = Path.Combine(rootDir, "stt-status.json");
        mediaDir = Path.Combine(rootDir, "media");
        Directory.CreateDirectory(rootDir);
        Directory.CreateDirectory(appDir);
        Directory.CreateDirectory(authDir);
        Directory.CreateDirectory(sttDir);
        Directory.CreateDirectory(mediaDir);
        WriteAudioState("starting", "Inicializando a preparação automática da transcrição local.", false);
        LoadOrCreateConfig();
        lastId = ReadStoredLastId();
        RegisterBrainTools();
        try
        {
            capri.Ui.SetOptions("Capri WhatsApp", delegate { return BuildOptions(); });
            capri.Ui.AddMenuItem(UiText("Capri WhatsApp — abrir opções", "Capri WhatsApp — open options"), delegate
            {
                capri.Mainframe.ShowPage("Capri WhatsApp", delegate { return BuildOptions(); });
            });
        }
        catch (Exception ex) { capri.Log("Não foi possível registrar a página de opções: " + ex.Message); }
        try
        {
            capri.Chat.AddContext(delegate
            {
                StringBuilder notesText = new StringBuilder();
                try
                {
                    foreach (object note in capri.Personality.Notes)
                    {
                        string noteLine = note == null ? "" : Clean(note.ToString(), 80);
                        if (String.IsNullOrWhiteSpace(noteLine)) continue;
                        if (notesText.Length > 0) notesText.Append(" | ");
                        notesText.Append(noteLine);
                        if (notesText.Length >= 230) break;
                    }
                }
                catch { }
                string persona = Clean(notesText.ToString(), 240);
                if (String.IsNullOrEmpty(persona))
                    return UiText("Integração WhatsApp ativa; respostas só com pedido expresso e aprovação.", "WhatsApp integration active; replies require an explicit request and approval.");
                return Clean(UiText("Notas adicionais de personalidade ativas: ", "Active additional personality notes: ") + persona, 300);
            });
        }
        catch { }
        try
        {
            capri.Chat.AddContext(delegate
            {
                return IsEnglishInterface()
                    ? "Capri WhatsApp help: explain features step by step in the user's language. Do not change settings in response to how-to questions. Cover pairing, VCF contacts, groups, search, summaries, profiles, backups, storage, diagnostics and approved replies."
                    : "Ajuda Capri WhatsApp: explique recursos em etapas no idioma do usuário. Não mude configurações quando a pessoa só perguntar como fazer. Oriente sobre conexão, contatos VCF, grupos, busca, resumos, perfis, backups, espaço, diagnóstico e respostas confirmadas.";
            });
        }
        catch { }
        timer = capri.Timers.Every(2, delegate { PollNotifications(); });
        Task.Run(delegate { RunBootstrap(); });
        capri.Log("Capri WhatsApp 1.0 iniciado. Preparando os componentes automaticamente na pasta privada do mod.");
        capri.Say(UiText("Estou preparando a integração do WhatsApp. Você poderá fazer o pareamento e controlar tudo nas opções deste mod.", "I am preparing the WhatsApp integration. You can pair your account and manage everything in this mod's options."));
    }

    private void LoadOrCreateConfig()
    {
        if (File.Exists(configPath))
        {
            string cfg = File.ReadAllText(configPath, Encoding.UTF8);
            token = ReadString(cfg, "token");
            port = ReadInt(cfg, "port", 39391);
        }
        if (String.IsNullOrEmpty(token) || port < 1024 || port > 65535)
        {
            byte[] bytes = new byte[24];
            using (RandomNumberGenerator rng = RandomNumberGenerator.Create()) rng.GetBytes(bytes);
            token = Convert.ToBase64String(bytes).Replace("+", "A").Replace("/", "B").Replace("=", "");
            port = 39391 + (int)(Math.Abs((long)Environment.TickCount) % 1200);
            string cfg = "{\r\n  \"port\": " + port + ",\r\n  \"token\": \"" + token + "\",\r\n" +
                "  \"mutedChats\": {},\r\n  \"priorityChats\": {},\r\n" +
                "  \"quietHours\": { \"enabled\": false, \"start\": \"22:00\", \"end\": \"08:00\" },\r\n" +
                "  \"focusMode\": false,\r\n  \"readIndividuals\": true,\r\n" +
                "  \"readGroups\": true,\r\n  \"readAudioTranscripts\": true,\r\n  \"groupBurstProtection\": true,\r\n  \"language\": \"pt-BR\"\r\n}";
            File.WriteAllText(configPath, cfg, new UTF8Encoding(false));
        }
    }

    private string ReadString(string json, string key)
    {
        string marker = "\"" + key + "\"";
        int i = json.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return "";
        int colon = json.IndexOf(':', i + marker.Length);
        int q1 = colon < 0 ? -1 : json.IndexOf('\"', colon + 1);
        int q2 = q1 < 0 ? -1 : json.IndexOf('\"', q1 + 1);
        return q2 > q1 ? json.Substring(q1 + 1, q2 - q1 - 1) : "";
    }

    private int ReadInt(string json, string key, int fallback)
    {
        string marker = "\"" + key + "\"";
        int i = json.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return fallback;
        int colon = json.IndexOf(':', i + marker.Length);
        if (colon < 0) return fallback;
        string value = json.Substring(colon + 1).Trim();
        int end = 0;
        while (end < value.Length && Char.IsDigit(value[end])) end++;
        int parsed;
        return Int32.TryParse(value.Substring(0, end), out parsed) ? parsed : fallback;
    }

    private string ReadNumber(string json, string key, string format)
    {
        string marker = "\"" + key + "\"";
        int i = (json ?? "").IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return "0";
        int colon = json.IndexOf(':', i + marker.Length);
        if (colon < 0) return "0";
        string value = json.Substring(colon + 1).TrimStart();
        int end = 0;
        while (end < value.Length && (Char.IsDigit(value[end]) || value[end] == '.' || value[end] == '-')) end++;
        double parsed;
        return Double.TryParse(value.Substring(0, end), NumberStyles.Float, CultureInfo.InvariantCulture, out parsed)
            ? parsed.ToString(format, CultureInfo.InvariantCulture) : "0";
    }

    private void RunBootstrap()
    {
        lock (bootstrapLock)
        {
            if (bootstrapRunning || stopped) return;
            bootstrapRunning = true;
        }
        try
        {
            WriteAudioState("checking", "Verificando o Windows e os componentes locais.", false);
            if (!Is64BitWindows())
            {
                WriteAudioState("error", "Esta versão requer Windows 10/11 de 64 bits.", true);
                capri.Log("Este pacote 1.0 requer Windows 10/11 x64 para o runtime automático incluído.");
                capri.Say(UiText("Esta versão do Capri WhatsApp está preparada para Windows de 64 bits.", "This version of Capri WhatsApp is prepared for 64-bit Windows."));
                return;
            }
            WriteAudioState("node", "Preparando o runtime interno do WhatsApp.", false);
            EnsureNodeRuntime();
            EnsureWorkerAndPackages();
            WriteAudioState("whatsapp", "Iniciando a conexão do WhatsApp.", false);
            // Bring WhatsApp online before optional transcription downloads, so messaging remains usable.
            EnsureBridgeRunning();
            capri.Log("WhatsApp iniciado. Preparando transcrição local de áudio em segundo plano.");
            try
            {
                WriteAudioState("whisper", "Preparando o mecanismo de transcrição Whisper.", false);
                EnsureWhisperRuntime();
                WriteAudioState("ready", "Transcrição local pronta: Whisper, modelo multilíngue e FFmpeg instalados.", false);
                capri.Log("Transcrição local pronta: Ogg/Opus será convertido para WAV antes do Whisper.");
                try
                {
                    string retry = Request("POST", "/audios/reprocess", "{}", 8000);
                    capri.Log("Fila de áudios anteriores: " + Clean(retry, 300));
                }
                catch (Exception retryEx)
                {
                    capri.Log("Não consegui iniciar a recuperação dos áudios pendentes: " + Clean(retryEx.Message, 300));
                }
            }
            catch (Exception audioEx)
            {
                WriteAudioState("error", "A preparação da transcrição falhou: " + Clean(audioEx.Message, 350), true);
                capri.Log("WhatsApp permanece ativo; a transcrição ainda não está pronta: " + Clean(audioEx.Message, 500));
                capri.Say(UiText("O WhatsApp está conectado ou pronto para parear. A transcrição de áudios ainda precisa terminar de ser preparada. Você pode tentar novamente nas opções.", "WhatsApp is connected or ready to pair. Audio transcription still needs to finish setting up. You can retry in Options."));
            }
            capri.Log("Preparação concluída. O QR Code, quando necessário, aparece nas opções do mod.");
        }
        catch (Exception ex)
        {
            WriteAudioState("error", "Falha na preparação do WhatsApp: " + Clean(ex.Message, 350), true);
            capri.Log("Falha ao preparar Capri WhatsApp: " + ex.ToString());
            capri.Say(UiText("Não consegui concluir a preparação do WhatsApp. Abra as opções do mod para ver o estado e o registro.", "I could not finish preparing WhatsApp. Open the mod options to check the status and log."));
        }
        finally { lock (bootstrapLock) { bootstrapRunning = false; } }
    }

    private void WriteAudioState(string stage, string message, bool error)
    {
        try
        {
            if (String.IsNullOrEmpty(audioStatusPath)) return;
            string json = "{\"stage\":\"" + JsonEscape(stage) + "\",\"message\":\"" + JsonEscape(message) +
                "\",\"error\":" + (error ? "true" : "false") +
                ",\"updatedAt\":\"" + DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture) + "\"}";
            File.WriteAllText(audioStatusPath, json, new UTF8Encoding(false));
        }
        catch (Exception ex)
        {
            try { if (capri != null) capri.Log("Não consegui atualizar o estado da transcrição: " + ex.Message); } catch { }
        }
    }

    private bool Is64BitWindows()
    {
        return Environment.OSVersion.Platform == PlatformID.Win32NT && Environment.Is64BitOperatingSystem;
    }

    private void EnsureNodeRuntime()
    {
        string nodeExe = Path.Combine(nodeDir, "node.exe");
        if (File.Exists(nodeExe) && NodeVersion(nodeExe) == "v26.13.1") return;
        capri.Log("Baixando runtime Node.js portátil oficial. Nenhum instalador será aberto.");
        string zip = Path.Combine(rootDir, "node-v26.13.1-win-x64.zip");
        DownloadVerified(NODE_URL, zip, NODE_SHA256);
        string temp = Path.Combine(rootDir, "node-extract");
        ExtractZip(zip, temp);
        string[] dirs = Directory.GetDirectories(temp);
        string source = "";
        for (int i = 0; i < dirs.Length; i++) if (File.Exists(Path.Combine(dirs[i], "node.exe"))) { source = dirs[i]; break; }
        if (String.IsNullOrEmpty(source)) throw new Exception("O pacote oficial do Node não contém node.exe.");
        if (Directory.Exists(nodeDir)) Directory.Delete(nodeDir, true);
        Directory.Move(source, nodeDir);
        TryDelete(zip); TryDeleteDirectory(temp);
        if (!File.Exists(nodeExe) || NodeVersion(nodeExe) != "v26.13.1") throw new Exception("O runtime Node.js não passou na verificação da versão fixada v26.13.1.");
    }

    private string NodeVersion(string exe)
    {
        try
        {
            ProcessStartInfo info = new ProcessStartInfo(exe, "-v");
            info.UseShellExecute = false; info.CreateNoWindow = true; info.RedirectStandardOutput = true; info.RedirectStandardError = true;
            using (Process p = Process.Start(info))
            {
                string text = p.StandardOutput.ReadToEnd().Trim();
                if (!p.WaitForExit(8000) || p.ExitCode != 0) return "";
                return text;
            }
        }
        catch { return ""; }
    }

    private void EnsureWorkerAndPackages()
    {
        string source = WORKER_SOURCE;
        if (!File.Exists(workerPath) || File.ReadAllText(workerPath, Encoding.UTF8) != source)
            File.WriteAllText(workerPath, source, new UTF8Encoding(false));
        string packagePath = Path.Combine(appDir, "package.json");
        File.WriteAllText(packagePath, PACKAGE_JSON, new UTF8Encoding(false));
        string baileys = Path.Combine(appDir, "node_modules", "@whiskeysockets", "baileys", "package.json");
        string qr = Path.Combine(appDir, "node_modules", "qrcode", "package.json");
        string pino = Path.Combine(appDir, "node_modules", "pino", "package.json");
        if (File.Exists(baileys) && File.Exists(qr) && File.Exists(pino)) return;
        string npmCmd = Path.Combine(nodeDir, "npm.cmd");
        if (!File.Exists(npmCmd)) throw new Exception("npm.cmd não foi encontrado no runtime portátil.");
        capri.Log("Instalando dependências JavaScript fixadas por versão, automaticamente, na pasta do mod.");
        ProcessStartInfo info = new ProcessStartInfo("cmd.exe", "/d /s /c \"\"" + npmCmd + "\" install --omit=dev --no-audit --no-fund --save-exact\"");
        info.WorkingDirectory = appDir; info.UseShellExecute = false; info.CreateNoWindow = true;
        info.RedirectStandardOutput = false; info.RedirectStandardError = false;
        info.EnvironmentVariables["PATH"] = nodeDir + ";" + (Environment.GetEnvironmentVariable("PATH") ?? "");
        using (Process p = Process.Start(info))
        {
            if (!p.WaitForExit(300000) || p.ExitCode != 0) throw new Exception("Não consegui preparar as bibliotecas do WhatsApp. Confira a conexão com a internet e tente novamente.");
        }
        if (!File.Exists(baileys) || !File.Exists(qr)) throw new Exception("As dependências do WhatsApp não foram instaladas corretamente.");
    }

    private void EnsureWhisperRuntime()
    {
        string exe = Path.Combine(sttDir, "whisper-cli.exe");
        string model = Path.Combine(sttDir, "ggml-small-q5_1.bin");
        if (!File.Exists(exe))
        {
            WriteAudioState("whisper", "Baixando o mecanismo Whisper.cpp.", false);
            capri.Log("Baixando Whisper.cpp para transcrição local de áudio, sem chave de API.");
            string zip = Path.Combine(rootDir, "whisper-bin-x64.zip");
            string temp = Path.Combine(rootDir, "whisper-extract");
            DownloadVerified(WHISPER_URL, zip, WHISPER_SHA256);
            ExtractZip(zip, temp);
            string found = FindFile(temp, "whisper-cli.exe");
            if (String.IsNullOrEmpty(found)) throw new Exception("O pacote Whisper não contém whisper-cli.exe.");
            string folder = Path.GetDirectoryName(found);
            string[] files = Directory.GetFiles(folder, "*", SearchOption.TopDirectoryOnly);
            for (int i = 0; i < files.Length; i++)
            {
                string dest = Path.Combine(sttDir, Path.GetFileName(files[i]));
                File.Copy(files[i], dest, true);
            }
            TryDelete(zip); TryDeleteDirectory(temp);
        }
        if (!File.Exists(model))
        {
            WriteAudioState("model", "Baixando o modelo multilíngue Whisper small (aprox. 190 MB).", false);
            capri.Log("Baixando modelo multilíngue Whisper small quantizado (aprox. 190 MB). A transcrição será local.");
            string part = model + ".part";
            DownloadVerified(MODEL_URL, part, MODEL_SHA256);
            if (File.Exists(model)) File.Delete(model);
            File.Move(part, model);
        }
        if (!File.Exists(exe) || !File.Exists(model)) throw new Exception("Whisper local não foi preparado corretamente.");
        EnsureFfmpegRuntime();
    }

    private void EnsureFfmpegRuntime()
    {
        string exe = Path.Combine(sttDir, "ffmpeg.exe");
        if (File.Exists(exe)) return;
        WriteAudioState("ffmpeg", "Baixando o conversor FFmpeg para áudios Ogg/Opus.", false);
        capri.Log("Preparando conversor FFmpeg 8.1 x64 (LGPL) para transcrição local de áudios Ogg/Opus do WhatsApp.");
        string zip = Path.Combine(rootDir, "ffmpeg-lgpl-win64.zip");
        string temp = Path.Combine(rootDir, "ffmpeg-extract");
        DownloadVerified(FFMPEG_URL, zip, FFMPEG_SHA256);
        ExtractZip(zip, temp);
        string found = FindFile(temp, "ffmpeg.exe");
        if (String.IsNullOrEmpty(found)) throw new Exception("O pacote FFmpeg não contém ffmpeg.exe.");
        string folder = Path.GetDirectoryName(found);
        string[] files = Directory.GetFiles(folder, "*", SearchOption.TopDirectoryOnly);
        for (int i = 0; i < files.Length; i++)
        {
            string dest = Path.Combine(sttDir, Path.GetFileName(files[i]));
            File.Copy(files[i], dest, true);
        }
        TryDelete(zip); TryDeleteDirectory(temp);
        if (!File.Exists(exe)) throw new Exception("FFmpeg não foi preparado corretamente.");
    }

    private string FindFile(string dir, string name)
    {
        string[] files = Directory.GetFiles(dir, name, SearchOption.AllDirectories);
        return files.Length > 0 ? files[0] : "";
    }

    // Helpers de limpeza usados durante a instalação automática dos componentes.
    // Falhas ao remover temporários não interrompem uma instalação que já foi validada.
    private void TryDelete(string path)
    {
        if (String.IsNullOrEmpty(path)) return;
        try
        {
            if (File.Exists(path)) File.Delete(path);
        }
        catch (Exception ex)
        {
            try { if (capri != null) capri.Log("Não foi possível remover arquivo temporário " + Path.GetFileName(path) + ": " + ex.Message); } catch { }
        }
    }

    private void TryDeleteDirectory(string path)
    {
        if (String.IsNullOrEmpty(path)) return;
        try
        {
            if (Directory.Exists(path)) Directory.Delete(path, true);
        }
        catch (Exception ex)
        {
            try { if (capri != null) capri.Log("Não foi possível remover pasta temporária " + Path.GetFileName(path) + ": " + ex.Message); } catch { }
        }
    }

    private void DownloadVerified(string url, string path, string expectedSha256)
    {
        try { ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12; } catch { }
        if (File.Exists(path) && String.Equals(FileSha256(path), expectedSha256, StringComparison.OrdinalIgnoreCase)) return;
        TryDelete(path);
        string part = path + ".download";
        TryDelete(part);
        using (WebClient client = new WebClient())
        {
            client.Headers.Add("User-Agent", "Capri-WhatsApp/1.0");
            client.DownloadFile(url, part);
        }
        string actual = FileSha256(part);
        if (!String.Equals(actual, expectedSha256, StringComparison.OrdinalIgnoreCase))
        {
            TryDelete(part);
            throw new Exception("A verificação SHA-256 falhou para " + Path.GetFileName(path) + ". O arquivo foi descartado.");
        }
        if (File.Exists(path)) File.Delete(path);
        File.Move(part, path);
    }

    private string FileSha256(string path)
    {
        using (SHA256 sha = SHA256.Create())
        using (FileStream stream = File.OpenRead(path))
        {
            byte[] hash = sha.ComputeHash(stream); StringBuilder sb = new StringBuilder();
            for (int i = 0; i < hash.Length; i++) sb.Append(hash[i].ToString("x2"));
            return sb.ToString();
        }
    }

    private void ExtractZip(string zip, string target)
    {
        if (Directory.Exists(target)) Directory.Delete(target, true);
        Directory.CreateDirectory(target);
        ProcessStartInfo info = new ProcessStartInfo("tar.exe", "-xf \"" + zip + "\" -C \"" + target + "\"");
        info.UseShellExecute = false; info.CreateNoWindow = true;
        try
        {
            using (Process p = Process.Start(info))
            {
                if (p.WaitForExit(180000) && p.ExitCode == 0 && (Directory.GetFiles(target).Length > 0 || Directory.GetDirectories(target).Length > 0)) return;
            }
        }
        catch { }
        string ps = "-NoProfile -NonInteractive -Command \"Expand-Archive -LiteralPath '" + zip.Replace("'", "''") + "' -DestinationPath '" + target.Replace("'", "''") + "' -Force\"";
        using (Process p2 = Process.Start(new ProcessStartInfo("powershell.exe", ps) { UseShellExecute = false, CreateNoWindow = true }))
        {
            if (!p2.WaitForExit(180000) || p2.ExitCode != 0) throw new Exception("Não foi possível extrair o arquivo verificado " + Path.GetFileName(zip) + ".");
        }
    }

    private void EnsureBridgeRunning()
    {
        if (stopped) return;
        if (BridgeAlive()) return;
        string nodeExe = Path.Combine(nodeDir, "node.exe");
        if (!File.Exists(nodeExe) || !File.Exists(workerPath)) throw new Exception("Runtime ou serviço local ausente.");
        try
        {
            if (bridgeProcess != null && !bridgeProcess.HasExited) return;
        }
        catch { }
        ProcessStartInfo info = new ProcessStartInfo(nodeExe, "\"" + workerPath + "\"");
        info.WorkingDirectory = appDir; info.UseShellExecute = false; info.CreateNoWindow = true;
        info.RedirectStandardOutput = true; info.RedirectStandardError = true;
        info.EnvironmentVariables["CAPRI_WA_ROOT"] = rootDir;
        info.EnvironmentVariables["CAPRI_WA_FFMPEG"] = Path.Combine(sttDir, "ffmpeg.exe");
        bridgeProcess = new Process(); bridgeProcess.StartInfo = info;
        bridgeProcess.OutputDataReceived += delegate(object sender, DataReceivedEventArgs e) { if (!String.IsNullOrEmpty(e.Data) && capri != null) capri.Log(Clean(e.Data, 500)); };
        bridgeProcess.ErrorDataReceived += delegate(object sender, DataReceivedEventArgs e) { if (!String.IsNullOrEmpty(e.Data) && capri != null) capri.Log(Clean(e.Data, 500)); };
        if (!bridgeProcess.Start()) throw new Exception("Não consegui iniciar o serviço WhatsApp local.");
        bridgeProcess.BeginOutputReadLine(); bridgeProcess.BeginErrorReadLine();
        lastRestartUtc = DateTime.UtcNow;
        for (int i = 0; i < 30 && !stopped; i++)
        {
            Thread.Sleep(300);
            if (BridgeAlive()) { capri.Log("Serviço local do WhatsApp ativo."); return; }
        }
        capri.Log("O serviço ainda está iniciando. Verifique novamente nas opções do mod.");
    }

    private bool BridgeAlive()
    {
        try { string result = Request("GET", "/health", null, 2500); return result.Contains("\"ok\":true"); }
        catch { return false; }
    }

    private string Request(string method, string route, string body, int timeout)
    {
        HttpWebRequest request = (HttpWebRequest)WebRequest.Create("http://127.0.0.1:" + port.ToString(CultureInfo.InvariantCulture) + route);
        request.Method = method; request.Timeout = timeout; request.ReadWriteTimeout = timeout;
        request.Headers.Add("x-capri-local-token", token); request.Proxy = null;
        if (body != null)
        {
            byte[] data = Encoding.UTF8.GetBytes(body); request.ContentType = "application/json; charset=utf-8"; request.ContentLength = data.Length;
            using (Stream stream = request.GetRequestStream()) stream.Write(data, 0, data.Length);
        }
        using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
        using (StreamReader reader = new StreamReader(response.GetResponseStream(), Encoding.UTF8)) return reader.ReadToEnd();
    }

    private long ReadStoredLastId()
    {
        long value = 0;
        try { Int64.TryParse(capri.Store.Get("lastNotificationId", "0"), out value); } catch { }
        return value;
    }

    private void PollNotifications()
    {
        try
        {
            if (stopped) return;
            if (bridgeProcess != null && bridgeProcess.HasExited && DateTime.UtcNow - lastRestartUtc > TimeSpan.FromSeconds(15))
                Task.Run(delegate { try { EnsureBridgeRunning(); } catch (Exception ex) { if (capri != null) capri.Log("Falha ao reiniciar serviço local: " + ex.Message); } });
            if (!File.Exists(eventsPath)) return;
            string[] lines = File.ReadAllLines(eventsPath, Encoding.UTF8);
            int count = 0;
            for (int i = 0; i < lines.Length; i++)
            {
                string[] parts = lines[i].Split(new char[] { '\t' }, 5);
                if (parts.Length < 3) continue;
                long id; if (!Int64.TryParse(parts[0], out id) || id <= lastId) continue;
                string contact = Clean(parts[1], 70); string preview = Clean(parts[2], 4000);
                string kind = parts.Length > 3 ? Clean(parts[3], 20) : "text";
                if (kind == "audio" && preview.Length > 650)
                {
                    string audioContact = contact;
                    string transcript = preview;
                    lastSpokenMessage = "Áudio de " + audioContact + ": " + transcript;
                    try
                    {
                        string language = CurrentLanguage();
                        string instruction = language == "en"
                            ? "Summarize this audio faithfully in natural English in up to three sentences. " +
                              "Highlight requests, dates, decisions and actions. Do not invent details or reproduce the full transcript."
                            : (language == "auto"
                                ? "Summarize this audio faithfully in the same language as the transcript, " +
                                  "defaulting to Brazilian Portuguese when unclear. Use up to three sentences. " +
                                  "Highlight requests, dates, decisions and actions. Do not invent details."
                                : "Resuma este áudio com fidelidade em português brasileiro, em até três frases. " +
                                  "Destaque pedidos, datas, decisões e ações. Não invente informações. " +
                                  "Não reproduza a transcrição inteira.");
                        capri.Brain.Ask(instruction, transcript, delegate(string answer)
                        {
                            if (capri == null) return;
                            string summary = String.IsNullOrWhiteSpace(answer) ? "Não consegui resumir automaticamente." : Clean(answer, 1200);
                            bool summaryEnglish = language == "en" || (language == "auto" && IsLikelyEnglish(summary));
                            SpeakChunks((summaryEnglish ? "I received a long audio from " + audioContact + ". Summary: " + summary + " The full transcript is saved in Capri WhatsApp." : "Recebi um áudio longo de " + audioContact + ". Resumo: " + summary + " A transcrição completa está salva e pode ser consultada no Capri WhatsApp."));
                        });
                    }
                    catch { SpeakChunks("Recebi um áudio longo de " + audioContact + ". A transcrição completa está salva; peça para eu resumir quando quiser."); }
                }
                else if (kind == "group_burst")
                {
                    lastSpokenMessage = CurrentLanguage() == "en" ? "The group " + contact + " is busy." : "O grupo " + contact + " está movimentado.";
                    SummarizeGroupAndSpeak(contact);
                }
                else
                {
                    string notificationLanguage = CurrentLanguage();
                    bool english = notificationLanguage == "en" || (notificationLanguage == "auto" && IsLikelyEnglish(preview));
                    string message = kind == "audio" ? (english ? "Audio received from " + contact + ". Transcript: " + preview : "Áudio recebido de " + contact + ". Transcrição: " + preview) : (english ? "Message from " + contact + ": " + preview : "Mensagem de " + contact + ": " + preview);
                    lastSpokenMessage = message;
                    SpeakChunks(message);
                }
                lastId = id; count++;
                try { capri.Store.Set("lastNotificationId", id.ToString(CultureInfo.InvariantCulture)); } catch { }
                if (count >= 4) break;
            }
        }
        catch (Exception ex) { if (capri != null) capri.Log("Falha ao ler notificações do WhatsApp: " + ex.Message); }
    }

    private void SummarizeGroupAndSpeak(string groupName)
    {
        try
        {
            string payload = Request("GET", "/summary?group=" + Uri.EscapeDataString(groupName), null, 12000);
            string language = CurrentLanguage();
            string instruction = language == "en"
                ? "You are the WhatsApp assistant. Summarize the provided group messages in natural English. " +
                  "Cover main topics, decisions, open questions and tasks. Be concise, faithful and do not invent details."
                : (language == "auto"
                    ? "Você é a assistente de WhatsApp. Resuma as mensagens no mesmo idioma predominante do grupo, " +
                      "usando português brasileiro se não estiver claro. Cubra assuntos, decisões, perguntas pendentes e tarefas. " +
                      "Seja breve e fiel; não invente detalhes."
                    : "Você é a assistente de WhatsApp. Resuma em português brasileiro as mensagens do grupo fornecidas. " +
                      "Diga apenas os assuntos principais, decisões, perguntas pendentes e tarefas. " +
                      "Seja breve, fiel e não invente detalhes.");
            capri.Brain.Ask(instruction, payload, delegate(string answer)
            {
                if (capri == null) return;
                string summary = String.IsNullOrWhiteSpace(answer) ? "Não consegui resumir as mensagens automaticamente." : Clean(answer, 1400);
                bool summaryEnglish = language == "en" || (language == "auto" && IsLikelyEnglish(summary));
                lastSpokenMessage = (summaryEnglish ? "Group summary for " : "Resumo do grupo ") + groupName + ": " + summary;
                SpeakChunks(lastSpokenMessage);
            });
        }
        catch (Exception ex)
        {
            capri.Log("Falha ao resumir grupo automaticamente: " + Clean(ex.Message, 300));
            SpeakChunks("O grupo " + groupName + " está movimentado. Peça um resumo quando quiser.");
        }
    }

    private string CurrentLanguage()
    {
        string selected = ReadString(File.Exists(configPath) ? File.ReadAllText(configPath, Encoding.UTF8) : "", "language");
        if (selected == "en" || selected == "auto") return selected;
        return "pt-BR";
    }

    private bool IsEnglishInterface()
    {
        string selected = CurrentLanguage();
        if (selected == "en") return true;
        if (selected == "auto")
        {
            try { return CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase); }
            catch { return false; }
        }
        return false;
    }

    private string UiText(string portuguese, string english)
    {
        return IsEnglishInterface() ? english : portuguese;
    }

    private string FormatStorageStatus(string storage)
    {
        return UiText("Mídia: ", "Media: ") + ReadNumber(storage, "megabytes", "0.00") + " MB; " +
            UiText("arquivos: ", "files: ") + ReadInt(storage, "files", 0).ToString(CultureInfo.InvariantCulture) + "; " +
            UiText("áudios sem transcrição: ", "audio without transcript: ") +
            ReadInt(storage, "pendingWithoutTranscript", 0).ToString(CultureInfo.InvariantCulture);
    }

    private bool IsHelpQuestion(string value)
    {
        string n = RemoveDiacritics(value ?? "").ToLowerInvariant().Trim();
        return n.StartsWith("como ") || n == "como" || n.StartsWith("como?") || n.StartsWith("onde ") ||
            n.StartsWith("me ensina") || n.StartsWith("me explique como") || n.StartsWith("me ajuda") ||
            n.StartsWith("o que eu clico") || n.StartsWith("qual o caminho") || n.StartsWith("qual comando") ||
            n.StartsWith("pode mostrar") || n.StartsWith("me orienta") || n.StartsWith("tem tutorial") ||
            n.StartsWith("voce sabe como") || n.StartsWith("me explica") || n.StartsWith("pode me explicar") ||
            n.StartsWith("how do i") || n.StartsWith("how can i") || n.StartsWith("how to ") ||
            n.StartsWith("how does") || n.StartsWith("how do you") || n.StartsWith("where do i") ||
            n.StartsWith("where can i") || n.StartsWith("show me how") || n.StartsWith("can you show") ||
            n.StartsWith("can you explain") || n.StartsWith("could you explain") || n.StartsWith("i want to know how") ||
            n.StartsWith("what should i click") || n.StartsWith("which menu") || n.StartsWith("what is the way") ||
            n.StartsWith("what's the way") || n == "help" || n.StartsWith("help me") || n.StartsWith("help with");
    }

    private string BuildUsageGuide(string question)
    {
        string n = RemoveDiacritics(question ?? "").ToLowerInvariant();
        bool en = CurrentLanguage() == "en" || (CurrentLanguage() == "auto" && IsLikelyEnglish(question));
        bool listGroups = n.Contains("listar grupo") || n.Contains("lista de grupo") || n.Contains("quais grupo") ||
            n.Contains("mostrar grupo") || n.Contains("meus grupo") || n.Contains("list group") || n.Contains("show group") ||
            n.Contains("see my group") || n.Contains("group list") || n.Contains("find my group") || n.Contains("show me my group");
        if (listGroups)
            return en
                ? "To see your groups, ask me 'list my WhatsApp groups' or open Mainframe > Mods > Capri WhatsApp > Options and use the group selector under 'Capri alerts and priorities'. Click Refresh groups to fetch the current group list. Select a group there before using Mute, Reactivate or Mark as priority."
                : "Para ver seus grupos, peça 'liste meus grupos do WhatsApp' ou abra Mainframe > Mods > Capri WhatsApp > Options e use o seletor de grupos em 'Avisos e prioridades'. Clique em Atualizar grupos para buscar a lista atual. Depois selecione o grupo antes de usar Silenciar, Reativar ou Marcar prioritário.";
        if ((n.Contains("grupo") || n.Contains("group") || n.Contains("conversa")) &&
            (n.Contains("silenc") || n.Contains("mute") || n.Contains("priorit") || n.Contains("aviso") || n.Contains("alert")))
            return en
                ? "To manage Capri alerts for a group: open Mainframe > Mods > Capri WhatsApp > Options. In 'Capri alerts and priorities', select the group from the list, then choose Mute alerts, Reactivate alerts or Mark as priority. Click Refresh groups to update the list. You can also ask me to mute the group that just messaged you. This affects Capri notifications only, not WhatsApp's own mute setting."
                : "Para controlar os avisos da Capri em um grupo: abra Mainframe > Mods > Capri WhatsApp > Options. Em 'Avisos e prioridades', selecione o grupo na lista e escolha Silenciar avisos, Reativar avisos ou Marcar prioritário. Clique em Atualizar grupos para renovar a lista. Você também pode pedir para eu silenciar o grupo que acabou de mandar mensagem. Isso afeta apenas os avisos da Capri, não o silenciamento do WhatsApp.";
        if (n.Contains("busca") || n.Contains("pesquis") || n.Contains("search"))
            return en
                ? "To search WhatsApp history, open Capri WhatsApp options and choose 'Open advanced search'. Fill in any combination of keyword, person, group, subject, start date and end date, then click Search. Leave a field blank to ignore that filter."
                : "Para pesquisar o histórico do WhatsApp, abra as opções do Capri WhatsApp e clique em 'Abrir busca avançada'. Preencha os filtros que quiser: palavra, pessoa, grupo, assunto, data inicial e final. Depois clique em Pesquisar. Deixe em branco os filtros que não quiser usar.";
        if (n.Contains("resum") || n.Contains("summary") || n.Contains("decis") || n.Contains("tarefa") || n.Contains("task"))
            return en
                ? "To get a group summary, ask naturally: 'summarize [group name]', 'summarize the last 24 hours in [group]', 'what happened since the last summary?', or 'list decisions and tasks in [group]'. Ask me to list your groups first if you do not know the exact name."
                : "Para resumir um grupo, peça normalmente: 'resuma [nome do grupo]', 'resuma as últimas 24 horas de [grupo]', 'o que aconteceu desde o último resumo?' ou 'liste decisões e tarefas de [grupo]'. Peça primeiro para eu listar seus grupos caso não saiba o nome exato.";
        if (n.Contains("contat") || n.Contains("agenda") || n.Contains("vcf") || n.Contains("apelid") || n.Contains("contact"))
            return en
                ? "To import phone contacts, export the address book as a .VCF file, open Capri WhatsApp options and click 'Import phone contacts (.VCF)'. To rename a contact only inside Capri, select the contact, enter the display name and click Save name. This does not edit your phone address book."
                : "Para importar a agenda do celular, exporte os contatos em um arquivo .VCF, abra as opções do Capri WhatsApp e clique em 'Importar agenda do celular (.VCF)'. Para mudar apenas o nome usado pela Capri, selecione o contato, digite o nome e clique em Salvar nome. Isso não altera a agenda do celular.";
        if (n.Contains("perfil") || n.Contains("profile") || n.Contains("horario") || n.Contains("schedule") || n.Contains("foco") || n.Contains("focus"))
            return en
                ? "To change notifications, open Capri WhatsApp options and choose Work, Gaming, Presentation or Sleep, then click Apply profile. For automatic switching, enable Schedule automation, choose a profile and set the time range. Focus mode and quiet hours are in the alerts section."
                : "Para mudar as notificações, abra as opções do Capri WhatsApp e escolha Trabalho, Jogando, Apresentação ou Dormindo; depois clique em Aplicar perfil. Para alternar automaticamente, ative a Automação por horário, escolha o perfil e informe o intervalo. Modo foco e horário de silêncio ficam na seção de avisos.";
        if (n.Contains("backup") || n.Contains("restaur") || n.Contains("export"))
            return en
                ? "To back up settings, open Capri WhatsApp options and click Export backup. To restore them, click Restore backup and select the JSON file. Backups include preferences and aliases only, never the WhatsApp session, credentials or message history."
                : "Para salvar as configurações, abra as opções do Capri WhatsApp e clique em Exportar backup. Para recuperar, clique em Restaurar backup e escolha o arquivo JSON. O backup inclui preferências e apelidos, nunca a sessão do WhatsApp, credenciais ou histórico de mensagens.";
        if (n.Contains("armazen") || n.Contains("limp") || n.Contains("storage") || n.Contains("clean"))
            return en
                ? "To manage storage, open Capri WhatsApp options and go to Storage and cleanup. Set audio retention and the storage limit, then click Save limits. Automatic cleanup is optional and removes only audio files that already have transcripts. Clean now asks for confirmation; messages, transcripts and the WhatsApp session are preserved."
                : "Para gerenciar o espaço, abra as opções do Capri WhatsApp e vá até Armazenamento e limpeza. Ajuste o prazo de retenção dos áudios e o limite de espaço; depois clique em Salvar limites. A limpeza automática é opcional e remove somente áudios já transcritos. Limpar agora pede confirmação; mensagens, transcrições e sessão do WhatsApp são preservadas.";
        if (n.Contains("diagnost") || n.Contains("health") || n.Contains("status"))
            return en
                ? "To check whether everything is working, open Capri WhatsApp options and click Open full diagnostics. The page shows WhatsApp connection, Node.js, Baileys, Whisper, model, FFmpeg, pending audio and storage. It does not display session credentials or message contents."
                : "Para verificar se está tudo funcionando, abra as opções do Capri WhatsApp e clique em Abrir diagnóstico completo. A página mostra conexão do WhatsApp, Node.js, Baileys, Whisper, modelo, FFmpeg, áudios pendentes e armazenamento. Ela não exibe credenciais da sessão nem o conteúdo das mensagens.";
        if (n.Contains("qr") || n.Contains("conect") || n.Contains("connect") || n.Contains("parear") || n.Contains("pair"))
            return en
                ? "To connect WhatsApp, open Capri WhatsApp options and keep the QR code visible. On your phone, open WhatsApp > Linked devices > Link a device and scan it. If no code appears, click Connect / try again. This personal-account connection uses an unofficial linked-device protocol."
                : "Para conectar o WhatsApp, abra as opções do Capri WhatsApp e deixe o QR Code visível. No celular, entre em WhatsApp > Aparelhos conectados > Conectar aparelho e escaneie o código. Se não aparecer, clique em Conectar / tentar novamente. A conexão de conta pessoal usa um protocolo não oficial de dispositivo vinculado.";
        if (n.Contains("respost") || n.Contains("enviar") || n.Contains("send") || n.Contains("reply") || n.Contains("mensagem"))
            return en
                ? "To let Capri prepare a written reply, enable Allow Capri to prepare written replies in Capri WhatsApp options. Ask her explicitly to draft a reply. She must show the full recipient and message, and you must approve before anything is sent. Automatic sending is not available."
                : "Para permitir que a Capri prepare uma resposta escrita, ative Permitir que a Capri prepare respostas escritas nas opções do Capri WhatsApp. Peça expressamente para ela preparar a resposta. A Capri precisa mostrar o destinatário e o texto completos, e você deve aprovar antes do envio. Não existe envio automático.";
        return en
            ? "You can ask me how to use any Capri WhatsApp feature in plain English. I can guide you through QR pairing, contacts and VCF import, group alerts, group lists, advanced search, summaries, notification profiles, backups, storage cleanup, diagnostics and confirmed written replies. Open Mainframe > Mods > Capri WhatsApp > Options for the visual controls."
            : "Pode me perguntar em português como usar qualquer recurso do Capri WhatsApp. Posso orientar sobre QR Code, contatos e VCF, avisos e lista de grupos, busca avançada, resumos, perfis de notificação, backups, limpeza de armazenamento, diagnóstico e respostas escritas com confirmação. Para os controles visuais, abra Mainframe > Mods > Capri WhatsApp > Options.";
    }

    private bool IsLikelyEnglish(string text)
    {
        string n = " " + RemoveDiacritics((text ?? "").ToLowerInvariant()) + " ";
        string[] en = new string[] { " the ", " and ", " you ", " your ", " are ", " is ", " was ", " have ", " with ", " this ", " that ", " what ", " when ", " where ", " how ", " do ", " can ", " will ", " mute ", " please ", " don't ", " thanks ", " hello " };
        string[] pt = new string[] { " que ", " para ", " voce ", " nao ", " uma ", " com ", " eu ", " ele ", " ela ", " esta ", " por ", " porque ", " obrigado ", " obrigada ", " oi " };
        int english = 0; int portuguese = 0;
        for (int i = 0; i < en.Length; i++) if (n.Contains(en[i])) english++;
        for (int i = 0; i < pt.Length; i++) if (n.Contains(pt[i])) portuguese++;
        return english >= 2 && english > portuguese;
    }

    private void SpeakChunks(string text)
    {
        if (capri == null || String.IsNullOrWhiteSpace(text)) return;
        const int limit = 450; int offset = 0;
        while (offset < text.Length)
        {
            int length = Math.Min(limit, text.Length - offset); int end = offset + length;
            if (end < text.Length)
            {
                int split = text.LastIndexOf(' ', end - 1, length);
                if (split > offset + 100) length = split - offset;
            }
            if (length <= 0) length = Math.Min(limit, text.Length - offset);
            capri.Say(text.Substring(offset, length).Trim()); offset += length;
            while (offset < text.Length && Char.IsWhiteSpace(text[offset])) offset++;
        }
    }

    private void RegisterBrainTools()
    {
        capri.Brain.AddTool("whatsapp_status", "Consulta o estado da integração e responde dúvidas de como usar qualquer recurso do Capri WhatsApp. Se o usuário perguntar como fazer algo, explique passo a passo no idioma escolhido; não altere configurações quando ele apenas pedir instruções. Cobre conexão, contatos, grupos, busca, resumos, perfis, backups, armazenamento e diagnóstico. Português/English.", "pergunta ou status", delegate(string input) { return ToolStatus(input); });
        capri.Brain.AddTool("whatsapp_consultar",
            "Consulta conversas e faz busca avançada por termo, pessoa, grupo, assunto e período; também lista grupos. " +
            "Para dúvidas sobre pesquisa, grupos ou reprocessamento de áudio, explique sem executar ação não solicitada. " +
            "JSON: {\"q\":\"palavra\",\"person\":\"nome\",\"group\":\"grupo\",\"subject\":\"assunto\",\"from\":\"2026-01-01\",\"to\":\"2026-01-31\"}. " +
            "Também aceita chats, mensagens: NOME, buscar: TERMO, áudios: NOME e reprocessar áudios. Portuguese/English.",
            "filtros ou texto", delegate(string input) { return ToolQuery(input); });
        capri.Brain.AddTool("whatsapp_resumo_grupo", "Resume um grupo usando últimas 80 mensagens (padrão), últimas 24 horas, desde o último resumo ou decisões e tarefas. Também explica como pedir esses resumos quando o usuário fizer uma pergunta de ajuda. Entrada JSON {\"group\":\"nome exato\",\"scope\":\"24h|since_last|decisions_tasks|recent\"} ou texto NOME | 24h / desde último / decisões e tarefas. Seja fiel, identifique responsáveis e pendências sem inventar.", "grupo e período", delegate(string input) { return ToolSummary(input); });
        capri.Brain.AddTool("whatsapp_preferencias",
            "Gerencia avisos da Capri (não altera o silenciamento do WhatsApp), contatos/grupos prioritários, foco e horários. " +
            "Reconhece o grupo mais recente por ‘silencie o grupo que acabou de mandar mensagem’ ou ‘mute the group that just messaged me’. " +
            "Aceita nome/JID, seleção no Mainframe, listagem de grupos e JSON com action/target/kind.",
            "comando ou JSON", delegate(string input) { return ToolPreferences(input); });
        capri.Brain.AddTool("whatsapp_apelido", "Altera o nome que a Capri usa para um contato, sem mudar a agenda do celular. Entrada JSON: {\"target\":\"__LAST_SENDER__\",\"alias\":\"nome novo\"} para a última pessoa que enviou mensagem, ou {\"contato\":\"nome\",\"apelido\":\"nome novo\"}. Use também contato=...; apelido=... . Só diga que salvou quando o retorno confirmar ok=true.", "contato e apelido", delegate(string input) { return ToolAlias(input); });
        capri.Brain.AddTool("whatsapp_preparar_envio", "Prepara uma mensagem escrita sem enviar. Entrada JSON {\"destinatario\":\"nome exato\",\"mensagem\":\"texto\",\"capriReply\":true} para resposta como Capri (somente se ativada no Mainframe e solicitada expressamente). A resposta precisa identificar Capri como assistente de IA. Sempre mostre destinatário e mensagem completos e peça aprovação humana; nunca envie nesta etapa.", "JSON destinatário/mensagem", delegate(string input) { return ToolPrepareSend(input); });
        capri.Brain.AddTool("whatsapp_confirmar_envio", "Confirma ou cancela um envio previamente preparado. Entrada JSON {\"approvalId\":\"código\",\"approved\":true/false}. Só usar após a última fala/texto recebido ser uma aprovação afirmativa isolada (por exemplo, SIM/YES ou “Capri, SIM” por voz), depois da prévia completa. Não aceite aprovação antiga nem frases que apenas contenham sim/yes.", "código e aprovação", delegate(string input) { return ToolConfirmSend(input); });
        capri.Brain.AddTool("whatsapp_backup", "Exporta ou restaura somente preferências, contatos prioritários, horários, silenciamentos e apelidos. Nunca inclui sessão, credenciais ou histórico de mensagens. Use exportar/export ou importar seguido do JSON.", "exportar ou importar JSON", delegate(string input) { return ToolBackup(input); });
    }

    private string ToolStatus(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        try { return Request("GET", "/health", null, 6000); }
        catch (Exception ex) { return UiText("O Capri WhatsApp ainda está preparando a conexão. ", "Capri WhatsApp is still preparing the connection. ") + Clean(ex.Message, 300); }
    }

    private string FormatGroupListForBrain(string rawRows)
    {
        StringBuilder output = new StringBuilder();
        string[] rows = (rawRows ?? "").Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        int count = 0;
        for (int i = 0; i < rows.Length; i++)
        {
            string[] fields = rows[i].Split('\t');
            if (fields.Length < 4) continue;
            string jid = DecodeContactField(fields[0]);
            string name = DecodeContactField(fields[1]);
            if (String.IsNullOrEmpty(jid)) continue;
            count++;
            if (output.Length > 0) output.AppendLine();
            output.Append(count.ToString(CultureInfo.InvariantCulture)).Append(". ")
                .Append(String.IsNullOrEmpty(name) ? UiText("Grupo sem nome", "Unnamed group") : name);
            if (DecodeContactField(fields[2]) == "1") output.Append(UiText(" — silenciado", " — muted"));
            if (DecodeContactField(fields[3]) == "1") output.Append(UiText(" — prioritário", " — priority"));
        }
        if (count == 0)
            return UiText("Não encontrei grupos. Verifique se o WhatsApp está conectado e tente atualizar a lista.",
                "No groups were found. Check that WhatsApp is connected and refresh the group list.");
        return UiText("Grupos disponíveis (" + count.ToString(CultureInfo.InvariantCulture) + "):\r\n",
            "Available groups (" + count.ToString(CultureInfo.InvariantCulture) + "):\r\n") + output.ToString();
    }

    private string ToolQuery(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        string value = (input ?? "").Trim(); string lower = RemoveDiacritics(value).ToLowerInvariant(); string route;
        bool reprocess = lower.Contains("reprocess") || lower.Contains("reproces") || lower.Contains("recuperar audio") ||
            lower.Contains("recuperar transcri") || lower.Contains("tentar novamente a transcri") || lower.Contains("retry transcription");
        if (reprocess)
        {
            try { return Request("POST", "/audios/reprocess", "{\"includeFailed\":true}", 8000); }
            catch (Exception ex) { return UiText("Não consegui iniciar a recuperação das transcrições: ", "Could not start transcription recovery: ") + Clean(ex.Message, 300); }
        }
        if (value.StartsWith("{"))
        {
            string q = ReadString(value, "q"); string person = ReadString(value, "person");
            string group = ReadString(value, "group"); string subject = ReadString(value, "subject");
            string from = ReadString(value, "from"); string to = ReadString(value, "to");
            route = BuildSearchRoute(q, person, group, subject, from, to);
        }
        else if (lower.Contains("listar grupos") || lower.Contains("listar os grupos") || lower.Contains("lista de grupos") || lower.Contains("quais grupos") || lower == "grupos" || lower == "groups" || lower.Contains("mostrar grupos") || lower.Contains("meus grupos") || lower.Contains("list groups") || lower.Contains("show groups"))
            route = "/groups/list?refresh=1";
        else if (lower.StartsWith("buscar:") || lower.StartsWith("search:"))
            route = BuildSearchRoute(value.Substring(value.IndexOf(':') + 1).Trim(), "", "", "", "", "");
        else if (lower.StartsWith("áudios:") || lower.StartsWith("audios:") || lower.StartsWith("audio:")) route = "/audios?contact=" + Uri.EscapeDataString(value.Substring(value.IndexOf(':') + 1).Trim());
        else if (lower.StartsWith("mensagens:") || lower.StartsWith("messages:")) route = "/messages?contact=" + Uri.EscapeDataString(value.Substring(value.IndexOf(':') + 1).Trim()) + "&limit=40";
        else route = "/chats?limit=30";
        try
        {
            string response = Request("GET", route, null, 12000);
            if (route.StartsWith("/groups/list", StringComparison.Ordinal)) return FormatGroupListForBrain(response);
            return response;
        }
        catch (Exception ex) { return UiText("Não consegui consultar o WhatsApp: ", "Could not query WhatsApp: ") + Clean(ex.Message, 300); }
    }

    private string BuildSearchRoute(string q, string person, string group, string subject, string from, string to)
    {
        StringBuilder route = new StringBuilder("/search?");
        bool added = false;
        Action<string, string> add = delegate(string key, string value)
        {
            if (String.IsNullOrWhiteSpace(value)) return;
            if (added) route.Append("&");
            route.Append(key).Append("=").Append(Uri.EscapeDataString(value.Trim())); added = true;
        };
        add("q", q); add("person", person); add("group", group); add("subject", subject); add("from", from); add("to", to);
        return route.ToString();
    }

    private string ToolSummary(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        string value = (input ?? "").Trim(); string group = value; string scope = "recent";
        if (value.StartsWith("{"))
        {
            group = ReadString(value, "group"); scope = ReadString(value, "scope");
        }
        else
        {
            int split = value.IndexOf('|');
            if (split >= 0) { group = value.Substring(0, split).Trim(); string mode = RemoveDiacritics(value.Substring(split + 1)).ToLowerInvariant();
                if (mode.Contains("24")) scope = "24h";
                else if (mode.Contains("ultimo") || mode.Contains("last")) scope = "since_last";
                else if (mode.Contains("decis") || mode.Contains("tarefa") || mode.Contains("task")) scope = "decisions_tasks";
            }
            else
            {
                string mode = RemoveDiacritics(value).ToLowerInvariant();
                if (mode.Contains("ultimas 24") || mode.Contains("last 24")) scope = "24h";
                else if (mode.Contains("desde o ultimo") || mode.Contains("since last")) scope = "since_last";
                else if (mode.Contains("decis") || mode.Contains("tarefas") || mode.Contains("tasks")) scope = "decisions_tasks";
                string[] prefixes = new string[] { "resumir grupo ", "resumo do grupo ", "resumo grupo ", "grupo: ", "grupo:" };
                for (int i = 0; i < prefixes.Length; i++) if (mode.StartsWith(prefixes[i])) { group = value.Substring(prefixes[i].Length).Trim(); break; }
            }
        }
        if (scope == "decisions_tasks")
        {
            // Os dados retornados são mensagens; o cérebro deve separar decisões, responsáveis e tarefas pendentes.
        }
        try { return Request("GET", "/summary?group=" + Uri.EscapeDataString(group) + "&scope=" + Uri.EscapeDataString(scope), null, 15000); }
        catch (Exception ex) { return UiText("Não consegui obter as mensagens do grupo: ", "Could not retrieve group messages: ") + Clean(ex.Message, 300); }
    }

    private string ToolPreferences(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        string normalized = RemoveDiacritics(input ?? "").ToLowerInvariant();
        try
        {
            if (normalized.Contains("listar grupos") || normalized.Contains("listar os grupos") || normalized.Contains("lista de grupos") || normalized.Contains("quais grupos") || normalized == "grupos" || normalized == "groups" || normalized.Contains("mostrar grupos") || normalized.Contains("meus grupos") || normalized.Contains("list groups") || normalized.Contains("show groups"))
                return FormatGroupListForBrain(Request("GET", "/groups/list?refresh=1", null, 15000));
            string body = BuildPreferenceBody(input);
            return Request("POST", "/preferences", body, 10000);
        }
        catch (Exception ex) { return UiText("Não consegui salvar essa preferência: ", "Could not save this preference: ") + Clean(ex.Message, 350); }
    }

    private string BuildPreferenceBody(string input)
    {
        string value = (input ?? "").Trim();
        if (value.StartsWith("{")) return value;
        string n = RemoveDiacritics(value).ToLowerInvariant().Trim();
        if (n == "listar" || n == "list" || n.Contains("minhas preferencias") || n.Contains("my preferences")) return "{\"action\":\"list\"}";
        if (n.Contains("desativar foco") || n.Contains("sair do foco") || n.Contains("focus off") || n.Contains("turn off focus")) return "{\"action\":\"focus\",\"enabled\":false}";
        if (n.Contains("ativar foco") || n.Contains("modo foco") || n.Contains("focus on") || n.Contains("turn on focus")) return "{\"action\":\"focus\",\"enabled\":true}";
        if (n == "silencio off" || n == "quiet hours off" || n == "turn off quiet hours") return "{\"action\":\"quiet_hours\",\"enabled\":false}";

        string action = "";
        if (n.StartsWith("dessilenciar ") || n.StartsWith("reativar ") || n.StartsWith("reative ") || n.StartsWith("unmute ") || n.StartsWith("stop muting ") || n.StartsWith("turn off mute for ")) action = "unmute";
        else if (n.StartsWith("prioridade ") || n.StartsWith("prioritize ") || n.StartsWith("priority ") || n.StartsWith("marcar como prioritario ") || n.StartsWith("mark as priority ") || n.StartsWith("mark ") || n.StartsWith("set ") || n.StartsWith("coloque ") || n.StartsWith("marque ")) action = "priority";
        else if (n.StartsWith("silenciar ") || n.StartsWith("silencie ") || n.StartsWith("mute ") || n.StartsWith("never notify me about ") || n.StartsWith("nunca mais me avise sobre ") || n.StartsWith("nao me avise sobre ") || n.StartsWith("don't notify me about ")) action = "mute";

        if (!String.IsNullOrEmpty(action))
        {
            string[] prefixes = new string[] {
                "nunca mais me avise sobre mensagens do grupo ", "nunca mais me avise sobre mensagens do contato ",
                "never notify me about messages from the group ", "never notify me about messages from group ",
                "never notify me about messages from the contact ", "never notify me about messages from contact ", "never notify me about messages from ",
                "don't notify me about the group ", "don't notify me about the contact ", "don't notify me about messages from ",
                "nao me avise sobre mensagens do grupo ", "nao me avise sobre mensagens do contato ",
                "silenciar permanentemente o grupo ", "silenciar para sempre o grupo ",
                "silencie permanentemente o grupo ", "silencie para sempre o grupo ",
                "silenciar permanentemente o contato ", "silenciar para sempre o contato ",
                "silencie permanentemente o contato ", "silencie para sempre o contato ", "silencie esse grupo ", "silencie este grupo ", "silencie esse contato ", "silencie este contato ",
                "mute this group forever ", "mute group forever ", "mute group ", "silenciar grupo ",
                "mute this contact forever ", "mute contact forever ", "mute contact ", "silenciar contato ",
                "reative as mensagens do grupo ", "reative as mensagens do contato ", "reativar as mensagens do grupo ", "reativar as mensagens do contato ",
                "reative grupo ", "reative contato ", "reativar grupo ", "reativar contato ",
                "dessilenciar grupo ", "dessilenciar contato ", "unmute the group ", "unmute the contact ",
                "unmute group ", "unmute contact ", "stop muting group ", "stop muting contact ", "turn off mute for ",
                "prioridade grupo ", "prioridade contato ", "prioritize group ", "prioritize contact ",
                "priority group ", "priority contact ", "marcar como prioritario ", "mark as priority ", "mark ",
                "coloque como prioritario o contato ", "coloque como prioritario o grupo ", "coloque como prioritario ",
                "marque como prioritario o contato ", "marque como prioritario o grupo ", "marque como prioritario ",
                "set priority for contact ", "set priority for group ", "set priority for ", "set ",
                "nunca mais me avise sobre ", "never notify me about ", "nao me avise sobre ",
                "don't notify me about ", "silenciar para sempre ", "silenciar permanentemente ",
                "silencie para sempre ", "silencie permanentemente ", "silenciar ", "silencie ",
                "dessilenciar ", "reativar as mensagens do ", "reative as mensagens do ", "reativar ", "reative ",
                "unmute ", "stop muting ", "prioridade ", "prioritize ", "priority ", "coloque ", "marque ", "mark ", "set ", "mute "
            };
            string matched = "";
            for (int i = 0; i < prefixes.Length; i++)
            {
                if (n.StartsWith(prefixes[i], StringComparison.Ordinal)) { matched = prefixes[i]; break; }
            }
            string target = matched.Length > 0 && value.Length >= matched.Length ? value.Substring(matched.Length).Trim() : "";
            bool group = n.Contains("grupo") || n.Contains(" group ") || n.StartsWith("group ") || n.Contains("do grupo") || n.Contains("from group");
            string targetNormalized = RemoveDiacritics(target).ToLowerInvariant();
            bool latestGroup = targetNormalized.Contains("grupo que acabou de mandar mensagem") || targetNormalized.Contains("grupo que acabou de mandar a mensagem") ||
                targetNormalized.Contains("grupo que acabou de me mandar mensagem") || targetNormalized.Contains("grupo que acabou de me mandar a mensagem") ||
                targetNormalized.Contains("grupo que acabou de enviar mensagem") ||
                targetNormalized.Contains("grupo que enviou a ultima mensagem") ||
                targetNormalized.Contains("grupo que me enviou a ultima mensagem") || targetNormalized.Contains("grupo que me mandou mensagem") ||
                targetNormalized.Contains("grupo da ultima mensagem") || targetNormalized.Contains("grupo mais recente") || targetNormalized.Contains("ultimo grupo") ||
                targetNormalized.Contains("last group that messaged") || targetNormalized.Contains("group that just messaged") ||
                targetNormalized.Contains("group that just sent a message");
            if (latestGroup) { group = true; target = "__LAST_GROUP__"; }
            if (target.StartsWith("o grupo ", StringComparison.OrdinalIgnoreCase)) { group = true; target = target.Substring(8).Trim(); }
            else if (target.StartsWith("grupo ", StringComparison.OrdinalIgnoreCase)) { group = true; target = target.Substring(6).Trim(); }
            else if (target.StartsWith("the group ", StringComparison.OrdinalIgnoreCase)) { group = true; target = target.Substring(10).Trim(); }
            else if (target.StartsWith("group ", StringComparison.OrdinalIgnoreCase)) { group = true; target = target.Substring(6).Trim(); }
            else if (target.StartsWith("o contato ", StringComparison.OrdinalIgnoreCase)) target = target.Substring(10).Trim();
            else if (target.StartsWith("contato ", StringComparison.OrdinalIgnoreCase)) target = target.Substring(8).Trim();
            else if (target.StartsWith("the contact ", StringComparison.OrdinalIgnoreCase)) target = target.Substring(12).Trim();
            else if (target.StartsWith("contact ", StringComparison.OrdinalIgnoreCase)) target = target.Substring(8).Trim();
            target = target.Trim().TrimEnd('.', '!', '?', ';', ',');
            string[] suffixes = new string[] { " como contato prioritario", " como contato prioritário", " como grupo prioritario", " como grupo prioritário", " as contact priority", " as priority contact", " como prioritario", " como prioritário", " como prioridade", " para sempre", " permanentemente", " forever" };
            for (int i = 0; i < suffixes.Length; i++)
            {
                if (target.EndsWith(suffixes[i], StringComparison.OrdinalIgnoreCase)) { target = target.Substring(0, target.Length - suffixes[i].Length).Trim(); break; }
            }
            if (target.Length > 0)
            {
                string body = "{\"action\":\"" + action + "\",\"kind\":\"" + (group ? "group" : "contact") + "\",\"target\":\"" + JsonEscape(target) + "\"";
                if (action == "priority") body += ",\"enabled\":true";
                return body + "}";
            }
        }
        if (n.StartsWith("horario ") || n.StartsWith("quiet hours "))
        {
            int pos = n.StartsWith("quiet hours ") ? 12 : 8;
            string range = value.Substring(Math.Min(pos, value.Length)).Trim().Replace(" a ", "-").Replace(" to ", "-");
            string[] times = range.Split('-');
            if (times.Length == 2) return "{\"action\":\"quiet_hours\",\"enabled\":true,\"start\":\"" + JsonEscape(times[0].Trim()) + "\",\"end\":\"" + JsonEscape(times[1].Trim()) + "\"}";
        }
        return "{\"action\":\"list\"}";
    }

    private string ToolAlias(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        string value = (input ?? "").Trim(); string body = value;
        if (!value.StartsWith("{"))
        {
            string contact = GetPairValue(value, "contato", "contact");
            if (String.IsNullOrEmpty(contact)) contact = GetPairValue(value, "target", "destino");
            string alias = GetPairValue(value, "apelido", "alias");
            string normalized = RemoveDiacritics(contact).ToLowerInvariant();
            if (normalized == "ultima pessoa" || normalized == "ultimo contato" || normalized == "last sender" || normalized == "last person") contact = "__LAST_SENDER__";
            body = "{\"target\":\"" + JsonEscape(contact) + "\",\"alias\":\"" + JsonEscape(alias) + "\"}";
        }
        try { return Request("POST", "/contacts/alias", body, 8000); }
        catch (Exception ex) { return UiText("Não consegui salvar o nome na Capri: ", "Could not save the name in Capri: ") + Clean(ex.Message, 300); }
    }

    private string ToolPrepareSend(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        string value = (input ?? "").Trim(); string body = value;
        if (!value.StartsWith("{"))
        {
            int colon = value.IndexOf(':'); int to = value.IndexOf(" para ", StringComparison.OrdinalIgnoreCase);
            if (to >= 0 && colon > to) body = "{\"destinatario\":\"" + JsonEscape(value.Substring(to + 6, colon - to - 6).Trim()) + "\",\"mensagem\":\"" + JsonEscape(value.Substring(colon + 1).Trim()) + "\"}";
        }
        try { return Request("POST", "/send/prepare", body, 10000); }
        catch (Exception ex) { return UiText("Não consegui preparar o envio: ", "Could not prepare the message: ") + Clean(ex.Message, 300); }
    }

    private bool HasExplicitSendApproval()
    {
        // Use only the most recent line delivered to Heard by Capri. This prevents
        // an older "yes" from remaining valid after a different request.
        string normalized = RemoveDiacritics(lastUserUtterance ?? "").ToLowerInvariant().Trim();
        normalized = normalized.Trim(' ', '.', ',', '!', '?', ';', ':');
        string[] wakePrefixes = new string[] { "hey capri", "hi capri", "capri" };
        for (int p = 0; p < wakePrefixes.Length; p++)
        {
            string prefix = wakePrefixes[p];
            if (!normalized.StartsWith(prefix, StringComparison.Ordinal)) continue;
            if (normalized.Length == prefix.Length || !Char.IsLetterOrDigit(normalized[prefix.Length]))
            {
                normalized = normalized.Substring(prefix.Length).Trim(' ', '.', ',', '!', '?', ';', ':');
                break;
            }
        }

        // Exact affirmative phrases only. A sentence that merely contains
        // "sim/yes" is not a confirmation of the previewed recipient and text.
        string[] approvals = new string[] {
            "sim", "sim pode enviar", "sim pode mandar", "sim pode enviar agora", "sim pode mandar agora",
            "pode enviar", "pode mandar", "pode enviar agora", "pode mandar agora", "envia agora", "manda agora",
            "confirmo", "confirmar envio", "autorizo", "autorizo o envio", "pode confirmar",
            "yes", "yes send", "yes send it", "yes please send", "send it", "send now",
            "go ahead", "i approve", "approved", "confirmed", "confirm send"
        };
        for (int i = 0; i < approvals.Length; i++)
            if (normalized == approvals[i]) return true;
        return false;
    }

    private string ToolConfirmSend(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        string value = (input ?? "").Trim(); string body = value;
        bool approved = value.StartsWith("{") && ReadBool(value, "approved");
        if (!value.StartsWith("{"))
        {
            string[] parts = value.Split(new char[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
            bool yes = parts.Length > 1 && (parts[0].Equals("sim", StringComparison.OrdinalIgnoreCase) || parts[0].Equals("yes", StringComparison.OrdinalIgnoreCase));
            bool no = parts.Length > 1 && (parts[0].Equals("não", StringComparison.OrdinalIgnoreCase) || parts[0].Equals("nao", StringComparison.OrdinalIgnoreCase) || parts[0].Equals("no", StringComparison.OrdinalIgnoreCase));
            if (parts.Length > 1 && (yes || no)) body = "{\"approvalId\":\"" + JsonEscape(parts[1]) + "\",\"approved\":" + (yes ? "true" : "false") + "}";
            approved = yes;
        }
        if (approved && !HasExplicitSendApproval())
            return UiText("Ainda preciso de um SIM explícito seu depois de mostrar o destinatário e a mensagem completos. Nada foi enviado.",
                "I still need your explicit YES after showing the full recipient and message. Nothing was sent.");
        try { return Request("POST", "/send/decision", body, 12000); }
        catch (Exception ex) { return UiText("Não consegui confirmar o envio: ", "Could not confirm the message: ") + Clean(ex.Message, 300); }
    }

    private string ToolBackup(string input)
    {
        if (IsHelpQuestion(input)) return BuildUsageGuide(input);
        string value = (input ?? "").Trim();
        try
        {
            if (value.StartsWith("importar ", StringComparison.OrdinalIgnoreCase) || value.StartsWith("import ", StringComparison.OrdinalIgnoreCase))
            {
                int pos = value.IndexOf(' '); string json = value.Substring(pos + 1).Trim();
                return Request("POST", "/backup/import", json, 10000);
            }
            return Request("GET", "/backup/export", null, 10000);
        }
        catch (Exception ex) { return UiText("Não consegui processar o backup: ", "Could not process the backup: ") + Clean(ex.Message, 300); }
    }

    private string GetPairValue(string text, string pt, string en)
    {
        string[] parts = text.Split(';');
        for (int i = 0; i < parts.Length; i++)
        {
            int eq = parts[i].IndexOf('='); if (eq < 0) continue;
            string key = parts[i].Substring(0, eq).Trim().ToLowerInvariant();
            if (key == pt || key == en) return parts[i].Substring(eq + 1).Trim();
        }
        return "";
    }

    private bool ReadBool(string json, string key)
    {
        string marker = "\"" + key + "\"";
        int i = (json ?? "").IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return false;
        int colon = json.IndexOf(':', i + marker.Length);
        return colon >= 0 && json.Substring(colon + 1).TrimStart().StartsWith("true", StringComparison.OrdinalIgnoreCase);
    }

    private string ReadStringInObject(string json, string parent, string key)
    {
        string marker = "\"" + parent + "\"";
        int i = (json ?? "").IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return "";
        return ReadString(json.Substring(i + marker.Length), key);
    }

    private bool ReadBoolInObject(string json, string parent, string key)
    {
        string marker = "\"" + parent + "\"";
        int i = (json ?? "").IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return false;
        return ReadBool(json.Substring(i + marker.Length), key);
    }

    private string DecodeVCardValue(string value, bool quotedPrintable)
    {
        string decoded = value ?? "";
        if (quotedPrintable)
        {
            List<byte> bytes = new List<byte>();
            for (int i = 0; i < decoded.Length; i++)
            {
                if (decoded[i] == '=' && i + 2 < decoded.Length)
                {
                    int hex;
                    if (Int32.TryParse(decoded.Substring(i + 1, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out hex))
                    { bytes.Add((byte)hex); i += 2; continue; }
                }
                bytes.AddRange(Encoding.UTF8.GetBytes(decoded[i].ToString()));
            }
            decoded = Encoding.UTF8.GetString(bytes.ToArray());
        }
        decoded = decoded.Replace("\\n", " ").Replace("\\N", " ").Replace("\\,", ",").Replace("\\;", ";").Replace("\\\\", "\\");
        return decoded.Trim();
    }

    private List<KeyValuePair<string, string>> ReadVCardContacts(string file)
    {
        if (!File.Exists(file)) throw new Exception("Arquivo VCF não encontrado.");
        FileInfo info = new FileInfo(file);
        if (info.Length > 20 * 1024 * 1024) throw new Exception("O arquivo VCF excede 20 MB.");
        string raw = File.ReadAllText(file, Encoding.UTF8);
        string[] physical = raw.Replace("\r\n", "\n").Replace("\r", "\n").Split('\n');
        List<string> lines = new List<string>();
        for (int i = 0; i < physical.Length; i++)
        {
            string line = physical[i];
            if (line.Length == 0) continue;
            if (lines.Count > 0 && lines[lines.Count - 1].EndsWith("="))
            {
                lines[lines.Count - 1] = lines[lines.Count - 1].Substring(0, lines[lines.Count - 1].Length - 1) + line.TrimStart();
            }
            else if (line.StartsWith(" ") || line.StartsWith("\t"))
            {
                if (lines.Count > 0) lines[lines.Count - 1] += line.Substring(1);
            }
            else lines.Add(line);
        }
        List<KeyValuePair<string, string>> result = new List<KeyValuePair<string, string>>();
        string name = ""; string structuredName = ""; List<string> phones = new List<string>();
        Action save = delegate
        {
            string finalName = name;
            if (String.IsNullOrWhiteSpace(finalName) && !String.IsNullOrWhiteSpace(structuredName))
            {
                string[] parts = structuredName.Split(';');
                List<string> bits = new List<string>();
                if (parts.Length > 1 && !String.IsNullOrWhiteSpace(parts[1])) bits.Add(parts[1]);
                if (parts.Length > 0 && !String.IsNullOrWhiteSpace(parts[0])) bits.Add(parts[0]);
                finalName = String.Join(" ", bits.ToArray());
            }
            finalName = Clean(finalName, 100);
            for (int j = 0; j < phones.Count; j++)
            {
                string digitsOnly = "";
                for (int k = 0; k < phones[j].Length; k++) if (Char.IsDigit(phones[j][k])) digitsOnly += phones[j][k];
                if (!String.IsNullOrWhiteSpace(finalName) && digitsOnly.Length >= 8 && digitsOnly.Length <= 15)
                    result.Add(new KeyValuePair<string, string>(finalName, digitsOnly));
            }
            name = ""; structuredName = ""; phones.Clear();
        };
        for (int i = 0; i < lines.Count; i++)
        {
            string line = lines[i];
            if (line.Equals("BEGIN:VCARD", StringComparison.OrdinalIgnoreCase)) { name = ""; structuredName = ""; phones.Clear(); continue; }
            if (line.Equals("END:VCARD", StringComparison.OrdinalIgnoreCase)) { save(); continue; }
            int colon = line.IndexOf(':'); if (colon < 0) continue;
            string property = line.Substring(0, colon); string value = line.Substring(colon + 1);
            string propName = property.Split(';')[0].ToUpperInvariant();
            bool qp = property.IndexOf("QUOTED-PRINTABLE", StringComparison.OrdinalIgnoreCase) >= 0;
            if (propName == "FN") name = DecodeVCardValue(value, qp);
            else if (propName == "N") structuredName = DecodeVCardValue(value, qp);
            else if (propName == "TEL") phones.Add(DecodeVCardValue(value, qp));
        }
        if (phones.Count > 0) save();
        return result;
    }

    private string ImportVCardFile(string file)
    {
        List<KeyValuePair<string, string>> contacts = ReadVCardContacts(file);
        if (contacts.Count == 0) throw new Exception(UiText("Não encontrei contatos com nome e telefone válidos no VCF.", "No VCF contacts with a valid name and phone number were found."));
        int imported = 0; int matched = 0;
        for (int start = 0; start < contacts.Count; start += 100)
        {
            int end = Math.Min(contacts.Count, start + 100); StringBuilder body = new StringBuilder("{\"contacts\":[");
            for (int i = start; i < end; i++)
            {
                if (i > start) body.Append(",");
                body.Append("{\"name\":\"").Append(JsonEscape(contacts[i].Key)).Append("\",\"phone\":\"").Append(JsonEscape(contacts[i].Value)).Append("\"}");
            }
            body.Append("]}");
            string response = Request("POST", "/contacts/import-vcf", body.ToString(), 15000);
            imported += ReadInt(response, "imported", 0); matched += ReadInt(response, "matchedMessages", 0);
        }
        return UiText("Agenda importada: ", "Address book imported: ") + imported.ToString(CultureInfo.InvariantCulture) + UiText(" telefone(s) válidos; ", " valid phone number(s); ") + matched.ToString(CultureInfo.InvariantCulture) + UiText(" mensagens/participantes receberam nome por correspondência de número. Nenhum contato foi alterado no celular.", " message(s)/participant(s) were matched by phone number. Your phone address book was not changed.");
    }

    private Control BuildSearchPage()
    {
        Panel page = new Panel(); page.Dock = DockStyle.Fill; page.Padding = new Padding(16); page.AutoScroll = true;
        Label title = new Label(); title.Text = UiText("Busca avançada do WhatsApp", "WhatsApp advanced search"); title.Font = new Font("Segoe UI", 14, FontStyle.Bold); title.SetBounds(12, 10, 650, 30); page.Controls.Add(title);
        Label termLabel = new Label(); termLabel.Text = UiText("Palavra ou frase", "Keyword or phrase"); termLabel.SetBounds(12, 50, 210, 20); page.Controls.Add(termLabel);
        TextBox term = new TextBox(); term.SetBounds(12, 72, 300, 25); page.Controls.Add(term);
        Label personLabel = new Label(); personLabel.Text = UiText("Pessoa / participante", "Person / participant"); personLabel.SetBounds(326, 50, 210, 20); page.Controls.Add(personLabel);
        TextBox person = new TextBox(); person.SetBounds(326, 72, 280, 25); page.Controls.Add(person);
        Label groupLabel = new Label(); groupLabel.Text = UiText("Grupo", "Group"); groupLabel.SetBounds(12, 108, 210, 20); page.Controls.Add(groupLabel);
        TextBox group = new TextBox(); group.SetBounds(12, 130, 300, 25); page.Controls.Add(group);
        Label subjectLabel = new Label(); subjectLabel.Text = UiText("Assunto / conteúdo", "Subject / content"); subjectLabel.SetBounds(326, 108, 210, 20); page.Controls.Add(subjectLabel);
        TextBox subject = new TextBox(); subject.SetBounds(326, 130, 280, 25); page.Controls.Add(subject);
        Label fromLabel = new Label(); fromLabel.Text = UiText("De", "From"); fromLabel.SetBounds(12, 166, 80, 20); page.Controls.Add(fromLabel);
        DateTimePicker from = new DateTimePicker(); from.Format = DateTimePickerFormat.Short; from.ShowCheckBox = true; from.Checked = false; from.SetBounds(12, 188, 150, 25); page.Controls.Add(from);
        Label toLabel = new Label(); toLabel.Text = UiText("Até", "To"); toLabel.SetBounds(175, 166, 80, 20); page.Controls.Add(toLabel);
        DateTimePicker to = new DateTimePicker(); to.Format = DateTimePickerFormat.Short; to.ShowCheckBox = true; to.Checked = false; to.SetBounds(175, 188, 150, 25); page.Controls.Add(to);
        Button search = new Button(); search.Text = UiText("Pesquisar", "Search"); search.SetBounds(345, 184, 130, 32); page.Controls.Add(search);
        Label resultLabel = new Label(); resultLabel.Text = UiText("Resultados (até 100 mensagens)", "Results (up to 100 messages)"); resultLabel.SetBounds(12, 232, 380, 20); page.Controls.Add(resultLabel);
        TextBox output = new TextBox(); output.Multiline = true; output.ReadOnly = true; output.ScrollBars = ScrollBars.Both; output.WordWrap = false; output.Font = new Font("Consolas", 9); output.SetBounds(12, 255, 700, 560); page.Controls.Add(output);
        search.Click += delegate
        {
            try
            {
                string route = BuildSearchRoute(term.Text, person.Text, group.Text, subject.Text,
                    from.Checked ? from.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "",
                    to.Checked ? to.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "");
                output.Text = Request("GET", route, null, 15000);
            }
            catch (Exception ex) { output.Text = UiText("Erro na pesquisa: ", "Search error: ") + Clean(ex.Message, 500); }
        };
        return page;
    }

    private Control BuildDiagnosticsPage()
    {
        Panel page = new Panel(); page.Dock = DockStyle.Fill; page.Padding = new Padding(16);
        Label title = new Label(); title.Text = UiText("Diagnóstico — Capri WhatsApp", "Diagnostics — Capri WhatsApp"); title.Font = new Font("Segoe UI", 14, FontStyle.Bold); title.SetBounds(12, 10, 700, 30); page.Controls.Add(title);
        Label intro = new Label(); intro.Text = UiText("Saúde da conexão, runtime, transcrição, contatos, fila e armazenamento. A sessão e as mensagens não são incluídas.", "Connection, runtime, transcription, contacts, queue and storage health. Session data and messages are not included."); intro.SetBounds(12, 48, 700, 42); intro.AutoSize = false; page.Controls.Add(intro);
        Button refresh = new Button(); refresh.Text = UiText("Atualizar diagnóstico", "Refresh diagnostics"); refresh.SetBounds(12, 98, 160, 30); page.Controls.Add(refresh);
        TextBox output = new TextBox(); output.Multiline = true; output.ReadOnly = true; output.ScrollBars = ScrollBars.Both; output.WordWrap = false; output.Font = new Font("Consolas", 9); output.SetBounds(12, 140, 700, 650); page.Controls.Add(output);
        Action update = delegate
        {
            try
            {
                string health = Request("GET", "/health", null, 8000);
                string storage = Request("GET", "/storage", null, 8000);
                StringBuilder report = new StringBuilder();
                report.AppendLine(UiText("=== SAÚDE DOS COMPONENTES ===", "=== COMPONENT HEALTH ==="));
                report.AppendLine(UiText("WhatsApp: ", "WhatsApp: ") + (health.Contains("\"connected\":true") ? UiText("Conectado", "Connected") : UiText("Aguardando pareamento/conexão", "Waiting for pairing/connection")));
                report.AppendLine(UiText("Node.js: ", "Node.js: ") + ReadString(health, "node"));
                report.AppendLine(UiText("Baileys: ", "Baileys: ") + ReadString(health, "baileys"));
                report.AppendLine(UiText("Whisper: ", "Whisper: ") + ReadString(health, "whisper"));
                report.AppendLine(UiText("Modelo de transcrição: ", "Transcription model: ") + ReadString(health, "modelo"));
                report.AppendLine(UiText("FFmpeg: ", "FFmpeg: ") + ReadString(health, "ffmpeg"));
                report.AppendLine(UiText("Transcrição pronta: ", "Transcription ready: ") + (health.Contains("\"transcriptionReady\":true") ? UiText("Sim", "Yes") : UiText("Não", "No")));
                report.AppendLine(UiText("Etapa de preparação: ", "Setup stage: ") + ReadString(health, "transcriptionStage"));
                report.AppendLine(UiText("Estado da preparação: ", "Setup status: ") + ReadString(health, "transcriptionMessage"));
                report.AppendLine(UiText("Áudios pendentes: ", "Pending audios: ") + ReadInt(health, "pendingAudios", 0).ToString(CultureInfo.InvariantCulture));
                report.AppendLine(UiText("Mensagens em cache: ", "Cached messages: ") + ReadInt(health, "cachedMessages", 0).ToString(CultureInfo.InvariantCulture));
                report.AppendLine(UiText("Contatos conhecidos: ", "Known contacts: ") + ReadInt(health, "knownContacts", 0).ToString(CultureInfo.InvariantCulture));
                report.AppendLine(UiText("Números importados por VCF: ", "Numbers imported from VCF: ") + ReadInt(health, "syncedPhoneContacts", 0).ToString(CultureInfo.InvariantCulture));
                report.AppendLine(UiText("Perfil de notificações: ", "Notification profile: ") + ReadString(health, "notificationProfile"));
                report.AppendLine(UiText("Respostas escritas da Capri: ", "Capri written replies: ") + (health.Contains("\"capriRepliesEnabled\":true") ? UiText("Ativadas", "Enabled") : UiText("Desativadas", "Disabled")));
                report.AppendLine(); report.AppendLine(UiText("=== ARMAZENAMENTO ===", "=== STORAGE ==="));
                report.AppendLine(UiText("Arquivos de áudio: ", "Audio files: ") + ReadInt(storage, "files", 0).ToString(CultureInfo.InvariantCulture));
                report.AppendLine(UiText("Espaço ocupado por áudios: ", "Audio storage used: ") + ReadNumber(storage, "megabytes", "0.00") + " MB");
                report.AppendLine(UiText("Limpeza automática: ", "Automatic cleanup: ") + (ReadBool(storage, "autoCleanup") ? UiText("Ativada", "Enabled") : UiText("Desativada", "Disabled")));
                report.AppendLine(UiText("Retenção: ", "Retention: ") + ReadInt(storage, "retentionDays", 30).ToString(CultureInfo.InvariantCulture) + UiText(" dia(s)", " day(s)"));
                report.AppendLine(UiText("Limite configurado: ", "Configured limit: ") + ReadInt(storage, "maxMb", 512).ToString(CultureInfo.InvariantCulture) + " MB");
                report.AppendLine(); report.AppendLine(UiText("Observação: esta página não lê nem exibe o conteúdo da sessão, credenciais ou mensagens.", "Note: this page does not read or display session contents, credentials or messages."));
                output.Text = report.ToString();
            }
            catch (Exception ex) { output.Text = UiText("Serviço local indisponível ou ainda iniciando.\r\n", "Local service unavailable or still starting.\r\n") + Clean(ex.Message, 500); }
        };
        refresh.Click += delegate { update(); };
        update();
        return page;
    }

    private string DecodeContactField(string value)
    {
        try { return Encoding.UTF8.GetString(Convert.FromBase64String(value ?? "")); }
        catch { return ""; }
    }

    private string JsonEscape(string value)
    {
        if (value == null) return "";
        return value.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", " ").Replace("\n", " ").Replace("\t", " ");
    }

    private string RemoveDiacritics(string value)
    {
        string normalized = (value ?? "").Normalize(NormalizationForm.FormD); StringBuilder sb = new StringBuilder();
        for (int i = 0; i < normalized.Length; i++)
            if (CharUnicodeInfo.GetUnicodeCategory(normalized[i]) != UnicodeCategory.NonSpacingMark) sb.Append(normalized[i]);
        return sb.ToString().Normalize(NormalizationForm.FormC);
    }

    private string Clean(string value, int max)
    {
        string result = (value ?? "").Replace("\r", " ").Replace("\n", " ").Replace("\t", " ").Trim();
        return result.Length > max ? result.Substring(0, max) : result;
    }

    private Control BuildOptions()
    {
        Panel panel = new Panel(); panel.Dock = DockStyle.Fill; panel.AutoScroll = true; panel.Padding = new Padding(14);
        // A janela que hospeda o controle das opções é maximizada depois que o host o anexa.
        // O Timer evita tentar localizar o Form antes de Parent/Handle estarem prontos.
        System.Windows.Forms.Timer expandOptionsTimer = new System.Windows.Forms.Timer();
        expandOptionsTimer.Interval = 120;
        int expandAttempts = 0;
        expandOptionsTimer.Tick += delegate
        {
            expandAttempts++;
            try
            {
                Form optionsWindow = panel.FindForm();
                if (optionsWindow != null)
                {
                    expandOptionsTimer.Stop();
                    optionsWindow.WindowState = FormWindowState.Maximized;
                    optionsWindow.Activate();
                }
                else if (expandAttempts >= 25) expandOptionsTimer.Stop();
            }
            catch (Exception ex)
            {
                expandOptionsTimer.Stop();
                if (capri != null) capri.Log("Não foi possível expandir a janela de opções: " + ex.Message);
            }
        };
        panel.HandleCreated += delegate { if (!expandOptionsTimer.Enabled) expandOptionsTimer.Start(); };
        panel.ParentChanged += delegate { if (panel.Parent != null && !expandOptionsTimer.Enabled) expandOptionsTimer.Start(); };
        if (panel.IsHandleCreated || panel.Parent != null) expandOptionsTimer.Start();
        Panel content = new Panel(); content.Width = 760; content.Height = 1570; content.Top = 0;
        content.Left = Math.Max(0, (panel.ClientSize.Width - content.Width) / 2);
        panel.Controls.Add(content);
        panel.Resize += delegate { if (!content.IsDisposed) content.Left = Math.Max(0, (panel.ClientSize.Width - content.Width) / 2); };
        Label title = new Label(); title.Text = "Capri WhatsApp"; title.Font = new Font("Segoe UI", 14, FontStyle.Bold); title.SetBounds(14, 12, 520, 30); content.Controls.Add(title);
        Label status = new Label(); status.Name = "waStatus"; status.Text = UiText("Verificando conexão...", "Checking connection..."); status.SetBounds(14, 48, 540, 20); content.Controls.Add(status);
        Label transcriptionStatus = new Label(); transcriptionStatus.Name = "waTranscriptionStatus"; transcriptionStatus.Font = new Font("Segoe UI", 9, FontStyle.Bold); transcriptionStatus.Text = UiText("Transcrição de áudio: verificando...", "Audio transcription: checking..."); transcriptionStatus.SetBounds(14, 70, 540, 20); content.Controls.Add(transcriptionStatus);
        Label transcriptionDetails = new Label(); transcriptionDetails.Name = "waTranscriptionDetails"; transcriptionDetails.Text = UiText("Preparação automática dos componentes locais.", "Automatically preparing local components."); transcriptionDetails.SetBounds(14, 91, 540, 24); transcriptionDetails.AutoSize = false; transcriptionDetails.AutoEllipsis = true; content.Controls.Add(transcriptionDetails);
        PictureBox qr = new PictureBox(); qr.Name = "waQr"; qr.SizeMode = PictureBoxSizeMode.Zoom; qr.BorderStyle = BorderStyle.FixedSingle; qr.SetBounds(14, 122, 220, 220); content.Controls.Add(qr);
        Label instructions = new Label(); instructions.Text = UiText("No celular: WhatsApp > Aparelhos conectados > Conectar aparelho. Escaneie o QR Code acima.", "On your phone: WhatsApp > Linked devices > Link a device. Scan the QR code above."); instructions.SetBounds(248, 134, 300, 70); instructions.AutoSize = false; content.Controls.Add(instructions);
        Button refresh = new Button(); refresh.Text = UiText("Atualizar status/QR", "Refresh status / QR"); refresh.SetBounds(248, 214, 160, 30); content.Controls.Add(refresh);
        Button connect = new Button(); connect.Text = UiText("Conectar / tentar novamente", "Connect / try again"); connect.SetBounds(248, 252, 210, 30); content.Controls.Add(connect);
        Button repair = new Button(); repair.Text = UiText("Preparar / reparar componentes", "Prepare / repair components"); repair.SetBounds(248, 290, 220, 30); content.Controls.Add(repair);
        Button reprocess = new Button(); reprocess.Text = UiText("Reprocessar áudios salvos", "Retry saved audio"); reprocess.SetBounds(248, 328, 220, 30); content.Controls.Add(reprocess);
        Label note = new Label(); note.Text = UiText("Conta pessoal usa protocolo não oficial de aparelho vinculado. Dúvidas sobre este mod? Pergunte à Capri como usar o recurso.", "Personal accounts use an unofficial linked-device protocol. Questions about this mod? Ask Capri how to use any feature."); note.SetBounds(14, 364, 700, 38); note.AutoSize = false; content.Controls.Add(note);

        Label contactTitle = new Label(); contactTitle.Text = UiText("Contatos e nomes", "Contacts and names"); contactTitle.Font = new Font("Segoe UI", 10, FontStyle.Bold); contactTitle.SetBounds(14, 411, 360, 24); content.Controls.Add(contactTitle);
        Label contactSelectLabel = new Label(); contactSelectLabel.Text = UiText("Contato / pessoa", "Contact / person"); contactSelectLabel.SetBounds(14, 438, 270, 20); content.Controls.Add(contactSelectLabel);
        Label contactAliasLabel = new Label(); contactAliasLabel.Text = UiText("Nome que a Capri usará", "Name Capri will use"); contactAliasLabel.SetBounds(294, 438, 250, 20); content.Controls.Add(contactAliasLabel);
        ComboBox contactChoice = new ComboBox(); contactChoice.DropDownStyle = ComboBoxStyle.DropDownList; contactChoice.SetBounds(14, 464, 270, 26); content.Controls.Add(contactChoice);
        TextBox contactAlias = new TextBox(); contactAlias.SetBounds(294, 464, 250, 25); contactAlias.Text = ""; content.Controls.Add(contactAlias);
        Button refreshContacts = new Button(); refreshContacts.Text = UiText("Atualizar lista", "Refresh list"); refreshContacts.SetBounds(14, 500, 115, 30); content.Controls.Add(refreshContacts);
        Button saveContactAlias = new Button(); saveContactAlias.Text = UiText("Salvar nome", "Save name"); saveContactAlias.SetBounds(136, 500, 115, 30); content.Controls.Add(saveContactAlias);
        Button clearContactAlias = new Button(); clearContactAlias.Text = UiText("Usar nome do WhatsApp", "Use WhatsApp name"); clearContactAlias.SetBounds(258, 500, 175, 30); content.Controls.Add(clearContactAlias);
        Label contactSyncNote = new Label(); contactSyncNote.Text = UiText("A agenda pode não sincronizar pelo WhatsApp; importe um .VCF para associar nomes aos números.", "Phone contacts may not sync through WhatsApp; import a .VCF file to match names to numbers."); contactSyncNote.SetBounds(14, 534, 690, 20); content.Controls.Add(contactSyncNote);
        Button importVcf = new Button(); importVcf.Text = UiText("Importar agenda do celular (.vcf)", "Import phone contacts (.VCF)"); importVcf.SetBounds(14, 558, 230, 30); content.Controls.Add(importVcf);

        GroupBox alertGroup = new GroupBox(); alertGroup.Text = UiText("Notificações por contato ou grupo — somente na Capri", "Per-contact or group notifications — Capri only"); alertGroup.Font = new Font("Segoe UI", 9, FontStyle.Bold); alertGroup.SetBounds(14, 570, 732, 140); content.Controls.Add(alertGroup);
        Label targetLabel = new Label(); targetLabel.Text = UiText("Pessoa (digite nome ou número)", "Person (type a name or number)"); targetLabel.Font = new Font("Segoe UI", 9); targetLabel.SetBounds(12, 22, 245, 18); alertGroup.Controls.Add(targetLabel);
        TextBox target = new TextBox(); target.SetBounds(12, 43, 245, 25); alertGroup.Controls.Add(target);
        Label groupSelectLabel = new Label(); groupSelectLabel.Text = UiText("Grupo (selecione na lista)", "Group (select from the list)"); groupSelectLabel.Font = new Font("Segoe UI", 9); groupSelectLabel.SetBounds(270, 22, 330, 18); alertGroup.Controls.Add(groupSelectLabel);
        ComboBox groupChoice = new ComboBox(); groupChoice.DropDownStyle = ComboBoxStyle.DropDownList; groupChoice.Enabled = true; groupChoice.IntegralHeight = false; groupChoice.DropDownHeight = 260; groupChoice.MaxDropDownItems = 12; groupChoice.SetBounds(270, 43, 350, 25); alertGroup.Controls.Add(groupChoice);
        Button refreshGroups = new Button(); refreshGroups.Text = UiText("Atualizar", "Refresh"); refreshGroups.Enabled = true; refreshGroups.SetBounds(628, 42, 88, 27); alertGroup.Controls.Add(refreshGroups);
        Button mute = new Button(); mute.Text = UiText("Silenciar avisos", "Mute alerts"); mute.SetBounds(12, 78, 160, 27); alertGroup.Controls.Add(mute);
        Button unmute = new Button(); unmute.Text = UiText("Reativar avisos", "Reactivate alerts"); unmute.SetBounds(180, 78, 145, 27); alertGroup.Controls.Add(unmute);
        Button priority = new Button(); priority.Text = UiText("Marcar prioritário", "Mark as priority"); priority.SetBounds(333, 78, 160, 27); alertGroup.Controls.Add(priority);
        Label alertInfo = new Label(); alertInfo.Text = UiText("Dica: escolha um grupo ou digite uma pessoa. Para tirar dúvidas, pergunte à Capri como usar este recurso.", "Tip: select a group or type a person. Ask Capri how to use this feature whenever you need help."); alertInfo.Font = new Font("Segoe UI", 8, FontStyle.Regular); alertInfo.ForeColor = Color.DimGray; alertInfo.AutoEllipsis = true; alertInfo.SetBounds(12, 111, 704, 18); alertGroup.Controls.Add(alertInfo);
        ToolTip alertTips = new ToolTip();
        alertTips.SetToolTip(target, UiText("Use para uma pessoa. Digite o nome ou número; não precisa ser o JID.", "Use this for a person. Enter their name or number; you do not need the JID."));
        alertTips.SetToolTip(groupChoice, UiText("Escolha diretamente um grupo. Selecionar aqui ativa o grupo como destino.", "Choose a group directly. Selecting one here makes it the active target.") );
        alertTips.SetToolTip(refreshGroups, UiText("Busca novamente os grupos da sua conta conectada.", "Fetches the groups from your linked WhatsApp account again."));
        alertTips.SetToolTip(mute, UiText("Impede a Capri de avisar sobre esta conversa. Não silencia o WhatsApp.", "Stops Capri from notifying you about this chat. It does not mute WhatsApp."));
        alertTips.SetToolTip(priority, UiText("Permite que esta conversa passe pelas regras de foco e silêncio da Capri.", "Lets this chat bypass Capri's focus and quiet-hour rules."));

        Label quietLabel = new Label(); quietLabel.Text = UiText("Horário de silêncio (HH:MM-HH:MM)", "Quiet hours (HH:MM-HH:MM)"); quietLabel.SetBounds(14, 717, 280, 24); content.Controls.Add(quietLabel);
        TextBox quietRange = new TextBox(); quietRange.Text = "22:00-08:00"; quietRange.SetBounds(14, 743, 130, 25); content.Controls.Add(quietRange);
        Button quietSet = new Button(); quietSet.Text = UiText("Ativar horário", "Enable quiet hours"); quietSet.SetBounds(152, 741, 120, 30); content.Controls.Add(quietSet);
        Button quietOff = new Button(); quietOff.Text = UiText("Desativar horário", "Disable quiet hours"); quietOff.SetBounds(280, 741, 135, 30); content.Controls.Add(quietOff);
        Button focus = new Button(); focus.Text = UiText("Alternar modo foco", "Toggle focus mode"); focus.SetBounds(14, 781, 165, 30); content.Controls.Add(focus);

        Label backupLabel = new Label(); backupLabel.Text = UiText("Backup inclui apenas preferências e apelidos — nunca sessão ou mensagens.", "Backup includes preferences and aliases only — never the session or messages."); backupLabel.SetBounds(14, 825, 540, 24); content.Controls.Add(backupLabel);
        Button backupOut = new Button(); backupOut.Text = UiText("Exportar backup", "Export backup"); backupOut.SetBounds(14, 853, 135, 30); content.Controls.Add(backupOut);
        Button backupIn = new Button(); backupIn.Text = UiText("Restaurar backup", "Restore backup"); backupIn.SetBounds(158, 853, 140, 30); content.Controls.Add(backupIn);
        Button openLog = new Button(); openLog.Text = UiText("Abrir registro", "Open log"); openLog.SetBounds(306, 853, 120, 30); content.Controls.Add(openLog);
        Label languageLabel = new Label(); languageLabel.Text = UiText("Idioma da interface, respostas e avisos", "Language for interface, replies and alerts"); languageLabel.SetBounds(14, 931, 250, 20); content.Controls.Add(languageLabel);
        ComboBox languageChoice = new ComboBox(); languageChoice.DropDownStyle = ComboBoxStyle.DropDownList; languageChoice.Items.Add(UiText("Português (Brasil)", "Português (Brasil)")); languageChoice.Items.Add("English"); languageChoice.Items.Add(UiText("Automático (idioma do Windows)", "Automatic (Windows language)")); languageChoice.SelectedIndex = 0; languageChoice.SetBounds(14, 955, 180, 26); content.Controls.Add(languageChoice);
        string languageCurrent = CurrentLanguage(); languageChoice.SelectedIndex = languageCurrent == "en" ? 1 : (languageCurrent == "auto" ? 2 : 0);
        Button languageSave = new Button(); languageSave.Text = UiText("Salvar idioma", "Save language"); languageSave.SetBounds(204, 953, 120, 30); content.Controls.Add(languageSave);
        Label result = new Label(); result.SetBounds(14, 995, 540, 58); result.AutoSize = false; content.Controls.Add(result);
        content.Height = 1072;

        bool serviceReady = false;
        Action update = delegate
        {
            string response = "";
            try { response = Request("GET", "/health", null, 1200); }
            catch { response = UiText("Preparando componentes ou aguardando conexão.", "Preparing components or waiting for connection."); }
            serviceReady = response.Contains("\"ok\":true");
            status.Text = response.Contains("\"connected\":true") ? UiText("WhatsApp conectado.", "WhatsApp connected.") : UiText("WhatsApp aguardando pareamento ou conexão.", "WhatsApp waiting for pairing or connection.");
            if (response.Contains("\"transcriptionReady\":true"))
            {
                transcriptionStatus.Text = UiText("Transcrição de áudio: PRONTA", "Audio transcription: READY");
                int pendingCount = ReadInt(response, "pendingAudios", 0);
                int failedCount = ReadInt(response, "failedAudios", 0);
                transcriptionDetails.Text = pendingCount > 0
                    ? pendingCount.ToString(CultureInfo.InvariantCulture) + UiText(" áudio(s) aguardando recuperação automática.", " audio file(s) waiting for automatic recovery.")
                    : (failedCount > 0
                        ? failedCount.ToString(CultureInfo.InvariantCulture) + UiText(" áudio(s) salvo(s) tiveram falha. Use Reprocessar áudios salvos para tentar novamente.", " saved audio file(s) failed. Use Retry saved audio to try again.")
                        : UiText("Whisper, modelo multilíngue e FFmpeg disponíveis no armazenamento privado do mod.", "Whisper, multilingual model and FFmpeg are ready in the mod's private storage."));
            }
            else if (response.Contains("\"transcriptionMessage\":"))
            {
                string stage = ReadString(response, "transcriptionStage");
                string detail = ReadString(response, "transcriptionMessage");
                bool setupError = response.Contains("\"transcriptionError\":true");
                transcriptionStatus.Text = setupError
                    ? UiText("Transcrição de áudio: ERRO NA PREPARAÇÃO", "Audio transcription: SETUP ERROR")
                    : UiText("Transcrição de áudio: preparando componentes...", "Audio transcription: preparing components...");
                string stageLabel = stage;
                if (stage == "checking") stageLabel = UiText("Verificando requisitos", "Checking requirements");
                else if (stage == "node") stageLabel = UiText("Preparando Node.js", "Preparing Node.js");
                else if (stage == "whatsapp") stageLabel = UiText("Iniciando WhatsApp", "Starting WhatsApp");
                else if (stage == "whisper") stageLabel = UiText("Preparando Whisper", "Preparing Whisper");
                else if (stage == "model") stageLabel = UiText("Baixando modelo de transcrição", "Downloading transcription model");
                else if (stage == "ffmpeg") stageLabel = UiText("Preparando conversor de áudio", "Preparing audio converter");
                else if (stage == "ready") stageLabel = UiText("Pronto", "Ready");
                string stageInfo = setupError ? detail : stageLabel;
                transcriptionDetails.Text = UiText("Etapa: ", "Stage: ") + stageInfo;
            }
            else
            {
                transcriptionStatus.Text = UiText("Transcrição de áudio: aguardando inicialização", "Audio transcription: waiting for startup");
                transcriptionDetails.Text = UiText("O serviço local ainda não respondeu. Use Preparar / reparar componentes.", "The local service has not responded yet. Use Prepare / repair components.");
            }
            try
            {
                if (qr.Image != null) { Image old = qr.Image; qr.Image = null; old.Dispose(); }
                string path = Path.Combine(rootDir, "pairing-qr.png");
                if (File.Exists(path)) using (Image image = Image.FromFile(path)) qr.Image = new Bitmap(image);
            }
            catch (Exception ex) { capri.Log("Falha ao exibir QR Code: " + ex.Message); }
        };
        refresh.Click += delegate { update(); };
        connect.Click += delegate
        {
            try { Request("POST", "/pair/retry", "{}", 4000); result.Text = UiText("Tentativa iniciada. O QR Code será atualizado automaticamente nesta tela.", "Attempt started. The QR code will update automatically on this screen."); }
            catch { Task.Run(delegate { try { EnsureBridgeRunning(); } catch (Exception ex) { capri.Log(ex.Message); } }); }
        };
        repair.Click += delegate
        {
            lock (bootstrapLock) { if (bootstrapRunning) { result.Text = UiText("A preparação automática já está em andamento.", "Automatic setup is already running."); return; } }
            result.Text = UiText("Preparação/reparo iniciado. O WhatsApp continua usando o serviço quando possível.", "Setup / repair started. WhatsApp will keep using the service when possible.");
            Task.Run(delegate { RunBootstrap(); });
        };
        reprocess.Click += delegate
        {
            try
            {
                string response = Request("POST", "/audios/reprocess", "{\"includeFailed\":true}", 8000);
                result.Text = response.Contains("\"ok\":true") ? UiText("Recuperação de áudios solicitada. A fila será processada pelo serviço.", "Audio recovery requested. The service will process the queue.") : response;
                update();
            }
            catch (Exception ex) { result.Text = UiText("Erro ao reprocessar áudios: ", "Could not retry audio: ") + Clean(ex.Message, 250); }
        };
        List<string> contactIds = new List<string>();
        List<string> contactAlternateIds = new List<string>();
        List<string> contactAliases = new List<string>();
        Action refreshContactRows = delegate
        {
            try
            {
                string selectedJid = contactChoice.SelectedIndex >= 0 && contactChoice.SelectedIndex < contactIds.Count ? contactIds[contactChoice.SelectedIndex] : "";
                string rawRows = Request("GET", "/contacts/list", null, 10000);
                contactChoice.Items.Clear(); contactIds.Clear(); contactAlternateIds.Clear(); contactAliases.Clear();
                string[] rows = rawRows.Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                for (int i = 0; i < rows.Length; i++)
                {
                    string[] fields = rows[i].Split('\t'); if (fields.Length < 5) continue;
                    string jid = DecodeContactField(fields[0]); string alternate = DecodeContactField(fields[1]);
                    string label = DecodeContactField(fields[2]); string alias = DecodeContactField(fields[3]); string phoneName = DecodeContactField(fields[4]);
                    if (String.IsNullOrEmpty(jid)) continue;
                    contactIds.Add(jid); contactAlternateIds.Add(alternate); contactAliases.Add(alias);
                    string display = String.IsNullOrEmpty(phoneName) ? label : label + " — celular: " + phoneName;
                    contactChoice.Items.Add(display);
                }
                if (contactChoice.Items.Count > 0)
                {
                    int selectedIndex = contactIds.IndexOf(selectedJid);
                    contactChoice.SelectedIndex = selectedIndex >= 0 ? selectedIndex : 0;
                    result.Text = UiText("Lista atualizada: ", "List updated: ") + contactChoice.Items.Count.ToString(CultureInfo.InvariantCulture) + UiText(" contato(s)/participante(s).", " contact(s)/participant(s).");
                }
                else { contactAlias.Text = ""; result.Text = UiText("Ainda não há contatos no histórico nem nomes sincronizados do WhatsApp.", "There are no contacts in the history or synced WhatsApp names yet."); }
            }
            catch (Exception ex) { result.Text = UiText("Erro ao carregar contatos: ", "Could not load contacts: ") + Clean(ex.Message, 250); }
        };
        contactChoice.SelectedIndexChanged += delegate
        {
            int index = contactChoice.SelectedIndex;
            if (index >= 0 && index < contactAliases.Count) contactAlias.Text = contactAliases[index];
        };
        refreshContacts.Click += delegate { refreshContactRows(); };
        importVcf.Click += delegate
        {
            try
            {
                OpenFileDialog dialog = new OpenFileDialog(); dialog.Title = UiText("Importar agenda exportada do celular", "Import phone address book");
                dialog.Filter = "Contatos vCard (*.vcf)|*.vcf|Todos os arquivos (*.*)|*.*";
                if (dialog.ShowDialog() == DialogResult.OK)
                {
                    result.Text = UiText("Importando contatos...", "Importing contacts...");
                    string importResult = ImportVCardFile(dialog.FileName);
                    refreshContactRows();
                    result.Text = importResult;
                }
            }
            catch (Exception ex) { result.Text = UiText("Não consegui importar o VCF: ", "Could not import the VCF: ") + Clean(ex.Message, 400); }
        };
        saveContactAlias.Click += delegate
        {
            try
            {
                int index = contactChoice.SelectedIndex;
                if (index < 0 || index >= contactIds.Count) throw new Exception(UiText("Selecione um contato primeiro.", "Select a contact first."));
                string body = "{\"jid\":\"" + JsonEscape(contactIds[index]) + "\",\"alternateJid\":\"" + JsonEscape(contactAlternateIds[index]) + "\",\"alias\":\"" + JsonEscape(contactAlias.Text) + "\"}";
                string saved = Request("POST", "/contacts/alias", body, 10000);
                refreshContactRows();
                result.Text = saved.Contains("\"ok\":true") ? UiText("Nome salvo na Capri. A agenda do celular não foi alterada.", "Name saved in Capri. Your phone address book was not changed.") : saved;
            }
            catch (Exception ex) { result.Text = UiText("Erro ao salvar nome: ", "Could not save name: ") + Clean(ex.Message, 250); }
        };
        clearContactAlias.Click += delegate
        {
            try
            {
                int index = contactChoice.SelectedIndex;
                if (index < 0 || index >= contactIds.Count) throw new Exception(UiText("Selecione um contato primeiro.", "Select a contact first."));
                string body = "{\"jid\":\"" + JsonEscape(contactIds[index]) + "\",\"alternateJid\":\"" + JsonEscape(contactAlternateIds[index]) + "\",\"alias\":\"\"}";
                string cleared = Request("POST", "/contacts/alias", body, 10000);
                refreshContactRows();
                result.Text = cleared.Contains("\"ok\":true") ? UiText("Apelido removido. A Capri usará novamente o nome recebido do WhatsApp.", "Alias removed. Capri will use the name received from WhatsApp again.") : cleared;
            }
            catch (Exception ex) { result.Text = UiText("Erro ao restaurar nome: ", "Could not restore name: ") + Clean(ex.Message, 250); }
        };
        refreshContactRows();

        List<string> groupIds = new List<string>();
        bool loadingGroupChoices = false;
        Action<bool> refreshGroupRows = delegate(bool refreshRemote)
        {
            try
            {
                string selectedJid = groupChoice.SelectedIndex > 0 && groupChoice.SelectedIndex < groupIds.Count ? groupIds[groupChoice.SelectedIndex] : "";
                string route = refreshRemote ? "/groups/list?refresh=1" : "/groups/list";
                string rawRows = Request("GET", route, null, 15000);
                loadingGroupChoices = true;
                groupChoice.Items.Clear(); groupIds.Clear();
                groupChoice.Items.Add(UiText("— Selecione um grupo —", "— Select a group —")); groupIds.Add("");
                string[] rows = rawRows.Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                for (int i = 0; i < rows.Length; i++)
                {
                    string[] fields = rows[i].Split('\t'); if (fields.Length < 4) continue;
                    string jid = DecodeContactField(fields[0]); string name = DecodeContactField(fields[1]);
                    bool isMuted = DecodeContactField(fields[2]) == "1"; bool isPriority = DecodeContactField(fields[3]) == "1";
                    if (String.IsNullOrEmpty(jid)) continue;
                    groupIds.Add(jid);
                    string display = String.IsNullOrEmpty(name) ? UiText("Grupo", "Group") : name;
                    if (isMuted) display += UiText(" — silenciado", " — muted");
                    if (isPriority) display += UiText(" — prioritário", " — priority");
                    groupChoice.Items.Add(display);
                }
                int selected = groupIds.IndexOf(selectedJid);
                groupChoice.SelectedIndex = selected > 0 ? selected : 0;
                alertInfo.Text = groupIds.Count > 1
                    ? UiText("Lista atualizada: ", "List updated: ") + (groupIds.Count - 1).ToString(CultureInfo.InvariantCulture) + UiText(" grupo(s) disponível(is).", " group(s) available.")
                    : UiText("Nenhum grupo encontrado. Verifique a conexão e clique em Atualizar.", "No groups found. Check the connection and click Refresh.");
                loadingGroupChoices = false;
            }
            catch (Exception ex)
            {
                loadingGroupChoices = false;
                alertInfo.Text = UiText("Erro ao carregar grupos: ", "Could not load groups: ") + Clean(ex.Message, 220);
            }
        };
        Func<bool> selectedPreferenceIsGroup = delegate
        {
            return groupChoice.SelectedIndex > 0 && groupChoice.SelectedIndex < groupIds.Count && !String.IsNullOrEmpty(groupIds[groupChoice.SelectedIndex]);
        };
        Func<string> selectedPreferenceTarget = delegate
        {
            if (selectedPreferenceIsGroup()) return groupIds[groupChoice.SelectedIndex];
            if (String.IsNullOrWhiteSpace(target.Text)) throw new Exception(UiText("Escolha um grupo na lista ou digite o nome/número de um contato.", "Choose a group from the list or enter a contact name/number."));
            return target.Text.Trim();
        };
        target.TextChanged += delegate
        {
            if (!loadingGroupChoices && !String.IsNullOrWhiteSpace(target.Text) && groupChoice.SelectedIndex > 0) groupChoice.SelectedIndex = 0;
            if (!loadingGroupChoices && !String.IsNullOrWhiteSpace(target.Text)) alertInfo.Text = UiText("Destino: contato informado.", "Target: typed contact.");
        };
        groupChoice.SelectedIndexChanged += delegate
        {
            if (!loadingGroupChoices && groupChoice.SelectedIndex > 0)
            {
                target.Text = "";
                alertInfo.Text = UiText("Grupo selecionado: ", "Selected group: ") + Convert.ToString(groupChoice.SelectedItem);
            }
        };
        refreshGroups.Click += delegate { refreshGroupRows(true); };
        refreshGroupRows(true);
        mute.Click += delegate
        {
            try
            {
                string preferenceTarget = selectedPreferenceTarget();
                string body = "{\"action\":\"mute\",\"kind\":\"" + (selectedPreferenceIsGroup() ? "group" : "contact") + "\",\"target\":\"" + JsonEscape(preferenceTarget) + "\"}";
                string saved = Request("POST", "/preferences", body, 8000);
                refreshGroupRows(false);
                alertInfo.Text = saved.Contains("\"ok\":true") ? UiText("Avisos da Capri silenciados para: ", "Capri alerts muted for: ") + preferenceTarget : saved;
            }
            catch (Exception ex) { alertInfo.Text = UiText("Erro: ", "Error: ") + Clean(ex.Message, 220); }
        };
        unmute.Click += delegate
        {
            try
            {
                string preferenceTarget = selectedPreferenceTarget();
                string body = "{\"action\":\"unmute\",\"kind\":\"" + (selectedPreferenceIsGroup() ? "group" : "contact") + "\",\"target\":\"" + JsonEscape(preferenceTarget) + "\"}";
                string saved = Request("POST", "/preferences", body, 8000);
                refreshGroupRows(false);
                alertInfo.Text = saved.Contains("\"ok\":true") ? UiText("Avisos reativados para: ", "Alerts reactivated for: ") + preferenceTarget : saved;
            }
            catch (Exception ex) { alertInfo.Text = UiText("Erro: ", "Error: ") + Clean(ex.Message, 220); }
        };
        priority.Click += delegate
        {
            try
            {
                string preferenceTarget = selectedPreferenceTarget();
                string body = "{\"action\":\"priority\",\"kind\":\"" + (selectedPreferenceIsGroup() ? "group" : "contact") + "\",\"target\":\"" + JsonEscape(preferenceTarget) + "\",\"enabled\":true}";
                string saved = Request("POST", "/preferences", body, 8000);
                refreshGroupRows(false);
                alertInfo.Text = saved.Contains("\"ok\":true") ? UiText("Conversa marcada como prioritária: ", "Conversation marked as priority: ") + preferenceTarget : saved;
            }
            catch (Exception ex) { alertInfo.Text = UiText("Erro: ", "Error: ") + Clean(ex.Message, 220); }
        };
        quietSet.Click += delegate
        {
            try
            {
                string[] times = quietRange.Text.Replace(" ", "").Split('-');
                if (times.Length != 2) throw new Exception(UiText("Use HH:MM-HH:MM.", "Use HH:MM-HH:MM."));
                string body = "{\"action\":\"quiet_hours\",\"enabled\":true,\"start\":\"" + JsonEscape(times[0]) + "\",\"end\":\"" + JsonEscape(times[1]) + "\"}";
                string saved = Request("POST", "/preferences", body, 8000);
                result.Text = saved.Contains("\"ok\":true") ? UiText("Horário de silêncio ativado.", "Quiet hours enabled.") : saved;
            }
            catch (Exception ex) { result.Text = UiText("Erro: ", "Error: ") + Clean(ex.Message, 250); }
        };
        quietOff.Click += delegate
        {
            try { string saved = Request("POST", "/preferences", "{\"action\":\"quiet_hours\",\"enabled\":false}", 8000); result.Text = saved.Contains("\"ok\":true") ? UiText("Horário de silêncio desativado.", "Quiet hours disabled.") : saved; }
            catch (Exception ex) { result.Text = UiText("Erro: ", "Error: ") + Clean(ex.Message, 250); }
        };
        focus.Click += delegate
        {
            try
            {
                string state = Request("GET", "/preferences", null, 5000);
                bool current = state.Contains("\"focusMode\": true") || state.Contains("\"focusMode\":true");
                bool enabled = !current;
                string saved = Request("POST", "/preferences", "{\"action\":\"focus\",\"enabled\":" + (enabled ? "true" : "false") + "}", 8000);
                result.Text = saved.Contains("\"ok\":true") ? (enabled ? UiText("Modo foco ativado.", "Focus mode enabled.") : UiText("Modo foco desativado.", "Focus mode disabled.")) : saved;
            }
            catch (Exception ex) { result.Text = UiText("Erro: ", "Error: ") + Clean(ex.Message, 250); }
        };
        languageSave.Click += delegate
        {
            try
            {
                string selected = languageChoice.SelectedIndex == 1 ? "en" : (languageChoice.SelectedIndex == 2 ? "auto" : "pt-BR");
                Request("POST", "/preferences", "{\"action\":\"language\",\"value\":\"" + selected + "\"}", 8000);
                result.Text = UiText("Idioma salvo. Feche e abra novamente as opções para aplicar a tradução da interface.", "Language saved. Close and reopen Options to apply the interface translation.");
                capri.Say(UiText("Idioma salvo. Reabra as opções para aplicar a tradução.", "Language saved. Reopen Options to apply the translation."));
            }
            catch (Exception ex) { result.Text = UiText("Erro ao salvar idioma: ", "Could not save language: ") + Clean(ex.Message, 250); }
        };
        backupOut.Click += delegate
        {
            try
            {
                SaveFileDialog dialog = new SaveFileDialog(); dialog.Title = UiText("Exportar preferências do Capri WhatsApp", "Export Capri WhatsApp preferences"); dialog.Filter = "Backup JSON (*.json)|*.json"; dialog.FileName = "capri-whatsapp-preferencias.json";
                if (dialog.ShowDialog() == DialogResult.OK) { string backup = Request("GET", "/backup/export", null, 10000); File.WriteAllText(dialog.FileName, backup, new UTF8Encoding(false)); result.Text = UiText("Backup exportado. A sessão privada e as mensagens não foram incluídas.", "Backup exported. The private session and messages were not included."); }
            }
            catch (Exception ex) { result.Text = UiText("Erro no backup: ", "Backup error: ") + Clean(ex.Message, 250); }
        };
        backupIn.Click += delegate
        {
            try
            {
                OpenFileDialog dialog = new OpenFileDialog(); dialog.Title = UiText("Restaurar preferências do Capri WhatsApp", "Restore Capri WhatsApp preferences"); dialog.Filter = "Backup JSON (*.json)|*.json";
                if (dialog.ShowDialog() == DialogResult.OK) { string backup = File.ReadAllText(dialog.FileName, Encoding.UTF8); string restored = Request("POST", "/backup/import", backup, 10000); result.Text = restored.Contains("\"ok\":true") ? UiText("Backup restaurado. Sessão e mensagens não foram alteradas.", "Backup restored. Session and messages were not changed.") : restored; }
            }
            catch (Exception ex) { result.Text = UiText("Erro ao restaurar: ", "Restore error: ") + Clean(ex.Message, 250); }
        };
        openLog.Click += delegate
        {
            try
            {
                string file = Path.Combine(rootDir, "bridge.log");
                if (!File.Exists(file)) { capri.Say(UiText("O registro ainda não foi criado.", "The log has not been created yet.")); return; }
                string[] rows = File.ReadAllLines(file, Encoding.UTF8);
                int first = Math.Max(0, rows.Length - 120);
                StringBuilder logBuilder = new StringBuilder();
                for (int i = first; i < rows.Length; i++) logBuilder.AppendLine(rows[i]);
                Form logWindow = new Form(); logWindow.Text = UiText("Registro — Capri WhatsApp", "Log — Capri WhatsApp"); logWindow.Width = 760; logWindow.Height = 520;
                TextBox logText = new TextBox(); logText.Multiline = true; logText.ReadOnly = true; logText.ScrollBars = ScrollBars.Both;
                logText.WordWrap = false; logText.Dock = DockStyle.Fill; logText.Font = new Font("Consolas", 9); logText.Text = logBuilder.ToString();
                logWindow.Controls.Add(logText); logWindow.StartPosition = FormStartPosition.CenterParent; logWindow.ShowDialog();
            }
            catch (Exception ex) { capri.Log("Não foi possível exibir o registro: " + ex.Message); }
        };
        // Mantém o espaço entre os blocos de contatos, alertas e configurações adicionais.
        foreach (Control existing in content.Controls) if (existing.Top >= 570) existing.Top += 40;

        Label profileTitle = new Label(); profileTitle.Text = UiText("Perfis de notificações", "Notification profiles"); profileTitle.Font = new Font("Segoe UI", 10, FontStyle.Bold); profileTitle.SetBounds(14, 1100, 420, 24); content.Controls.Add(profileTitle);
        Label profileLabel = new Label(); profileLabel.Text = UiText("Perfil atual", "Current profile"); profileLabel.SetBounds(14, 1128, 100, 20); content.Controls.Add(profileLabel);
        ComboBox profileChoice = new ComboBox(); profileChoice.DropDownStyle = ComboBoxStyle.DropDownList;
        profileChoice.Items.AddRange(new object[] { UiText("Trabalho", "Work"), UiText("Jogando", "Gaming"), UiText("Apresentação", "Presentation"), UiText("Dormindo", "Sleep") }); profileChoice.SetBounds(14, 1150, 180, 26); content.Controls.Add(profileChoice);
        Button profileSave = new Button(); profileSave.Text = UiText("Aplicar perfil", "Apply profile"); profileSave.SetBounds(204, 1148, 120, 30); content.Controls.Add(profileSave);
        Label scheduleLabel = new Label(); scheduleLabel.Text = UiText("Automação por horário", "Schedule automation"); scheduleLabel.SetBounds(14, 1185, 180, 20); content.Controls.Add(scheduleLabel);
        CheckBox scheduleEnabled = new CheckBox(); scheduleEnabled.Text = UiText("Ativar", "Enable"); scheduleEnabled.AutoSize = true; scheduleEnabled.SetBounds(14, 1208, 65, 24); content.Controls.Add(scheduleEnabled);
        ComboBox scheduleProfile = new ComboBox(); scheduleProfile.DropDownStyle = ComboBoxStyle.DropDownList;
        scheduleProfile.Items.AddRange(new object[] { UiText("Trabalho", "Work"), UiText("Jogando", "Gaming"), UiText("Apresentação", "Presentation"), UiText("Dormindo", "Sleep") }); scheduleProfile.SelectedIndex = 3; scheduleProfile.SetBounds(90, 1208, 150, 26); content.Controls.Add(scheduleProfile);
        TextBox scheduleRange = new TextBox(); scheduleRange.Text = "22:00-08:00"; scheduleRange.SetBounds(250, 1208, 110, 25); content.Controls.Add(scheduleRange);
        Button scheduleSave = new Button(); scheduleSave.Text = UiText("Salvar horário", "Save schedule"); scheduleSave.SetBounds(370, 1206, 125, 30); content.Controls.Add(scheduleSave);

        Label storageTitle = new Label(); storageTitle.Text = UiText("Armazenamento e limpeza", "Storage and cleanup"); storageTitle.Font = new Font("Segoe UI", 10, FontStyle.Bold); storageTitle.SetBounds(14, 1250, 420, 24); content.Controls.Add(storageTitle);
        CheckBox autoCleanup = new CheckBox(); autoCleanup.Text = UiText("Limpeza automática de áudios já transcritos", "Automatically clean up transcribed audio"); autoCleanup.AutoSize = true; autoCleanup.SetBounds(14, 1280, 230, 24); content.Controls.Add(autoCleanup);
        Label retentionLabel = new Label(); retentionLabel.Text = UiText("Manter áudios (dias)", "Keep audio (days)"); retentionLabel.SetBounds(14, 1310, 145, 20); content.Controls.Add(retentionLabel);
        NumericUpDown retentionDays = new NumericUpDown(); retentionDays.Minimum = 1; retentionDays.Maximum = 3650; retentionDays.Value = 30; retentionDays.SetBounds(14, 1332, 90, 25); content.Controls.Add(retentionDays);
        Label maxStorageLabel = new Label(); maxStorageLabel.Text = UiText("Limite da mídia (MB)", "Media limit (MB)"); maxStorageLabel.SetBounds(125, 1310, 160, 20); content.Controls.Add(maxStorageLabel);
        NumericUpDown maxStorage = new NumericUpDown(); maxStorage.Minimum = 50; maxStorage.Maximum = 102400; maxStorage.Value = 512; maxStorage.SetBounds(125, 1332, 100, 25); content.Controls.Add(maxStorage);
        Button storageSave = new Button(); storageSave.Text = UiText("Salvar limites", "Save limits"); storageSave.SetBounds(240, 1330, 115, 30); content.Controls.Add(storageSave);
        Button storageClean = new Button(); storageClean.Text = UiText("Limpar agora", "Clean now"); storageClean.SetBounds(365, 1330, 110, 30); content.Controls.Add(storageClean);
        Label storageStatus = new Label(); storageStatus.Text = UiText("Uso de mídia: verificando...", "Media usage: checking..."); storageStatus.SetBounds(14, 1365, 690, 22); content.Controls.Add(storageStatus);
        Label storageNote = new Label(); storageNote.Text = UiText("A limpeza remove somente arquivos de áudio já transcritos. Mensagens, textos transcritos e sessão do WhatsApp são preservados.", "Cleanup removes only audio files that already have transcripts. Messages, transcripts and the WhatsApp session are preserved."); storageNote.SetBounds(14, 1388, 700, 30); storageNote.AutoSize = false; content.Controls.Add(storageNote);

        Label replyTitle = new Label(); replyTitle.Text = UiText("Respostas escritas pela Capri", "Written replies by Capri"); replyTitle.Font = new Font("Segoe UI", 10, FontStyle.Bold); replyTitle.SetBounds(14, 1420, 420, 24); content.Controls.Add(replyTitle);
        CheckBox repliesEnabled = new CheckBox(); repliesEnabled.Text = UiText("Permitir que a Capri prepare respostas escritas com sua personalidade", "Allow Capri to prepare written replies in her own personality"); repliesEnabled.AutoSize = true; repliesEnabled.SetBounds(14, 1450, 650, 24); content.Controls.Add(repliesEnabled);
        Label replyNote = new Label(); replyNote.Text = UiText("Toda resposta exige prévia completa e confirmação explícita. Desativado por padrão. Não envia automaticamente.", "Every reply requires a full preview and explicit approval. Off by default. Nothing is sent automatically."); replyNote.SetBounds(14, 1475, 690, 22); content.Controls.Add(replyNote);
        Label voiceNote = new Label(); voiceNote.Text = UiText("Áudio com a voz configurada: ainda não exportável pela API pública da Capri (Speak reproduz localmente).", "Voice messages using Capri’s configured voice cannot yet be exported through the public Capri API (Speak plays locally)."); voiceNote.SetBounds(14, 1500, 700, 36); voiceNote.AutoSize = false; content.Controls.Add(voiceNote);

        Button searchPage = new Button(); searchPage.Text = UiText("Abrir busca avançada", "Open advanced search"); searchPage.SetBounds(14, 1545, 170, 32); content.Controls.Add(searchPage);
        Button diagnosticsPage = new Button(); diagnosticsPage.Text = UiText("Abrir diagnóstico completo", "Open full diagnostics"); diagnosticsPage.SetBounds(194, 1545, 200, 32); content.Controls.Add(diagnosticsPage);
        content.Height = 1610;

        string savedPreferences = "";
        try { savedPreferences = Request("GET", "/preferences", null, 5000); } catch { }
        string savedProfile = ReadStringInObject(savedPreferences, "preferences", "notificationProfile");
        profileChoice.SelectedIndex = savedProfile == "gaming" ? 1 : (savedProfile == "presentation" ? 2 : (savedProfile == "sleep" ? 3 : 0));
        string savedScheduleProfile = ReadStringInObject(savedPreferences, "profileSchedule", "profile");
        scheduleProfile.SelectedIndex = savedScheduleProfile == "work" ? 0 : (savedScheduleProfile == "gaming" ? 1 : (savedScheduleProfile == "presentation" ? 2 : 3));
        scheduleEnabled.Checked = ReadBoolInObject(savedPreferences, "profileSchedule", "enabled");
        string scheduleStart = ReadStringInObject(savedPreferences, "profileSchedule", "start");
        string scheduleEnd = ReadStringInObject(savedPreferences, "profileSchedule", "end");
        if (!String.IsNullOrEmpty(scheduleStart) && !String.IsNullOrEmpty(scheduleEnd)) scheduleRange.Text = scheduleStart + "-" + scheduleEnd;
        autoCleanup.Checked = ReadBoolInObject(savedPreferences, "storage", "autoCleanup");
        int savedRetention = ReadInt(savedPreferences.Substring(Math.Max(0, savedPreferences.IndexOf("\"storage\"", StringComparison.OrdinalIgnoreCase))), "retentionDays", 30);
        int savedMaxMb = ReadInt(savedPreferences.Substring(Math.Max(0, savedPreferences.IndexOf("\"storage\"", StringComparison.OrdinalIgnoreCase))), "maxMb", 512);
        retentionDays.Value = Math.Min(retentionDays.Maximum, Math.Max(retentionDays.Minimum, savedRetention));
        maxStorage.Value = Math.Min(maxStorage.Maximum, Math.Max(maxStorage.Minimum, savedMaxMb));
        repliesEnabled.Checked = ReadBoolInObject(savedPreferences, "preferences", "capriRepliesEnabled");
        bool featurePreferencesLoaded = savedPreferences.Contains("\"preferences\":");
        bool loadingFeaturePreferences = false;
        Action loadFeaturePreferences = delegate
        {
            try
            {
                string fresh = Request("GET", "/preferences", null, 1500);
                if (!fresh.Contains("\"preferences\":")) return;
                loadingFeaturePreferences = true;
                string freshProfile = ReadStringInObject(fresh, "preferences", "notificationProfile");
                profileChoice.SelectedIndex = freshProfile == "gaming" ? 1 : (freshProfile == "presentation" ? 2 : (freshProfile == "sleep" ? 3 : 0));
                string freshSchedule = ReadStringInObject(fresh, "profileSchedule", "profile");
                scheduleProfile.SelectedIndex = freshSchedule == "work" ? 0 : (freshSchedule == "gaming" ? 1 : (freshSchedule == "presentation" ? 2 : 3));
                scheduleEnabled.Checked = ReadBoolInObject(fresh, "profileSchedule", "enabled");
                string freshStart = ReadStringInObject(fresh, "profileSchedule", "start");
                string freshEnd = ReadStringInObject(fresh, "profileSchedule", "end");
                if (!String.IsNullOrEmpty(freshStart) && !String.IsNullOrEmpty(freshEnd)) scheduleRange.Text = freshStart + "-" + freshEnd;
                autoCleanup.Checked = ReadBoolInObject(fresh, "storage", "autoCleanup");
                int freshRetention = ReadInt(fresh.Substring(Math.Max(0, fresh.IndexOf("\"storage\"", StringComparison.OrdinalIgnoreCase))), "retentionDays", 30);
                int freshMaxMb = ReadInt(fresh.Substring(Math.Max(0, fresh.IndexOf("\"storage\"", StringComparison.OrdinalIgnoreCase))), "maxMb", 512);
                retentionDays.Value = Math.Min(retentionDays.Maximum, Math.Max(retentionDays.Minimum, freshRetention));
                maxStorage.Value = Math.Min(maxStorage.Maximum, Math.Max(maxStorage.Minimum, freshMaxMb));
                repliesEnabled.Checked = ReadBoolInObject(fresh, "preferences", "capriRepliesEnabled");
                string currentStorage = Request("GET", "/storage", null, 1500);
                storageStatus.Text = FormatStorageStatus(currentStorage);
                featurePreferencesLoaded = true;
            }
            catch { }
            finally { loadingFeaturePreferences = false; }
        };

        profileSave.Click += delegate
        {
            try
            {
                string selected = profileChoice.SelectedIndex == 1 ? "gaming" : (profileChoice.SelectedIndex == 2 ? "presentation" : (profileChoice.SelectedIndex == 3 ? "sleep" : "work"));
                string saved = Request("POST", "/preferences", "{\"action\":\"profile\",\"profile\":\"" + selected + "\"}", 8000);
                result.Text = saved.Contains("\"ok\":true") ? UiText("Perfil aplicado: ", "Profile applied: ") + Convert.ToString(profileChoice.SelectedItem) : saved;
            }
            catch (Exception ex) { result.Text = UiText("Erro ao aplicar perfil: ", "Could not apply profile: ") + Clean(ex.Message, 250); }
        };
        scheduleSave.Click += delegate
        {
            try
            {
                string[] times = scheduleRange.Text.Replace(" ", "").Split('-'); if (times.Length != 2) throw new Exception(UiText("Use HH:MM-HH:MM.", "Use HH:MM-HH:MM."));
                string selected = scheduleProfile.SelectedIndex == 0 ? "work" : (scheduleProfile.SelectedIndex == 1 ? "gaming" : (scheduleProfile.SelectedIndex == 2 ? "presentation" : "sleep"));
                string body = "{\"action\":\"profile_schedule\",\"enabled\":" + (scheduleEnabled.Checked ? "true" : "false") + ",\"profile\":\"" + selected + "\",\"start\":\"" + JsonEscape(times[0]) + "\",\"end\":\"" + JsonEscape(times[1]) + "\"}";
                string saved = Request("POST", "/preferences", body, 8000);
                result.Text = saved.Contains("\"ok\":true") ? UiText("Programação de notificações salva.", "Notification schedule saved.") : saved;
            }
            catch (Exception ex) { result.Text = UiText("Erro ao salvar horário: ", "Could not save schedule: ") + Clean(ex.Message, 250); }
        };
        storageSave.Click += delegate
        {
            try
            {
                string body = "{\"action\":\"storage_settings\",\"autoCleanup\":" + (autoCleanup.Checked ? "true" : "false") + ",\"retentionDays\":" + retentionDays.Value.ToString(CultureInfo.InvariantCulture) + ",\"maxMb\":" + maxStorage.Value.ToString(CultureInfo.InvariantCulture) + "}";
                string saved = Request("POST", "/preferences", body, 8000);
                result.Text = saved.Contains("\"ok\":true") ? UiText("Limites de armazenamento salvos.", "Storage limits saved.") : saved;
                storageStatus.Text = FormatStorageStatus(Request("GET", "/storage", null, 8000));
            }
            catch (Exception ex) { result.Text = UiText("Erro ao salvar armazenamento: ", "Could not save storage settings: ") + Clean(ex.Message, 250); }
        };
        storageClean.Click += delegate
        {
            DialogResult confirm = MessageBox.Show(UiText("Remover somente arquivos de áudio já transcritos que ultrapassem o prazo ou limite de espaço? As mensagens, transcrições e a sessão do WhatsApp serão preservadas.", "Remove only audio files that already have transcripts and exceed the retention period or storage limit? Messages, transcripts and the WhatsApp session will be preserved."), UiText("Confirmar limpeza de armazenamento", "Confirm storage cleanup"), MessageBoxButtons.YesNo, MessageBoxIcon.Warning);
            if (confirm != DialogResult.Yes) return;
            try { Request("POST", "/storage/cleanup", "{}", 12000); storageStatus.Text = FormatStorageStatus(Request("GET", "/storage", null, 8000)); result.Text = UiText("Limpeza concluída. Mensagens e transcrições foram preservadas.", "Cleanup complete. Messages and transcripts were preserved."); }
            catch (Exception ex) { result.Text = UiText("Erro na limpeza: ", "Cleanup error: ") + Clean(ex.Message, 250); }
        };
        repliesEnabled.CheckedChanged += delegate
        {
            if (loadingFeaturePreferences) return;
            try { string body = "{\"action\":\"capri_replies\",\"enabled\":" + (repliesEnabled.Checked ? "true" : "false") + "}"; result.Text = Request("POST", "/preferences", body, 8000); }
            catch (Exception ex) { result.Text = UiText("Erro ao salvar respostas da Capri: ", "Could not save Capri replies setting: ") + Clean(ex.Message, 250); }
        };
        searchPage.Click += delegate { try { capri.Mainframe.ShowPage(UiText("Busca avançada — WhatsApp", "Advanced search — WhatsApp"), delegate { return BuildSearchPage(); }); } catch (Exception ex) { result.Text = UiText("Não consegui abrir a busca: ", "Could not open search: ") + Clean(ex.Message, 250); } };
        diagnosticsPage.Click += delegate { try { capri.Mainframe.ShowPage(UiText("Diagnóstico — WhatsApp", "Diagnostics — WhatsApp"), delegate { return BuildDiagnosticsPage(); }); } catch (Exception ex) { result.Text = UiText("Não consegui abrir o diagnóstico: ", "Could not open diagnostics: ") + Clean(ex.Message, 250); } };
        try
        {
            string storage = Request("GET", "/storage", null, 5000);
            storageStatus.Text = FormatStorageStatus(storage);
        }
        catch { }

        System.Windows.Forms.Timer statusTimer = new System.Windows.Forms.Timer();
        statusTimer.Interval = 2500;
        statusTimer.Tick += delegate
        {
            if (!panel.IsDisposed && !status.IsDisposed)
            {
                if (serviceReady && !featurePreferencesLoaded) loadFeaturePreferences();
                update();
            }
        };
        statusTimer.Start();
        panel.Disposed += delegate
        {
            try { statusTimer.Stop(); statusTimer.Dispose(); } catch { }
            try { expandOptionsTimer.Stop(); expandOptionsTimer.Dispose(); } catch { }
            try { if (qr.Image != null) { Image old = qr.Image; qr.Image = null; old.Dispose(); } } catch { }
        };
        update();
        return panel;
    }

    public bool Heard(string words)
    {
        lastUserUtterance = words ?? "";
        string n = RemoveDiacritics(words ?? "").ToLowerInvariant();
        bool repeat = (n.Contains("repete") || n.Contains("repetir") || n.Contains("repeat")) && (n.Contains("mensagem") || n.Contains("whatsapp") || n.Contains("message"));
        if (repeat && !String.IsNullOrEmpty(lastSpokenMessage)) { SpeakChunks("Repetindo: " + lastSpokenMessage); return true; }
        return false;
    }

    public void Stop()
    {
        stopped = true;
        try { if (timer != null) timer.Cancel(); } catch { }
        timer = null;
        try
        {
            if (BridgeAlive()) Request("POST", "/shutdown", "{}", 1500);
        }
        catch { }
        try
        {
            if (bridgeProcess != null && !bridgeProcess.HasExited)
            {
                if (!bridgeProcess.WaitForExit(2500)) bridgeProcess.Kill();
            }
        }
        catch { }
        try
        {
            capri.Brain.RemoveTool("whatsapp_status"); capri.Brain.RemoveTool("whatsapp_consultar");
            capri.Brain.RemoveTool("whatsapp_resumo_grupo"); capri.Brain.RemoveTool("whatsapp_preferencias");
            capri.Brain.RemoveTool("whatsapp_apelido"); capri.Brain.RemoveTool("whatsapp_preparar_envio");
            capri.Brain.RemoveTool("whatsapp_confirmar_envio"); capri.Brain.RemoveTool("whatsapp_backup");
        }
        catch { }
        capri = null;
    }
}
