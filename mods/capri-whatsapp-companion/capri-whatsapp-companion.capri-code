      whisper: whisperExecutableExists ? 'ok' : 'ausente', modelo: modelExists ? 'ok' : 'ausente', ffmpeg: ffmpegExecutableExists ? 'ok' : 'ausente',
      audiosPendentes: pending, mensagensEmCache: messages.length, armazenamentoMB: storage.megabytes } };
