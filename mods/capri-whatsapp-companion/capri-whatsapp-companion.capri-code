    const target = clean(body.target || '', 100); const kind = body.kind === 'group' ? 'group' : 'contact';
    if (!target) throw new Error('Informe o nome exato do contato ou grupo.');
    const matches = findChatMatches(target, kind);
    if (!matches.length && kind === 'group' && normalize(target) === 'last group')
      throw new Error('Não encontrei uma mensagem recente de grupo para identificar. Aguarde uma mensagem de um grupo ou escolha-o na lista do Mainframe.');
    if (!matches.length) throw new Error('Não encontrei esse chat. Atualize a lista de grupos ou escolha o grupo no Mainframe; também aceito nome ou JID.');
    if (matches.length > 1) throw new Error('Encontrei mais de um chat com esse nome. Especifique o JID ou um apelido exclusivo.');
    const item = matches[0];
    const mapName = action === 'priority' ? 'priorityChats' : 'mutedChats';
    const ids = [item.jid, item.altJid].filter((v, i, a) => v && a.indexOf(v) === i);
    if (action === 'unmute' || (action === 'priority' && !body.enabled)) {
      for (const id of ids) delete config[mapName][id];
