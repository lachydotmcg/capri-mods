  const timestampRaw = Number(raw.messageTimestamp?.toString?.() || raw.messageTimestamp || Math.floor(Date.now() / 1000));
  const timestamp = timestampRaw > 1000000000000 ? timestampRaw : timestampRaw * 1000;
