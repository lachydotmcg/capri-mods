function storageStats() {
  let bytes = 0, files = 0, pendingWithoutTranscript = 0;
  const seenFiles = new Set();
  for (const m of messages) {
    if (m.kind === 'audio' && m.mediaFile && !m.transcription) pendingWithoutTranscript++;
    if (!m.mediaFile) continue;
    const name = path.basename(String(m.mediaFile));
    if (!name.startsWith('audio-') || !name.endsWith('.ogg') || seenFiles.has(name)) continue;
    seenFiles.add(name);
