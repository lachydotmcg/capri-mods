function recentChats(limit = 25) {
  const byJid = new Map();
  for (const m of messages) {
    if (m.fromMe) continue;
    byJid.set(m.jid, { jid: m.jid, kind: m.isGroup ? 'group' : 'contact', name: m.isGroup ? m.groupName : m.senderName,
      lastMessage: m.text, timestamp: m.timestamp, lastSender: m.senderName });
  }
