function validateTime(value) { return /^([01]\d|2[0-3]):[0-5]\d$/.test(String(value || '')); }
async function handlePreferences(body) {
  const action = String(body.action || 'list').toLowerCase();
  if (action === 'list') return { ok: true, preferences: cleanPrefs(config), aliases: contacts };
  if (action === 'language') {
    const selected = String(body.value || 'pt-BR');
    if (!['pt-BR', 'en', 'auto'].includes(selected)) throw new Error('Idioma inválido. Use pt-BR, en ou auto.');
    config.language = selected;
  } else if (action === 'quiet_hours') {
    if (body.enabled && (!validateTime(body.start) || !validateTime(body.end) || body.start === body.end)) throw new Error('Informe horários válidos e diferentes, no formato HH:MM.');
    config.quietHours = { enabled: Boolean(body.enabled), start: String(body.start || config.quietHours.start), end: String(body.end || config.quietHours.end) };
  } else if (action === 'focus') config.focusMode = Boolean(body.enabled);
  else if (action === 'read_settings') {
    if (typeof body.individuals === 'boolean') config.readIndividuals = body.individuals;
    if (typeof body.groups === 'boolean') config.readGroups = body.groups;
    if (typeof body.audioTranscripts === 'boolean') config.readAudioTranscripts = body.audioTranscripts;
    if (typeof body.burstProtection === 'boolean') config.groupBurstProtection = body.burstProtection;
  } else if (action === 'profile') {
    const selected = String(body.profile || 'work');
    if (!['work','gaming','presentation','sleep'].includes(selected)) throw new Error('Perfil inválido.');
    config.notificationProfile = selected;
  } else if (action === 'profile_schedule') {
    const selected = String(body.profile || 'sleep');
    if (!['work','gaming','presentation','sleep'].includes(selected)) throw new Error('Perfil automático inválido.');
    if (body.enabled && (!validateTime(body.start) || !validateTime(body.end) || body.start === body.end)) throw new Error('Informe início e fim válidos, diferentes, no formato HH:MM.');
    config.profileSchedule = { enabled: Boolean(body.enabled), profile: selected, start: String(body.start || '22:00'), end: String(body.end || '08:00') };
  } else if (action === 'storage_settings') {
    config.storage = Object.assign({}, config.storage || DEFAULT_CONFIG.storage, {
      autoCleanup: Boolean(body.autoCleanup),
      retentionDays: Math.min(3650, Math.max(1, Number(body.retentionDays) || 30)),
      maxMb: Math.min(102400, Math.max(50, Number(body.maxMb) || 512))
