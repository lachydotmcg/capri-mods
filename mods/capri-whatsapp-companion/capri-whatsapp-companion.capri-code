    focusMode: Boolean(config.focusMode), quietHours: config.quietHours,
    notificationProfile: activeNotificationProfile(), profileSchedule: config.profileSchedule,
    capriRepliesEnabled: Boolean(config.capriRepliesEnabled), storage,
