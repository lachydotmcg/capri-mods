private static readonly Dictionary<string,KeyValuePair<DateTime,Page>>Recent=new Dictionary<string,KeyValuePair<DateTime,Page>>();public static double ReadSeconds=3.5;public static Page Search(string search){return Search(search,null);}public static Page Search(string search,Action<string>reading){Page page=new Page{Query=Regex.Replace(search??"",@"\s+"," ").Trim().TrimEnd('?','.','!',' ')};if(page.Query.Length==0)return page;string key=page.Query.ToLowerInvariant();lock(Recent){KeyValuePair<DateTime,Page>kept;if(Recent.TryGetValue(key,out kept)&&(DateTime.UtcNow-kept.Key).TotalMinutes<10&&kept.Value.Results.Count>0)return kept.Value;}List<string>wanted=Wanted(page.Query);string q=Uri.EscapeDataString(page.Query);string[]addresses={"https://www.bing.com/search?setlang="+Lang+"&q="+q,"https://html.duckduckgo.com/html/?q="+q,"https://"+WikiHost+"/w/api.php?action=query&list=search&format=json&srlimit=3&srsearch="+q};string[]pages=new string[3];ManualResetEvent[]done={new ManualResetEvent(false),new ManualResetEvent(false),new ManualResetEvent(false)};for(int i=0;i<3;i++){int which=i;Thread fetcher=new Thread(delegate(){try{pages[which]=Fetch(addresses[which]);}catch(Exception){}finally{done[which].Set();}});fetcher.IsBackground=true;fetcher.Start();}DateTime until=DateTime.UtcNow.AddSeconds(7);for(int i=0;i<3&&page.Results.Count==0;i++){done[i].WaitOne(Left(until));string got;lock(pages)got=pages[i];page.Results=Relevant(i==0?Bing(got):i==1?DuckDuckGo(got):Encyclopedia(got),wanted);}List<Result>toRead=new List<Result>();foreach(Result result in page.Results)if(toRead.Count<2&& !Unreadable.IsMatch(result.Host))toRead.Add(result);if(toRead.Count>0&&reading!=null)reading(toRead[0].Host);string[]read=new string[toRead.Count];List<Thread>readers=new List<Thread>();for(int i=0;i<toRead.Count;i++){int which=i;Thread reader=new Thread(delegate(){string passage;try{passage=Read(toRead[which].Address,page.Query);}catch(Exception){passage=null;}lock(read)read[which]=passage;});reader.IsBackground=true;reader.Start();readers.Add(reader);}DateTime readUntil=DateTime.UtcNow.AddSeconds(ReadSeconds);foreach(Thread reader in readers)reader.Join(Left(readUntil));lock(read)for(int i=0;i<read.Length;i++)if(!string.IsNullOrEmpty(read[i]))page.Read.Add(new KeyValuePair<string,string>(toRead[i].Host,read[i]));if(page.Results.Count>0)lock(Recent){if(Recent.Count>30)Recent.Clear();Recent[key]=new KeyValuePair<DateTime,Page>(DateTime.UtcNow,page);}return page;}public static void Forget(){lock(Recent)Recent.Clear();}private static TimeSpan Left(DateTime until){return TimeSpan.FromTicks(Math.Max(0,(until-DateTime.UtcNow).Ticks));}public static List<Result>Bing(string html){List<Result>found=new List<Result>();foreach(string part in Regex.Split(html??"",@"(?=<li class=""b_algo"")")){if(!part.StartsWith("<li class=\"b_algo\"",StringComparison.Ordinal))continue;string body=Hidden.Replace(Regex.Replace(part,@"<link\b[^>]*>","")," ");Match link=Regex.Match(body,@"<h2\b[^>]*>\s*<a\b[^>]*\bhref=""([^""]+)""[^>]*>(.*?)</a>",RegexOptions.Singleline);
if(!link.Success)continue;string address=WebUtility.HtmlDecode(link.Groups[1].Value);Match coded=Regex.Match(address,@"^https://www\.bing\.com/ck/a\?.*?[?&]u=a1([A-Za-z0-9_-]+)");if(coded.Success){string base64=coded.Groups[1].Value.Replace('-','+').Replace('_','/');try{address=Encoding.UTF8.GetString(Convert.FromBase64String(base64.PadRight(base64.Length+(4-base64.Length%4)%4,'=')));}catch(FormatException){continue;}}Uri uri;if(!Uri.TryCreate(address,UriKind.Absolute,out uri)||(uri.Scheme!="http"&&uri.Scheme!="https")||uri.Host.EndsWith("bing.com",StringComparison.OrdinalIgnoreCase))continue;Match snippet=Regex.Match(body,@"<p\b[^>]*>(.*?)</p>",RegexOptions.Singleline);found.Add(new Result{Title=Clip(Flat(link.Groups[2].Value),120),Address=uri.AbsoluteUri,Snippet=snippet.Success?Clip(Flat(snippet.Groups[1].Value),300):""});if(found.Count==8)break;}return found;}public static List<Result>DuckDuckGo(string html){List<Result>found=new List<Result>();foreach(string part in Regex.Split(html??"",@"(?=<a\b[^>]*class=""result__a"")")){Match link=Regex.Match(part,@"^<a\b[^>]*\bhref=""([^""]*)""[^>]*>(.*?)</a>",RegexOptions.Singleline);if(!link.Success)continue;string address=WebUtility.HtmlDecode(link.Groups[1].Value);Match real=Regex.Match(address,@"[?&]uddg=([^&]+)");if(real.Success)address=Uri.UnescapeDataString(real.Groups[1].Value);if(address.StartsWith("//",StringComparison.Ordinal))address="https:"+address;Uri uri;if(!Uri.TryCreate(address,UriKind.Absolute,out uri)||(uri.Scheme!="http"&&uri.Scheme!="https")||uri.Host.EndsWith("duckduckgo.com",StringComparison.OrdinalIgnoreCase))continue;Match snippet=Regex.Match(part,@"class=""result__snippet""[^>]*>(.*?)</(a|div|td)>",RegexOptions.Singleline);found.Add(new Result{Title=Clip(Flat(link.Groups[2].Value),120),Address=uri.AbsoluteUri,Snippet=snippet.Success?Clip(Flat(snippet.Groups[1].Value),300):""});if(found.Count==8)break;}return found;}public static List<Result>Encyclopedia(string json){List<Result>found=new List<Result>();foreach(Match hit in Regex.Matches(json??"",@"""title""\s*:\s*""((?:[^""\\]|\\.)*)""[^{}]*?""snippet""\s*:\s*""((?:[^""\\]|\\.)*)""")){string title=Regex.Unescape(hit.Groups[1].Value);found.Add(new Result{Title=title+" - Wikipedia",Address="https://"+WikiHost+"/wiki/"+Uri.EscapeDataString(title.Replace(' ','_')),Snippet=Clip(Flat(Regex.Unescape(hit.Groups[2].Value)),300)});}return found;}private static string Read(string address,string asked){Match wiki=Regex.Match(address,@"^https://([a-z-]+\.wikipedia\.org)/wiki/([^?#]+)");if(!wiki.Success)return Passage(Fetch(address),asked);Match extract=Regex.Match(Fetch("https://"+wiki.Groups[1].Value+"/api/rest_v1/page/summary/"+wiki.Groups[2].Value)??"",@"""extract""\s*:\s*""((?:[^""\\]|\\.)*)""");return extract.Success?Clip(Regex.Replace(Regex.Unescape(extract.Groups[1].Value),@"\s+"," ").Trim(),900):null;}public static string Passage(string html,string asked){string page=html??"";if(page.Length>400000)page=page.Substring(0,400000);Match main=Regex.Match(page,@"<(main|article)\b.*?</\1\s*>",RegexOptions.Singleline|RegexOptions.IgnoreCase);
if(main.Success&&main.Length>2000)page=main.Value;page=Regex.Replace(Hidden.Replace(page," "),@"<br\s*/?>|</(p|li|h[1-6]|td|th|tr|div|section|dd|dt|blockquote|figcaption)\s*>","\n",RegexOptions.IgnoreCase);string text=Regex.Replace(WebUtility.HtmlDecode(Regex.Replace(page,"<[^>]+>"," ")),@"\[\s*(\d+|[a-z]|note \d+|citation needed)\s*\]","",RegexOptions.IgnoreCase);List<string>wanted=Wanted(asked);List<string>lines=new List<string>();List<int>scores=new List<int>();foreach(string piece in Regex.Split(text,@"\n|(?<=[.!?])\s+(?=[\p{Lu}\p{N}""“])")){string line=Regex.Replace(piece,@"\s+"," ").Trim();if(line.Length<40||line.Length>500|| !Regex.IsMatch(line,@"\p{Ll}.*\s.*\p{Ll}")||Regex.IsMatch(line,@"\b(Archived from the original|Retrieved (on )?\d|ISBN|All rights reserved|cookies?)\b",RegexOptions.IgnoreCase))continue;int score=0;foreach(string word in wanted)if(Mentions(line,word))score++;lines.Add(line);scores.Add(score);}if(lines.Count==0)return null;List<int>order=new List<int>();for(int i=0;i<lines.Count;i++)order.Add(i);order.Sort(delegate(int a,int b){return scores[a]!=scores[b]?scores[b].CompareTo(scores[a]):a.CompareTo(b);});if(scores[order[0]]==0)order.Sort();List<int>kept=new List<int>();int length=0;foreach(int i in order){if(length>0&&(length+lines[i].Length>700||(scores[order[0]]>0&&scores[i]==0)))break;kept.Add(i);length+=lines[i].Length+1;}kept.Sort();return Clip(string.Join(" ",kept.ConvertAll(i=>lines[i]).ToArray()),900);}private static List<string>Wanted(string asked){List<string>wanted=new List<string>();foreach(string word in Regex.Split((asked??"").ToLowerInvariant(),@"[^\p{L}\p{N}']+"))if((word.Length>=3||Regex.IsMatch(word,@"^\d+$"))&&Array.IndexOf(Filler,word)<0&& !wanted.Contains(word))wanted.Add(word);return wanted;}private static List<Result>Relevant(List<Result>found,List<string>wanted){int needed=(wanted.Count+2)/3;return found.FindAll(result=>wanted.FindAll(word=>Mentions(result.Title+" "+result.Snippet,word)).Count>=needed);}private static bool Mentions(string text,string word){return Regex.IsMatch(text,@"(?<![\p{L}\p{N}])"+Regex.Escape(word)+@"(s|es|d|ed|ing|'s)?(?![\p{L}\p{N}])",RegexOptions.IgnoreCase);}private static string Flat(string html){return Regex.Replace(WebUtility.HtmlDecode(Regex.Replace(html??"","<[^>]+>","")),@"\s+"," ").Trim();}private static string Clip(string text,int most){return text.Length<=most?text:text.Substring(0,most-3).TrimEnd()+"...";}private static string Download(string address){HttpWebRequest request=(HttpWebRequest)WebRequest.Create(address);request.UserAgent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36";request.Headers["Accept-Language"]=Lang=="en"?"en":Lang+",en;q=0.5";request.Timeout=5000;request.ReadWriteTimeout=5000;request.AutomaticDecompression=DecompressionMethods.GZip|DecompressionMethods.Deflate;try{using(WebResponse response=request.GetResponse())using(StreamReader reader=new StreamReader(response.GetResponseStream(),Encoding.UTF8))return reader.ReadToEnd();
}catch(WebException){return"";}catch(IOException){return"";}}}