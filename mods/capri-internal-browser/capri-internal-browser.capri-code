return hosts;}private static readonly Regex Want=new Regex(@"\b(find|get|pick|choose|show|search|look\s+up|put\s+on|play|recommend|suggest|give|throw\s+on|pull\s+up|wanna\s+watch|want\s+to\s+watch|something\s+to\s+watch|what\s+should\s+i\s+watch|i'?m\s+bored)\b",Plain);private static readonly Regex Watch=new Regex(@"\b(videos?|vids?|youtube|yt|tiktoks?|anime|shows?|movies?|films?|episodes?|streams?|clips?|netflix|crunchyroll|twitch|prime\s+video|to\s+watch|should\s+i\s+watch)\b",Plain);private static readonly Regex FindVideo=new Regex(@"^(?:find|get|pick|choose|show|search(?:\s+up|\s+for)?|look\s+up|put\s+on)\s+(?:me\s+|us\s+)?(?:a\s+|an\s+|some\s+)?(?:good\s+|random\s+)?(?<what>.*?)\s*(?<kind>videos?|vids?|shows?|anime|episodes?|movies?|films?|tiktoks?|clips?|streams?)(?:\s+(?:for\s+(?:me|us)\s+)?to\s+watch)?(?:\s+(?:on|from|in)\s+(?<site>youtube|yt|tiktok|crunchyroll|netflix|twitch|prime(?:\s+video)?))?$",Plain);private static readonly string[]Finding={"Okay choom, finding one now.","On it choom, give me a sec.","Ooh, let me dig one up for you.","Say less, scrolling now.","Alright, let me find you something good."};private static readonly string[]Lazy={"Find it yourself choom..","Ugh, you've got hands, choom.","Nah, I'm on break. Scroll yourself.","Mm... not right now, choom."};private static readonly Random dice=new Random();private static readonly string[][]Sites={new[]{"youtube|yt","youtube.com","https://www.youtube.com/","https://www.youtube.com/results?search_query=",@"/watch\?v="},new[]{"tiktoks?","tiktok.com","https://www.tiktok.com/","https://www.tiktok.com/search?q=",@"/video/\d"},new[]{"crunchyroll","crunchyroll.com","https://www.crunchyroll.com/","https://www.crunchyroll.com/search?q=",@"/(series|watch)/"},new[]{"netflix","netflix.com","https://www.netflix.com/browse","https://www.netflix.com/search?q=",@"/(title|watch)/\d"},new[]{"twitch","twitch.tv","https://www.twitch.tv/","https://www.twitch.tv/search?term=",@"/videos/\d|^https://www\.twitch\.tv/\w{