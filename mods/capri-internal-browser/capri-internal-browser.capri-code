private static int Distance(string a,string b){int[]row=new int[b.Length+1];for(int j=0;j<=b.Length;j++)row[j]=j;for(int i=1;i<=a.Length;i++){int last=row[0];row[0]=i;for(int j=1;j<=b.Length;j++){int was=row[j];row[j]=Math.Min(Math.Min(row[j]+1,row[j-1]+1),last+(a[i-1]==b[j-1]?0:1));last=was;}}return row[b.Length];}private string SiteFor(string said){Match m=OpenSite.Match(said??"");if(!m.Success)return null;string what=Regex.Replace(m.Groups["what"].Value,@"\s+(?:in|on)\s+(?:the\s+|your\s+)?(?:capri\s+)?browser$|^(?:a|an)\s+","",Plain).Trim();if(Regex.IsMatch(what,@"^(?:https?://)?[\w-]+(\.[\w-]+)+(/\S*)?$",Plain))return what.StartsWith("http",StringComparison.OrdinalIgnoreCase)?what:"https://"+what;List<string>often=Often();if(often.Count>0&&Regex.IsMatch(what,@"^(?:my\s+)?(?:usual|favou?rite|most\s+used|normal|go-?to)(?:\s+(?:site|website|one))?$|^(?:the\s+)?(?:site|website|one)\s+i\s+(?:use|go\s+on|visit)\s+(?:the\s+)?most$",Plain))return"https://"+often[0]+"/";string name=Regex.Replace(what.ToLowerInvariant(),@"[\s'.-]+","");if(name.Length>=3)foreach(string d in capri==null?new string[0]:(capri.Store.Get("dial","")??"").Split(new[]{(char)10})){Uri du;if(Uri.TryCreate(d.Trim(),UriKind.Absolute,out du)){string bare=Regex.Replace(du.Host,@"^(?:wwwd?|m).|.[a-z.]+$","").Replace(".","");if(name==bare||(name.Length>=5&&Distance(name,bare)<=1))return d.Trim();}}foreach(string host in often){string bare=Regex.Replace(host,@"^(?:www\d?|m)\.|\.[a-z.]+$","").Replace(".","");if(name.Length>=3&&(name==bare||(name.Length>=5&&Distance(name,bare)<=1)))return"https://"+host+"/";}if(name.Length<2||name.Length>30)return null;foreach(string k in Known){string bare=k.Substring(0,k.IndexOf('.'));if(name==bare||name==k.Replace(".",""))return"https://www."+k+"/";}if(name.Length>=5)foreach(string k in Known){string bare=k.Substring(0,k.IndexOf('.'));if(bare.Length>=5&&Distance(name,bare)<=(bare.Length>=9?2:1))return"https://www."+k+"/";}return m.Groups["web"].Success&&Regex.IsMatch(name