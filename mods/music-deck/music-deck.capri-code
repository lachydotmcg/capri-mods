// Puts a drawn frame on a layered window, alpha and all.
public static class Layered
{
    [StructLayout(LayoutKind.Sequential)] private struct Size32 { public int Width, Height; }
    [StructLayout(LayoutKind.Sequential)] private struct Point32 { public int X, Y; }
    [StructLayout(LayoutKind.Sequential, Pack = 1)] private struct Blend { public byte Op, Flags, Alpha, Format; }
    [DllImport("user32.dll", SetLastError = true)] private static extern bool UpdateLayeredWindow(IntPtr window, IntPtr screen, ref Point32 at, ref Size32 size, IntPtr source, ref Point32 from, int key, ref Blend blend, int flags);
    [DllImport("user32.dll")] private static extern IntPtr GetDC(IntPtr window);
    [DllImport("user32.dll")] private static extern int ReleaseDC(IntPtr window, IntPtr dc);
    [DllImport("gdi32.dll")] private static extern IntPtr CreateCompatibleDC(IntPtr dc);
    [DllImport("gdi32.dll")] private static extern bool DeleteDC(IntPtr dc);
    [DllImport("gdi32.dll")] private static extern IntPtr SelectObject(IntPtr dc, IntPtr thing);
    [DllImport("gdi32.dll")] private static extern bool DeleteObject(IntPtr thing);

    public static void Push(Form window, Bitmap frame, byte alpha, Point crop, Size shown)
    {
        IntPtr screen = GetDC(IntPtr.Zero), memory = CreateCompatibleDC(screen), bitmap = IntPtr.Zero, was = IntPtr.Zero;
        try
        {
            bitmap = frame.GetHbitmap(Color.FromArgb(0));
            was = SelectObject(memory, bitmap);
            Size32 size = new Size32 { Width = Math.Min(shown.Width, frame.Width - crop.X), Height = Math.Min(shown.Height, frame.Height - crop.Y) };
            Point32 from = new Point32 { X = crop.X, Y = crop.Y }, at = new Point32 { X = window.Left, Y = window.Top };
            Blend blend = new Blend { Op = 0, Flags = 0, Alpha = alpha, Format = 1 };
            UpdateLayeredWindow(window.Handle, screen, ref at, ref size, memory, ref from, 0, ref blend, 2);
        }
        finally
        {
            ReleaseDC(IntPtr.Zero, screen);
            if (bitmap != IntPtr.Zero) { SelectObject(memory, was); DeleteObject(bitmap); }
            DeleteDC(memory);
        }
    }
}

public static class Screens
{
    [StructLayout(LayoutKind.Sequential)] private struct Rect { public int Left, Top, Right, Bottom; }
    [DllImport("user32.dll")] private static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] private static extern bool GetWindowRect(IntPtr window, out Rect rect);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] private static extern int GetClassName(IntPtr window, StringBuilder name, int size);
    [DllImport("user32.dll")] private static extern IntPtr GetShellWindow();
    [DllImport("user32.dll")] private static extern uint GetWindowThreadProcessId(IntPtr window, out uint process);

    // A game or video filling the screen it's on, not the desktop and not Capri.
    public static bool FullScreenApp(IntPtr mine)
    {
        IntPtr front = GetForegroundWindow();
        if (front == IntPtr.Zero || front == mine || front == GetShellWindow()) return false;
        uint process;
        GetWindowThreadProcessId(front, out process);
        if (process == (uint)Process.GetCurrentProcess().Id) return false;
        StringBuilder name = new StringBuilder(64);
        GetClassName(front, name, 64);
        string kind = name.ToString();
        if (kind == "Progman" || kind == "WorkerW" || kind == "Shell_TrayWnd") return false;
        Rect rect;
        if (!GetWindowRect(front, out rect)) return false;
        Rectangle bounds = Screen.FromHandle(front).Bounds;
        return rect.Left <= bounds.Left && rect.Top <= bounds.Top && rect.Right >= bounds.Right && rect.Bottom >= bounds.Bottom;
    }
}

public static class Fonts
{
    private static readonly Dictionary<string, Font> made = new Dictionary<string, Font>();
    private static string ui, digits;

    private static bool Has(string family)
    {
        using (InstalledFontCollection installed = new InstalledFontCollection())
            foreach (FontFamily one in installed.Families) if (string.Equals(one.Name, family, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    // Kept for the life of the mod, so a frame never makes fonts. Callers' using blocks only dispose a copy.
    private static Font Get(string family, float size, FontStyle style)
    {
        string key = family + "|" + size + "|" + style;
        Font font;
        if (!made.TryGetValue(key, out font)) { font = new Font(family, size, style, GraphicsUnit.Pixel); made[key] = font; }
        return (Font)font.Clone();
    }

    public static Font Ui(float size, FontStyle style)
    {
        if (ui == null) ui = Has("Segoe UI") ? "Segoe UI" : FontFamily.GenericSansSerif.Name;
        return Get(ui, size, style);
    }

    public static Font Digits(float size)
    {
        if (digits == null) digits = Has("Bahnschrift") ? "Bahnschrift" : Has("Consolas") ? "Consolas" : FontFamily.GenericMonospace.Name;
        return Get(digits, size, FontStyle.Regular);
    }
}

// Windows' own icon font.
public static class Icons
{
    public const string Play = "", Pause = "", Previous = "", Next = "", Shuffle = "", RepeatAll = "", RepeatOne = "",
        Heart = "", HeartFull = "", Speaker = "", Speaker1 = "", Speaker2 = "", Speaker3 = "", Muted = "",
        Down = "", Up = "", Close = "", Mini = "", Moon = "", Note = "", Check = "", Open = "", Auto = "";
    private static string family;
    private static readonly Dictionary<string, Font> made = new Dictionary<string, Font>();

    public static Font Font(float size)
    {
        if (family == null)
        {
            family = "Segoe MDL2 Assets";
            using (InstalledFontCollection installed = new InstalledFontCollection())
            {
                bool mdl = false, fluent = false;
                foreach (FontFamily one in installed.Families) { if (one.Name == "Segoe MDL2 Assets") mdl = true; if (one.Name == "Segoe Fluent Icons") fluent = true; }
                if (!mdl && fluent) family = "Segoe Fluent Icons";
            }
        }
        string key = family + "|" + size;
        Font font;
        if (!made.TryGetValue(key, out font)) { font = new Font(family, size, FontStyle.Regular, GraphicsUnit.Pixel); made[key] = font; }
        return (Font)font.Clone();
    }
}

public static class Draw
{
    private static readonly StringFormat plain = MakeFormat(false), centred = MakeFormat(true);

    private static StringFormat MakeFormat(bool centre)
    {
        StringFormat format = (StringFormat)StringFormat.GenericTypographic.Clone();
        format.FormatFlags |= StringFormatFlags.NoWrap | StringFormatFlags.MeasureTrailingSpaces;
        if (centre) { format.Alignment = StringAlignment.Center; format.LineAlignment = StringAlignment.Center; }
        return format;
    }

    public static GraphicsPath Round(RectangleF box, float radius)
    {
        GraphicsPath path = new GraphicsPath();
        float r = Math.Max(0.1f, Math.Min(radius, Math.Min(box.Width, box.Height) / 2)), d = r * 2;
        path.AddArc(box.X, box.Y, d, d, 180, 90);
        path.AddArc(box.Right - d, box.Y, d, d, 270, 90);
        path.AddArc(box.Right - d, box.Bottom - d, d, d, 0, 90);
        path.AddArc(box.X, box.Bottom - d, d, d, 90, 90);
        path.CloseFigure();
        return path;
    }

    // A soft shadow under a card, in rings that fade out.
    public static void Shadow(Graphics g, RectangleF card, float radius, float spread)
    {
        for (int i = 0; i < 12; i++)
        {
            float grow = spread * (i + 1) / 12f;
            RectangleF ring = new RectangleF(card.X - grow * 0.8f, card.Y - grow * 0.5f, card.Width + grow * 1.6f, card.Height + grow * 1.3f);
            using (GraphicsPath shape = Round(ring, radius + grow))
            using (Brush dark = new SolidBrush(Color.FromArgb((int)(14 * (1 - i / 12f)), 0, 0, 0))) g.FillPath(dark, shape);
        }
    }

    // An image filling a box, cropped to keep its shape.
    public static RectangleF Cover(Size image, RectangleF box)
    {
        float scale = Math.Max(box.Width / image.Width, box.Height / image.Height);
        float w = image.Width * scale, h = image.Height * scale;
        return new RectangleF(box.X + (box.Width - w) / 2, box.Y + (box.Height - h) / 2, w, h);
    }

    public static SizeF Measure(Graphics g, string text, Font font) { return g.MeasureString(text ?? "", font, PointF.Empty, plain); }

    public static void Text(Graphics g, string text, Font font, Color colour, PointF at)
    {
        using (Brush ink = new SolidBrush(colour)) g.DrawString(text ?? "", font, ink, at, plain);
    }

    public static void Center(Graphics g, string text, Font font, Color colour, RectangleF box)
    {
        using (Brush ink = new SolidBrush(colour)) g.DrawString(text ?? "", font, ink, box, centred);
    }

    // The longest start that fits, with an ellipsis when it's cut.
    public static string Fit(Graphics g, string text, Font font, float width)
    {
        text = text ?? "";
        if (Measure(g, text, font).Width <= width) return text;
        int low = 0, high = text.Length;
        while (low < high)
        {
            int mid = (low + high + 1) / 2;
            if (Measure(g, text.Substring(0, mid).TrimEnd() + "…", font).Width <= width) low = mid; else high = mid - 1;
        }
        return text.Substring(0, low).TrimEnd() + "…";
    }
}

// Colours for the deck from a cover: its most vivid colour, and a second one far enough round the wheel to pair with it.
public static class Palette
{
    public static Color[] Pick(Bitmap art)
    {
        Color fallback = DeckWindow.Pink, fallback2 = DeckWindow.Cyan;
        if (art == null) return new[] { fallback, fallback2 };
        double[] weight = new double[36];
        double[][] sums = new double[36][];
        for (int i = 0; i < 36; i++) sums[i] = new double[3];
        using (Bitmap small = new Bitmap(32, 32))
        {
            using (Graphics g = Graphics.FromImage(small)) { g.InterpolationMode = InterpolationMode.HighQualityBilinear; g.DrawImage(art, new Rectangle(0, 0, 32, 32)); }
            for (int y = 0; y < 32; y++)
                for (int x = 0; x < 32; x++)
                {
                    Color c = small.GetPixel(x, y);
                    float hue = c.GetHue(), sat = c.GetSaturation(), bright = Math.Max(c.R, Math.Max(c.G, c.B)) / 255f;
                    double vivid = sat * sat * bright;
                    if (bright < 0.18 || sat < 0.2) continue;
                    int bin = (int)(hue / 10) % 36;
                    weight[bin] += vivid;
                    sums[bin][0] += c.R * vivid; sums[bin][1] += c.G * vivid; sums[bin][2] += c.B * vivid;
                }
        }
        int best = -1, second = -1;
        for (int i = 0; i < 36; i++) if (best < 0 || Smooth(weight, i) > Smooth(weight, best)) best = i;
        if (best < 0 || weight[best] < 1.5) return new[] { fallback, fallback2 };
        for (int i = 0; i < 36; i++)
        {
            int apart = Math.Min(Math.Abs(i - best), 36 - Math.Abs(i - best));
            if (apart < 5) continue;
            if (second < 0 || Smooth(weight, i) > Smooth(weight, second)) second = i;
        }
        Color first = Lift(Average(sums[best], weight[best]));
        Color other = second >= 0 && weight[second] > 0.6 ? Lift(Average(sums[second], weight[second])) : Lift(Turn(first, 150));
        return new[] { first, other };
    }

    private static double Smooth(double[] weight, int i) { return weight[i] + 0.5 * weight[(i + 1) % 36] + 0.5 * weight[(i + 35) % 36]; }

    private static Color Average(double[] sum, double weight)
    {
        return Color.FromArgb(Clamp(sum[0] / weight), Clamp(sum[1] / weight), Clamp(sum[2] / weight));
    }

    private static int Clamp(double value) { return (int)Math.Max(0, Math.Min(255, value)); }

    // Bright and saturated enough to glow on black.
    private static Color Lift(Color c)
    {
        double h = c.GetHue(), s = Math.Max(0.55, c.GetSaturation()), v = Math.Max(0.85, Math.Max(c.R, Math.Max(c.G, c.B)) / 255.0);
        return FromHsv(h, s, v);
    }

    private static Color Turn(Color c, double degrees) { return FromHsv((c.GetHue() + degrees) % 360, 0.7, 0.95); }

    public static Color FromHsv(double h, double s, double v)
    {
        double c = v * s, x = c * (1 - Math.Abs((h / 60) % 2 - 1)), m = v - c, r = 0, g = 0, b = 0;
        if (h < 60) { r = c; g = x; } else if (h < 120) { r = x; g = c; } else if (h < 180) { g = c; b = x; } else if (h < 240) { g = x; b = c; } else if (h < 300) { r = x; b = c; } else { r = c; b = x; }
        return Color.FromArgb(Clamp((r + m) * 255), Clamp((g + m) * 255), Clamp((b + m) * 255));
    }

    // A steady colour for a song with no cover, from its name.
    public static Color FromText(string text)
    {
        int hash = 17;
        foreach (char c in text ?? "") hash = unchecked(hash * 31 + c);
        return FromHsv(Math.Abs(hash % 360), 0.6, 0.75);
    }
}

// Lyrics from lrclib.net, synced when it has them, kept on disk so a song is only looked up once.
public static class LyricFinder
{
    private const string Agent = "Capri Music Deck mod 1.1.0 (https://github.com/lachydotmcg/capri-desktop)";

    // "- slowed", "(sped up)", "nightcore" and the like: an edit of a song lrclib usually only has the original of.
    private static readonly Regex Tempo = new Regex(@"\s*(?:[-\u2013\u2014|]\s*|[\(\[]\s*)(?:super\s+|ultra\s+)?(?:slowed|sped\s*up|speed\s*up|nightcore|daycore|reverb)\b[^\)\]]*[\)\]]?\s*$", RegexOptions.IgnoreCase);

    public static LyricSet Find(string title, string artist, string album, double length, string folder)
    {
        string cleanTitle = CleanTitle(title), cleanArtist = CleanArtist(artist);
        // A video titled "Artist - Song" on a channel names both in its title.
        Match split = Regex.Match(Tempo.Replace(cleanTitle, ""), @"^(.+?)\s+[-\u2013\u2014]\s+(.+)$");
        if (split.Success && (cleanArtist.Length == 0 || split.Groups[1].Value.IndexOf(cleanArtist, StringComparison.OrdinalIgnoreCase) >= 0 || cleanArtist.IndexOf(split.Groups[1].Value, StringComparison.OrdinalIgnoreCase) >= 0))
        {
            cleanArtist = split.Groups[1].Value.Trim();
            cleanTitle = split.Groups[2].Value.Trim() + Tempo.Match(cleanTitle).Value;
        }
        string cacheFile = null;
        try
        {
            string cacheFolder = Path.Combine(folder, "lyrics-2");
            Directory.CreateDirectory(cacheFolder);
            cacheFile = Path.Combine(cacheFolder, Short(cleanArtist.ToLowerInvariant() + "\n" + cleanTitle.ToLowerInvariant()) + ".txt");
            if (File.Exists(cacheFile))
            {
                string cached = File.ReadAllText(cacheFile, Encoding.UTF8);
                try { return Parse(cached); }
                catch (Exception) { File.Delete(cacheFile); }
            }
        }
        catch (Exception) { cacheFile = null; }
        if (cleanTitle.Length == 0) return new LyricSet { Status = "No lyrics for this one." };
        string found = null;
        bool reached = false;
        try
        {
            string url = "https://lrclib.net/api/get?track_name=" + Uri.EscapeDataString(cleanTitle) + "&artist_name=" + Uri.EscapeDataString(cleanArtist)
                + (string.IsNullOrEmpty(album) ? "" : "&album_name=" + Uri.EscapeDataString(album)) + (length > 0 ? "&duration=" + ((int)Math.Round(length)).ToString(CultureInfo.InvariantCulture) : "");
            string body = Fetch(url, out reached);
            if (body != null) found = Pick(Json.Parse(body) as Dictionary<string, object>);
            if (found == null && reached) found = Search(cleanTitle, cleanArtist, length, true, out reached);
            // A slowed or sped-up edit: the original's lyrics, stretched to fit when they're shown.
            string plainTitle = Tempo.Replace(cleanTitle, "").Trim();
            if ((found == null || !found.StartsWith("[synced")) && reached && plainTitle.Length > 0 && plainTitle != cleanTitle)
            {
                string original = Search(plainTitle, cleanArtist, length, false, out reached);
                if (original != null && (found == null || original.StartsWith("[synced"))) found = original;
            }
        }
        catch (Exception) { }
        if (found == null && !reached) return new LyricSet { Status = "Couldn't reach lrclib.net for lyrics." };
        string saved = found ?? "[none]";
        LyricSet set = Parse(saved);
        try { if (cacheFile != null) File.WriteAllText(cacheFile, saved, Encoding.UTF8); } catch (Exception) { }
        return set;
    }

    // lrclib's search, best match first: synced ones, then the closest length. Strict keeps to within 15 seconds of this length.
    private static string Search(string title, string artist, double length, bool strict, out bool reached)
    {
        string body = Fetch("https://lrclib.net/api/search?track_name=" + Uri.EscapeDataString(title) + (artist.Length > 0 ? "&artist_name=" + Uri.EscapeDataString(artist) : ""), out reached);
        List<object> list = body == null ? null : Json.Parse(body) as List<object>;
        if (list == null) return null;
        string found = null;
        double bestScore = double.MaxValue;
        foreach (object one in list)
        {
            Dictionary<string, object> song = one as Dictionary<string, object>;
            string picked = Pick(song);
            if (picked == null) continue;
            double duration = Number(song, "duration");
            if (strict && length > 0 && duration > 0 && Math.Abs(duration - length) > 15) continue;
            double score = (length > 0 && duration > 0 ? Math.Abs(duration - length) / (strict ? 1 : 10) : 30) + (picked.StartsWith("[synced") ? 0 : 40);
            if (score < bestScore) { bestScore = score; found = picked; }
        }
        return found;
    }

    private static string Pick(Dictionary<string, object> song)
    {
        if (song == null) return null;
        if (song.ContainsKey("instrumental") && song["instrumental"] is bool && (bool)song["instrumental"]) return "[instrumental]";
        string length = Number(song, "duration").ToString("0.###", CultureInfo.InvariantCulture);
        string synced = song.ContainsKey("syncedLyrics") ? song["syncedLyrics"] as string : null;
        if (!string.IsNullOrWhiteSpace(synced)) return "[synced:" + length + "]\n" + synced;
        string plain = song.ContainsKey("plainLyrics") ? song["plainLyrics"] as string : null;
        if (!string.IsNullOrWhiteSpace(plain)) return "[plain:" + length + "]\n" + plain;
        return null;
    }

    private static double Number(Dictionary<string, object> song, string key)
    {
        return song != null && song.ContainsKey(key) && song[key] is double ? (double)song[key] : 0;
    }

    public static LyricSet Parse(string saved)
    {
        LyricSet set = new LyricSet();
        if (saved.StartsWith("[instrumental]")) { set.Instrumental = true; set.Status = "Instrumental \u2014 no words to this one."; return set; }
        if (saved.StartsWith("[none]")) { set.Status = "No lyrics for this one."; return set; }
        // "[synced:243.5]" or "[plain]"; files saved by 1.0.0 have no length.
        Match head = Regex.Match(saved, @"^\[(synced|plain)(?::([\d.]+))?\]");
        bool synced = head.Success && head.Groups[1].Value == "synced";
        double duration;
        if (head.Success && head.Groups[2].Success && double.TryParse(head.Groups[2].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out duration)) set.Duration = duration;
        string body = saved.Substring(saved.IndexOf('\n') + 1);
        foreach (string raw in body.Replace("\r", "").Split('\n'))
        {
            if (!synced)
            {
                set.Lines.Add(new LyricLine { At = -1, Text = raw.Trim() });
                continue;
            }
            MatchCollection stamps = Regex.Matches(raw, @"\[(\d+):(\d+(?:\.\d+)?)\]");
            if (stamps.Count == 0) continue;
            string text = Regex.Replace(raw, @"\[[^\]]*\]", "").Trim();
            foreach (Match stamp in stamps)
            {
                double at = int.Parse(stamp.Groups[1].Value) * 60 + double.Parse(stamp.Groups[2].Value, CultureInfo.InvariantCulture);
                set.Lines.Add(new LyricLine { At = at, Text = text.Length == 0 ? "\u266a" : text });
            }
        }
        if (synced)
        {
            set.Lines.Sort(delegate(LyricLine a, LyricLine b) { return a.At.CompareTo(b.At); });
            // Pauses come once, and a long intro gets its own dots before the first words.
            for (int i = set.Lines.Count - 1; i > 0; i--) if (set.Lines[i].Text == "\u266a" && set.Lines[i - 1].Text == "\u266a") set.Lines.RemoveAt(i);
            if (set.Lines.Count > 0 && set.Lines[0].At > 3 && set.Lines[0].Text != "\u266a") set.Lines.Insert(0, new LyricLine { At = 0, Text = "\u266a" });
            while (set.Lines.Count > 0 && set.Lines[set.Lines.Count - 1].Text == "\u266a") set.Lines.RemoveAt(set.Lines.Count - 1);
        }
        set.Synced = synced && set.Lines.Count > 0;
        if (set.Lines.Count == 0) set.Status = "No lyrics for this one.";
        return set;
    }

    private static string Fetch(string url, out bool reached)
    {
        reached = false;
        try
        {
            ServicePointManager.SecurityProtocol |= SecurityProtocolType.Tls12;
            HttpWebRequest request = (HttpWebRequest)WebRequest.Create(url);
            request.UserAgent = Agent;
            request.Timeout = 8000;
            request.ReadWriteTimeout = 8000;
            using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
            using (StreamReader reader = new StreamReader(response.GetResponseStream(), Encoding.UTF8))
            {
                reached = true;
                return reader.ReadToEnd();
            }
        }
        catch (WebException error)
        {
            HttpWebResponse response = error.Response as HttpWebResponse;
            if (response != null) { reached = true; response.Close(); }
            return null;
        }
    }

    public static string CleanTitle(string title)
    {
        string clean = title ?? "";
        clean = Regex.Replace(clean, @"\s*[\(\[](?:official|lyrics?|audio|video|music video|visuali[sz]er|hd|hq|4k|explicit|clean|remaster(?:ed)?[^\)\]]*|\d{4} remaster[^\)\]]*|feat\.?[^\)\]]*|ft\.?[^\)\]]*|with [^\)\]]*)[^\)\]]*[\)\]]", "", RegexOptions.IgnoreCase);
        clean = Regex.Replace(clean, @"\s+-\s+(?:\d{4}\s+)?remaster(?:ed)?(?:\s+\d{4})?.*$", "", RegexOptions.IgnoreCase);
        clean = Regex.Replace(clean, @"\s+(?:feat\.?|ft\.?)\s+.*$", "", RegexOptions.IgnoreCase);
        return clean.Trim();
    }

    public static string CleanArtist(string artist)
    {
        string clean = Regex.Replace(artist ?? "", @"\s*-\s*Topic$|VEVO$", "", RegexOptions.IgnoreCase);
        // "A, B & C" looks up as A.
        clean = Regex.Split(clean, @"\s*(?:,|&| x | feat\.? | ft\.? )\s*", RegexOptions.IgnoreCase)[0];
        return clean.Trim();
    }

    public static string Short(string text)
    {
        using (System.Security.Cryptography.SHA1 sha = System.Security.Cryptography.SHA1.Create())
            return BitConverter.ToString(sha.ComputeHash(Encoding.UTF8.GetBytes(text))).Replace("-", "").Substring(0, 20).ToLowerInvariant();
    }
}

// Just enough JSON for lrclib's answers.
public static class Json
{
    public static object Parse(string text)
    {
        int at = 0;
        try { return Value(text, ref at); }
        catch (Exception) { return null; }
    }

    private static void Skip(string s, ref int at) { while (at < s.Length && char.IsWhiteSpace(s[at])) at++; }

    private static object Value(string s, ref int at)
    {
        Skip(s, ref at);
        char c = s[at];
        if (c == '{')
        {
            Dictionary<string, object> obj = new Dictionary<string, object>();
            at++;
            Skip(s, ref at);
            if (s[at] == '}') { at++; return obj; }
            while (true)
            {
                Skip(s, ref at);
                string key = Str(s, ref at);
                Skip(s, ref at);
                at++;
                obj[key] = Value(s, ref at);
                Skip(s, ref at);
                if (s[at++] == '}') return obj;
            }
        }
        if (c == '[')
        {
            List<object> list = new List<object>();
            at++;
            Skip(s, ref at);
            if (s[at] == ']') { at++; return list; }
            while (true)
            {
                list.Add(Value(s, ref at));
                Skip(s, ref at);
                if (s[at++] == ']') return list;
            }
        }
        if (c == '"') return Str(s, ref at);
        if (s.Substring(at).StartsWith("true")) { at += 4; return true; }
        if (s.Substring(at).StartsWith("false")) { at += 5; return false; }
        if (s.Substring(at).StartsWith("null")) { at += 4; return null; }
        int start = at;
        while (at < s.Length && "+-0123456789.eE".IndexOf(s[at]) >= 0) at++;
        return double.Parse(s.Substring(start, at - start), CultureInfo.InvariantCulture);
    }

    private static string Str(string s, ref int at)
    {
        StringBuilder text = new StringBuilder();
        at++;
        while (s[at] != '"')
        {
            char c = s[at++];
            if (c != '\\') { text.Append(c); continue; }
            char e = s[at++];
            switch (e)
            {
                case 'n': text.Append('\n'); break;
                case 'r': text.Append('\r'); break;
                case 't': text.Append('\t'); break;
                case 'b': text.Append('\b'); break;
                case 'f': text.Append('\f'); break;
                case 'u': text.Append((char)Convert.ToInt32(s.Substring(at, 4), 16)); at += 4; break;
                default: text.Append(e); break;
            }
        }
        at++;
        return text.ToString();
    }
}
