// capri-mod: 1
// id: russian-ui
// name: Rusifikator
// version: 1.0.0
// author: Tvoi Protivnik помощник Opus 5.5
// description: Русификатор Капри: переводит мейнфрейм, настройки, меню, кнопки, подсказки при наведении, названия и описания модов и скинов из каталога. Списки устройств, моделей и языков не трогает.

using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Globalization;
using System.IO;
using System.Reflection;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading;
using System.Windows.Forms;
using CapriDesktop;

public class RussianUi : ICapriMod
{
    const BindingFlags Any = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
    const BindingFlags Statics = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
    const BindingFlags AnyStatic = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
    // \u041c\u0435\u043d\u044e \u0441\u043e \u0441\u043f\u0438\u0441\u043a\u0430\u043c\u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432, \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0438 \u044f\u0437\u044b\u043a\u043e\u0432 \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u0435\u043c: \u0438\u0445 \u043f\u0443\u043d\u043a\u0442\u044b \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u043c\u0438.
    static readonly string[] SkipMenus = { "languageMenu", "modelMenu", "cloudMenu", "speechModelMenu", "micMenu", "speakerMenu", "mixInputMenu", "mixOutputMenu", "planMenu", "freeKeyMenu", "screenMenu" };
    // \u041a\u043d\u043e\u043f\u043a\u0438-\u0441\u043f\u0438\u0441\u043a\u0438 \u043c\u0435\u0439\u043d\u0444\u0440\u0435\u0439\u043c\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f: \u0438\u0445 \u043d\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u043c \u0441\u043e\u0432\u0441\u0435\u043c, \u0438\u043d\u0430\u0447\u0435 \u0442\u0435\u043a\u0441\u0442 \u0434\u0451\u0440\u0433\u0430\u0435\u0442\u0441\u044f.
    static readonly string[] KeyNames = { "mics", "speakers", "models", "languages", "speechModels", "screens", "mixInput", "mixOutput" };
    static readonly CultureInfo Ru = new CultureInfo("ru-RU");
    static readonly Regex VerRx = new Regex(@"^(.+?) (v\d+(?:\.\d+)*)$");
    static readonly Regex ByRx = new Regex(@"^(?:([A-Z]{2,12})\. )?by ([^.]{1,60})\. (.+)$", RegexOptions.Singleline);
    const string Me = "Tvoi Protivnik";

    ICapriHost host;
    Form window;
    System.Windows.Forms.Timer timer;
    string folder;
    volatile bool stopped;
    bool busy;
    int ticks;
    bool missingDirty;
    FieldInfo hintsField, hintText;
    bool hintsLooked;

    readonly Dictionary<string, string> exact = new Dictionary<string, string>(StringComparer.Ordinal);
    readonly Dictionary<string, string> upper = new Dictionary<string, string>(StringComparer.Ordinal);
    readonly Dictionary<string, string> lists = new Dictionary<string, string>(StringComparer.Ordinal);
    readonly List<KeyValuePair<string, string>> starts = new List<KeyValuePair<string, string>>();
    readonly List<KeyValuePair<string, string>> ends = new List<KeyValuePair<string, string>>();
    readonly Dictionary<string, string> cache = new Dictionary<string, string>(StringComparer.Ordinal);
    readonly HashSet<string> ours = new HashSet<string>(StringComparer.Ordinal);
    readonly HashSet<string> missing = new HashSet<string>(StringComparer.Ordinal);
    readonly Dictionary<object, string[]> texts = new Dictionary<object, string[]>();
    readonly Dictionary<object, string[]> tips = new Dictionary<object, string[]>();
    readonly List<object[]> listBackup = new List<object[]>();
    readonly HashSet<object> hooked = new HashSet<object>();
    readonly HashSet<object> skipped = new HashSet<object>();
    readonly Dictionary<Type, FieldInfo[]> fieldsOf = new Dictionary<Type, FieldInfo[]>();
    readonly Dictionary<object, int[]> fights = new Dictionary<object, int[]>();
    readonly HashSet<object> stubborn = new HashSet<object>();
    readonly Dictionary<Type, FieldInfo[]> keysOf = new Dictionary<Type, FieldInfo[]>();
    readonly HashSet<ToolTip> toolTips = new HashSet<ToolTip>();
    readonly List<object[]> tipBackup = new List<object[]>();
    readonly List<object[]> hintBackup = new List<object[]>();

    public void Start(ICapriHost capri)
    {
        host = capri;
        folder = capri.Folder;
        try { Directory.CreateDirectory(folder); } catch { }
        try { LoadWords(); } catch (Exception e) { Log("dictionary: " + e.Message); }
        window = Get(capri, "capri") as Form;
        MethodInvoker go = Begin;
        if (window != null && window.IsHandleCreated) window.BeginInvoke(go); else go();
    }

    public bool Heard(string words)
    {
        return false;
    }

    public void Stop()
    {
        stopped = true;
        MethodInvoker undo = Undo;
        try
        {
            if (window != null && window.IsHandleCreated && window.InvokeRequired) window.Invoke(undo); else undo();
        }
        catch (Exception e) { Log("stop: " + e.Message); }
    }

    void Begin()
    {
        if (stopped) return;
        try { Lists(); } catch (Exception e) { Log("lists: " + e.Message); }
        timer = new System.Windows.Forms.Timer();
        timer.Interval = 350;
        timer.Tick += delegate { Tick(); };
        timer.Start();
        Tick();
        Log("on, " + exact.Count + " phrases");
    }

    void Undo()
    {
        if (timer != null) { timer.Stop(); timer.Dispose(); timer = null; }
        foreach (KeyValuePair<object, string[]> p in texts)
        {
            try { if (TextOf(p.Key) == p.Value[1]) SetText(p.Key, p.Value[0]); } catch { }
        }
        foreach (KeyValuePair<object, string[]> p in tips)
        {
            try
            {
                Control c = p.Key as Control;
                ToolStripItem it = p.Key as ToolStripItem;
                if (c != null && !c.IsDisposed && c.AccessibleDescription == p.Value[1]) c.AccessibleDescription = p.Value[0];
                else if (it != null && !it.IsDisposed && it.ToolTipText == p.Value[1]) it.ToolTipText = p.Value[0];
            }
            catch { }
        }
        foreach (object[] b in tipBackup)
        {
            try { ToolTip tt = (ToolTip)b[0]; Control c = (Control)b[1]; if (!c.IsDisposed && tt.GetToolTip(c) == (string)b[3]) tt.SetToolTip(c, (string)b[2]); } catch { }
        }
        foreach (object[] b in hintBackup)
        {
            try { if (hintText != null && (string)hintText.GetValue(b[0]) == (string)b[2]) hintText.SetValue(b[0], b[1]); } catch { }
        }
        texts.Clear();
        tips.Clear();
        tipBackup.Clear();
        hintBackup.Clear();
        foreach (object[] b in listBackup) { try { ((string[])b[0])[(int)b[1]] = (string)b[2]; } catch { } }
        listBackup.Clear();
        SaveMissing();
    }

    // ---------- \u0441\u043b\u043e\u0432\u0430\u0440\u044c ----------

    void LoadWords()
    {
        try { AddWords(Encoding.UTF8.GetString(Convert.FromBase64String(Dict)).Split('\n')); }
        catch (Exception e) { Log("embedded dictionary: " + e.Message); }
        string user = Path.Combine(folder, "ru-user.txt");
        if (File.Exists(user)) AddWords(File.ReadAllLines(user, Encoding.UTF8));
        Comparison<KeyValuePair<string, string>> longest = delegate(KeyValuePair<string, string> x, KeyValuePair<string, string> y) { return y.Key.Length.CompareTo(x.Key.Length); };
        starts.Sort(longest);
        ends.Sort(longest);
        string old = Path.Combine(folder, "untranslated.txt");
        if (File.Exists(old))
        {
            foreach (string l in File.ReadAllLines(old, Encoding.UTF8))
                if (l.Length > 0 && l.IndexOf(Me, StringComparison.Ordinal) < 0 && Whole(l.Replace("\\n", "\n")) == null) missing.Add(l);
            missingDirty = true;
        }
    }

    void AddWords(string[] all)
    {
        foreach (string raw in all)
        {
            string line = raw.TrimEnd('\r').TrimStart('\uFEFF');
            if (line.Length == 0 || line[0] == '#') continue;
            int tab = line.IndexOf('\t');
            if (tab <= 0) continue;
            string en = line.Substring(0, tab);
            string ru = line.Substring(tab + 1).Replace("\\n", "\n");
            if (ru.Trim().Length == 0) continue;
            char k = en[0];
            if (k == '>' && en.Length > 1) starts.Add(new KeyValuePair<string, string>(en.Substring(1), ru));
            else if (k == '<' && en.Length > 1) ends.Add(new KeyValuePair<string, string>(en.Substring(1), ru));
            else if (k == '@' && en.Length > 1) lists[en.Substring(1)] = ru;
            else
            {
                en = en.Trim();
                exact[en] = ru;
                string up = en.ToUpperInvariant();
                if (!upper.ContainsKey(up)) upper[up] = ru;
                ours.Add(ru);
                ours.Add(ru.ToUpper(Ru));
            }
        }
    }

    string Translate(string s)
    {
        if (string.IsNullOrEmpty(s) || ours.Contains(s)) return null;
        string r;
        if (cache.TryGetValue(s, out r)) return r;
        r = Whole(s);
        if (cache.Count > 20000) cache.Clear();
        cache[s] = r;
        if (r == null) Note(s); else ours.Add(r);
        return r;
    }

    string Whole(string s)
    {
        if (s.IndexOf(Me, StringComparison.Ordinal) >= 0) return null;
        int a = 0, b = s.Length;
        while (a < b && char.IsWhiteSpace(s[a])) a++;
        while (b > a && char.IsWhiteSpace(s[b - 1])) b--;
        if (a >= b || !Latin(s)) return null;
        string core = s.Substring(a, b - a);
        string t = null;
        if (core.IndexOf('\n') >= 0)
        {
            string[] lines = core.Split('\n');
            bool any = false;
            for (int i = 0; i < lines.Length; i++)
            {
                string x = lines[i].TrimEnd('\r').Trim();
                if (x.Length == 0) continue;
                string y = Part(x, 0);
                if (y != null) { lines[i] = lines[i].Replace(x, y); any = true; }
            }
            if (any) t = string.Join("\n", lines);
        }
        else t = Part(core, 0);
        if (t == null || t == core) return null;
        return s.Substring(0, a) + t + s.Substring(b);
    }

    string Part(string core, int depth)
    {
        string v;
        if (exact.TryGetValue(core, out v)) return v;
        if (Latin(core) && !Lower(core) && upper.TryGetValue(core, out v)) return v.ToUpper(Ru);
        if (depth > 3 || !Latin(core)) return null;
        Match m = VerRx.Match(core);
        if (m.Success)
        {
            string h = Part(m.Groups[1].Value, depth + 1);
            return h == null ? null : h + " " + m.Groups[2].Value;
        }
        m = ByRx.Match(core);
        if (m.Success)
        {
            string kind = m.Groups[1].Value, rest = m.Groups[3].Value;
            string k2 = kind.Length > 0 ? (Part(kind, depth + 1) ?? kind) + ". " : "";
            string r2 = Latin(rest) ? (Part(rest.Trim(), depth + 1) ?? rest) : rest;
            return k2 + "\u043e\u0442 " + m.Groups[2].Value + ". " + r2;
        }
        if (core.IndexOf(" \u00b7 ", StringComparison.Ordinal) > 0)
        {
            string[] parts = core.Split(new string[] { " \u00b7 " }, StringSplitOptions.None);
            bool any = false;
            for (int i = 0; i < parts.Length; i++)
            {
                string y = Part(parts[i].Trim(), depth + 1);
                if (y != null) { parts[i] = y; any = true; }
            }
            if (any) return string.Join(" \u00b7 ", parts);
        }
        for (int i = 0; i < starts.Count; i++)
        {
            string k = starts[i].Key;
            if (core.Length <= k.Length || !core.StartsWith(k, StringComparison.Ordinal)) continue;
            string tail = core.Substring(k.Length);
            string y = Latin(tail) ? Part(tail.Trim(), depth + 1) : null;
            if (y == null && Latin(tail) && !NameLike(tail)) continue;
            return starts[i].Value + (y ?? tail);
        }
        for (int i = 0; i < ends.Count; i++)
        {
            string k = ends[i].Key;
            if (core.Length <= k.Length || !core.EndsWith(k, StringComparison.Ordinal)) continue;
            string head = core.Substring(0, core.Length - k.Length);
            if (!Latin(head)) return head + ends[i].Value;
            string y = Part(head.Trim(), depth + 1);
            if (y != null) return y + ends[i].Value;
        }
        int c = core.IndexOf(": ", StringComparison.Ordinal);
        if (c > 0)
        {
            string l = Part(core.Substring(0, c), depth + 1);
            if (l != null)
            {
                string rest = core.Substring(c + 2);
                string y = Latin(rest) ? Part(rest.Trim(), depth + 1) : null;
                return l + ": " + (y ?? rest);
            }
        }
        return null;
    }

    static bool Latin(string s)
    {
        foreach (char ch in s) if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) return true;
        return false;
    }

    static bool Lower(string s)
    {
        foreach (char ch in s) if (char.IsLower(ch)) return true;
        return false;
    }

    // \u0418\u043c\u0435\u043d\u0430, \u043a\u043b\u0430\u0432\u0438\u0448\u0438 \u0438 \u0447\u0438\u0441\u043b\u0430 \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0444\u0440\u0430\u0437\u044b \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u043a\u0430\u043a \u0435\u0441\u0442\u044c.
    static bool NameLike(string s)
    {
        if (s.Length > 60) return false;
        foreach (string w in s.Split(' ')) if (w.Length > 0 && w[0] >= 'a' && w[0] <= 'z') return false;
        return true;
    }

    void Note(string s)
    {
        if (missing.Count > 4000 || s.Length > 400 || !Latin(s) || s.IndexOf(Me, StringComparison.Ordinal) >= 0) return;
        if (s.IndexOf('\\') >= 0 || s.IndexOf("://", StringComparison.Ordinal) >= 0) return;
        string line = s.Replace("\r", "").Replace("\n", "\\n").Replace("\t", " ").Trim();
        if (line.Length > 1 && missing.Add(line)) missingDirty = true;
    }

    void SaveMissing()
    {
        if (!missingDirty || folder == null) return;
        missingDirty = false;
        try
        {
            List<string> l = new List<string>(missing);
            l.Sort(StringComparer.Ordinal);
            File.WriteAllLines(Path.Combine(folder, "untranslated.txt"), l.ToArray(), new UTF8Encoding(false));
        }
        catch { }
    }

    // ---------- \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 ----------

    void Lists()
    {
        Type t = typeof(ICapriMod).Assembly.GetType("CapriDesktop.Mainframe");
        if (t == null) return;
        foreach (FieldInfo f in t.GetFields(Statics))
        {
            if (f.FieldType != typeof(string[]) || f.Name == "Clouds") continue;
            string[] arr = f.GetValue(null) as string[];
            if (arr == null) continue;
            for (int i = 0; i < arr.Length; i++)
            {
                string en = arr[i];
                if (string.IsNullOrEmpty(en)) continue;
                string ru;
                if (!lists.TryGetValue(f.Name + "|" + en, out ru)) ru = Whole(en);
                if (ru == null || ru == en) continue;
                listBackup.Add(new object[] { arr, i, en });
                arr[i] = ru;
                ours.Add(ru);
            }
        }
    }

    void Tick()
    {
        if (busy || stopped) return;
        busy = true;
        try
        {
            ticks++;
            List<Form> forms = new List<Form>();
            foreach (Form f in Application.OpenForms) forms.Add(f);
            if (window != null && !forms.Contains(window)) forms.Add(window);
            Form main = Get(window, "mainframe") as Form;
            if (main != null && !forms.Contains(main)) forms.Add(main);
            if (main != null && !main.IsDisposed && (ticks < 3 || ticks % 2 == 0)) Hints(main);
            foreach (Form f in forms)
            {
                if (f == null || f.IsDisposed) continue;
                string fn = f.GetType().Name;
                if (fn == "FileEditor") continue;
                if (fn == "HintCard") { if (f.Visible) Card(f); continue; }
                if (!f.Visible && ticks % 4 != 0) continue;
                Keys(f);
                Fields(f, false);
                Walk(f.Controls);
            }
            if (ticks % 40 == 0) { Prune(); SaveMissing(); }
        }
        catch (Exception e) { if (ticks < 3 || ticks % 300 == 0) Log(e.Message); }
        finally { busy = false; }
    }

    // \u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438 \u043f\u0440\u0438 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438: \u043c\u0435\u0439\u043d\u0444\u0440\u0435\u0439\u043c \u0445\u0440\u0430\u043d\u0438\u0442 \u0438\u0445 \u0442\u0435\u043a\u0441\u0442 \u0432 hints (Control -> SettingHint.Text).
    void Hints(Form main)
    {
        if (!hintsLooked) { hintsLooked = true; hintsField = Find(main.GetType(), "hints"); }
        if (hintsField == null) return;
        System.Collections.IDictionary d = hintsField.GetValue(main) as System.Collections.IDictionary;
        if (d == null || d.Count == 0) return;
        List<object> hs = new List<object>();
        foreach (object h in d.Values) if (h != null) hs.Add(h);
        foreach (object h in hs)
        {
            if (hintText == null)
            {
                hintText = Find(h.GetType(), "Text");
                if (hintText == null || hintText.FieldType != typeof(string)) { hintsField = null; hintText = null; Log("hints: no Text field"); return; }
            }
            string t = hintText.GetValue(h) as string;
            if (string.IsNullOrEmpty(t) || ours.Contains(t)) continue;
            string tr = Translate(t);
            if (tr == null) continue;
            hintText.SetValue(h, tr);
            ours.Add(tr);
            if (hintBackup.Count < 3000) hintBackup.Add(new object[] { h, t, tr });
        }
    }

    // \u041a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438, \u0435\u0441\u043b\u0438 \u0432 \u043d\u0435\u0439 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439 \u0442\u0435\u043a\u0441\u0442.
    void Card(Form f)
    {
        bool changed = false;
        foreach (string n in new string[] { "title", "Body" })
        {
            FieldInfo fi = Find(f.GetType(), n);
            if (fi == null || fi.FieldType != typeof(string)) continue;
            string t = fi.GetValue(f) as string;
            if (string.IsNullOrEmpty(t) || ours.Contains(t)) continue;
            string tr = Translate(t);
            if (tr == null) continue;
            fi.SetValue(f, tr);
            ours.Add(tr);
            changed = true;
        }
        if (changed) f.Invalidate();
    }

    void Keys(object owner)
    {
        Type t = owner.GetType();
        FieldInfo[] fs;
        if (!keysOf.TryGetValue(t, out fs))
        {
            List<FieldInfo> l = new List<FieldInfo>();
            foreach (string n in KeyNames) { FieldInfo f = Find(t, n); if (f != null) l.Add(f); }
            fs = l.ToArray();
            keysOf[t] = fs;
        }
        foreach (FieldInfo f in fs)
        {
            object v;
            try { v = f.GetValue(owner); } catch { continue; }
            if (v == null || !(v is Control || v is ToolStripItem) || !skipped.Add(v)) continue;
            string[] rec;
            if (texts.TryGetValue(v, out rec))
            {
                try { if (TextOf(v) == rec[1]) SetText(v, rec[0]); } catch { }
                texts.Remove(v);
            }
        }
    }

    void Walk(Control.ControlCollection list)
    {
        for (int i = 0; i < list.Count; i++)
        {
            Control c = list[i];
            if (c == null || c.IsDisposed || skipped.Contains(c)) continue;
            if (c is TextBoxBase || c is ComboBox || c is NumericUpDown || c is ListBox || c is WebBrowser) continue;
            string tn = c.GetType().Name;
            bool input = tn.IndexOf("Edit", StringComparison.Ordinal) >= 0 || tn.IndexOf("Entry", StringComparison.Ordinal) >= 0
                || tn.IndexOf("Input", StringComparison.Ordinal) >= 0 || tn.IndexOf("TextBox", StringComparison.Ordinal) >= 0;
            if (c is UserControl) Fields(c, true);
            if (!input) { Apply(c); ApplyTip(c); if (toolTips.Count > 0) TipBoxes(c); }
            ToolStrip ts = c as ToolStrip;
            if (ts != null) Strip(ts);
            if (c.ContextMenuStrip != null) Strip(c.ContextMenuStrip);
            if (c.HasChildren) Walk(c.Controls);
        }
    }

    void TipBoxes(Control c)
    {
        foreach (ToolTip tt in toolTips)
        {
            string t;
            try { t = tt.GetToolTip(c); } catch { continue; }
            if (string.IsNullOrEmpty(t) || ours.Contains(t)) continue;
            string tr = Translate(t);
            if (tr == null) continue;
            tt.SetToolTip(c, tr);
            ours.Add(tr);
            if (tipBackup.Count < 3000) tipBackup.Add(new object[] { tt, c, t, tr });
        }
    }

    void Fields(object owner, bool tipsOnly)
    {
        FieldInfo[] fs = FieldsOf(owner.GetType());
        if (fs.Length == 0) return;
        List<object> todo = new List<object>();
        foreach (FieldInfo fi in fs)
        {
            object v;
            try { v = fi.GetValue(owner); } catch { continue; }
            if (v == null) continue;
            if (Array.IndexOf(SkipMenus, fi.Name) >= 0) skipped.Add(v); else todo.Add(v);
        }
        foreach (object v in todo)
        {
            ToolTip tt = v as ToolTip;
            if (tt != null) { toolTips.Add(tt); continue; }
            IContainer ic = v as IContainer;
            if (ic != null)
            {
                try { foreach (IComponent x in ic.Components) { ToolTip t2 = x as ToolTip; if (t2 != null) toolTips.Add(t2); } } catch { }
                continue;
            }
            if (tipsOnly) continue;
            ToolStrip ts = v as ToolStrip;
            if (ts != null) { if (ts.Parent == null) Strip(ts); continue; }
            NotifyIcon ni = v as NotifyIcon;
            if (ni != null) { if (ni.ContextMenuStrip != null) Strip(ni.ContextMenuStrip); continue; }
            ToolStripItem it = v as ToolStripItem;
            if (it != null && it.Owner == null && !it.IsDisposed) Apply(it);
        }
    }

    FieldInfo[] FieldsOf(Type t)
    {
        FieldInfo[] r;
        if (fieldsOf.TryGetValue(t, out r)) return r;
        List<FieldInfo> l = new List<FieldInfo>();
        for (Type x = t; x != null && x.Namespace != null && !x.Namespace.StartsWith("System", StringComparison.Ordinal); x = x.BaseType)
            foreach (FieldInfo fi in x.GetFields(Any))
            {
                Type ft = fi.FieldType;
                if (typeof(ToolStrip).IsAssignableFrom(ft) || typeof(NotifyIcon).IsAssignableFrom(ft) || typeof(ToolStripItem).IsAssignableFrom(ft)
                    || typeof(ToolTip).IsAssignableFrom(ft) || typeof(IContainer).IsAssignableFrom(ft)) l.Add(fi);
            }
        r = l.ToArray();
        fieldsOf[t] = r;
        return r;
    }

    void Strip(ToolStrip ts)
    {
        if (ts == null || ts.IsDisposed || skipped.Contains(ts)) return;
        ToolStripDropDown dd = ts as ToolStripDropDown;
        if (dd != null && hooked.Add(dd)) dd.Opened += delegate { if (!stopped) Safe(dd.Items); };
        Items(ts.Items);
    }

    void Safe(ToolStripItemCollection items)
    {
        try { Items(items); } catch (Exception e) { Log(e.Message); }
    }

    void Items(ToolStripItemCollection items)
    {
        for (int i = 0; i < items.Count; i++)
        {
            ToolStripItem it = items[i];
            if (it == null || it.IsDisposed || it is ToolStripControlHost || skipped.Contains(it)) continue;
            Apply(it);
            ApplyTip(it);
            ToolStripDropDownItem sub = it as ToolStripDropDownItem;
            if (sub != null && sub.HasDropDownItems && !skipped.Contains(sub.DropDown)) Strip(sub.DropDown);
        }
    }

    void Apply(object o)
    {
        if (stubborn.Contains(o)) return;
        string t = TextOf(o);
        if (string.IsNullOrEmpty(t)) return;
        string[] rec;
        if (texts.TryGetValue(o, out rec))
        {
            if (rec[1] == t) return;
            if (rec[0] == t && Fight(o, t)) return;
        }
        string tr = Translate(t);
        if (tr == null) { if (rec != null) texts.Remove(o); return; }
        SetText(o, tr);
        string now = TextOf(o) ?? tr;
        ours.Add(now);
        texts[o] = new string[] { t, now };
    }

    // \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 4 \u0440\u0430\u0437\u0430 \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u0432\u043e\u0439 \u0442\u0435\u043a\u0441\u0442, \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u043c \u0435\u0433\u043e \u0442\u0440\u043e\u0433\u0430\u0442\u044c (\u0431\u0435\u0437 \u043c\u0438\u0433\u0430\u043d\u0438\u044f).
    bool Fight(object o, string t)
    {
        int[] f;
        if (!fights.TryGetValue(o, out f) || ticks - f[1] > 29) { f = new int[] { 0, ticks }; fights[o] = f; }
        if (++f[0] < 4) return false;
        stubborn.Add(o);
        texts.Remove(o);
        fights.Remove(o);
        try { File.AppendAllText(Path.Combine(folder, "fights.txt"), t.Replace("\r", "").Replace("\n", "\\n") + "\r\n", new UTF8Encoding(false)); } catch { }
        return true;
    }

    void ApplyTip(object o)
    {
        Control c = o as Control;
        ToolStripItem it = o as ToolStripItem;
        string t = c != null ? c.AccessibleDescription : (it != null ? it.ToolTipText : null);
        if (string.IsNullOrEmpty(t)) return;
        string[] rec;
        if (tips.TryGetValue(o, out rec) && rec[1] == t) return;
        string tr = Translate(t);
        if (tr == null) { if (rec != null) tips.Remove(o); return; }
        if (c != null) c.AccessibleDescription = tr; else it.ToolTipText = tr;
        ours.Add(tr);
        tips[o] = new string[] { t, tr };
    }

    static string TextOf(object o)
    {
        Control c = o as Control;
        if (c != null) return c.IsDisposed ? null : c.Text;
        ToolStripItem it = o as ToolStripItem;
        if (it != null) return it.IsDisposed ? null : it.Text;
        return null;
    }

    static void SetText(object o, string s)
    {
        Control c = o as Control;
        if (c != null) { if (!c.IsDisposed) c.Text = s; return; }
        ToolStripItem it = o as ToolStripItem;
        if (it != null && !it.IsDisposed) it.Text = s;
    }

    static bool Dead(object o)
    {
        Control c = o as Control;
        ToolStripItem it = o as ToolStripItem;
        return (c != null && c.IsDisposed) || (it != null && it.IsDisposed);
    }

    void Prune()
    {
        Prune(texts);
        Prune(tips);
        hooked.RemoveWhere(Dead);
        skipped.RemoveWhere(Dead);
        stubborn.RemoveWhere(Dead);
        List<object> dead = new List<object>();
        foreach (object o in fights.Keys) if (Dead(o)) dead.Add(o);
        foreach (object o in dead) fights.Remove(o);
        tipBackup.RemoveAll(delegate(object[] b) { return Dead(b[1]); });
    }

    static void Prune(Dictionary<object, string[]> d)
    {
        List<object> dead = new List<object>();
        foreach (object o in d.Keys) if (Dead(o)) dead.Add(o);
        foreach (object o in dead) d.Remove(o);
    }

    // ---------- \u043c\u0435\u043b\u043e\u0447\u0438 ----------

    static FieldInfo Find(Type t, string name)
    {
        for (Type x = t; x != null; x = x.BaseType)
        {
            FieldInfo f = x.GetField(name, Any);
            if (f != null) return f;
        }
        return null;
    }

    static object Get(object o, string name)
    {
        if (o == null) return null;
        FieldInfo f = Find(o.GetType(), name);
        return f == null ? null : f.GetValue(o);
    }

    void Log(string s)
    {
        try { host.Log("russian-ui: " + s); } catch { }
    }

