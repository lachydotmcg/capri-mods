// capri-mod: 1
// id: better-chat-capri
// name: Better Chat // Capri
// version: 1.0.1
// author: CyberPhantxm
// description: Hide chat bubble toggle (Mute Button & Hologram Speech Glass compatible, auto-shows for Security prompts), Esc to cancel thinking, 2.5s speech debounce with noise filter, and custom native chimes.
// permissions: chat, voice
// requires: api 3

using System;
using System.Diagnostics;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Drawing.Imaging;
using System.Reflection;
using System.Runtime.InteropServices;
using System.Text.RegularExpressions;
using System.Windows.Forms;
using CapriDesktop;

public class VoiceFlow : ICapriMod
{
    const BindingFlags Any = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static;
    public const int Side = 40, Gap = 4;
    const float IconScale = 0.9f;
    const int ChimeUser = -1, ChimePulse = 1, ChimeShard = 3;
    const int KindHeard = 1, KindListening = 2;
    const double DebounceSeconds = 2.5;
    const double IdleResetSeconds = 2.5;
    const int VkEscape = 0x1B;
    const int DwmwaCloak = 13;

    static readonly Regex NoiseWords = new Regex(@"^(uh+|um+|hm+|ah+|eh+|oh+|mm+|huh)$", RegexOptions.IgnoreCase);
    static readonly Regex LettersOnly = new Regex(@"\p{L}");

    sealed class Hook : NativeWindow
    {
        public Action Moved;
        protected override void WndProc(ref Message m)
        {
            if (m.Msg == 0x02E0 && Moved == null) return;
            base.WndProc(ref m);
            if (m.Msg == 0x47 && Moved != null) Moved();
        }
    }

    [StructLayout(LayoutKind.Sequential)]
    struct Rect { public int Left, Top, Right, Bottom; }
    [DllImport("user32.dll")] static extern bool GetWindowRect(IntPtr window, out Rect rect);
    [DllImport("user32.dll")] static extern bool IsWindowVisible(IntPtr window);
    [DllImport("user32.dll")] static extern short GetAsyncKeyState(int vKey);
    [DllImport("dwmapi.dll")] static extern int DwmSetWindowAttribute(IntPtr window, int attribute, ref int value, int size);

    public static Rectangle Real(Form form)
    {
        Rect r;
        if (!form.IsHandleCreated || !GetWindowRect(form.Handle, out r)) return form.Bounds;
        return Rectangle.FromLTRB(r.Left, r.Top, r.Right, r.Bottom);
    }

    ICapriHost capri;
    Form window, pill, button, box;
    FieldInfo pillUntil, pillCentre, pillScale, askingField, talkStateField, utteranceField, transcribingField, jobField, securityHeldField, securityHoldingField, jobAskingField;
    PropertyInfo chatting, securityHoldingProp, jobAskingProp;
    EventInfo securityHeldEvent;
    Delegate securityHeldHandler;
    volatile object securityHold;
    Hook watch, still;
    Stopwatch clock;
    MethodInfo talkScale, present, plate, chimePlay, closeNameChat;
    FieldInfo chimeSet, chimeOn;
    Type chimeEnum;
    Color cyan, red, ink, dim;
    System.Windows.Forms.Timer timer;

    bool bubbleHidden, hover;
    volatile bool securityAsking;
    IntPtr cloakedHandle = IntPtr.Zero;
    IntPtr cloakedMirrorHandle = IntPtr.Zero;
    float drawnScale = -1;
    bool drawnHover, drawnHidden;
    bool wasEscDown;
    bool wasChatting;
    bool glassPlayedInChat;
    bool chimesSuppressed;
    bool savedChimesOn = true;

    string pendingText;
    string lastChunk;
    bool forwarding;
    bool listeningSession;
    bool cancelled;
    double lastSpeechAt;
    double lastActiveAt;

    public void Start(ICapriHost host)
    {
        capri = host;
        bubbleHidden = host.Store.Flag("hide_bubble", false);

        try
        {
            window = (Form)host.GetType().GetField("capri", Any).GetValue(host);
            Assembly app = typeof(ICapriMod).Assembly;
            Type pillType = app.GetType("CapriDesktop.TalkPill");
            Type look = app.GetType("CapriDesktop.Look");
            Type overlay = app.GetType("CapriDesktop.Overlay");
            Type chimesType = app.GetType("CapriDesktop.Chimes");
            chimeEnum = app.GetType("CapriDesktop.Chime");

            pill = (Form)Field(window.GetType(), "pill").GetValue(window);
            pillUntil = Field(window.GetType(), "pillUntil");
            clock = (Stopwatch)Field(window.GetType(), "clock").GetValue(window);
            talkScale = Need(window.GetType().GetMethod("TalkScale", Any, null, Type.EmptyTypes, null), "TalkScale");
            plate = Need(pillType.GetMethod("Plate", Any), "TalkPill.Plate");
            pillCentre = Field(pillType, "centre");
            pillScale = Field(pillType, "scale");
            chatting = Need(pillType.GetProperty("Chatting", Any), "TalkPill.Chatting");

            FieldInfo boxField = window.GetType().GetField("box", Any);
            box = boxField == null ? null : boxField.GetValue(window) as Form;

            askingField = window.GetType().GetField("asking", Any);
            talkStateField = window.GetType().GetField("talkState", Any);
            closeNameChat = window.GetType().GetMethod("CloseNameChat", Any, null, Type.EmptyTypes, null);
            utteranceField = window.GetType().GetField("utterance", Any);
            transcribingField = window.GetType().GetField("transcribing", Any);
            jobField = window.GetType().GetField("job", Any);

            Type securityType = app.GetType("CapriDesktop.Security");
            if (securityType != null)
            {
                securityHoldingProp = securityType.GetProperty("HoldingId", Any);
                securityHoldingField = securityType.GetField("HoldingId", Any);
                MethodInfo onHeld = GetType().GetMethod("OnSecurityHeldChanged", Any);
                securityHeldEvent = securityType.GetEvent("HeldChanged", Any);
                if (securityHeldEvent != null)
                {
                    securityHeldHandler = Delegate.CreateDelegate(securityHeldEvent.EventHandlerType, this, onHeld);
                    securityHeldEvent.AddEventHandler(null, securityHeldHandler);
                }
                else
                {
                    securityHeldField = securityType.GetField("HeldChanged", Any);
                    if (securityHeldField != null)
                    {
                        securityHeldHandler = Delegate.CreateDelegate(securityHeldField.FieldType, this, onHeld);
                        securityHeldField.SetValue(null, Delegate.Combine(securityHeldField.GetValue(null) as Delegate, securityHeldHandler));
                    }
                }
            }

            Type jobType = app.GetType("CapriDesktop.Job");
            if (jobType != null)
            {
                jobAskingProp = jobType.GetProperty("Asking", Any);
                jobAskingField = jobType.GetField("Asking", Any);
            }

            if (chimesType != null && chimeEnum != null)
            {
                chimePlay = chimesType.GetMethod("Play", Any);
                chimeSet = chimesType.GetField("Set", Any);
                chimeOn = chimesType.GetField("On", Any);
                SuppressNativeChimes();
            }

            cyan = (Color)Field(look, "Cyan").GetValue(null);
            red = (Color)Field(look, "Red").GetValue(null);
            ink = (Color)Field(look, "Ink").GetValue(null);
            dim = (Color)Field(look, "Dim").GetValue(null);
            present = Need(overlay.GetMethod("Present", Any), "Overlay.Present");
            Cursor pointer = (Cursor)look.GetProperty("Pointer", Any).GetValue(null, null);

            host.Voice.Heard += OnVoiceHeard;
            host.Voice.Speaking += OnVoiceSpeaking;
            host.Chat.Sending += OnChatSending;
            host.Chat.Replying += OnChatReplying;
            host.Chat.Replied += OnChatReplied;

            OnUi(delegate
            {
                if (box != null)
                {
                    box.VisibleChanged += OnBoxChanged;
                    box.HandleCreated += OnBoxChanged;
                    ApplyBubbleCloak();
                }

                button = (Form)Activator.CreateInstance(overlay, Any, null, new object[] { "Hide Chat Bubble" }, null);
                button.Cursor = pointer;
                button.Owner = window;
                button.MouseUp += delegate(object sender, MouseEventArgs e) { if (e.Button == MouseButtons.Left) ToggleBubble(); };
                still = new Hook();
                still.AssignHandle(button.Handle);
                timer = new System.Windows.Forms.Timer { Interval = 15 };
                timer.Tick += delegate { Tick(); };
                timer.Start();
            });
        }
        catch (Exception error)
        {
            host.Log("Voice Flow couldn't hook into Capri: " + error.Message);
        }
    }

    public bool Heard(string words) { return false; }

    public void Stop()
    {
        ResetSession();
        cancelled = false;
        glassPlayedInChat = false;
        securityAsking = false;
        securityHold = null;
        try
        {
            if (securityHeldHandler != null)
            {
                if (securityHeldEvent != null)
                    securityHeldEvent.RemoveEventHandler(null, securityHeldHandler);
                else if (securityHeldField != null)
                    securityHeldField.SetValue(null, Delegate.Remove(securityHeldField.GetValue(null) as Delegate, securityHeldHandler));
                securityHeldHandler = null;
            }
        }
        catch (Exception) { }
        RestoreNativeChimes();
        OnUi(delegate
        {
            if (box != null)
            {
                box.VisibleChanged -= OnBoxChanged;
                box.HandleCreated -= OnBoxChanged;
            }
            UncloakBubble();
            if (timer != null) timer.Dispose();
            timer = null;
            if (watch != null) { watch.Moved = null; watch.ReleaseHandle(); watch = null; }
            if (still != null) { still.ReleaseHandle(); still = null; }
            if (button != null) button.Dispose();
            button = null;
        });
    }

    double Now() { return clock != null ? clock.Elapsed.TotalSeconds : Environment.TickCount / 1000.0; }

    void SuppressNativeChimes()
    {
        if (chimeOn == null) return;
        try
        {
            bool current = (bool)chimeOn.GetValue(null);
            if (!chimesSuppressed)
            {
                savedChimesOn = current;
                chimesSuppressed = true;
            }
            if (current) chimeOn.SetValue(null, false);
        }
        catch (Exception) { }
    }

    void RestoreNativeChimes()
    {
        if (!chimesSuppressed || chimeOn == null) return;
        try { chimeOn.SetValue(null, savedChimesOn); }
        catch (Exception) { }
        chimesSuppressed = false;
    }

    void OnBoxChanged(object sender, EventArgs e)
    {
        ApplyBubbleCloak();
    }

    void OnSecurityHeldChanged(object hold, string state, string words)
    {
        if (state == "asking")
        {
            securityHold = hold;
            securityAsking = true;
            ResetSession();
        }
        else if (securityHold == null || Equals(hold, securityHold))
        {
            securityHold = null;
            securityAsking = false;
        }
        OnUi(ApplyBubbleCloak);
    }

    bool IsSecurityAsking()
    {
        if (securityAsking)
        {
            try
            {
                if (securityHold != null)
                {
                    object currentHold = securityHoldingProp != null ? securityHoldingProp.GetValue(null, null)
                        : securityHoldingField != null ? securityHoldingField.GetValue(null) : securityHold;
                    if (!Equals(currentHold, securityHold))
                    {
                        securityHold = null;
                        securityAsking = false;
                    }
                }
            }
            catch (Exception) { }
            if (securityAsking) return true;
        }
        try
        {
            if (jobField != null)
            {
                object currentJob = jobField.GetValue(window);
                if (currentJob != null)
                {
                    if (jobAskingProp != null && (bool)jobAskingProp.GetValue(currentJob, null)) return true;
                    if (jobAskingField != null && (bool)jobAskingField.GetValue(currentJob)) return true;
                }
            }
        }
        catch (Exception) { }
        return false;
    }

    Form FindMirrorForm()
    {
        try
        {
            foreach (Form f in Application.OpenForms)
            {
                if (f != null && !f.IsDisposed && f.IsHandleCreated)
                {
                    string name = f.GetType().FullName;
                    if (name != null && name.EndsWith("HologramSpeechGlass+Mirror", StringComparison.Ordinal))
                        return f;
                }
            }
        }
        catch (Exception) { }
        return null;
    }

    void ApplyBubbleCloak()
    {
        if (box == null || box.IsDisposed || !box.IsHandleCreated) return;
        IntPtr handle = box.Handle;
        if (bubbleHidden && !IsSecurityAsking())
        {
            if (cloakedHandle != IntPtr.Zero && cloakedHandle != handle)
                UncloakHandle(cloakedHandle);
            int on = 1;
            DwmSetWindowAttribute(handle, DwmwaCloak, ref on, 4);
            cloakedHandle = handle;

            Form mirror = FindMirrorForm();
            if (mirror != null)
            {
                IntPtr mirrorHandle = mirror.Handle;
                if (cloakedMirrorHandle != IntPtr.Zero && cloakedMirrorHandle != mirrorHandle)
                    UncloakHandle(cloakedMirrorHandle);
                DwmSetWindowAttribute(mirrorHandle, DwmwaCloak, ref on, 4);
                cloakedMirrorHandle = mirrorHandle;
            }
        }
        else
        {
            UncloakBubble();
        }
    }

    void UncloakBubble()
    {
        if (cloakedHandle != IntPtr.Zero)
        {
            UncloakHandle(cloakedHandle);
            cloakedHandle = IntPtr.Zero;
        }
        if (box != null && !box.IsDisposed && box.IsHandleCreated)
            UncloakHandle(box.Handle);
        if (cloakedMirrorHandle != IntPtr.Zero)
        {
            UncloakHandle(cloakedMirrorHandle);
            cloakedMirrorHandle = IntPtr.Zero;
        }
        Form mirror = FindMirrorForm();
        if (mirror != null)
            UncloakHandle(mirror.Handle);
    }

    static void UncloakHandle(IntPtr handle)
    {
        int off = 0;
        DwmSetWindowAttribute(handle, DwmwaCloak, ref off, 4);
    }

    void BeginListeningSession()
    {
        if (listeningSession) return;
        listeningSession = true;
        if (!glassPlayedInChat)
        {
            glassPlayedInChat = true;
            PlayChime(ChimeUser, KindListening);
        }
    }

    void OnVoiceHeard(string text, bool forHer)
    {
        if (IsSecurityAsking()) return;
        if (capri.Voice.Talking || capri.Her.State == "talking") return;
        string clean = (text ?? "").Trim();
        if (IsNoise(clean)) return;

        if (forHer)
        {
            BeginListeningSession();
            AppendPending(clean);
            lastSpeechAt = Now();
            return;
        }

        if (listeningSession)
        {
            AppendPending(clean);
            lastSpeechAt = Now();
        }
        else
        {
            glassPlayedInChat = false;
        }
    }

    void OnChatSending(CapriMessage message)
    {
        if (forwarding) return;
        if (message.Source == "mod") return;
        if (IsSecurityAsking()) return;
        if (message.Source == "type")
        {
            cancelled = false;
            return;
        }

        string clean = (message.Text ?? "").Trim();
        if (IsNoise(clean))
        {
            message.Cancel = true;
            return;
        }

        message.Cancel = true;
        BeginListeningSession();
        AppendPending(clean);
        lastSpeechAt = Now();
    }

    void OnChatReplying(CapriMessage message)
    {
        if (!cancelled || message.Source == "remark") return;
        cancelled = false;
        message.Cancel = true;
        message.Text = "";
        capri.Voice.Stop();
    }

    void OnVoiceSpeaking(CapriMessage message)
    {
        if (!cancelled || message.Source == "remark") return;
        cancelled = false;
        message.Cancel = true;
    }

    void AppendPending(string text)
    {
        if (string.Equals(lastChunk, text, StringComparison.OrdinalIgnoreCase)) return;
        lastChunk = text;
        pendingText = string.IsNullOrEmpty(pendingText) ? text : pendingText + " " + text;
    }

    void OnChatReplied(CapriMessage message)
    {
        if (cancelled && message.Source != "remark")
        {
            cancelled = false;
            capri.Voice.Stop();
            return;
        }
        if (bubbleHidden) ApplyBubbleCloak();
    }

    void ResetSession()
    {
        pendingText = null;
        lastChunk = null;
        listeningSession = false;
        lastSpeechAt = 0;
    }

    bool IsSpeakingOrTranscribing()
    {
        try
        {
            if (utteranceField != null && utteranceField.GetValue(window) != null) return true;
            if (transcribingField != null && (bool)transcribingField.GetValue(window)) return true;
        }
        catch (Exception) { }
        return false;
    }

    void FlushPending()
    {
        string toSend = pendingText;
        ResetSession();
        if (string.IsNullOrEmpty(toSend)) return;

        cancelled = false;
        PlayChime(ChimeShard, KindHeard);
        forwarding = true;
        try { capri.Chat.Send(toSend); }
        finally { forwarding = false; }
    }

    static bool IsNoise(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return true;
        string trimmed = text.Trim();
        if (LettersOnly.Matches(trimmed).Count < 2) return true;
        if (NoiseWords.IsMatch(trimmed)) return true;
        return false;
    }

    void CancelThinking()
    {
        bool inFlight = capri.Her.State == "thinking" || capri.Chat.Busy;
        ResetSession();
        glassPlayedInChat = false;
        securityAsking = false;
        securityHold = null;
        cancelled = inFlight;
        try
        {
            if (askingField != null)
            {
                int current = (int)askingField.GetValue(window);
                askingField.SetValue(window, current + 1);
            }
            if (talkStateField != null)
            {
                talkStateField.SetValue(window, Enum.ToObject(talkStateField.FieldType, 0));
            }
            if (closeNameChat != null) closeNameChat.Invoke(window, null);
        }
        catch (Exception error)
        {
            capri.Log("Voice Flow cancel error: " + error.Message);
        }
        capri.Voice.Stop();
        try { capri.Her.Animate("idle"); } catch (Exception) { }
        PlayChime(ChimePulse, KindHeard);
    }

    void PlayChime(int setIndex, int kindIndex)
    {
        if (chimePlay == null || chimeSet == null || chimeEnum == null) return;
        try
        {
            int prevSet = (int)chimeSet.GetValue(null);
            bool prevOn = chimeOn != null ? (bool)chimeOn.GetValue(null) : true;
            try
            {
                if (chimeOn != null) chimeOn.SetValue(null, true);
                if (setIndex >= 0) chimeSet.SetValue(null, setIndex);
                object kind = Enum.ToObject(chimeEnum, kindIndex);
                chimePlay.Invoke(null, new object[] { kind, true });
            }
            finally
            {
                chimeSet.SetValue(null, prevSet);
                if (chimeOn != null) chimeOn.SetValue(null, prevOn);
            }
        }
        catch (Exception error)
        {
            capri.Log("Voice Flow chime error: " + error.Message);
        }
    }

    void Tick()
    {
        SuppressNativeChimes();

        bool isChatting = pill != null && (bool)chatting.GetValue(pill, null);
        if (isChatting && !wasChatting)
        {
            wasChatting = true;
        }
        else if (!isChatting && wasChatting)
        {
            wasChatting = false;
            glassPlayedInChat = false;
        }

        short escState = GetAsyncKeyState(VkEscape);
        bool escDown = (escState & 0x8000) != 0;
        bool escPressed = (escState & 0x0001) != 0 || (escDown && !wasEscDown);
        wasEscDown = escDown;

        if (escPressed)
        {
            if (capri.Her.State == "thinking" || capri.Chat.Busy || listeningSession || pendingText != null)
                CancelThinking();
        }

        if (cancelled && capri.Voice.Talking)
            capri.Voice.Stop();

        bool active = listeningSession || IsSecurityAsking() || capri.Chat.Busy || capri.Voice.Talking || capri.Her.State == "thinking" || capri.Her.State == "talking";
        if (active)
            lastActiveAt = Now();
        else if (glassPlayedInChat && Now() - lastActiveAt >= IdleResetSeconds)
        {
            glassPlayedInChat = false;
            try { if (closeNameChat != null) closeNameChat.Invoke(window, null); } catch (Exception) { }
        }

        if (listeningSession && pendingText != null)
        {
            if (IsSpeakingOrTranscribing())
                lastSpeechAt = Now();
            else if (Now() - lastSpeechAt >= DebounceSeconds)
                FlushPending();
        }

        if (bubbleHidden) ApplyBubbleCloak();
        Follow();
    }

    void ToggleBubble()
    {
        bubbleHidden = !bubbleHidden;
        capri.Store.Set("hide_bubble", bubbleHidden);
        ApplyBubbleCloak();
        Follow();
    }

    bool Showing() { return pill.IsHandleCreated && pill.Visible && IsWindowVisible(pill.Handle); }

    float Scale()
    {
        float s = (float)pillScale.GetValue(pill);
        return s >= 0.5f && s <= 8 ? s : (float)talkScale.Invoke(window, null);
    }

    public static Rectangle Spot(float s, Point c, bool chat, bool hasMuteMod)
    {
        Size size = Measure(s);
        int gap = (int)Math.Round(Gap * s), wide = (int)Math.Round(100 * s), pillLeft = c.X - wide / 2;
        int slots = hasMuteMod ? 2 : 1;
        Rectangle at = new Rectangle(new Point(pillLeft - (gap + size.Width) * slots, c.Y), size);
        if (at.Left < Screen.FromPoint(c).WorkingArea.Left)
            at.X = pillLeft + wide + gap + (chat ? (int)Math.Round(40 * s) + gap : 0) + (hasMuteMod ? size.Width + gap : 0);
        return at;
    }

    void Follow()
    {
        if (button == null || button.IsDisposed) return;
        if (pill.IsHandleCreated && (watch == null || watch.Handle != pill.Handle))
        {
            if (watch != null) watch.ReleaseHandle();
            watch = new Hook { Moved = Follow };
            watch.AssignHandle(pill.Handle);
        }
        if (!Showing()) { if (button.Visible) button.Hide(); hover = false; return; }
        float s = Scale();
        bool hasMuteMod = capri.Mods.IsRunning("mute-button");
        Rectangle want = Spot(s, (Point)pillCentre.GetValue(pill), (bool)chatting.GetValue(pill, null), hasMuteMod);
        Point cursor = Cursor.Position;
        hover = button.Visible && want.Contains(cursor) && Body(s).Contains(new Point(cursor.X - want.X, cursor.Y - want.Y));
        if (hover) pillUntil.SetValue(window, Math.Max((double)pillUntil.GetValue(window), clock.Elapsed.TotalSeconds + 1.5));
        if (button.Visible && Real(button) == want && s == drawnScale && hover == drawnHover && bubbleHidden == drawnHidden) return;
        drawnScale = s; drawnHover = hover; drawnHidden = bubbleHidden;
        present.Invoke(button, new object[] { Render(s, hover, bubbleHidden), want.Location });
    }

    public static Size Measure(float s) { int side = (int)Math.Round(Side * s); return new Size(side, side); }

    public static Rectangle Body(float s)
    {
        Size size = Measure(Math.Max(s, 0.1f));
        int margin = (int)Math.Round(3 * s);
        return new Rectangle(margin, margin, size.Width - margin * 2, size.Height - margin * 2);
    }

    Bitmap Render(float s, bool lit, bool hidden)
    {
        Size size = Measure(s);
        Bitmap image = new Bitmap(size.Width, size.Height, PixelFormat.Format32bppPArgb);
        using (Graphics g = Graphics.FromImage(image))
        {
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.PixelOffsetMode = PixelOffsetMode.HighQuality;
            Rectangle body = Body(s);
            Color edge = hidden ? red : cyan;
            plate.Invoke(null, new object[] { g, body, s, lit ? body : Rectangle.Empty, edge, edge });
            DrawBubbleIcon(g, new PointF(body.Left + body.Width / 2f, body.Top + body.Height / 2f), s, lit ? cyan : hidden ? dim : ink, hidden);
        }
        return image;
    }

    void DrawBubbleIcon(Graphics g, PointF center, float s, Color colour, bool hidden)
    {
        float k = s * IconScale;
        float w = 15f * k;
        float h = 11f * k;
        float r = 3f * k;
        float x = center.X - w / 2f;
        float y = center.Y - h / 2f - 1f * k;

        using (GraphicsPath path = new GraphicsPath())
        {
            path.AddArc(x, y, r * 2, r * 2, 180, 90);
            path.AddArc(x + w - r * 2, y, r * 2, r * 2, 270, 90);
            path.AddArc(x + w - r * 2, y + h - r * 2, r * 2, r * 2, 0, 90);
            path.AddLine(x + 6.5f * k, y + h, x + 3f * k, y + h + 3.5f * k);
            path.AddLine(x + 3f * k, y + h + 3.5f * k, x + 3.5f * k, y + h);
            path.AddArc(x, y + h - r * 2, r * 2, r * 2, 90, 90);
            path.CloseFigure();

            using (Brush brush = new SolidBrush(colour))
                g.FillPath(brush, path);
        }

        if (hidden)
        {
            using (Pen slash = new Pen(red, 2.0f * k))
            {
                slash.StartCap = slash.EndCap = LineCap.Round;
                g.DrawLine(slash, center.X - 8f * k, center.Y - 7f * k, center.X + 8f * k, center.Y + 7f * k);
            }
        }
    }

    void OnUi(Action work)
    {
        Action safe = delegate
        {
            try { work(); }
            catch (Exception error) { capri.Log("Voice Flow: " + error.Message); }
        };
        try { if (window != null && window.IsHandleCreated && !window.IsDisposed && window.InvokeRequired) window.BeginInvoke(safe); else safe(); }
        catch (InvalidOperationException) { safe(); }
    }

    static FieldInfo Field(Type type, string name) { return Need(type.GetField(name, Any), type.Name + "." + name); }

    static T Need<T>(T found, string name) where T : class
    {
        if (found == null) throw new MissingMemberException(name + " is missing from this Capri version");
        return found;
    }
}
